---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import PlayerBar from '../components/PlayerBar.astro';
const { title = "Music App" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" /></noscript>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&display=swap" /></noscript>
  <script is:inline>
    try {
      document.documentElement.dataset.authed = localStorage.getItem('auth_token') ? 'true' : 'false';
    } catch {}
  </script>
  <slot name="head" />
  <ClientRouter />
  <title>{title}</title>

</head>

<body>
  <div id="app" class="min-h-screen flex flex-col">
    <slot />
  </div>

  <div id="playbar-container" transition:persist>
    <PlayerBar />
  </div>

  <div id="global-atp-modal" class="hidden fixed inset-0 z-[300] flex items-center justify-center bg-[#020617]/80 p-4 sm:p-6" style="transform: translateZ(0); will-change: transform;">
    <div class="w-full max-w-lg overflow-hidden rounded-[1.75rem] border border-white/10 bg-[linear-gradient(180deg,rgba(15,23,42,0.98)_0%,rgba(9,15,29,0.98)_100%)] shadow-[0_24px_80px_rgba(0,0,0,0.55)]">
      <div class="relative border-b border-white/10 px-5 py-4 sm:px-6 sm:py-5">
        <div class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-purple-400/40 to-transparent"></div>
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0 pr-10">
            <h3 class="text-xl font-bold tracking-tight text-white flex items-center gap-2">
              <span class="material-symbols-outlined text-purple-400 text-[20px]">playlist_add</span>
              Add to Playlist
            </h3>
            <p id="global-atp-song-name" class="mt-1 text-sm leading-6 text-slate-400 truncate"></p>
          </div>
          <button id="global-atp-close" type="button" class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 text-slate-300 transition-colors hover:bg-white/10 hover:text-white">
            <span class="material-symbols-outlined text-[20px]">close</span>
          </button>
        </div>
      </div>
      <div class="px-5 py-5 sm:px-6 sm:py-6">
        <div id="global-atp-list" class="space-y-2 max-h-72 overflow-y-auto pr-1 rounded-2xl">
          <p class="text-slate-400 text-sm text-center py-4">Loading...</p>
        </div>
        <p id="global-atp-feedback" class="hidden mt-3 text-xs font-medium"></p>
        <a href="/playlist" class="mt-4 inline-flex items-center gap-2 text-sm text-purple-300 hover:text-purple-200 transition-colors font-medium">
          <span class="material-symbols-outlined text-[18px]">add</span>
          Create new playlist
        </a>
      </div>
    </div>
  </div>

  <script>
    import { API_BASE, clearAuth } from '../lib/api.js';

    const _GRADS_ATP = [
      'linear-gradient(135deg,#6366f1,#8b5cf6)',
      'linear-gradient(135deg,#f43f5e,#f97316)',
      'linear-gradient(135deg,#ec4899,#7c3aed)',
      'linear-gradient(135deg,#ef4444,#d946ef)',
      'linear-gradient(135deg,#3b82f6,#06b6d4)',
      'linear-gradient(135deg,#06b6d4,#10b981)',
      'linear-gradient(135deg,#d946ef,#7c3aed)',
      'linear-gradient(135deg,#fb923c,#fb7185)',
    ];

    const _atpModal    = document.getElementById('global-atp-modal')!;
    const _atpClose    = document.getElementById('global-atp-close')!;
    const _atpList     = document.getElementById('global-atp-list')!;
    const _atpSongName = document.getElementById('global-atp-song-name')!;
    const _atpFeedback = document.getElementById('global-atp-feedback')!;
    let _atpSong: any  = null;

    function _atpShowFeedback(msg: string, ok: boolean) {
      _atpFeedback.textContent = msg;
      _atpFeedback.className = `text-xs mt-2 font-medium ${ok ? 'text-green-400' : 'text-red-400'}`;
      _atpFeedback.classList.remove('hidden');
      setTimeout(() => _atpFeedback.classList.add('hidden'), 2500);
    }

    _atpClose?.addEventListener('click', () => _atpModal.classList.add('hidden'));
    _atpModal?.addEventListener('click', (e) => { if (e.target === _atpModal) _atpModal.classList.add('hidden'); });

    async function openAddToPlaylist(song: any) {
      _atpSong = song;
      _atpSongName.textContent = `"${song.title}"`;
      _atpFeedback.classList.add('hidden');
      _atpModal.classList.remove('hidden');
      _atpList.innerHTML = '<p class="text-gray-500 text-sm text-center py-4">Loading...</p>';

      const token = localStorage.getItem('auth_token');
      if (!token) {
        _atpList.innerHTML = '<p class="text-gray-400 text-sm text-center py-4"><a href="/login" class="text-purple-400">Log in</a> to add to a playlist.</p>';
        return;
      }

      try {
        const res  = await fetch(`${API_BASE}/playlists/me`, {
          headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
        });
        const json = await res.json();
        const playlists: any[] = json.data || [];

        if (!playlists.length) {
          _atpList.innerHTML = '<p class="text-gray-400 text-sm text-center py-4">No playlists yet. <a href="/playlist" class="text-purple-400">Create one</a>.</p>';
          return;
        }

        _atpList.innerHTML = playlists.map((pl: any) => {
          const bg    = _GRADS_ATP[(Number(pl.id) - 1) % _GRADS_ATP.length];
          const img   = pl.cover_url || pl.first_cover_url;
          const cover = img ? `<img src="${img}" class="w-full h-full object-cover rounded-lg" alt="" />` : '';
          return `
            <button class="atp-pl-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-white/8 transition-colors text-left group"
                    data-pl-id="${pl.id}" data-pl-name="${pl.name}" type="button">
              <div class="w-10 h-10 rounded-lg shrink-0 overflow-hidden flex items-center justify-center" style="background:${bg}">
                ${cover || '<span class="material-symbols-outlined text-white/30 text-lg">queue_music</span>'}
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-gray-200 group-hover:text-white truncate">${pl.name}</p>
                <p class="text-xs text-gray-500">${pl.songs_count ?? 0} songs</p>
              </div>
              <span class="material-symbols-outlined text-gray-600 group-hover:text-green-400 transition-colors text-[20px] shrink-0">add_circle</span>
            </button>`;
        }).join('');
      } catch {
        _atpList.innerHTML = '<p class="text-red-400 text-sm text-center py-4">Failed to load playlists.</p>';
      }
    }

    _atpList?.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('.atp-pl-item') as HTMLButtonElement | null;
      if (!btn || !_atpSong || btn.disabled) return;
      const plId   = btn.dataset.plId;
      const plName = btn.dataset.plName;
      const icon   = btn.querySelector('.material-symbols-outlined:last-of-type') as HTMLElement | null;
      const origIcon = icon?.textContent || 'add_circle';
      btn.disabled = true;
      if (icon) icon.textContent = 'pending';

      try {
        const token = localStorage.getItem('auth_token');
        const res = await fetch(`${API_BASE}/playlists/${plId}/songs`, {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ songId: _atpSong.id }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.message || 'Failed');
        if (icon) { icon.textContent = 'check_circle'; icon.classList.add('text-green-400'); }
        _atpShowFeedback(`Added to "${plName}"`, true);
        setTimeout(() => _atpModal.classList.add('hidden'), 900);
      } catch (err: any) {
        btn.disabled = false;
        if (icon) { icon.textContent = origIcon; icon.classList.remove('text-green-400'); }
        _atpShowFeedback(err.message || 'Failed to add song.', false);
      }
    });


    (window as any).openAddToPlaylist = openAddToPlaylist;
  </script>
  <script>
    import { getUser, getToken, clearAuth, apiFetch } from '../lib/api.js';

    function applyAuthenticatedUI(user: any) {
      document.documentElement.dataset.authed = 'true';
      const sidebar = document.getElementById('main-sidebar');
      if (sidebar) sidebar.dataset.authed = 'true';
      document.getElementById('sidebar-guest')?.classList.add('hidden');
      document.getElementById('sidebar-user')?.classList.remove('hidden');
      document.getElementById('sidebar-user')?.classList.add('flex');
      document.getElementById('btn-new-playlist')?.classList.remove('hidden');
      document.getElementById('btn-new-playlist')?.classList.add('flex');
      document.getElementById('header-user')?.classList.remove('hidden');
      document.getElementById('header-login-btn')?.classList.add('hidden');
      const greetingEl = document.getElementById('header-greeting');
      if (greetingEl) {
        const hour = new Date().getHours();
        const timeGreeting = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
        greetingEl.textContent = `${timeGreeting}, ${user?.full_name || user?.username || ''}`;
      }
    }

    function applyUnauthenticatedUI() {
      document.documentElement.dataset.authed = 'false';
      const sidebar = document.getElementById('main-sidebar');
      if (sidebar) sidebar.dataset.authed = 'false';
      document.getElementById('sidebar-guest')?.classList.remove('hidden');
      document.getElementById('sidebar-user')?.classList.add('hidden');
      document.getElementById('sidebar-user')?.classList.remove('flex');
      document.getElementById('btn-new-playlist')?.classList.add('hidden');
      document.getElementById('btn-new-playlist')?.classList.remove('flex');
      document.getElementById('header-user')?.classList.add('hidden');
      document.getElementById('header-login-btn')?.classList.remove('hidden');
    }

    function syncAuthFromStorage() {
      const token = localStorage.getItem('auth_token');
      const user = JSON.parse(localStorage.getItem('auth_user') ?? 'null');
      if (token && user) applyAuthenticatedUI(user);
      else applyUnauthenticatedUI();
    }

    document.addEventListener('astro:before-swap', (e: any) => {
      const token = localStorage.getItem('auth_token');
      if (token) e.newDocument.documentElement.dataset.authed = 'true';
    });

    document.addEventListener('astro:page-load', () => {
      syncAuthFromStorage();
      const token = getToken();
      const user = getUser();
      if (token && user) {
        applyAuthenticatedUI(user);
        const verify = () => apiFetch('/auth/me').catch(() => {
          clearAuth();
          applyUnauthenticatedUI();
          window.location.href = '/login?reason=session_expired';
        });
        if ('requestIdleCallback' in window) requestIdleCallback(verify);
        else setTimeout(verify, 0);
      }
    });

    document.addEventListener('astro:before-swap', (e: any) => {
      const token = localStorage.getItem('auth_token');
      if (token) e.newDocument.documentElement.dataset.authed = 'true';
    });

    syncAuthFromStorage();
  </script>
</body>
</html>