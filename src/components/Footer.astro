---
const year = new Date().getFullYear();
---

<footer class="relative z-20 mt-auto border-t border-white/10 bg-[linear-gradient(180deg,rgba(7,14,32,0.2),rgba(5,10,24,0.92))] backdrop-blur-xl">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-purple-500/60 to-transparent"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <div class="grid gap-8 md:grid-cols-[1.3fr_1fr_1fr] lg:grid-cols-[1.4fr_0.8fr_0.8fr] items-start">
      <div class="space-y-4">
        <a href="/" class="inline-flex items-center gap-3 text-white">
          <span class="flex h-11 w-11 items-center justify-center rounded-2xl border border-purple-400/20 bg-purple-500/10 shadow-[0_0_30px_rgba(168,85,247,0.18)]">
            <span class="material-symbols-outlined text-purple-300">music_note</span>
          </span>
          <div>
            <p class="text-lg font-black tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-indigo-300 via-purple-300 to-fuchsia-300">
              Shadows of Melody
            </p>
            <p class="text-sm text-gray-400">Feel the music, discover your next favorite track.</p>
          </div>
        </a>

        <p class="max-w-md text-sm leading-6 text-gray-400">
          A modern music space for discovering songs, playlists, and your favorite artists.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="/search" class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-gray-200 transition-colors hover:bg-white/10 hover:text-white">
            <span class="material-symbols-outlined text-[18px] text-purple-300">search</span>
            Explore
          </a>
          <a href="/playlist" class="inline-flex items-center gap-2 rounded-full border border-purple-500/20 bg-purple-500/10 px-4 py-2 text-sm font-medium text-purple-200 transition-colors hover:bg-purple-500/20 hover:text-white">
            <span class="material-symbols-outlined text-[18px]">queue_music</span>
            My Playlists
          </a>
        </div>
      </div>

      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-gray-500">Navigate</h3>
        <ul class="space-y-3 text-sm text-gray-300">
          <li><a class="transition-colors hover:text-white" href="/">Home</a></li>
          <li><a class="transition-colors hover:text-white" href="/search">Search</a></li>
          <li><a class="transition-colors hover:text-white" href="/playlist">Playlists</a></li>
          <li><a class="transition-colors hover:text-white" href="/subscription">Subscription</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-gray-500">Connect</h3>
        <ul class="space-y-3 text-sm text-gray-300">
          <li><a class="transition-colors hover:text-white" href="/login">Login</a></li>
          <li><a class="transition-colors hover:text-white" href="/signup">Create account</a></li>
          <li><a class="transition-colors hover:text-white" href="/upload">Upload song</a></li>
          <li><a class="transition-colors hover:text-white" href="/studio">Artist studio</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-3 border-t border-white/10 pt-5 text-sm text-gray-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Shadows of Melody. All rights reserved.</p>
      <p class="flex items-center gap-2">
        <span class="inline-flex h-2 w-2 rounded-full bg-green-400 shadow-[0_0_12px_rgba(74,222,128,0.7)]"></span>
        Crafted for a smooth listening experience
      </p>
    </div>
  </div>
</footer>
