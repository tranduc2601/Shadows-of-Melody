<div id="playerBar" class="fixed bottom-0 left-0 right-0 w-full bg-[#0a1229]/80 border-t border-white/5 z-50 flex flex-col gap-3 sm:gap-0 sm:flex-row sm:items-center sm:justify-between px-4 sm:px-6 py-4 sm:py-4 lg:py-5 shadow-[0_-4px_16px_rgba(0,0,0,0.22)]" style="display:none;">


  <div class="flex items-center gap-3 w-full sm:w-1/4 min-w-0 sm:min-w-[180px]">
    <div id="pb-cover" class="w-14 h-14 rounded-xl bg-linear-to-br from-indigo-500 to-purple-500 shadow-lg shadow-purple-500/20 relative group cursor-pointer overflow-hidden shrink-0">
      <span class="material-symbols-outlined absolute inset-0 flex items-center justify-center text-white/30 text-3xl">music_note</span>
      <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity">
        <span class="material-symbols-outlined text-white text-xl">keyboard_arrow_up</span>
      </div>
    </div>
    <div class="flex flex-col justify-center min-w-0 flex-1">
      <span id="pb-title" class="font-bold text-white text-[15px] truncate">No Music Playing</span>
      <span id="pb-artist" class="text-xs text-gray-400 truncate mt-0.5">-</span>
    </div>
  </div>


  <div class="flex-1 flex flex-col items-center w-full max-w-2xl px-0 sm:px-8">
    <div class="flex items-center gap-6 mb-1.5">
      <button id="pb-shuffle" type="button" aria-label="Ngẫu nhiên" class="text-gray-500 hover:text-white transition-colors">
        <span class="material-symbols-outlined text-xl">shuffle</span>
      </button>
      <button id="pb-prev" type="button" aria-label="Trước" class="text-gray-400 hover:text-white transition-colors">
        <span class="material-symbols-outlined text-2xl">skip_previous</span>
      </button>
      <button id="pb-play" type="button" aria-label="Phát / Dừng" class="w-10 h-10 rounded-full bg-white text-black flex items-center justify-center hover:scale-110 transition-transform shadow-[0_0_20px_rgba(255,255,255,0.3)]">
        <span class="material-symbols-outlined">play_arrow</span>
      </button>
      <button id="pb-next" type="button" aria-label="Tiếp theo" class="text-gray-400 hover:text-white transition-colors">
        <span class="material-symbols-outlined text-2xl">skip_next</span>
      </button>
      <button id="pb-repeat" type="button" aria-label="Lặp lại" class="text-gray-500 hover:text-white transition-colors relative">
        <span class="material-symbols-outlined text-xl">repeat</span>
        <span id="pb-repeat-dot" class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-current opacity-0"></span>
      </button>
      <button id="pb-fav" type="button" aria-label="Yêu thích" class="ml-2 text-gray-400 hover:text-pink-500 transition-colors shrink-0">
        <span class="material-symbols-outlined">favorite_border</span>
      </button>
      <button id="pb-add" type="button" aria-label="Thêm vào playlist" class="text-gray-400 hover:text-purple-400 transition-colors shrink-0">
        <span class="material-symbols-outlined">playlist_add</span>
      </button>
      <button id="pb-share" type="button" aria-label="Chia sẻ" class="text-gray-400 hover:text-cyan-300 transition-colors shrink-0">
        <span class="material-symbols-outlined">share</span>
      </button>
      <span id="pb-queue-chip" class="ml-1 hidden rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-[11px] font-semibold text-gray-300"></span>
    </div>
    <div class="w-full flex items-center gap-3">
      <span id="pb-curtime" class="text-[11px] font-medium text-gray-400 w-10 text-right tabular-nums">0:00</span>
      <div id="pb-seek-hit" class="flex-1 py-1.5 cursor-pointer group">
        <div id="pb-seek" class="relative h-1 bg-white/10 rounded-full overflow-visible transition-[height,background-color] duration-200 group-hover:h-1.5">
          <div id="pb-progress" class="absolute top-0 left-0 h-full bg-linear-to-r from-purple-500 to-pink-500 rounded-full pointer-events-none" style="width:0%">
            <div class="absolute right-0 top-1/2 -translate-y-1/2 w-2.5 h-2.5 bg-white rounded-full opacity-0 group-hover:opacity-100 shadow-md transition-opacity"></div>
          </div>
        </div>
      </div>
      <span id="pb-duration" class="text-[11px] font-medium text-gray-400 w-10 tabular-nums">0:00</span>
    </div>
  </div>


  <div class="w-full sm:w-1/4 min-w-0 sm:min-w-[180px] hidden md:flex items-center justify-end gap-4">
    <div class="flex items-center justify-end gap-3 w-full max-w-[18rem]">
      <button id="pb-volbtn" type="button" class="text-gray-400 hover:text-white transition-colors shrink-0" aria-label="Volume">
        <span class="material-symbols-outlined text-xl">volume_up</span>
      </button>
      <div id="pb-volhit" class="relative flex-1 py-1.5 cursor-pointer group">
        <div id="pb-voltrack" class="relative h-1.5 bg-white/10 rounded-full overflow-visible transition-[height,background-color] duration-200 group-hover:h-2">
          <div id="pb-volbar" class="h-full bg-white hover:bg-purple-400 transition-colors rounded-full pointer-events-none" style="width:100%"></div>
          <div id="pb-volknob" class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-white shadow-md border border-white/20 pointer-events-none" style="left:100%"></div>
          <div id="pb-voltooltip" class="absolute bottom-[calc(100%+0.4rem)] left-0 -translate-x-1/2 hidden bg-gray-800 text-white text-xs rounded px-2 py-0.5 pointer-events-none whitespace-nowrap">100%</div>
        </div>
      </div>
      <div id="pb-speed-wrap" class="relative shrink-0">
        <button id="pb-speed-btn" type="button" class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-gray-300 hover:text-white hover:bg-white/10 transition-colors text-xs font-semibold tracking-wide flex items-center gap-1.5" aria-haspopup="dialog" aria-expanded="false" aria-label="Playback speed">
          <span class="material-symbols-outlined text-sm">speed</span>
          <span data-speed-label>1x</span>
        </button>
        <div id="pb-speed-popover" class="absolute right-0 bottom-[calc(100%+0.5rem)] w-72 rounded-2xl border border-white/10 bg-[#10182f]/95 shadow-[0_16px_40px_rgba(0,0,0,0.45)] p-4 hidden">
          <div class="flex items-center justify-between gap-3 mb-3">
            <span class="text-sm font-semibold text-white">Playback speed</span>
            <button type="button" id="pb-speed-reset" class="text-xs font-medium text-gray-300 hover:text-white transition-colors">Reset to 1x</button>
          </div>
          <div class="space-y-3">
            <input id="pb-speed-range" type="range" min="0.25" max="3.0" step="0.05" value="1" class="w-full accent-purple-500" />
            <div class="flex items-center gap-3">
              <input id="pb-speed-input" type="number" min="0.25" max="3.0" step="0.05" value="1" class="w-24 bg-white/5 border border-white/10 text-white rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/40" />
              <span class="text-xs text-gray-400">x playback</span>
            </div>
            <p id="pb-speed-empty" class="text-xs text-gray-400 hidden">No track playing</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="add-to-playlist-modal" class="hidden fixed inset-0 z-[70] items-center justify-center bg-black/70 backdrop-blur-sm px-4 py-6">
  <div class="w-full max-w-2xl overflow-hidden rounded-[2rem] border border-white/10 bg-[#0d1630]/95 shadow-[0_30px_120px_rgba(0,0,0,0.6)]">
    <div class="flex items-start justify-between gap-4 border-b border-white/10 px-5 sm:px-6 py-5">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.28em] text-purple-400">Add to playlist</p>
        <h3 class="mt-2 text-xl sm:text-2xl font-black text-white">Choose where to save this song</h3>
        <p id="apt-song-title" class="mt-1 text-sm text-gray-400 truncate">—</p>
      </div>
      <button id="apt-close" type="button" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/5 text-gray-300 transition hover:bg-white/10 hover:text-white" aria-label="Close modal">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="px-5 sm:px-6 py-4 border-b border-white/10">
      <div class="relative">
        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-[20px]">search</span>
        <input id="apt-search" type="text" placeholder="Search playlists..." class="w-full rounded-2xl border border-white/10 bg-white/5 py-3 pl-12 pr-4 text-sm text-white placeholder-gray-500 outline-none transition focus:border-purple-500/40 focus:ring-2 focus:ring-purple-500/20" />
      </div>
    </div>
    <div class="max-h-[60vh] overflow-y-auto custom-scrollbar px-3 sm:px-4 py-4">
      <div id="apt-state" class="hidden rounded-2xl border border-dashed border-white/10 bg-white/5 px-4 py-10 text-center text-sm text-gray-400"></div>
      <div id="apt-list" class="grid gap-3 sm:grid-cols-2"></div>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-t border-white/10 px-5 sm:px-6 py-4">
      <p id="apt-hint" class="text-xs text-gray-500">Select a playlist to add the current track.</p>
      <button id="apt-cancel" type="button" class="rounded-full border border-white/10 bg-white/5 px-5 py-2.5 text-sm font-semibold text-gray-300 transition hover:bg-white/10 hover:text-white">Cancel</button>
    </div>
  </div>
</div>

<script>
  // @ts-nocheck
  import { player } from '../lib/player.js';
  import { apiFetch, API_BASE } from '../lib/api.js';

  const w = window as any;
  if (!w.__playerBarInitialized) w.__playerBarInitialized = true;

  const pbTitle    = document.getElementById('pb-title') as HTMLElement;
  const pbArtist   = document.getElementById('pb-artist') as HTMLElement;
  const pbCover    = document.getElementById('pb-cover') as HTMLElement;
  const pbPlay     = document.getElementById('pb-play') as HTMLButtonElement;
  const pbPrev     = document.getElementById('pb-prev') as HTMLButtonElement;
  const pbNext     = document.getElementById('pb-next') as HTMLButtonElement;
  const pbShuffle  = document.getElementById('pb-shuffle') as HTMLButtonElement;
  const pbRepeat   = document.getElementById('pb-repeat') as HTMLButtonElement;
  const pbRepeatDot = document.getElementById('pb-repeat-dot') as HTMLElement;
  const pbSeekHit  = document.getElementById('pb-seek-hit') as HTMLElement;
  const pbSeek     = document.getElementById('pb-seek') as HTMLElement;
  const pbProgress = document.getElementById('pb-progress') as HTMLElement;
  const pbCurtime  = document.getElementById('pb-curtime') as HTMLElement;
  const pbDuration = document.getElementById('pb-duration') as HTMLElement;
  const pbVolHit   = document.getElementById('pb-volhit') as HTMLElement;
  const pbVolTrack = document.getElementById('pb-voltrack') as HTMLElement;
  const pbVolBar   = document.getElementById('pb-volbar') as HTMLElement;
  const pbVolKnob  = document.getElementById('pb-volknob') as HTMLElement;
  const pbVolTooltip = document.getElementById('pb-voltooltip') as HTMLElement;
  const pbVolbtn   = document.getElementById('pb-volbtn') as HTMLButtonElement;
  const pbSpeedWrap = document.getElementById('pb-speed-wrap') as HTMLElement;
  const pbSpeedBtn = document.getElementById('pb-speed-btn') as HTMLButtonElement;
  const pbSpeedPopover = document.getElementById('pb-speed-popover') as HTMLElement;
  const pbSpeedRange = document.getElementById('pb-speed-range') as HTMLInputElement;
  const pbSpeedInput = document.getElementById('pb-speed-input') as HTMLInputElement;
  const pbSpeedReset = document.getElementById('pb-speed-reset') as HTMLButtonElement;
  const pbSpeedEmpty = document.getElementById('pb-speed-empty') as HTMLElement;
  const pbFav      = document.getElementById('pb-fav') as HTMLButtonElement;
  const pbAdd      = document.getElementById('pb-add') as HTMLButtonElement;
  const pbShare    = document.getElementById('pb-share') as HTMLButtonElement;
  const pbQueueChip = document.getElementById('pb-queue-chip') as HTMLElement;
  const aptModal = document.getElementById('add-to-playlist-modal') as HTMLElement;
  const aptClose = document.getElementById('apt-close') as HTMLButtonElement;
  const aptCancel = document.getElementById('apt-cancel') as HTMLButtonElement;
  const aptSearch = document.getElementById('apt-search') as HTMLInputElement;
  const aptList = document.getElementById('apt-list') as HTMLElement;
  const aptState = document.getElementById('apt-state') as HTMLElement;
  const aptSongTitle = document.getElementById('apt-song-title') as HTMLElement;

  const GRADS = [
    'linear-gradient(135deg,#6366f1,#8b5cf6)',
    'linear-gradient(135deg,#f43f5e,#f97316)',
    'linear-gradient(135deg,#ec4899,#7c3aed)',
    'linear-gradient(135deg,#ef4444,#d946ef)',
    'linear-gradient(135deg,#3b82f6,#06b6d4)',
    'linear-gradient(135deg,#06b6d4,#10b981)',
    'linear-gradient(135deg,#d946ef,#7c3aed)',
    'linear-gradient(135deg,#fb923c,#fb7185)',
  ];

  function fmt(sec: number) {
    const s = Math.floor(sec) || 0;
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  }

  function grad(id: number) {
    return GRADS[(Number(id) - 1) % GRADS.length];
  }

  function updatePlayIcon(playing: boolean) {
    const icon = pbPlay?.querySelector('.material-symbols-outlined');
    if (icon) icon.textContent = playing ? 'pause' : 'play_arrow';
  }

  function volumeIconFor(v: number) {
    if (v <= 0) return 'volume_off';
    if (v < 0.5) return 'volume_down';
    return 'volume_up';
  }

  function syncVolumeUI(v: number) {
    const value = Math.max(0, Math.min(1, v));
    if (pbVolBar) pbVolBar.style.width = `${value * 100}%`;
    if (pbVolKnob) pbVolKnob.style.left = `${value * 100}%`;
    if (pbVolTooltip) {
      pbVolTooltip.textContent = `${Math.round(value * 100)}%`;
      pbVolTooltip.style.left = `${value * 100}%`;
    }
    const icon = pbVolbtn?.querySelector('.material-symbols-outlined');
    if (icon) icon.textContent = volumeIconFor(value);
  }

  function clampSpeed(rate: number) {
    return Math.max(0.25, Math.min(3, Number(rate) || 1));
  }

  function fmtSpeed(rate: number) {
    const value = clampSpeed(rate);
    return `${value.toFixed(value % 1 === 0 ? 0 : 2)}x`;
  }

  function syncSpeedUI(rate: number) {
    const value = clampSpeed(rate);
    if (pbSpeedBtn) {
      const label = pbSpeedBtn.querySelector('[data-speed-label]') as HTMLElement | null;
      if (label) label.textContent = fmtSpeed(value);
    }
    if (pbSpeedRange) pbSpeedRange.value = String(value);
    if (pbSpeedInput) pbSpeedInput.value = String(value);
  }

  function syncSpeedAvailability() {
    const hasTrack = !!player.current;
    if (pbSpeedRange) pbSpeedRange.disabled = !hasTrack;
    if (pbSpeedInput) pbSpeedInput.disabled = !hasTrack;
    if (pbSpeedReset) pbSpeedReset.disabled = !hasTrack;
    if (pbSpeedEmpty) pbSpeedEmpty.classList.toggle('hidden', hasTrack);
  }

  function syncPlayerBarVisibility() {
    const bar = document.getElementById('playerBar') as HTMLElement | null;
    if (!bar) return;
    if (player.current || player.isPlaying) bar.style.display = '';
  }

  function syncSongUI(song = player.current) {
    if (!song) return;
    const queueLen = player.queue?.length || 0;
    if (pbQueueChip) {
      pbQueueChip.textContent = queueLen ? `${player.queueIndex + 1}/${queueLen}` : '';
      pbQueueChip.classList.toggle('hidden', !queueLen);
    }
    _likedSongId = song?.id ?? null;
    const bar = document.getElementById('playerBar') as HTMLElement | null;
    if (bar && bar.style.display === 'none') bar.style.display = '';
    syncPlayerBarVisibility();
    if (pbTitle)  pbTitle.textContent  = song.title || '—';
    if (pbArtist) pbArtist.textContent = song.artist_names || '—';
    if (pbCover) {
      const bg = grad(song.id);
      if (song.cover_url) {
        pbCover.innerHTML = `<img src="${song.cover_url}" class="w-full h-full object-cover" alt="" />`;
        pbCover.style.background = '';
      } else {
        pbCover.innerHTML = `<span class="material-symbols-outlined absolute inset-0 flex items-center justify-center text-white/30 text-3xl">music_note</span>`;
        pbCover.style.background = bg;
      }
    }
    if (pbDuration && song.duration) pbDuration.textContent = fmt(song.duration);
    _lastSec = -1;
    if (pbProgress) pbProgress.style.width = '0%';
    if (pbCurtime)  pbCurtime.textContent  = '0:00';
    updatePlayIcon(player.isPlaying);
    startRaf();
    syncSpeedAvailability();
    setFavUI(false);
    checkFavoriteStatus(song.id);
  }

  let _isDragging = false;
  let _isVolumeDragging = false;
  const _volumeState = { hover: false };
  let _rafId = 0;
  let _lastSec = -1;
  let _likedSongId: number | null = null;
  let _likedState = false;
  let _likeErrorTimer: ReturnType<typeof setTimeout> | null = null;
  let _sessionSongId: number | null = null;
  let _sessionStart: number | null = null;
  let _aptSong: any = null;
  let _aptPlaylists: any[] = [];

  function showPlayerBarToast(message: string, type: 'success' | 'error' | 'info' = 'info') {
    window.dispatchEvent(new CustomEvent('toast', { detail: { message, type } }));
  }

  async function submitSessionIfValid() {
    if (!_sessionSongId || !_sessionStart) return;
    const token = localStorage.getItem('auth_token');
    if (!token) { _sessionSongId = null; _sessionStart = null; return; }
    const durationSec = Math.round((Date.now() - _sessionStart) / 1000);
    const songId = _sessionSongId;
    _sessionSongId = null;
    _sessionStart = null;
    try {
      await apiFetch('/history/play-session', {
        method: 'POST',
        body: JSON.stringify({ song_id: songId, duration_played: durationSec }),
      });
    } catch {}
  }

  window.addEventListener('beforeunload', () => {

    player.saveState();

    if (!_sessionSongId || !_sessionStart) return;
    const token = localStorage.getItem('auth_token');
    if (!token) return;
    const durationSec = Math.round((Date.now() - _sessionStart) / 1000);
    if (durationSec < 1) return;
    const songId = _sessionSongId;
    fetch(`${API_BASE}/history/play-session`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ song_id: songId, duration_played: durationSec }),
      keepalive: true,
    }).catch(() => {});
  });


  player.preloadLibrary?.();
  player.restoreState();
  player.syncPlaybackRateFromStorage?.();
  syncPlayerBarVisibility();
  syncVolumeUI(player.volume ?? 1);
  syncSpeedUI(player.playbackRate ?? 1);
  syncSpeedAvailability();
  setVolumeInteractionState(false);


  window.addEventListener('player:songchange', (e: any) => {
    const song = e.detail.song;
    if (!song) return;
    syncSongUI(song);

    submitSessionIfValid();
    _sessionSongId = song.id;
    _sessionStart = Date.now();
  });

  function startRaf() {
    cancelAnimationFrame(_rafId);
    (function tick() {
      if (!_isDragging) {
        const audioDur = player.duration;
        const dur = (isFinite(audioDur) && audioDur > 0)
          ? audioDur
          : (player.current?.duration ?? 0);
        const cur = player.currentTime;
        if (dur > 0) {
          const sec = Math.floor(cur);
          if (sec !== _lastSec) {
            _lastSec = sec;
            if (pbProgress) pbProgress.style.width = `${(cur / dur) * 100}%`;
            if (pbCurtime)  pbCurtime.textContent  = fmt(sec);
          }
        }
      }
      _rafId = requestAnimationFrame(tick);
    })();
  }

  window.addEventListener('player:play', () => {
    syncPlayerBarVisibility();
    if (player.current && !_sessionStart) {
      _sessionSongId = Number(player.current.id);
      _sessionStart = Date.now();
    }
    updatePlayIcon(true);
    startRaf();
  });
  window.addEventListener('player:pause', () => {
    submitSessionIfValid();
    updatePlayIcon(false);
    syncSpeedAvailability();
  });

  pbPlay?.addEventListener('click', () => player.toggle());
  pbPrev?.addEventListener('click', () => player.prev());
  pbNext?.addEventListener('click', () => player.next());

  pbShuffle?.addEventListener('click', () => {
    const on = player.toggleShuffle();
    pbShuffle.classList.toggle('text-purple-400', on);
    pbShuffle.classList.toggle('text-gray-500', !on);
  });

  pbRepeat?.addEventListener('click', () => {
    const mode = player.cycleRepeat();
    const icon = pbRepeat.querySelector('.material-symbols-outlined');
    const active = mode !== 'none';
    pbRepeat.classList.toggle('text-purple-400', active);
    pbRepeat.classList.toggle('text-gray-500', !active);
    if (pbRepeatDot) pbRepeatDot.style.opacity = active ? '1' : '0';
    if (icon) icon.textContent = mode === 'one' ? 'repeat_one' : 'repeat';
  });

  function applySeekVisual(clientX: number) {
    const rect = pbSeek!.getBoundingClientRect();
    const frac = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
    if (pbProgress) pbProgress.style.width = `${frac * 100}%`;
    const audioDur = player.duration;
    const dur = (isFinite(audioDur) && audioDur > 0) ? audioDur : (player.current?.duration ?? 0);
    if (dur > 0 && pbCurtime) pbCurtime.textContent = fmt(frac * dur);
    return frac;
  }

  pbSeekHit?.addEventListener('mousedown', (e) => {
    _isDragging = true;
    applySeekVisual(e.clientX);
    const onMove = (mv: MouseEvent) => applySeekVisual(mv.clientX);
    const onUp   = (mv: MouseEvent) => {
      _isDragging = false;
      _lastSec = -1;
      player.seek(applySeekVisual(mv.clientX));
      window.removeEventListener('mousemove', onMove);
      window.removeEventListener('mouseup',   onUp);
    };
    window.addEventListener('mousemove', onMove);
    window.addEventListener('mouseup',   onUp);
  });

  pbSeekHit?.addEventListener('touchstart', (e) => {
    _isDragging = true;
    applySeekVisual(e.touches[0].clientX);
    const onMove = (mv: TouchEvent) => applySeekVisual(mv.touches[0].clientX);
    const onEnd  = (mv: TouchEvent) => {
      _isDragging = false;
      _lastSec = -1;
      player.seek(applySeekVisual(mv.changedTouches[0].clientX));
      window.removeEventListener('touchmove', onMove);
      window.removeEventListener('touchend',  onEnd);
    };
    window.addEventListener('touchmove', onMove, { passive: true });
    window.addEventListener('touchend',  onEnd);
  }, { passive: true });

  function volumeFromClientX(clientX: number) {
    if (!pbVolTrack) return 1;
    const rect = pbVolTrack.getBoundingClientRect();
    const raw = (clientX - rect.left) / rect.width;
    return Math.max(0, Math.min(1, raw));
  }

  function setVolumeInteractionState(active: boolean) {
    if (!pbVolTooltip) return;
    pbVolTooltip.classList.toggle('hidden', !active && !_volumeState.hover);
  }

  function applyVolumeFromClientX(clientX: number) {
    if (!pbVolTrack) return;
    const raw = volumeFromClientX(clientX);
    player.setVolume(raw);
    syncVolumeUI(raw);
    setVolumeInteractionState(true);
  }

  pbVolHit?.addEventListener('mouseenter', () => {
    _volumeState.hover = true;
    setVolumeInteractionState(true);
    syncVolumeUI(player.volume ?? 1);
  });

  pbVolHit?.addEventListener('mouseleave', () => {
    _volumeState.hover = false;
    if (!_isVolumeDragging) setVolumeInteractionState(false);
  });

  pbVolHit?.addEventListener('mousemove', (e) => {
    if (!_isVolumeDragging) return;
  });

  pbVolHit?.addEventListener('mousedown', (e) => {
    _isVolumeDragging = true;
    applyVolumeFromClientX(e.clientX);
    const onMove = (mv: MouseEvent) => applyVolumeFromClientX(mv.clientX);
    const endDrag = () => {
      _isVolumeDragging = false;
      if (!_volumeState.hover) setVolumeInteractionState(false);
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup', endDrag);
      document.removeEventListener('mouseleave', endDrag);
    };
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', endDrag);
    document.addEventListener('mouseleave', endDrag);
  });

  pbVolHit?.addEventListener('touchstart', (e) => {
    _isVolumeDragging = true;
    applyVolumeFromClientX(e.touches[0].clientX);
    const onMove = (mv: TouchEvent) => applyVolumeFromClientX(mv.touches[0].clientX);
    const onEnd = () => {
      _isVolumeDragging = false;
      if (!_volumeState.hover) setVolumeInteractionState(false);
      window.removeEventListener('touchmove', onMove);
      window.removeEventListener('touchend', onEnd);
    };
    window.addEventListener('touchmove', onMove, { passive: true });
    window.addEventListener('touchend', onEnd);
  }, { passive: true });

  pbVolbtn?.addEventListener('click', () => {
    const current = player.volume ?? 1;
    const next = current <= 0 ? 0.5 : current < 1 ? 1 : 0;
    player.setVolume(next);
    syncVolumeUI(next);
  });

  function closeSpeedMenu() {
    if (!pbSpeedPopover || !pbSpeedBtn) return;
    pbSpeedPopover.classList.add('hidden');
    pbSpeedBtn.setAttribute('aria-expanded', 'false');
  }

  function openSpeedMenu() {
    if (!pbSpeedPopover || !pbSpeedBtn) return;
    pbSpeedPopover.classList.remove('hidden');
    pbSpeedBtn.setAttribute('aria-expanded', 'true');
  }

  function toggleSpeedMenu() {
    if (!pbSpeedPopover || !pbSpeedBtn) return;
    pbSpeedPopover.classList.contains('hidden') ? openSpeedMenu() : closeSpeedMenu();
  }

  function setPlaybackSpeed(rate: number) {
    const next = clampSpeed(rate);
    player.setPlaybackRate(next);
    try { localStorage.setItem('player_speed', String(next)); } catch {}
    syncSpeedUI(next);
  }

  pbSpeedBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleSpeedMenu();
  });

  pbSpeedRange?.addEventListener('input', () => setPlaybackSpeed(Number(pbSpeedRange.value)));
  pbSpeedInput?.addEventListener('input', () => setPlaybackSpeed(Number(pbSpeedInput.value)));
  pbSpeedReset?.addEventListener('click', () => setPlaybackSpeed(1));

  document.addEventListener('astro:page-load', () => {
    const savedSpeed = parseFloat(localStorage.getItem('player_speed') ?? '1');
    if (Number.isFinite(savedSpeed)) {
      player.syncPlaybackRateFromStorage?.();
      syncSpeedUI(savedSpeed);
    }
    syncSpeedAvailability();
  });

  document.addEventListener('click', (e) => {
    if (!pbSpeedWrap?.contains(e.target as Node)) closeSpeedMenu();
  });

  window.addEventListener('favorites:changed', (e: any) => {
    const { songId, isFavorite } = e.detail || {};
    if (_likedSongId != null && Number(songId) === Number(_likedSongId)) setFavUI(!!isFavorite);
  });

  window.addEventListener('player:songchange', () => syncSongUI(player.current));

  aptClose?.addEventListener('click', closeAddToPlaylistModal);
  aptCancel?.addEventListener('click', closeAddToPlaylistModal);
  aptModal?.addEventListener('click', (e) => {
    if (e.target === aptModal) closeAddToPlaylistModal();
  });
  aptSearch?.addEventListener('input', () => renderPlaylistOptions(aptSearch.value));
  aptList?.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest('.playlist-option') as HTMLElement | null;
    const playlistId = card?.dataset.playlistId;
    if (playlistId) addSongToPlaylist(Number(playlistId));
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeSpeedMenu();
      closeAddToPlaylistModal();
    }
  });

  function setFavUI(isFav: boolean) {
    _likedState = isFav;
    if (pbFav) pbFav.dataset.liked = String(isFav);
    const icon = pbFav?.querySelector('.material-symbols-outlined') as HTMLElement | null;
    if (icon) {
      icon.textContent = isFav ? 'favorite' : 'favorite_border';
      icon.style.fontVariationSettings = isFav ? "'FILL' 1" : "'FILL' 0";
    }
    pbFav?.classList.toggle('text-pink-500', isFav);
    pbFav?.classList.toggle('text-gray-400', !isFav);
  }

  function favoritePayload(song: any) {
    return JSON.stringify({ songId: song.id });
  }

  function getShareUrl(song: any) {
    return `${window.location.origin}/song?id=${encodeURIComponent(song.id)}`;
  }

  async function shareCurrentSong() {
    const song = player.current;
    if (!song) return;
    const shareData = {
      title: song.title || 'Shadows of Melody',
      text: `${song.title || 'Listen to this track'} on Shadows of Melody`,
      url: getShareUrl(song),
    };
    try {
      if (navigator.share) {
        await navigator.share(shareData);
        return;
      }
    } catch {}
    try {
      await navigator.clipboard.writeText(shareData.url);
      showPlayerBarToast('Link copied to clipboard', 'success');
    } catch {}
  }

  function closeAddToPlaylistModal() {
    aptModal?.classList.add('hidden');
    aptModal?.classList.remove('flex');
    _aptSong = null;
    if (aptSearch) aptSearch.value = '';
  }

  function setAddToPlaylistState(message: string, visible = true) {
    if (!aptState) return;
    aptState.textContent = message;
    aptState.classList.toggle('hidden', !visible);
  }

  function renderPlaylistOptions(filter = '') {
    if (!aptList) return;
    const query = filter.trim().toLowerCase();
    const playlists = _aptPlaylists.filter((pl) => !query || String(pl.name || '').toLowerCase().includes(query));
    if (!playlists.length) {
      aptList.innerHTML = '';
      setAddToPlaylistState(query ? 'No playlists match your search.' : 'You do not have any playlists yet.');
      return;
    }
    setAddToPlaylistState('', false);
    aptList.innerHTML = playlists.map((pl: any) => {
      const count = pl.songs_count ?? pl.song_count ?? pl.songs?.length ?? 0;
      const cover = pl.cover_url
        ? `<img src="${pl.cover_url}" class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-105" alt="${pl.name || 'Playlist'}" />`
        : `<div class="absolute inset-0 bg-linear-to-br from-purple-600 via-indigo-600 to-sky-500"></div>`;
      return `
        <button type="button" class="group playlist-option flex w-full items-center gap-4 rounded-2xl border border-white/10 bg-white/5 p-3 text-left transition hover:border-purple-500/30 hover:bg-white/[0.08]" data-playlist-id="${pl.id}">
          <div class="relative h-16 w-16 shrink-0 overflow-hidden rounded-xl border border-white/10 bg-white/5 shadow-lg shadow-black/20">
            ${cover}
            <div class="absolute inset-0 bg-black/20"></div>
            <div class="absolute inset-0 flex items-center justify-center text-white/90 opacity-0 transition group-hover:opacity-100">
              <span class="material-symbols-outlined text-[22px]">queue_music</span>
            </div>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="truncate font-semibold text-white group-hover:text-purple-300">${pl.name || 'Untitled playlist'}</p>
                <p class="mt-1 text-xs text-gray-400 truncate">${pl.description || 'No description'}</p>
              </div>
              <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-[11px] font-semibold text-gray-300 whitespace-nowrap">${count} songs</span>
            </div>
            <div class="mt-3 flex items-center gap-2 text-xs text-gray-500">
              <span class="material-symbols-outlined text-[14px]">${pl.is_public === false ? 'lock' : 'public'}</span>
              <span>${pl.is_public === false ? 'Private' : 'Public'}</span>
            </div>
          </div>
        </button>`;
    }).join('');
  }

  async function openAddToPlaylistModal(song: any) {
    const token = localStorage.getItem('auth_token');
    if (!token) {
      window.location.href = '/login';
      return;
    }
    _aptSong = song;
    if (aptSongTitle) aptSongTitle.textContent = song?.title || '—';
    if (aptModal) {
      aptModal.classList.remove('hidden');
      aptModal.classList.add('flex');
    }
    setAddToPlaylistState('Loading playlists...');
    if (aptList) aptList.innerHTML = '';
    try {
      const { data: playlists } = await apiFetch('/playlists/me');
      _aptPlaylists = Array.isArray(playlists) ? playlists : [];
      if (!_aptPlaylists.length) {
        setAddToPlaylistState('You do not have any playlists yet. Create one first.');
        return;
      }
      renderPlaylistOptions(aptSearch?.value || '');
    } catch {
      setAddToPlaylistState('Failed to load playlists.');
    }
  }

  (window as any).openAddToPlaylist = openAddToPlaylistModal;

  async function addSongToPlaylist(playlistId: number) {
    if (!_aptSong?.id) return;
    try {
      await apiFetch(`/playlists/${playlistId}/songs`, {
        method: 'POST',
        body: JSON.stringify({ songId: _aptSong.id }),
      });
      const playlist = _aptPlaylists.find((pl) => Number(pl.id) === Number(playlistId));
      showPlayerBarToast(`Song added to "${playlist?.name || 'playlist'}" successfully.`, 'success');
      closeAddToPlaylistModal();
    } catch (err: any) {
      showPlayerBarToast(err?.message || 'Failed to add song to playlist.', 'error');
    }
  }

  async function checkFavoriteStatus(songId: number) {
    _likedSongId = songId;
    const token = localStorage.getItem('auth_token');
    if (!token) { setFavUI(false); return; }
    try {
      const res = await apiFetch(`/favorites/${songId}/is-favorite`);
      if (_likedSongId === songId) setFavUI(!!res.data?.isFavorite);
    } catch {
      if (_likedSongId === songId) setFavUI(false);
    }
  }

  async function refreshLikedPages(songId: number, isFavorite: boolean) {
    if (window.location.pathname !== '/liked') {
      window.dispatchEvent(new CustomEvent('favorites:changed', {
        detail: { songId, isFavorite },
      }));
      return;
    }
    window.dispatchEvent(new CustomEvent('favorites:changed', {
      detail: { songId, isFavorite },
    }));
    window.dispatchEvent(new CustomEvent('liked:refresh', {
      detail: { songId, isFavorite },
    }));
  }

  pbFav?.addEventListener('click', async () => {
    const song = player.current;
    if (!song) return;
    const token = localStorage.getItem('auth_token');
    if (!token) { window.location.href = '/login'; return; }
    const isFav = _likedState;
    if (_likeErrorTimer) clearTimeout(_likeErrorTimer);
    const nextFav = !isFav;
    setFavUI(nextFav);
    try {
      if (isFav) {
        await apiFetch(`/favorites/${song.id}`, { method: 'DELETE' });
      } else {
        await apiFetch('/favorites', { method: 'POST', body: favoritePayload(song) });
      }
      await refreshLikedPages(song.id, nextFav);
    } catch (error) {
      console.error('Favorite toggle failed:', error);
      setFavUI(isFav);
      if (pbFav) pbFav.dataset.error = 'true';
      _likeErrorTimer = setTimeout(() => {
        if (pbFav?.dataset.error === 'true') delete pbFav.dataset.error;
      }, 1500);
    }
  });

  const openAddToPlaylistFromEvent = (detail: any) => {
    const song = detail?.song || player.current;
    if (!song) return;
    openAddToPlaylistModal(song);
  };

  pbAdd?.addEventListener('click', () => {
    openAddToPlaylistFromEvent({ song: player.current });
  });

  window.addEventListener('player:add-to-playlist', (e: Event) => {
    const detail = (e as CustomEvent).detail;
    openAddToPlaylistFromEvent(detail);
  });

  pbShare?.addEventListener('click', shareCurrentSong);
</script>
