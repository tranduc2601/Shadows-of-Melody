---
const { currentPage = 'home' } = Astro.props;
const isAuthed = Astro.url.searchParams.get('auth') === '1';

const navItems = [
  { href: '/',        icon: 'home',        label: 'Home',      page: 'home'    },
  { href: '/songs',   icon: 'music_note',   label: 'Songs',     page: 'songs'   },
  { href: '/artists', icon: 'person',      label: 'Artists',   page: 'artists' },
  { href: '/subscription', icon: 'workspace_premium', label: 'Subscription', page: 'subscription', iconClass: 'text-amber-400' },
];
const libItems = [
  { href: '/liked',    icon: 'favorite',    label: 'Liked Songs', page: 'liked',    iconClass: 'text-rose-400' },
  { href: '/playlist', icon: 'queue_music', label: 'Playlists',   page: 'playlist', iconClass: '' },
];
---


<script is:inline>
  (function () {
    if (localStorage.getItem('sidebar_collapsed') === 'true') {
      var el = document.getElementById('main-sidebar');
      if (el) {
        el.classList.add('sidebar-collapsed', 'no-sidebar-transition');
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            el.classList.remove('no-sidebar-transition');
          });
        });
      }
    }
  })();
</script>

<aside id="main-sidebar"
  class="sidebar-root w-64 shrink-0 border-r border-white/5 bg-[#0a1229]/80 backdrop-blur-xl hidden md:flex md:flex-col z-40
         transition-[width] duration-300 ease-in-out overflow-hidden max-h-screen sticky top-0"
  data-authed={isAuthed ? 'true' : 'false'}>


  <div class="h-20 flex items-center justify-between px-4 shrink-0">
    <a href="/" class="flex items-center gap-2 min-w-0 overflow-hidden">
      <span class="material-symbols-outlined text-purple-400 animate-pulse shrink-0">music_note</span>
      <span class="sidebar-label text-2xl font-black bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-purple-400
                   transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Melody</span>
    </a>
    <button id="sidebar-toggle"
      title="Toggle sidebar"
      class="shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-400
             hover:text-white hover:bg-white/10 transition-all duration-200">
      <span id="sidebar-toggle-icon" class="material-symbols-outlined text-[20px] transition-transform duration-300">chevron_left</span>
    </button>
  </div>

  <div class="px-3 py-4 flex-1 overflow-y-auto overflow-x-hidden">
    <p class="sidebar-label px-3 text-xs font-bold text-gray-500 uppercase tracking-wider mb-3
              transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Menu</p>
    <nav class="space-y-1 mb-6">
      {navItems.map(item => (
        <a href={item.href}
           title={item.label}
           class={`sidebar-nav-item flex items-center gap-4 px-3 py-3 rounded-xl font-medium transition-all duration-200 group ${
             currentPage === item.page
               ? 'nav-active bg-gradient-to-r from-purple-500/20 to-transparent text-white shadow-[inset_2px_0_0_0_rgba(168,85,247,1)]'
               : 'text-gray-400 hover:text-white hover:bg-white/5'
           }`}>
          <span class={`nav-icon material-symbols-outlined shrink-0 transition-all duration-200 ${
            currentPage === item.page ? 'text-purple-400' : 'group-hover:scale-110'
          }`}>{item.icon}</span>
          <span class="sidebar-label transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">
            {item.label}
          </span>
        </a>
      ))}
    </nav>

    <p class="sidebar-label px-3 text-xs font-bold text-gray-500 uppercase tracking-wider mb-3
              transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Library</p>
    <nav class="space-y-1 mb-3">
      {libItems.map(item => (
        <a href={item.href}
           title={item.label}
           class={`sidebar-nav-item flex items-center gap-4 px-3 py-3 rounded-xl font-medium transition-all duration-200 group ${
             currentPage === item.page
               ? 'nav-active bg-gradient-to-r from-purple-500/20 to-transparent text-white shadow-[inset_2px_0_0_0_rgba(168,85,247,1)]'
               : 'text-gray-400 hover:text-white hover:bg-white/5'
           }`}>
          <span class={`nav-icon material-symbols-outlined shrink-0 transition-all duration-200 group-hover:scale-110 ${item.iconClass} ${
            currentPage === item.page ? 'text-purple-400' : ''
          }`}>{item.icon}</span>
          <span class="sidebar-label transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">
            {item.label}
          </span>
        </a>
      ))}
    </nav>


    <a id="sidebar-admin-link" href="/admin" title="Admin Panel"
       class="hidden mt-2 sidebar-nav-item items-center gap-3 px-3 py-2 text-purple-400 hover:text-white hover:bg-purple-500/10 w-full rounded-lg transition-all duration-200 text-sm font-semibold">
      <span class="w-8 h-8 rounded-md bg-purple-500/20 flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-purple-400 text-base">admin_panel_settings</span>
      </span>
      <span class="sidebar-label transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Admin Panel</span>
    </a>


    <a id="sidebar-studio-link" href="/studio" title="Artist Studio"
       class="hidden mt-2 sidebar-nav-item items-center gap-3 px-3 py-2 text-green-400 hover:text-white hover:bg-green-500/10 w-full rounded-lg transition-all duration-200 text-sm font-semibold">
      <span class="w-8 h-8 rounded-md bg-green-500/20 flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-green-400 text-base">equalizer</span>
      </span>
      <span class="sidebar-label transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Artist Studio</span>
    </a>


    <a id="sidebar-upload-link" href="/upload" title="Upload Song"
       class="hidden mt-2 sidebar-nav-item items-center gap-3 px-3 py-2 text-indigo-400 hover:text-white hover:bg-indigo-500/10 w-full rounded-lg transition-all duration-200 text-sm font-semibold">
      <span class="w-8 h-8 rounded-md bg-indigo-500/20 flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-indigo-400 text-base">upload_file</span>
      </span>
      <span class="sidebar-label transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Upload Song</span>
    </a>


    <button id="btn-new-playlist" title="Create new playlist"
       class="hidden mt-2 sidebar-nav-item items-center gap-3 px-3 py-2 text-gray-500 hover:text-white w-full rounded-lg hover:bg-white/5 transition-all duration-200 text-sm">
      <span class="w-8 h-8 rounded-md border border-dashed border-white/20 flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-base">add</span>
      </span>
      <span class="sidebar-label transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Create new playlist</span>
    </button>
  </div>


  <div class="p-3 border-t border-white/5 shrink-0">

    <div id="sidebar-guest">
      <a href="/login" title="Đăng Nhập"
         class="sidebar-nav-item flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-purple-600 to-indigo-600 rounded-xl text-white font-semibold text-sm hover:opacity-90 transition-opacity">
        <span class="material-symbols-outlined text-base shrink-0">login</span>
        <span class="sidebar-label transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Login</span>
      </a>
    </div>


  </div>
</aside>

<style>
  [data-authed='true'] #main-sidebar,
  [data-authed='true'] #header-user {
    display: flex;
  }
  [data-authed='false'] #main-sidebar {
    display: none;
  }

  .sidebar-root.no-sidebar-transition {
    transition: none !important;
  }


  .sidebar-root.sidebar-collapsed {
    width: 4.5rem;
  }
  .sidebar-root.sidebar-collapsed .sidebar-label {
    max-width: 0;
    opacity: 0;
    margin: 0;
    padding: 0;
  }
  .sidebar-root.sidebar-collapsed .sidebar-nav-item {
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
    gap: 0;
  }

  .sidebar-root.sidebar-collapsed > div:first-child {
    justify-content: center;
    gap: 0;
  }

  .sidebar-root.sidebar-collapsed > div:first-child > a {
    display: none;
  }
  .sidebar-root:not(.sidebar-collapsed) .sidebar-label {
    max-width: 200px;
    opacity: 1;
  }


  .sidebar-root.sidebar-collapsed .nav-active {
    background: transparent !important;
    box-shadow: none !important;
  }
  .sidebar-root.sidebar-collapsed .nav-active .nav-icon {
    background: linear-gradient(135deg, rgba(139,92,246,0.35), rgba(99,102,241,0.35));
    border-radius: 0.75rem;
    padding: 0.5rem;
    box-shadow: 0 0 12px rgba(139,92,246,0.25);
  }
</style>

<script is:inline>
  (function () {
    function readUser() {
      try {
        return JSON.parse(localStorage.getItem('auth_user') || 'null');
      } catch {
        return null;
      }
    }

    function readRole(user) {
      return String(user?.role || user?.user_role || user?.account_role || '').trim().toLowerCase();
    }

    function syncSidebarAuth() {
      const user = readUser();
      const role = readRole(user);
      const isAuthed = !!localStorage.getItem('auth_token');
      const adminAllowed = role === 'admin' || !!user?.is_admin;
      const artistAllowed = role === 'artist' || role === 'manager' || !!user?.is_artist;

      const guestEl = document.getElementById('sidebar-guest');
      const userEl = document.getElementById('sidebar-user');
      const btnNew = document.getElementById('btn-new-playlist');
      const adminLink = document.getElementById('sidebar-admin-link');
      const studioLink = document.getElementById('sidebar-studio-link');
      const uploadLink = document.getElementById('sidebar-upload-link');

      document.documentElement.dataset.authed = isAuthed ? 'true' : 'false';
      const sidebar = document.getElementById('main-sidebar');
      if (sidebar) sidebar.dataset.authed = isAuthed ? 'true' : 'false';

      guestEl?.classList.toggle('hidden', isAuthed);
      userEl?.classList.toggle('hidden', !isAuthed);
      if (isAuthed) userEl?.classList.add('flex');
      btnNew?.classList.toggle('hidden', !isAuthed);
      if (isAuthed) btnNew?.classList.add('flex');
      adminLink?.classList.toggle('hidden', !adminAllowed);
      if (adminAllowed) adminLink?.classList.add('flex');
      studioLink?.classList.toggle('hidden', !artistAllowed);
      if (artistAllowed) studioLink?.classList.add('flex');
      uploadLink?.classList.toggle('hidden', !artistAllowed);
      if (artistAllowed) uploadLink?.classList.add('flex');
    }

    document.addEventListener('astro:page-load', syncSidebarAuth);
    syncSidebarAuth();
  })();
</script>

<div id="modal-new-playlist" class="hidden fixed inset-0 z-[200] flex items-center justify-center">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="modal-pl-bg"></div>
  <div class="relative bg-[#0e1835] border border-white/10 rounded-2xl p-8 w-full max-w-md shadow-2xl z-10 mx-4 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold text-white">Create new Playlist</h2>
      <button id="modal-pl-close" class="text-gray-400 hover:text-white transition-colors">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    <form id="form-sbpl-new" class="space-y-5" novalidate>


      <div>
        <label class="block text-sm font-medium text-gray-300 mb-2">Cover Image</label>
        <div class="flex items-start gap-4">

          <div id="sbpl-cover-preview"
               class="w-20 h-20 rounded-xl bg-white/5 border-2 border-dashed border-white/20 flex items-center justify-center shrink-0 overflow-hidden relative group cursor-pointer"
               title="Click to upload cover">
            <span id="sbpl-cover-placeholder" class="material-symbols-outlined text-gray-500 text-3xl">add_photo_alternate</span>
            <img id="sbpl-cover-img" class="hidden absolute inset-0 w-full h-full object-cover rounded-xl" alt="" />
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center rounded-xl">
              <span class="material-symbols-outlined text-white text-xl">edit</span>
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <input id="sbpl-cover-file" type="file" accept="image/jpeg,image/png,image/webp" class="hidden" />
            <button type="button" id="sbpl-cover-btn"
              class="w-full px-4 py-2.5 bg-white/5 border border-white/10 rounded-lg text-sm text-gray-300 hover:bg-white/10 hover:text-white transition-all text-left flex items-center gap-2">
              <span class="material-symbols-outlined text-[18px]">upload</span>
              Choose image…
            </button>
            <p class="text-xs text-gray-500 mt-2">JPG, PNG or WebP · max 5 MB</p>
            <button type="button" id="sbpl-cover-remove" class="hidden mt-1 text-xs text-red-400 hover:text-red-300 transition-colors">Remove</button>
          </div>
        </div>
        <p id="sbpl-cover-err" class="hidden mt-1 text-xs text-red-400"></p>
      </div>


      <div>
        <label for="sbpl-name" class="block text-sm font-medium text-gray-300 mb-1.5">
          Name <span class="text-rose-400">*</span>
        </label>
        <input id="sbpl-name" type="text" maxlength="100" placeholder="My Playlist"
          class="w-full px-4 py-3 bg-[#1a2847] border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all" />
        <div class="flex justify-between mt-1">
          <p id="sbpl-name-err" class="hidden text-xs text-red-400">Playlist name is required.</p>
          <span id="sbpl-name-count" class="ml-auto text-xs text-gray-600">0 / 100</span>
        </div>
      </div>


      <div>
        <label for="sbpl-desc" class="block text-sm font-medium text-gray-300 mb-1.5">Description</label>
        <textarea id="sbpl-desc" rows="3" maxlength="300" placeholder="What's this playlist about?"
          class="w-full px-4 py-3 bg-[#1a2847] border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all resize-none"></textarea>
        <span id="sbpl-desc-count" class="block text-right text-xs text-gray-600 mt-1">0 / 300</span>
      </div>


      <div>
        <label class="block text-sm font-medium text-gray-300 mb-2">Visibility</label>
        <div class="grid grid-cols-2 gap-3">
          <label id="lbl-vis-public" class="vis-option flex items-center gap-3 p-3 rounded-xl border-2 border-purple-500/60 bg-purple-500/10 cursor-pointer transition-all">
            <input type="radio" name="sbpl-visibility" value="public" checked class="accent-purple-500 w-4 h-4" />
            <div>
              <span class="material-symbols-outlined text-[18px] text-purple-400 align-middle">public</span>
              <span class="text-sm font-semibold text-white ml-1">Public</span>
              <p class="text-xs text-gray-400 mt-0.5">Anyone can see</p>
            </div>
          </label>
          <label id="lbl-vis-private" class="vis-option flex items-center gap-3 p-3 rounded-xl border-2 border-white/10 bg-white/5 cursor-pointer transition-all">
            <input type="radio" name="sbpl-visibility" value="private" class="accent-purple-500 w-4 h-4" />
            <div>
              <span class="material-symbols-outlined text-[18px] text-gray-400 align-middle">lock</span>
              <span class="text-sm font-semibold text-white ml-1">Private</span>
              <p class="text-xs text-gray-400 mt-0.5">Only you can see</p>
            </div>
          </label>
        </div>
      </div>

      <div id="sbpl-error" class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm rounded-lg px-4 py-3"></div>

      <button type="submit" id="sbpl-submit"
        class="w-full py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-lg transition-all flex items-center justify-center gap-2">
        <span class="material-symbols-outlined text-[20px]">add</span>
        Create Playlist
      </button>
    </form>
  </div>
</div>

<script>
  // @ts-nocheck
  import { getUser, apiFetch, getUserRole, hasMinRole, API_BASE } from '../lib/api.js';


  const user = getUser();
  const role = getUserRole();

  const guestEl   = document.getElementById('sidebar-guest') as HTMLElement;
  const userEl    = document.getElementById('sidebar-user') as HTMLElement;
  const nameEl    = document.getElementById('sidebar-username') as HTMLElement;
  const planEl    = document.getElementById('sidebar-plan') as HTMLElement;
  const avatarInner = document.getElementById('sidebar-avatar-inner') as HTMLElement;
  const btnNew    = document.getElementById('btn-new-playlist') as HTMLElement;

  if (user) {
    guestEl?.classList.add('hidden');
    userEl?.classList.remove('hidden');
    userEl?.classList.add('flex');
    btnNew?.classList.remove('hidden');
    btnNew?.classList.add('flex');

    if (nameEl) nameEl.textContent = user.full_name || user.username || user.email;
    if (planEl) {
      const roleLabels: Record<string, string> = {
        admin: 'Administrator',
        manager: 'Manager',
        artist: 'Artist',
      };
      if (role && roleLabels[role]) {
        planEl.textContent = roleLabels[role];
        planEl.className = role === 'admin'
          ? 'text-xs text-indigo-300 font-semibold'
          : role === 'manager'
          ? 'text-xs text-yellow-300 font-semibold'
          : 'text-xs text-green-400 font-semibold';
      } else if (user.is_admin) {
        planEl.textContent = 'Administrator';
        planEl.className = 'text-xs text-indigo-300 font-semibold';
      } else {
        const planType = (user.subscription_badge?.subscription_type || user.subscription?.subscription_type || user.subscription?.plan_name || 'free').toLowerCase();
        const active = user.subscription_badge?.is_active ?? user.subscription?.is_active ?? false;
        planEl.textContent = active && planType !== 'free' ? `✦ ${planType.toUpperCase()}` : 'Free';
        planEl.className = active && planType !== 'free'
          ? 'text-xs text-amber-300 font-semibold'
          : 'text-xs text-purple-400 font-medium';
      }
    }
    if (user.avatar_url && avatarInner) {
      avatarInner.innerHTML = `<img src="${user.avatar_url}" class="w-full h-full object-cover rounded-full" alt="" />`;
    }


    if (hasMinRole('manager') || user.is_admin) {
      const adminLink = document.getElementById('sidebar-admin-link') as HTMLElement;
      adminLink?.classList.remove('hidden');
      adminLink?.classList.add('flex');
    }


    if (role === 'artist') {
      const uploadLink = document.getElementById('sidebar-upload-link') as HTMLElement;
      uploadLink?.classList.remove('hidden');
      uploadLink?.classList.add('flex');
      const studioLink = document.getElementById('sidebar-studio-link') as HTMLElement;
      studioLink?.classList.remove('hidden');
      studioLink?.classList.add('flex');
    }

  }

  const modal     = document.getElementById('modal-new-playlist') as HTMLElement;
  const modalBg   = document.getElementById('modal-pl-bg') as HTMLElement;
  const closeBtn  = document.getElementById('modal-pl-close') as HTMLElement;
  const form      = document.getElementById('form-sbpl-new') as HTMLFormElement;
  const plError   = document.getElementById('sbpl-error') as HTMLElement;
  const plSubmit  = document.getElementById('sbpl-submit') as HTMLButtonElement;
  const plName    = document.getElementById('sbpl-name') as HTMLInputElement;
  const plDesc    = document.getElementById('sbpl-desc') as HTMLTextAreaElement;
  const plNameCount = document.getElementById('sbpl-name-count') as HTMLElement;
  const plDescCount = document.getElementById('sbpl-desc-count') as HTMLElement;
  const plNameErr   = document.getElementById('sbpl-name-err') as HTMLElement;


  const coverFile    = document.getElementById('sbpl-cover-file') as HTMLInputElement;
  const coverBtn     = document.getElementById('sbpl-cover-btn') as HTMLButtonElement;
  const coverPreview = document.getElementById('sbpl-cover-preview') as HTMLElement;
  const coverImg     = document.getElementById('sbpl-cover-img') as HTMLImageElement;
  const coverPlaceholder = document.getElementById('sbpl-cover-placeholder') as HTMLElement;
  const coverRemove  = document.getElementById('sbpl-cover-remove') as HTMLButtonElement;
  const coverErr     = document.getElementById('sbpl-cover-err') as HTMLElement;


  const visOptions = document.querySelectorAll('.vis-option') as NodeListOf<HTMLElement>;
  function updateVisStyles() {
    visOptions.forEach(lbl => {
      const radio = lbl.querySelector('input[type="radio"]') as HTMLInputElement;
      if (radio.checked) {
        lbl.classList.add('border-purple-500/60', 'bg-purple-500/10');
        lbl.classList.remove('border-white/10', 'bg-white/5');
      } else {
        lbl.classList.remove('border-purple-500/60', 'bg-purple-500/10');
        lbl.classList.add('border-white/10', 'bg-white/5');
      }
    });
  }
  visOptions.forEach(lbl => lbl.querySelector('input')?.addEventListener('change', updateVisStyles));


  function showCoverPreview(file: File) {
    const reader = new FileReader();
    reader.onload = (e) => {
      coverImg.src = e.target?.result as string;
      coverImg.classList.remove('hidden');
      coverPlaceholder.classList.add('hidden');
      coverRemove.classList.remove('hidden');
      coverBtn.innerHTML = `<span class="material-symbols-outlined text-[18px]">check_circle</span><span class="truncate">${file.name}</span>`;
    };
    reader.readAsDataURL(file);
  }

  function clearCover() {
    coverFile.value = '';
    coverImg.src = '';
    coverImg.classList.add('hidden');
    coverPlaceholder.classList.remove('hidden');
    coverRemove.classList.add('hidden');
    coverErr.classList.add('hidden');
    coverBtn.innerHTML = `<span class="material-symbols-outlined text-[18px]">upload</span>Choose image…`;
  }

  coverBtn.addEventListener('click', () => coverFile.click());
  coverPreview.addEventListener('click', () => coverFile.click());
  coverRemove.addEventListener('click', clearCover);

  coverFile.addEventListener('change', () => {
    coverErr.classList.add('hidden');
    const file = coverFile.files?.[0];
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) {
      coverErr.textContent = 'Image must be under 5 MB.';
      coverErr.classList.remove('hidden');
      clearCover();
      return;
    }
    showCoverPreview(file);
  });


  plName.addEventListener('input', () => {
    plNameCount.textContent = `${plName.value.length} / 100`;
    if (plName.value.trim()) {
      plNameErr.classList.add('hidden');
      plName.classList.remove('border-red-500/60');
    }
  });
  plDesc.addEventListener('input', () => {
    plDescCount.textContent = `${plDesc.value.length} / 300`;
  });

  function resetModal() {
    form.reset();
    plNameCount.textContent = '0 / 100';
    plDescCount.textContent = '0 / 300';
    plNameErr.classList.add('hidden');
    plName.classList.remove('border-red-500/60');
    plError.classList.add('hidden');
    clearCover();
    updateVisStyles();
  }

  function openSidebarModal() {
    resetModal();
    modal?.classList.remove('hidden');
    plName?.focus();
  }

  btnNew?.addEventListener('click', openSidebarModal);
  modalBg?.addEventListener('click', () => modal?.classList.add('hidden'));
  closeBtn?.addEventListener('click', () => modal?.classList.add('hidden'));


  window.addEventListener('open-create-playlist-modal', () => openSidebarModal());


  const sidebar     = document.getElementById('main-sidebar') as HTMLElement;
  const toggleBtn   = document.getElementById('sidebar-toggle') as HTMLButtonElement;
  const toggleIcon  = document.getElementById('sidebar-toggle-icon') as HTMLElement;

  const COLLAPSED_KEY = 'sidebar_collapsed';
  const isCollapsed   = localStorage.getItem(COLLAPSED_KEY) === 'true';

  function setSidebarState(collapsed: boolean, animate = true) {
    if (!animate) sidebar.style.transition = 'none';
    sidebar.classList.toggle('sidebar-collapsed', collapsed);
    if (!animate) requestAnimationFrame(() => { sidebar.style.transition = ''; });
    toggleIcon.style.transform = collapsed ? 'rotate(180deg)' : '';
    localStorage.setItem(COLLAPSED_KEY, String(collapsed));
  }


  setSidebarState(localStorage.getItem(COLLAPSED_KEY) === 'true', true);

  toggleBtn?.addEventListener('click', () => {
    setSidebarState(!sidebar.classList.contains('sidebar-collapsed'));
  });


  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    plError?.classList.add('hidden');


    const nameVal = plName.value.trim();
    if (!nameVal) {
      plNameErr.classList.remove('hidden');
      plName.classList.add('border-red-500/60');
      plName.focus();
      return;
    }


    const coverFileVal = coverFile.files?.[0];
    if (coverFileVal && coverFileVal.size > 5 * 1024 * 1024) {
      coverErr.textContent = 'Image must be under 5 MB.';
      coverErr.classList.remove('hidden');
      return;
    }

    const isPublic = (document.querySelector('input[name="sbpl-visibility"]:checked') as HTMLInputElement)?.value !== 'private';

    plSubmit.disabled = true;
    plSubmit.innerHTML = '<span class="material-symbols-outlined text-[20px] animate-spin">refresh</span> Creating…';

    try {
      const token = localStorage.getItem('auth_token');
      const fd = new FormData();
      fd.append('name', nameVal);
      fd.append('description', plDesc.value.trim());
      fd.append('is_public', String(isPublic));
      if (coverFileVal) {
        fd.append('cover', coverFileVal);
        console.log('[Sidebar] Appending cover file:', coverFileVal.name, coverFileVal.size, 'bytes');
      } else {
        console.log('[Sidebar] No cover file selected');
      }

      const res = await fetch(`${API_BASE}/playlists`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
        body: fd,
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.message || `Error ${res.status}`);

      modal?.classList.add('hidden');
      form.reset();
      resetModal();
      window.dispatchEvent(new CustomEvent('playlist-created', { detail: json.data }));
    } catch (err: any) {
      if (plError) {
        plError.textContent = err.message || 'Failed to create playlist';
        plError.classList.remove('hidden');
      }
    } finally {
      plSubmit.disabled = false;
      plSubmit.innerHTML = '<span class="material-symbols-outlined text-[20px]">add</span> Create Playlist';
    }
  });
</script>
