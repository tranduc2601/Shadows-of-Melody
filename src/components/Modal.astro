---
const { id = 'modal', open = false, title = '', description = '', className = '' } = Astro.props;
---
<div
  id={id}
  class={`fixed inset-0 z-[300] ${open ? 'flex' : 'hidden'} items-center justify-center bg-[#020617]/80 backdrop-blur-md p-4 sm:p-6 ${className}`}
  aria-hidden={!open}
>
  <div class="w-full max-w-2xl overflow-hidden rounded-[1.75rem] border border-white/10 bg-[linear-gradient(180deg,rgba(15,23,42,0.98)_0%,rgba(9,15,29,0.98)_100%)] shadow-[0_24px_80px_rgba(0,0,0,0.55)]">
    <div class="relative border-b border-white/10 px-5 py-4 sm:px-6 sm:py-5">
      <div class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-purple-400/40 to-transparent"></div>
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0 pr-10">
          {title && <h3 class="text-xl font-bold tracking-tight text-white">{title}</h3>}
          {description && <p class="mt-1 text-sm leading-6 text-slate-400">{description}</p>}
        </div>
        <button
          type="button"
          data-modal-close
          class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 text-slate-300 transition-colors hover:bg-white/10 hover:text-white"
        >
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>
    </div>
    <div class="px-5 py-5 sm:px-6 sm:py-6">
      <slot />
    </div>
  </div>
</div>
