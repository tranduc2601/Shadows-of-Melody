---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Sign Up - Shadows of Melody">
  <div class="min-h-screen bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30 flex items-center justify-center p-4 mobile-page-shell">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-black bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-purple-400 flex items-center justify-center gap-2 mb-2">
          <span class="material-symbols-outlined text-purple-400">music_note</span>
          Shadows of Melody
        </h1>
        <p class="text-gray-400 text-sm">Join our music community</p>
      </div>

      <div class="bg-[#0a1229]/80 backdrop-blur-xl border border-white/10 rounded-2xl p-8 shadow-2xl">
        <h2 class="text-2xl font-bold mb-6 text-center text-white">Create New Account</h2>

        <form id="signupForm" class="space-y-4">
          <div>
            <label for="username" class="block text-sm font-medium text-gray-300 mb-2">
              Username
            </label>
            <input
              type="text"
              id="username"
              name="username"
              required
              minlength="3"
              maxlength="20"
              pattern="[a-zA-Z0-9_]+"
              class="w-full px-4 py-3 bg-[#1a2847] border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all duration-200"
              placeholder="username"
            />
            <p class="text-xs text-gray-500 mt-1">Only letters, numbers, and underscores are allowed</p>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-300 mb-2">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 bg-[#1a2847] border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all duration-200"
              placeholder="your@email.com"
            />
          </div>

          <div>
            <label for="password" class="block text-sm font-medium text-gray-300 mb-2">
              Password
            </label>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                class="w-full px-4 py-3 pr-12 bg-[#1a2847] border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all duration-200"
                placeholder="••••••••"
              />
              <button
                type="button"
                id="toggle-password"
                aria-label="Toggle password visibility"
                class="absolute inset-y-0 right-0 flex items-center px-3 text-gray-500 hover:text-gray-300 transition-colors"
              >
                <span class="material-symbols-outlined text-[20px]" id="toggle-password-icon">visibility</span>
              </button>
            </div>
            <p class="text-xs text-gray-500 mt-2">
              Password must be at least 8 characters
            </p>
          </div>

          <div>
            <label for="confirmPassword" class="block text-sm font-medium text-gray-300 mb-2">
              Confirm Password
            </label>
            <div class="relative">
              <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                required
                class="w-full px-4 py-3 pr-12 bg-[#1a2847] border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all duration-200"
                placeholder="••••••••"
              />
              <button
                type="button"
                id="toggle-confirm-password"
                aria-label="Toggle confirm password visibility"
                class="absolute inset-y-0 right-0 flex items-center px-3 text-gray-500 hover:text-gray-300 transition-colors"
              >
                <span class="material-symbols-outlined text-[20px]" id="toggle-confirm-password-icon">visibility</span>
              </button>
            </div>
          </div>

          <div class="flex items-start gap-2 pt-2">
            <input
              type="checkbox"
              id="terms"
              name="terms"
              required
              class="w-4 h-4 mt-1 bg-[#1a2847] border border-white/10 rounded cursor-pointer accent-purple-500 flex-shrink-0"
            />
            <label for="terms" class="text-sm text-gray-400 cursor-pointer">
              By continuing, you agree to our
              <a href="/terms" class="text-purple-400 hover:text-purple-300 transition-colors">
                Terms of Service
              </a>
              and
              <a href="/privacy" class="text-purple-400 hover:text-purple-300 transition-colors">
                Privacy Policy
              </a>
            </label>
          </div>

          <div id="signupError" class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm rounded-lg px-4 py-3"></div>

          <button
            type="submit"
            id="signupBtn"
            class="w-full py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-lg transition-all duration-200 transform hover:scale-[1.02] active:scale-95 shadow-lg shadow-purple-500/25 mt-6"
          >
            Create Account
          </button>
        </form>

        <div class="my-6 flex items-center">
          <div class="flex-1 h-px bg-white/10"></div>
          <span class="px-4 text-gray-500 text-sm">OR</span>
          <div class="flex-1 h-px bg-white/10"></div>
        </div>

        <button
          type="button"
          id="googleSignupBtn"
          class="w-full py-3 bg-[#1a2847] border border-white/10 text-gray-300 font-medium rounded-lg hover:bg-[#233d5d] transition-all duration-200 flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <text x="0" y="20" font-size="20" fill="currentColor">G</text>
          </svg>
          Sign Up with Google
        </button>

        <p class="text-center text-gray-400 text-sm mt-6">
          Already have an account?
          <a href="/login" class="text-purple-400 hover:text-purple-300 font-semibold transition-colors">
            Login
          </a>
        </p>
      </div>

    </div>
  </div>

<script>
  import { API_BASE, setAuth } from '../lib/api.js';

  function showToast(msg: string, type: 'success' | 'error' | 'info' = 'info') {
    let container = document.getElementById('toast-container');
    if (!container) {
      container = document.createElement('div');
      container.id = 'toast-container';
      container.className = 'fixed bottom-6 right-6 z-[999] flex flex-col gap-2 pointer-events-none';
      document.body.appendChild(container);
    }
    const colors = { success: 'bg-green-500/20 border-green-500/40 text-green-300', error: 'bg-red-500/20 border-red-500/40 text-red-300', info: 'bg-indigo-500/20 border-indigo-500/40 text-indigo-300' };
    const icons  = { success: 'check_circle', error: 'error', info: 'info' };
    const toast = document.createElement('div');
    toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl border backdrop-blur-xl shadow-2xl text-sm font-medium transition-all duration-300 translate-y-2 opacity-0 ${colors[type]}`;
    toast.innerHTML = `<span class="material-symbols-outlined text-[18px] shrink-0">${icons[type]}</span><span>${msg}</span>`;
    container.appendChild(toast);
    requestAnimationFrame(() => toast.classList.remove('translate-y-2', 'opacity-0'));
    setTimeout(() => { toast.classList.add('translate-y-2', 'opacity-0'); setTimeout(() => toast.remove(), 300); }, 3500);
  }

  const form = document.getElementById('signupForm') as HTMLFormElement;
  const errDiv = document.getElementById('signupError') as HTMLElement;
  const btn = document.getElementById('signupBtn') as HTMLButtonElement;
  const googleBtn = document.getElementById('googleSignupBtn') as HTMLButtonElement;

  const existingToken = localStorage.getItem('auth_token');
  if (existingToken) window.location.href = '/';

  function completeAuth(data: any, successMsg: string) {
    setAuth(data.token, data);
    localStorage.setItem('me_cache', JSON.stringify(data));
    showToast(successMsg, 'success');
    setTimeout(() => { window.location.href = '/'; }, 900);
  }

  const setupToggle = (btnId: string, iconId: string, inputId: string) => {
    const btn   = document.getElementById(btnId) as HTMLButtonElement;
    const icon  = document.getElementById(iconId) as HTMLElement;
    const input = document.getElementById(inputId) as HTMLInputElement;
    btn?.addEventListener('click', () => {
      const hidden = input.type === 'password';
      input.type = hidden ? 'text' : 'password';
      icon.textContent = hidden ? 'visibility_off' : 'visibility';
    });
  };
  setupToggle('toggle-password',         'toggle-password-icon',         'password');
  setupToggle('toggle-confirm-password', 'toggle-confirm-password-icon', 'confirmPassword');

  function loadGoogleScript() {
    return new Promise<void>((resolve, reject) => {
      if ((window as any).google?.accounts?.id) return resolve();
      const existing = document.querySelector('script[data-google-gis="true"]');
      if (existing) {
        existing.addEventListener('load', () => resolve(), { once: true });
        existing.addEventListener('error', () => reject(new Error('Failed to load Google script')), { once: true });
        return;
      }
      const script = document.createElement('script');
      script.src = 'https://accounts.google.com/gsi/client';
      script.async = true;
      script.defer = true;
      script.dataset.googleGis = 'true';
      script.onload = () => resolve();
      script.onerror = () => reject(new Error('Failed to load Google script'));
      document.head.appendChild(script);
    });
  }

  async function ensureGoogleInitialized() {
    const clientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;
    if (!clientId) throw new Error('Google login is not configured.');
    await loadGoogleScript();
    const google = (window as any).google;
    if (!google?.accounts?.id) throw new Error('Google Identity Services did not load.');

    if (!(window as any).__googleSignupInitialized) {
      google.accounts.id.initialize({
        client_id: clientId,
        callback: (response: any) => {
          if (response?.credential) loginWithGoogle(response.credential);
        },
      });
      (window as any).__googleSignupInitialized = true;
    }
  }

  async function startGoogleLogin() {
    await ensureGoogleInitialized();
    (window as any).google.accounts.id.prompt();
  }

  async function loginWithGoogle(credential: string) {
    googleBtn.disabled = true;
    googleBtn.textContent = 'Signing up with Google...';
    errDiv.classList.add('hidden');
    try {
      const res = await fetch(`${API_BASE}/auth/google`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ credential }),
      });
      const json = await res.json();
      if (!res.ok) {
        const msg = json.message || 'Google sign up failed';
        if (json.code === 'ACCOUNT_LOCKED') {
          errDiv.textContent = msg;
          errDiv.classList.remove('hidden');
          showToast(msg, 'error');
          return;
        }
        throw new Error(msg);
      }
      completeAuth(json.data, 'Google account linked! Redirecting...');
    } catch (err: any) {
      errDiv.textContent = err.message;
      errDiv.classList.remove('hidden');
      showToast(err.message, 'error');
    } finally {
      googleBtn.disabled = false;
      googleBtn.textContent = 'Sign Up with Google';
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const username = (document.getElementById('username') as HTMLInputElement).value.trim();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value;
    const confirmPassword = (document.getElementById('confirmPassword') as HTMLInputElement).value;

    errDiv.classList.add('hidden');

    if (password !== confirmPassword) {
      errDiv.textContent = 'Passwords do not match.';
      errDiv.classList.remove('hidden');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Creating Account...';

    try {
      const res = await fetch(`${API_BASE}/auth/register`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, email, password, confirmPassword }),
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.message || 'Sign up failed');

      completeAuth(json.data, 'Account created successfully! Redirecting...');
    } catch (err: any) {
      errDiv.textContent = err.message;
      errDiv.classList.remove('hidden');
      showToast(err.message, 'error');
      btn.disabled = false;
      btn.textContent = 'Create Account';
    }
  });

  googleBtn?.addEventListener('click', async () => {
    errDiv.classList.add('hidden');
    googleBtn.disabled = true;
    googleBtn.textContent = 'Preparing Google...';
    try {
      await startGoogleLogin();
    } catch (error: any) {
      const msg = error?.message || 'Google login failed';
      errDiv.textContent = msg;
      errDiv.classList.remove('hidden');
      showToast(msg, 'error');
    } finally {
      googleBtn.disabled = false;
      googleBtn.textContent = 'Sign Up with Google';
    }
  });

</script>

</MainLayout>
