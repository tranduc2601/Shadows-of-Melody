---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Reset Password - Shadows of Melody">
  <div class="min-h-screen bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30 flex items-center justify-center p-4 mobile-page-shell">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-black bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-purple-400 flex items-center justify-center gap-2 mb-2">
          <span class="material-symbols-outlined text-purple-400">music_note</span>
          Shadows of Melody
        </h1>
        <p class="text-gray-400 text-sm">Choose a new password</p>
      </div>

      <div class="bg-[#0a1229]/80 backdrop-blur-xl border border-white/10 rounded-2xl p-8 shadow-2xl">
        <h2 class="text-2xl font-bold mb-3 text-center text-white">Reset Password</h2>
        <p id="tokenStatus" class="text-sm text-gray-400 text-center mb-6">Validating reset link...</p>

        <div id="tokenError" class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm rounded-lg px-4 py-3 mb-5"></div>

        <form id="resetPasswordForm" class="space-y-4 hidden">
          <div>
            <label for="password" class="block text-sm font-medium text-gray-300 mb-2">New Password</label>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                minlength="8"
                class="w-full px-4 py-3 pr-12 bg-[#1a2847] border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all duration-200"
                placeholder="••••••••"
              />
              <button type="button" id="toggle-password" class="absolute inset-y-0 right-0 flex items-center px-3 text-gray-500 hover:text-gray-300 transition-colors">
                <span class="material-symbols-outlined text-[20px]" id="toggle-password-icon">visibility</span>
              </button>
            </div>
          </div>

          <div>
            <label for="confirmPassword" class="block text-sm font-medium text-gray-300 mb-2">Confirm New Password</label>
            <div class="relative">
              <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                required
                minlength="8"
                class="w-full px-4 py-3 pr-12 bg-[#1a2847] border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all duration-200"
                placeholder="••••••••"
              />
              <button type="button" id="toggle-confirm-password" class="absolute inset-y-0 right-0 flex items-center px-3 text-gray-500 hover:text-gray-300 transition-colors">
                <span class="material-symbols-outlined text-[20px]" id="toggle-confirm-password-icon">visibility</span>
              </button>
            </div>
          </div>

          <div id="resetPasswordError" class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm rounded-lg px-4 py-3"></div>
          <div id="resetPasswordSuccess" class="hidden bg-green-500/10 border border-green-500/30 text-green-300 text-sm rounded-lg px-4 py-3"></div>

          <button type="submit" id="resetPasswordBtn" class="w-full py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-lg transition-all duration-200 transform hover:scale-[1.02] active:scale-95 shadow-lg shadow-purple-500/25">
            Update Password
          </button>
        </form>

        <div id="expiredActions" class="hidden text-center">
          <p class="text-gray-400 text-sm mb-4">Your reset link is invalid or expired.</p>
          <a href="/forgot-password" class="inline-flex items-center justify-center px-4 py-3 rounded-lg bg-[#1a2847] border border-white/10 text-purple-300 hover:text-white hover:bg-[#233d5d] transition-colors w-full">Resend reset link</a>
        </div>
      </div>
    </div>
  </div>

<script>
  import { API_BASE } from '../lib/api.js';

  const params = new URLSearchParams(window.location.search);
  const token = params.get('token');
  const status = document.getElementById('tokenStatus') as HTMLElement;
  const tokenError = document.getElementById('tokenError') as HTMLElement;
  const form = document.getElementById('resetPasswordForm') as HTMLFormElement;
  const expiredActions = document.getElementById('expiredActions') as HTMLElement;
  const errDiv = document.getElementById('resetPasswordError') as HTMLElement;
  const successDiv = document.getElementById('resetPasswordSuccess') as HTMLElement;
  const btn = document.getElementById('resetPasswordBtn') as HTMLButtonElement;

  const setExpired = (msg: string) => {
    status.textContent = 'Reset link unavailable';
    tokenError.textContent = msg;
    tokenError.classList.remove('hidden');
    expiredActions.classList.remove('hidden');
    form.classList.add('hidden');
  };

  const setupToggle = (btnId: string, iconId: string, inputId: string) => {
    const btn = document.getElementById(btnId) as HTMLButtonElement;
    const icon = document.getElementById(iconId) as HTMLElement;
    const input = document.getElementById(inputId) as HTMLInputElement;
    btn?.addEventListener('click', () => {
      const hidden = input.type === 'password';
      input.type = hidden ? 'text' : 'password';
      icon.textContent = hidden ? 'visibility_off' : 'visibility';
    });
  };
  setupToggle('toggle-password', 'toggle-password-icon', 'password');
  setupToggle('toggle-confirm-password', 'toggle-confirm-password-icon', 'confirmPassword');

  if (!token) {
    setExpired('Missing reset token.');
  } else {
    fetch(`${API_BASE}/auth/reset-password/validate?token=${encodeURIComponent(token)}`)
      .then(async (res) => {
        const json = await res.json();
        if (!res.ok) throw new Error(json.message || 'Invalid reset token');
        status.textContent = `Resetting password for ${json.data.email}`;
        form.classList.remove('hidden');
      })
      .catch((err: any) => {
        if (String(err.message || '').toLowerCase().includes('expired')) {
          setExpired(err.message || 'Invalid reset token');
          return;
        }
        tokenError.textContent = err.message || 'Invalid reset token';
        tokenError.classList.remove('hidden');
        form.classList.remove('hidden');
        status.textContent = 'Reset link validated, please choose a new password.';
      });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errDiv.classList.add('hidden');
    successDiv.classList.add('hidden');
    btn.disabled = true;
    btn.textContent = 'Updating...';

    try {
      const password = (document.getElementById('password') as HTMLInputElement).value;
      const confirmPassword = (document.getElementById('confirmPassword') as HTMLInputElement).value;
      const res = await fetch(`${API_BASE}/auth/reset-password`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token, password, confirmPassword }),
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.message || 'Failed to reset password');

      successDiv.textContent = 'Password updated successfully. Redirecting to login...';
      successDiv.classList.remove('hidden');
      setTimeout(() => { window.location.href = '/login?reason=password_reset_success'; }, 1200);
    } catch (err: any) {
      errDiv.textContent = err.message;
      errDiv.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Update Password';
    }
  });
</script>
</MainLayout>
