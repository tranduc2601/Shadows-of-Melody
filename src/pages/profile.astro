---
import MainLayout from "../layouts/MainLayout.astro";
import PlayerBar from "../components/PlayerBar.astro";
---

<MainLayout title="Hồ sơ - Shadows of Melody">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">

    <!-- Sidebar -->
    <aside class="w-64 shrink-0 border-r border-white/5 bg-[#0a1229]/80 backdrop-blur-xl hidden md:flex md:flex-col z-40">
      <div class="h-20 flex items-center px-6">
        <a href="/" class="text-2xl font-black bg-clip-text text-transparent bg-linear-to-r from-indigo-400 to-purple-400 flex items-center gap-2">
          <span class="material-symbols-outlined text-purple-400 animate-pulse">music_note</span>
          Melody
        </a>
      </div>

      <div class="px-4 py-6 flex-1 overflow-y-auto">
        <p class="px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Menu</p>
        <nav class="space-y-1 mb-8">
          <a href="/" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">home</span>Home
          </a>
          <a href="/search" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">search</span>Search
          </a>
          <a href="/artists" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">person</span>Artists
          </a>
        </nav>

        <p class="px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Library</p>
        <nav class="space-y-1">
          <a href="/liked" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform text-rose-400">favorite</span>Liked Songs
          </a>
          <a href="/playlist" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">queue_music</span>Playlists
          </a>
        </nav>
      </div>

      <!-- Active: Profile -->
      <div class="p-4 border-t border-white/5">
        <div class="flex items-center gap-3 p-2 rounded-xl transition-colors">
          <a href="/profile" class="flex items-center gap-3 flex-1 min-w-0 bg-linear-to-r from-purple-500/20 to-transparent rounded-xl px-2 py-1 shadow-[inset_2px_0_0_0_rgba(168,85,247,1)]">
            <div class="w-10 h-10 rounded-full bg-linear-to-tr from-purple-500 to-pink-500 p-0.5 shrink-0">
              <div class="w-full h-full rounded-full bg-[#0a1229] flex items-center justify-center">
                <span class="material-symbols-outlined text-purple-400">person</span>
              </div>
            </div>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-white truncate" id="sidebar-name">—</p>
              <p class="text-xs text-purple-400 font-medium truncate" id="sidebar-plan">Free</p>
            </div>
          </a>
          <a href="/settings" class="shrink-0 text-gray-500 hover:text-white transition-colors p-1 rounded-lg hover:bg-white/5">
            <span class="material-symbols-outlined text-[20px]">settings</span>
          </a>
          <button id="logout-btn" type="button" title="Đăng xuất" class="shrink-0 text-gray-500 hover:text-red-400 transition-colors p-1 rounded-lg hover:bg-red-500/10">
            <span class="material-symbols-outlined text-[20px]">logout</span>
          </button>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col relative overflow-hidden bg-linear-to-br from-[#0c1328] via-[#060e20] to-[#040813]">
      <!-- Ambient Glow -->
      <div class="absolute top-0 right-0 w-[50%] h-[50%] bg-purple-900/15 blur-[160px] rounded-full pointer-events-none"></div>
      <div class="absolute bottom-[20%] left-0 w-[35%] h-[40%] bg-indigo-900/10 blur-[130px] rounded-full pointer-events-none"></div>

      <!-- Scrollable Content -->
      <div class="flex-1 overflow-y-auto pb-32 relative z-10 custom-scrollbar scroll-smooth">

        <!-- Profile Banner -->
        <div class="relative h-48 bg-linear-to-r from-purple-900/60 via-indigo-900/50 to-pink-900/30 overflow-hidden">
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(168,85,247,0.3)_0%,transparent_60%)]"></div>
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(236,72,153,0.2)_0%,transparent_60%)]"></div>
          <!-- Edit banner button -->
          <button type="button" class="absolute top-4 right-4 flex items-center gap-2 px-4 py-2 bg-black/30 hover:bg-black/50 backdrop-blur-md rounded-full text-sm text-white/70 hover:text-white transition-all border border-white/10">
            <span class="material-symbols-outlined text-[16px]">edit</span>
            Edit banner
          </button>
        </div>

        <!-- Profile Info -->
        <div class="px-6 lg:px-8">
          <div class="flex flex-col sm:flex-row sm:items-end gap-5 -mt-14 relative z-10 mb-8">
            <!-- Avatar -->
            <div class="relative shrink-0">
              <div class="w-28 h-28 rounded-full bg-linear-to-tr from-purple-500 to-pink-500 p-1 shadow-2xl shadow-purple-500/30">
                <div id="profile-avatar-inner" class="w-full h-full rounded-full bg-[#0a1229] flex items-center justify-center overflow-hidden">
                  <span class="material-symbols-outlined text-purple-300" style="font-size: 3.5rem;">person</span>
                </div>
              </div>
              <button id="avatar-upload-btn" type="button" aria-label="Đổi ảnh đại diện" class="absolute bottom-1 right-1 w-8 h-8 rounded-full bg-purple-500 hover:bg-purple-400 flex items-center justify-center transition-colors shadow-lg">
                <span class="material-symbols-outlined text-white text-[16px]">photo_camera</span>
              </button>
              <input id="avatar-file-input" type="file" accept="image/jpeg,image/png,image/webp" class="hidden" />
            </div>

            <!-- Name + Stats -->
            <div class="flex-1 min-w-0 pb-2">
              <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-3xl font-black text-white" id="profile-name">—</h1>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-purple-500/20 border border-purple-500/40 rounded-full text-xs font-bold text-purple-300 uppercase tracking-wider">
                  <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span><span id="profile-plan">Free</span>
                </span>
              </div>
              <p class="text-gray-500 text-sm mt-0.5" id="profile-handle">—</p>
              <p class="text-gray-400 text-sm mt-2 max-w-md" id="profile-bio">—</p>
              <div class="flex items-center gap-6 mt-3 text-sm">
                <div>
                  <span class="font-bold text-white" id="profile-followers">0</span>
                  <span class="text-gray-500 ml-1">followed</span>
                </div>
                <div>
                  <span class="font-bold text-white" id="profile-following">0</span>
                  <span class="text-gray-500 ml-1">following</span>
                </div>
                <div>
                  <span class="font-bold text-white" id="profile-liked">0</span>
                  <span class="text-gray-500 ml-1">liked</span>
                </div>
              </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-3 shrink-0 pb-2">
              <a href="/settings" class="flex items-center gap-2 px-5 py-2.5 bg-white/5 border border-white/10 hover:bg-white/10 hover:border-white/20 text-white rounded-full font-semibold text-sm transition-all">
                <span class="material-symbols-outlined text-[18px]">edit</span>
                Edit Profile
              </a>
              <!-- Artist request button — hidden by JS until role is 'user' -->
              <button id="artist-request-btn" type="button" class="hidden items-center gap-2 px-5 py-2.5 bg-indigo-500/15 border border-indigo-500/30 hover:bg-indigo-500/25 text-indigo-300 rounded-full font-semibold text-sm transition-all">
                <span class="material-symbols-outlined text-[18px]">star</span>
                <span id="artist-request-label">Request Artist Access</span>
              </button>
            </div>
          </div>

          <!-- Tabs -->
          <div class="flex items-center gap-1 border-b border-white/5 mb-8">
            <button type="button" class="px-5 py-3 text-sm font-semibold transition-all relative text-white after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-purple-400 after:rounded-full">Overview</button>
            <button type="button" class="px-5 py-3 text-sm font-semibold transition-all relative text-gray-500 hover:text-gray-300">Playlists</button>
            <button type="button" class="px-5 py-3 text-sm font-semibold transition-all relative text-gray-500 hover:text-gray-300">Following</button>
          </div>

          <!-- Grid Layout -->
          <div class="grid grid-cols-1 xl:grid-cols-3 gap-8 mb-10">

            <!-- Left: Recent Tracks -->
            <div class="xl:col-span-2">
              <h2 class="text-lg font-bold text-white mb-5 flex items-center gap-2">
                <span class="material-symbols-outlined text-purple-400 text-[20px]">history</span>
                Recent Play
              </h2>
              <div class="space-y-1.5" id="recent-tracks">
                <p class="text-gray-500 text-sm text-center py-4">Loading...</p>
              </div>
            </div>

            <!-- Right: Top Artists + Stats -->
            <div class="flex flex-col gap-8">
              <!-- Top Artists -->
              <div>
                <h2 class="text-lg font-bold text-white mb-5 flex items-center gap-2">
                  <span class="material-symbols-outlined text-purple-400 text-[20px]">star</span>
                  Favorite Artists
                </h2>
                <div class="grid grid-cols-2 gap-3" id="top-artists">
                  <p class="col-span-2 text-gray-500 text-sm text-center py-2">Loading...</p>
                </div>
              </div>

              <!-- Listening Stats -->
              <!-- <div>
                <h2 class="text-lg font-bold text-white mb-5 flex items-center gap-2">
                  <span class="material-symbols-outlined text-purple-400 text-[20px]">equalizer</span>
                  Thống kê
                </h2>
                <div class="bg-white/3 border border-white/5 rounded-2xl p-5 space-y-4">
                  {[
                    { label: "Giờ nghe tháng này", value: "42h", icon: "schedule",  pct: 70  },
                    { label: "Bài hát đã nghe",    value: "312",  icon: "music_note", pct: 55  },
                    { label: "Nghệ sĩ khám phá",   value: "28",   icon: "person",     pct: 40  },
                  ].map((stat) => (
                    <div>
                      <div class="flex items-center justify-between mb-1.5">
                        <div class="flex items-center gap-2 text-sm text-gray-400">
                          <span class="material-symbols-outlined text-[16px] text-purple-400">{stat.icon}</span>
                          {stat.label}
                        </div>
                        <span class="text-sm font-bold text-white">{stat.value}</span>
                      </div>
                      <div class="h-1 bg-white/5 rounded-full overflow-hidden">
                        <div class={`h-full bg-linear-to-r from-purple-500 to-pink-500 rounded-full`} style={`width: ${stat.pct}%`}></div>
                      </div>
                    </div>
                  ))}
                </div>
              </div> -->
            </div>
          </div>

          <!-- Playlists Grid -->
          <div class="mb-6">
            <div class="flex items-end justify-between mb-5">
              <h2 class="text-lg font-bold text-white flex items-center gap-2">
                <span class="material-symbols-outlined text-purple-400 text-[20px]">queue_music</span>
                Playlists
              </h2>
              <a href="/playlist" class="text-sm font-semibold text-purple-400 hover:text-purple-300 transition-colors">Xem tất cả</a>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4" id="user-playlists-grid">
              <p class="col-span-4 text-gray-500 text-sm text-center py-4">Loading...</p>
            </div>
          </div>

        </div>
      </div>

      <!-- Now Playing Bar -->
      <PlayerBar />
    </main>
  </div>

  <style>
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.3); }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
  </style>

<script>
  import { apiFetch, getUserRole, setAuth, getToken, getUser } from '../lib/api.js';

  const GRADS = [
    'linear-gradient(135deg,#6366f1,#8b5cf6)',
    'linear-gradient(135deg,#f43f5e,#f97316)',
    'linear-gradient(135deg,#ec4899,#7c3aed)',
    'linear-gradient(135deg,#ef4444,#d946ef)',
    'linear-gradient(135deg,#3b82f6,#06b6d4)',
    'linear-gradient(135deg,#06b6d4,#10b981)',
    'linear-gradient(135deg,#d946ef,#7c3aed)',
    'linear-gradient(135deg,#fb923c,#fb7185)',
  ];
  const grad = (id: number) => GRADS[(id - 1) % GRADS.length];

  function setText(id: string, text: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  }

  async function loadProfile() {
    const token = localStorage.getItem('auth_token');
    if (!token) {
      setText('profile-name', 'Chưa đăng nhập');
      document.getElementById('recent-tracks')!.innerHTML =
        '<p class="text-center py-4"><a href="/login" class="text-purple-400 hover:text-purple-300 font-semibold">Đăng nhập</a> để xem hồ sơ.</p>';
      return;
    }

    try {
      const { data: user } = await apiFetch('/auth/me');

      setText('sidebar-name', user.full_name || user.username);
      setText('sidebar-plan', user.subscription?.subscription_type || 'free');
      setText('profile-name', user.full_name || user.username);
      setText('profile-plan', user.subscription?.subscription_type || 'free');
      setText('profile-handle', `@${user.username}`);
      setText('profile-bio', user.bio || 'Không có mô tả.');
      setText('profile-followers', '0');
      setText('profile-following', '0');
      setText('profile-liked', '0');

      // Show avatar
      const avatarInner = document.getElementById('profile-avatar-inner');
      if (avatarInner && user.avatar_url) {
        avatarInner.innerHTML = `<img src="${user.avatar_url}" class="w-full h-full object-cover rounded-full" alt="Avatar" />`;
      }
    } catch {}

    // Load history
    try {
      const { data: history } = await apiFetch('/history?limit=5');
      const tracksEl = document.getElementById('recent-tracks')!;
      if (!history?.length) {
        tracksEl.innerHTML = '<p class="text-gray-500 text-sm text-center py-4">Chưa có lịch sử nghe.</p>';
      } else {
        tracksEl.innerHTML = history.map((h: any, i: number) => {
          const s = h.song || h;
          const cover = s.cover_url
            ? `<img src="${s.cover_url}" class="w-11 h-11 rounded-xl shrink-0 object-cover shadow-md" alt=""/>`
            : `<div class="w-11 h-11 rounded-xl shrink-0 shadow-md" style="background:${grad(s.id || i + 1)}"></div>`;
          return `
            <div class="flex items-center gap-4 p-3 rounded-2xl hover:bg-white/5 transition-colors group cursor-pointer">
              <span class="text-gray-600 font-medium text-sm w-5 text-center shrink-0 group-hover:hidden">${i + 1}</span>
              <span class="material-symbols-outlined text-purple-400 text-[20px] hidden group-hover:block shrink-0">play_arrow</span>
              ${cover}
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-gray-100 group-hover:text-purple-400 transition-colors truncate text-sm">${s.title || '—'}</p>
                <p class="text-xs text-gray-500 truncate mt-0.5">${s.artist_names || 'Unknown'}</p>
              </div>
              <button class="opacity-0 group-hover:opacity-100 text-gray-500 hover:text-white">
                <span class="material-symbols-outlined text-[20px]">more_horiz</span>
              </button>
            </div>`;
        }).join('');
      }
    } catch {
      try {
        // Fallback: show recent songs
        const { data: songs } = await apiFetch('/songs?limit=5');
        const tracksEl = document.getElementById('recent-tracks')!;
        tracksEl.innerHTML = (songs || []).map((s: any, i: number) => {
          const cover = s.cover_url
            ? `<img src="${s.cover_url}" class="w-11 h-11 rounded-xl shrink-0 object-cover shadow-md" alt=""/>`
            : `<div class="w-11 h-11 rounded-xl shrink-0 shadow-md" style="background:${grad(s.id)}"></div>`;
          return `
            <div class="flex items-center gap-4 p-3 rounded-2xl hover:bg-white/5 transition-colors group cursor-pointer">
              <span class="text-gray-600 font-medium text-sm w-5 text-center shrink-0">${i + 1}</span>
              ${cover}
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-gray-100 group-hover:text-purple-400 truncate text-sm">${s.title}</p>
                <p class="text-xs text-gray-500 truncate mt-0.5">${s.artist_names || 'Unknown'}</p>
              </div>
            </div>`;
        }).join('');
      } catch {}
    }

    // Load artists
    try {
      const { data: artists } = await apiFetch('/artists?limit=4');
      const artistsEl = document.getElementById('top-artists')!;
      if (artists?.length) {
        artistsEl.innerHTML = artists.slice(0, 4).map((a: any) => {
          const img = a.image_url ? `<img src="${a.image_url}" class="w-full h-full object-cover" alt=""/>` : '';
          return `
            <a href="/artists" class="flex flex-col items-center gap-2 p-4 bg-white/5 border border-white/5 rounded-2xl hover:bg-white/10 transition-all group cursor-pointer">
              <div class="w-14 h-14 rounded-full overflow-hidden group-hover:scale-105 transition-transform shadow-lg" style="background:${grad(a.id)}">${img}</div>
              <p class="text-xs font-semibold text-gray-200 group-hover:text-white transition-colors text-center truncate w-full">${a.name}</p>
            </a>`;
        }).join('');
      }
    } catch {}

    // Load playlists
    try {
      const { data: playlists } = await apiFetch('/playlists?limit=4');
      const plEl = document.getElementById('user-playlists-grid')!;
      if (playlists?.length) {
        plEl.innerHTML = playlists.slice(0, 4).map((pl: any) => `
          <a href="/playlist" class="group cursor-pointer">
            <div class="aspect-square rounded-2xl mb-3 shadow-lg flex items-center justify-center relative overflow-hidden group-hover:scale-[1.03] transition-all duration-300" style="background:${grad(pl.id)}">
              ${pl.cover_url ? `<img src="${pl.cover_url}" class="absolute inset-0 w-full h-full object-cover" alt=""/>` : '<span class="material-symbols-outlined text-white/30 text-5xl">queue_music</span>'}
              <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity">
                <span class="material-symbols-outlined text-white text-4xl">play_circle</span>
              </div>
            </div>
            <p class="font-semibold text-gray-200 group-hover:text-white transition-colors text-sm truncate">${pl.name}</p>
            <p class="text-xs text-gray-500 mt-0.5">${pl.description || 'Playlist'}</p>
          </a>`).join('');
      } else {
        plEl.innerHTML = '<p class="col-span-4 text-gray-500 text-sm text-center py-4">Chưa có playlist.</p>';
      }
    } catch {}
  }

  loadProfile();

  // ── Avatar upload ──────────────────────────────────────────────────────────
  const avatarUploadBtn = document.getElementById('avatar-upload-btn') as HTMLButtonElement;
  const avatarFileInput = document.getElementById('avatar-file-input') as HTMLInputElement;

  avatarUploadBtn?.addEventListener('click', () => avatarFileInput?.click());

  avatarFileInput?.addEventListener('change', async () => {
    const file = avatarFileInput.files?.[0];
    if (!file) return;
    const token = localStorage.getItem('auth_token');
    if (!token) { alert('Vui lòng đăng nhập.'); return; }

    const btn = avatarUploadBtn;
    const origHTML = btn.innerHTML;
    btn.innerHTML = '<span class="material-symbols-outlined text-white text-[16px] animate-spin">refresh</span>';
    btn.disabled = true;

    try {
      const fd = new FormData();
      fd.append('avatar', file);
      const res = await fetch(`http://localhost:5000/api/auth/upload-avatar`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
        body: fd,
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.message || 'Upload thất bại');

      const newUrl: string = json.data.url;

      // Update avatar display
      const avatarInner = document.getElementById('profile-avatar-inner');
      if (avatarInner) {
        avatarInner.innerHTML = `<img src="${newUrl}" class="w-full h-full object-cover rounded-full" alt="Avatar" />`;
      }

      // Update localStorage so sidebar and other pages reflect the change
      try {
        const stored = JSON.parse(localStorage.getItem('auth_user') || 'null');
        if (stored) { stored.avatar_url = newUrl; localStorage.setItem('auth_user', JSON.stringify(stored)); }
      } catch {}
    } catch (err: any) {
      alert(err.message || 'Upload ảnh thất bại');
    } finally {
      btn.innerHTML = origHTML;
      btn.disabled = false;
      avatarFileInput.value = '';
    }
  });

  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    try {
      const token = getToken();
      if (token) {
        await fetch('http://localhost:5000/api/auth/logout', {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}` },
        });
      }
    } catch {}
    localStorage.removeItem('auth_token');
    localStorage.removeItem('auth_user');
    window.location.href = '/login';
  });

  // ── Artist request button ──────────────────────────────────────────────────
  (async () => {
    const role = getUserRole();
    if (role !== 'user') return; // only 'user' role sees the button

    const btn   = document.getElementById('artist-request-btn') as HTMLButtonElement;
    const label = document.getElementById('artist-request-label') as HTMLElement;
    if (!btn) return;

    // Check existing request state
    try {
      const { data: req } = await apiFetch('/roles/my-request');
      if (req?.status === 'pending') {
        label.textContent = 'Pending approval…';
        btn.disabled = true;
        btn.classList.add('opacity-60', 'cursor-not-allowed');
      } else if (req?.status === 'approved') {
        // Role was approved — refresh user data and skip showing button
        const { data: fresh } = await apiFetch('/auth/me');
        const stored = getUser();
        if (stored) setAuth(getToken()!, { ...stored, role: fresh.role ?? 'artist' });
        return; // don't show button
      }
    } catch {}

    btn.classList.remove('hidden');
    btn.classList.add('flex');

    btn.addEventListener('click', async () => {
      if (btn.disabled) return;
      btn.disabled = true;
      label.textContent = 'Submitting…';
      try {
        await apiFetch('/roles/request-artist', { method: 'POST' });
        label.textContent = 'Pending approval…';
        btn.classList.add('opacity-60', 'cursor-not-allowed');

        // Poll every 15 s until approved/rejected
        const poll = setInterval(async () => {
          try {
            const { data: req } = await apiFetch('/roles/my-request');
            if (req?.status === 'approved') {
              clearInterval(poll);
              // Re-fetch profile to get updated role
              const { data: fresh } = await apiFetch('/auth/me');
              const stored = getUser();
              if (stored) setAuth(getToken()!, { ...stored, role: fresh.role ?? 'artist' });
              btn.classList.add('hidden');
              // Briefly notify the user
              const notice = document.createElement('span');
              notice.textContent = '🎵 Artist access granted! Reload to see all features.';
              notice.className = 'px-4 py-2 text-sm text-green-400 bg-green-500/10 border border-green-500/30 rounded-full';
              btn.parentElement?.appendChild(notice);
            } else if (req?.status === 'rejected') {
              clearInterval(poll);
              label.textContent = 'Request Artist Access';
              btn.disabled = false;
              btn.classList.remove('opacity-60', 'cursor-not-allowed');
            }
          } catch {}
        }, 15_000);
        // Stop polling when the user navigates away to prevent API spam
        window.addEventListener('pagehide', () => clearInterval(poll), { once: true });
      } catch (err: any) {
        label.textContent = err.message.includes('pending')
          ? 'Pending approval…'
          : 'Request Artist Access';
        if (!label.textContent.startsWith('Pending')) btn.disabled = false;
        btn.classList.toggle('opacity-60', btn.disabled);
        btn.classList.toggle('cursor-not-allowed', btn.disabled);
      }
    });
  })();
</script>

</MainLayout>
