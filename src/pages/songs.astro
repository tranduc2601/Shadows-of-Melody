---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
---

<MainLayout title="Songs - Shadows of Melody">
  <div class="flex h-screen min-h-0 overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">
    <Sidebar currentPage="songs" />
    <main class="flex-1 flex min-h-0 flex-col relative overflow-hidden bg-[#060e20] min-w-0">
      <div class="flex-1 min-h-0 overflow-y-auto px-4 sm:px-6 lg:px-8 pb-32 pt-8 custom-scrollbar relative">
        <section class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-[#0b1328] p-5 sm:p-6 lg:p-8 mb-6">
          <div class="relative flex flex-col gap-6">
            <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5">
              <div class="max-w-2xl">
                <p class="text-xs uppercase tracking-[0.3em] text-purple-300/90 mb-3">Library</p>
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white leading-tight">Songs</h1>
                <p class="mt-3 text-sm sm:text-base text-gray-300/90 max-w-xl">
                  Explore the full music library with fast search, flexible sorting, and one-tap playback.
                </p>
              </div>

              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 w-full lg:w-auto">
                <div class="rounded-2xl border border-white/10 bg-[#060e20] px-4 py-3 min-w-[120px]">
                  <p class="text-[11px] uppercase tracking-[0.2em] text-gray-400">Total songs</p>
                  <p id="songs-count" class="mt-1 text-2xl font-black text-white tabular-nums">0</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-[#060e20] px-4 py-3 min-w-[120px]">
                  <p class="text-[11px] uppercase tracking-[0.2em] text-gray-400">Visible now</p>
                  <p id="visible-count" class="mt-1 text-2xl font-black text-white tabular-nums">0</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-[#060e20] px-4 py-3 min-w-[120px]">
                  <p class="text-[11px] uppercase tracking-[0.2em] text-gray-400">Plays</p>
                  <p id="total-plays" class="mt-1 text-2xl font-black text-white tabular-nums">0</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-[#060e20] px-4 py-3 min-w-[120px]">
                  <p class="text-[11px] uppercase tracking-[0.2em] text-gray-400">Total duration</p>
                  <p id="total-duration" class="mt-1 text-2xl font-black text-white tabular-nums">0:00</p>
                </div>
              </div>
            </div>

            <div class="flex flex-col xl:flex-row xl:items-center gap-3">
              <label class="flex-1 relative block">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none material-symbols-outlined">search</span>
                <input id="song-search" type="search" placeholder="Search by song title or artist..." class="w-full h-12 rounded-2xl bg-[#060e20] border border-white/10 pl-12 pr-4 text-white placeholder:text-gray-500 outline-none focus:border-purple-400/60 focus:ring-4 focus:ring-purple-500/10 transition" />
              </label>

              <div class="flex flex-col sm:flex-row gap-3">
                <select id="sort-select" class="songs-filter-select h-12 rounded-2xl bg-[#060e20] border border-white/15 px-4 text-white outline-none focus:border-purple-400/60 focus:ring-4 focus:ring-purple-500/10 transition">
                  <option value="recent">Default</option>
                  <option value="title">Title A → Z</option>
                  <option value="artist">Artist A → Z</option>
                  <option value="plays">Most played</option>
                  <option value="duration">Longest duration</option>
                </select>

                <button id="clear-filters" type="button" class="h-12 px-5 rounded-2xl bg-white/10 border border-white/10 text-white hover:bg-white/15 transition font-semibold">
                  Clear filters
                </button>
              </div>
            </div>
          </div>
        </section>

        <section class="rounded-[2rem] border border-white/10 bg-[#0b1328] overflow-hidden">
          <div class="flex items-center justify-between gap-3 px-5 sm:px-6 py-4 border-b border-white/10 bg-[#0c1328]">
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-white">Song list</h2>
              <p id="songs-hint" class="text-sm text-gray-400 mt-1">Click a song to play it instantly.</p>
            </div>
            <div class="hidden sm:flex items-center gap-2 text-sm text-gray-400">
              <span class="material-symbols-outlined text-base">touch_app</span>
            </div>
          </div>

          <div id="songs-table" class="overflow-x-auto"></div>
          <div id="songs-empty" class="hidden px-6 py-16 text-center">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-purple-300">
              <span class="material-symbols-outlined text-3xl">music_off</span>
            </div>
            <h3 class="text-xl font-bold text-white">No songs found</h3>
            <p class="mt-2 text-gray-400">Try changing the search term or sort option.</p>
          </div>
        </section>
      </div>
    </main>
  </div>
<script>
  // @ts-nocheck
  import { apiFetch, formatCount, formatDuration } from '../lib/api.js';
  import { player } from '../lib/player.js';

  const GRADS = [
    'linear-gradient(135deg,#6366f1,#8b5cf6)',
    'linear-gradient(135deg,#f43f5e,#f97316)',
    'linear-gradient(135deg,#ec4899,#7c3aed)',
    'linear-gradient(135deg,#ef4444,#d946ef)',
    'linear-gradient(135deg,#3b82f6,#06b6d4)',
    'linear-gradient(135deg,#06b6d4,#10b981)',
    'linear-gradient(135deg,#d946ef,#7c3aed)',
    'linear-gradient(135deg,#fb923c,#fb7185)',
  ];

  let els = null;
  const state = {
    songs: [],
    query: '',
    sort: 'recent',
  };

  function getEls() {
    return {
      table: document.getElementById('songs-table'),
      empty: document.getElementById('songs-empty'),
      search: document.getElementById('song-search'),
      sort: document.getElementById('sort-select'),
      clear: document.getElementById('clear-filters'),
      count: document.getElementById('songs-count'),
      visible: document.getElementById('visible-count'),
      plays: document.getElementById('total-plays'),
      duration: document.getElementById('total-duration'),
      hint: document.getElementById('songs-hint'),
    };
  }

  function normalize(value) {
    return String(value || '').toLowerCase().trim();
  }


  function getSongsForPlayer() {
    return state.songs.map((song) => ({ ...song }));
  }

  function gradientForSong(song) {
    return GRADS[(Number(song.id) - 1) % GRADS.length];
  }

  function songMatches(song, query) {
    if (!query) return true;
    const haystack = [song.title, song.artist_names, song.album_name].map(normalize).join(' ');
    return haystack.includes(query);
  }

  function sortSongs(list) {
    const songs = [...list];
    switch (state.sort) {
      case 'title':
        return songs.sort((a, b) => normalize(a.title).localeCompare(normalize(b.title), 'vi'));
      case 'artist':
        return songs.sort((a, b) => normalize(a.artist_names).localeCompare(normalize(b.artist_names), 'vi'));
      case 'plays':
        return songs.sort((a, b) => Number(b.plays_count || 0) - Number(a.plays_count || 0));
      case 'duration':
        return songs.sort((a, b) => Number(b.duration || 0) - Number(a.duration || 0));
      default:
        return songs.sort((a, b) => Number(b.id || 0) - Number(a.id || 0));
    }
  }

  function renderStats(list) {
    const totalSongs = state.songs.length;
    const visibleSongs = list.length;
    const totalPlays = list.reduce((sum, song) => sum + Number(song.plays_count || 0), 0);
    const totalDuration = list.reduce((sum, song) => sum + Number(song.duration || 0), 0);

    if (!els) els = getEls();
    if (els.count) els.count.textContent = String(totalSongs);
    if (els.visible) els.visible.textContent = String(visibleSongs);
    if (els.plays) els.plays.textContent = formatCount(totalPlays);
    if (els.duration) els.duration.textContent = formatDuration(totalDuration);
  }

  function renderSongs() {
    if (!els) els = getEls();
    if (!els.table || !els.empty) return;

    const filtered = sortSongs(state.songs.filter((song) => songMatches(song, state.query)));
    renderStats(filtered);

    const activeQuery = state.query ? ` for “${state.query}”` : '';
    if (els.hint) {
      els.hint.textContent = filtered.length
        ? `Showing ${filtered.length} songs${activeQuery}. Click one to play.`
        : `No results${activeQuery}. Try a different search term.`;
    }

    if (!filtered.length) {
      els.table.innerHTML = '';
      els.empty.classList.remove('hidden');
      return;
    }

    els.empty.classList.add('hidden');
    els.table.innerHTML = `
      <table class="w-full min-w-[780px]">
        <thead class="sticky top-0 z-10 bg-[#0c1328] border-b border-white/10">
          <tr class="text-center text-[11px] uppercase tracking-[0.22em] text-gray-400">
            <th class="px-5 py-4 w-16 text-center align-middle">#</th>
            <th class="px-5 py-4 text-center align-middle">Song</th>
            <th class="px-5 py-4 text-center align-middle hidden sm:table-cell">Plays</th>
            <th class="px-5 py-4 text-center align-middle">Duration</th>
            <th class="px-5 py-4 text-center align-middle">Play</th>
          </tr>
        </thead>
        <tbody>
          ${filtered.map((song, index) => {
            const cover = song.cover_url
              ? `<img src="${song.cover_url}" width="56" height="56" loading="lazy" decoding="async" class="w-14 h-14 rounded-2xl object-cover ring-1 ring-white/10" alt="${song.title || ''}"/>`
              : `<div class="w-14 h-14 rounded-2xl ring-1 ring-white/10" style="background:${gradientForSong(song)}"></div>`;

            return `
              <tr class="border-b border-white/5 cursor-pointer song-row" data-song="${encodeURIComponent(JSON.stringify(song))}">
                <td class="px-5 py-4 text-center text-gray-500 tabular-nums">${index + 1}</td>
                <td class="px-5 py-4">
                  <div class="flex items-center gap-4 min-w-0">
                    <div class="relative shrink-0">
                      ${cover}
                    </div>
                    <div class="min-w-0">
                      <p class="font-semibold text-white truncate">${song.title || 'Untitled'}</p>
                      <p class="text-xs text-gray-500 truncate mt-1">${song.artist_names || 'Unknown artist'}</p>
                    </div>
                  </div>
                </td>
                <td class="px-5 py-4 text-right hidden sm:table-cell text-gray-500 tabular-nums">${formatCount(song.plays_count)}</td>
                <td class="px-5 py-4 text-center text-gray-500 tabular-nums">${formatDuration(song.duration)}</td>
                <td class="px-5 py-4 text-right">
                  <div class="flex items-center justify-end gap-1 sm:gap-2">
                    <button type="button" class="btn-song-add inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-gray-400 hover:text-purple-300 hover:bg-purple-500/10 transition" data-song="${encodeURIComponent(JSON.stringify(song))}" title="Add to playlist" aria-label="Add to playlist">
                      <span class="material-symbols-outlined text-[18px]">playlist_add</span>
                    </button>
                    <button type="button" class="btn-song-like inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-gray-400 hover:text-pink-400 hover:bg-pink-500/10 transition" data-song-id="${song.id}" title="Like" aria-label="Like">
                      <span class="material-symbols-outlined text-[18px]">favorite_border</span>
                    </button>
                    <button type="button" class="btn-song-share inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-gray-400 hover:text-cyan-300 hover:bg-cyan-500/10 transition" data-song="${encodeURIComponent(JSON.stringify(song))}" title="Share" aria-label="Share">
                      <span class="material-symbols-outlined text-[18px]">share</span>
                    </button>
                    <button type="button" class="inline-flex items-center gap-2 rounded-full bg-white/8 border border-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-purple-500/20 hover:border-purple-400/40 transition song-play-btn" data-song="${encodeURIComponent(JSON.stringify(song))}">
                      <span class="material-symbols-outlined text-base">play_arrow</span>
                      Play
                    </button>
                  </div>
                </td>
              </tr>`;
          }).join('')}
        </tbody>
      </table>`;
  }

  async function loadSongs() {
    els = getEls();
    if (!els.table) return;
    els.table.innerHTML = `
      <div class="flex items-center justify-center py-20 text-gray-400">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined animate-pulse">music_note</span>
          <span>Loading songs...</span>
        </div>
      </div>`;

    try {
      const res = await apiFetch('/songs?limit=500');
      console.log('[Songs] raw response', res);
      state.songs = Array.isArray(res.data) ? [...res.data] : [];
      renderSongs();
    } catch (error) {
      console.error('[Songs] failed to load songs', error);
      if (els.table) {
        els.table.innerHTML = '';
      }
      if (els.empty) {
        els.empty.classList.remove('hidden');
      }
      if (els.hint) {
        els.hint.textContent = 'Unable to load songs right now.';
      }
    }
  }

  let songsPageBound = false;

  function bindSongsPage() {
    if (songsPageBound) return;
    songsPageBound = true;
    els = getEls();

    els.table?.addEventListener('click', (e) => {
      const target = e.target;
      const shareBtn = target instanceof HTMLElement ? target.closest('.btn-song-share') as HTMLElement | null : null;
      if (shareBtn) {
        e.stopPropagation();
        try { const song = JSON.parse(decodeURIComponent(shareBtn.dataset.song || '')); (window as any).shareMusicItem?.('song', song); } catch {}
        return;
      }
      const addBtn = target instanceof HTMLElement ? target.closest('.btn-song-add') as HTMLElement | null : null;
      if (addBtn) {
        e.stopPropagation();
        try { const song = JSON.parse(decodeURIComponent(addBtn.dataset.song || '')); (window as any).openAddToPlaylist?.(song); } catch {}
        return;
      }
      const likeBtn = target instanceof HTMLElement ? target.closest('.btn-song-like') as HTMLElement | null : null;
      if (likeBtn) {
        e.stopPropagation();
        const icon = likeBtn.querySelector('.material-symbols-outlined');
        const isLiked = likeBtn.dataset.liked === 'true';
        likeBtn.dataset.liked = String(!isLiked);
        if (icon) icon.textContent = !isLiked ? 'favorite' : 'favorite_border';
        likeBtn.classList.toggle('text-pink-400', !isLiked);
        likeBtn.classList.toggle('text-gray-400', isLiked);
        return;
      }
      const playBtn = target instanceof HTMLElement ? target.closest('.song-play-btn') as HTMLElement | null : null;
      if (playBtn) {
        e.stopPropagation();
        try {
          const song = JSON.parse(decodeURIComponent(playBtn.dataset.song || ''));
          player.playSong(song, getSongsForPlayer());
        } catch {}
        return;
      }
      const row = target instanceof HTMLElement ? target.closest('.song-row') as HTMLElement | null : null;
      if (!row) return;
      try {
        const song = JSON.parse(decodeURIComponent(row.dataset.song || ''));
        player.playSong(song, getSongsForPlayer());
      } catch {}
    });

    els.search?.addEventListener('input', () => {
      state.query = normalize((els?.search as HTMLInputElement)?.value);
      renderSongs();
    });

    els.sort?.addEventListener('change', () => {
      state.sort = (els?.sort as HTMLSelectElement)?.value || 'recent';
      renderSongs();
    });

    els.clear?.addEventListener('click', () => {
      if (els?.search) (els.search as HTMLInputElement).value = '';
      if (els?.sort) (els.sort as HTMLSelectElement).value = 'recent';
      state.query = '';
      state.sort = 'recent';
      renderSongs();
    });

    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        (els?.search as HTMLInputElement | null)?.focus();
      }
    });
  }

  function bootSongsPage() {
    if (window.location.pathname !== '/songs') return;
    if ((window as any).__songsPageBootedFor === window.location.pathname) return;
    (window as any).__songsPageBootedFor = window.location.pathname;
    songsPageBound = false;
    bindSongsPage();
    loadSongs();
  }

  if (!(window as any).__songsPageNavBound) {
    (window as any).__songsPageNavBound = true;
    document.addEventListener('astro:page-load', bootSongsPage);
  }
  bootSongsPage();
</script>

<style>
  #sort-select.songs-filter-select {
    background-color: #060e20;
    color: #fff;
  }

  #sort-select.songs-filter-select option {
    background-color: #060e20;
    color: #fff;
  }

  #sort-select.songs-filter-select:focus {
    background-color: #060e20;
    color: #fff;
  }
</style>
</MainLayout>
