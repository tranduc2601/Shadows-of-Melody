---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import PlayerBar from "../components/PlayerBar.astro";
---

<MainLayout title="Songs - Shadows of Melody">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">
    <Sidebar currentPage="songs" />
    <main class="flex-1 flex flex-col relative overflow-hidden bg-linear-to-br from-[#0c1328] via-[#060e20] to-[#040813] min-w-0">
      <div class="flex-1 overflow-y-auto px-4 sm:px-6 lg:px-8 pb-32 pt-8 custom-scrollbar">
        <div class="flex items-center justify-between gap-4 mb-6"><h1 class="text-3xl font-black text-white">Songs</h1></div>
        <div id="songs-table" class="bg-white/2 border border-white/5 rounded-3xl p-2 sm:p-3 backdrop-blur-sm"></div>
      </div>
      <PlayerBar />
    </main>
  </div>
<script>
  import { apiFetch, formatCount, formatDuration } from '../lib/api.js';
  import { player } from '../lib/player.js';

  const GRADS = [
    'linear-gradient(135deg,#6366f1,#8b5cf6)',
    'linear-gradient(135deg,#f43f5e,#f97316)',
    'linear-gradient(135deg,#ec4899,#7c3aed)',
    'linear-gradient(135deg,#ef4444,#d946ef)',
    'linear-gradient(135deg,#3b82f6,#06b6d4)',
    'linear-gradient(135deg,#06b6d4,#10b981)',
    'linear-gradient(135deg,#d946ef,#7c3aed)',
    'linear-gradient(135deg,#fb923c,#fb7185)',
  ];

  const el = document.getElementById('songs-table');

  async function loadSongs() {
    const res = await apiFetch('/songs?limit=500');
    const songs = [...(res.data || [])];
    if (!el) return;

    el.innerHTML = `
      <table class="w-full min-w-[720px]">
        <tbody>
          ${songs.map((s, i) => {
            const cover = s.cover_url
              ? `<img src="${s.cover_url}" loading="lazy" decoding="async" class="w-12 h-12 rounded-lg object-cover" alt=""/>`
              : `<div class="w-12 h-12 rounded-lg" style="background:${GRADS[(s.id - 1) % GRADS.length]}"></div>`;
            return `
              <tr class="group hover:bg-white/[0.05] cursor-pointer song-row" data-song="${encodeURIComponent(JSON.stringify(s))}">
                <td class="px-4 py-3 text-center text-gray-500 group-hover:text-white">${i + 1}</td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-4">
                    ${cover}
                    <div class="min-w-0">
                      <p class="font-semibold text-white group-hover:text-purple-300 truncate">${s.title}</p>
                      <p class="text-xs text-gray-500 truncate">${s.artist_names || 'Unknown'}</p>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3 text-right hidden sm:table-cell text-gray-500">${formatCount(s.plays_count)}</td>
                <td class="px-4 py-3 text-center text-gray-500">${formatDuration(s.duration)}</td>
              </tr>`;
          }).join('')}
        </tbody>
      </table>`;
  }

  el?.addEventListener('click', (e) => {
    const target = e.target;
    const row = target instanceof HTMLElement ? target.closest('.song-row') as HTMLElement | null : null;
    if (!row) return;
    try {
      const song = JSON.parse(decodeURIComponent(row.dataset.song || ''));
      const rows = [...document.querySelectorAll('.song-row')]
        .map((r) => {
          const el = r as HTMLElement;
          try { return JSON.parse(decodeURIComponent(el.dataset.song || '')); } catch { return null; }
        })
        .filter(Boolean);
      player.playSong(song, rows);
    } catch {}
  });

  loadSongs();
</script>
</MainLayout>
