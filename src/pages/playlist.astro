---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import PlayerBar from "../components/PlayerBar.astro";
---

<MainLayout title="Playlist - Shadows of Melody">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">

    <Sidebar currentPage="playlist" />

    <!-- Main Content -->
    <main class="flex-1 flex flex-col overflow-hidden bg-gradient-to-br from-[#0c1328] via-[#060e20] to-[#040813] relative">
      <div class="absolute top-0 left-0 w-full h-80 bg-gradient-to-b from-purple-900/30 to-transparent pointer-events-none"></div>

      <!-- Header -->
      <header class="h-20 flex-shrink-0 flex items-center justify-between px-8 relative z-10">
        <h1 class="text-2xl font-bold text-white">My Playlists</h1>
        <button id="btn-open-create" class="flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-full transition-all hover:scale-105 shadow-lg shadow-purple-500/25">
          <span class="material-symbols-outlined">add</span>
          New Playlist
        </button>
      </header>

      <div class="flex-1 overflow-y-auto px-8 pb-32 relative z-10 custom-scrollbar">

        <!-- Playlist Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 xl:grid-cols-6 gap-5 mb-12" id="playlists-grid">
          <p class="col-span-6 text-gray-500 text-sm text-center py-10">Loading...</p>
        </div>

        <!-- Featured Playlist Detail -->
        <div id="featured-section" class="hidden">
          <div class="flex flex-col md:flex-row gap-8 mb-8 p-6 bg-white/[0.02] rounded-3xl border border-white/5" id="featured-header"></div>
          <div class="bg-white/[0.02] border border-white/5 rounded-3xl overflow-hidden">
            <table class="w-full text-left">
              <thead>
                <tr class="border-b border-white/5">
                  <th class="px-6 py-4 text-gray-500 text-xs font-medium w-12 text-center">#</th>
                  <th class="px-4 py-4 text-gray-500 text-xs font-medium uppercase tracking-wider">Title</th>
                  <th class="px-4 py-4 text-gray-500 text-xs font-medium uppercase tracking-wider hidden md:table-cell">Album</th>
                  <th class="px-4 py-4 text-gray-500 text-xs font-medium text-right w-20">
                    <span class="material-symbols-outlined text-[18px]">schedule</span>
                  </th>
                </tr>
              </thead>
              <tbody id="featured-tbody">
                <tr><td colspan="4" class="px-6 py-8 text-center text-gray-500">Select a playlist to view songs.</td></tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>

      <PlayerBar />
    </main>

    <!-- Toast -->
    <div id="pl-toast" class="fixed bottom-36 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 transition-opacity duration-300">
      <div class="flex items-center gap-3 bg-[#1e2a45] border border-white/10 text-white text-sm font-medium px-5 py-3 rounded-2xl shadow-2xl backdrop-blur-md whitespace-nowrap">
        <span id="pl-toast-icon" class="material-symbols-outlined text-[18px] text-blue-400">info</span>
        <span id="pl-toast-msg"></span>
      </div>
    </div>

    <!-- Create Playlist Modal -->
    <div id="modal-create-pl" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
      <div class="bg-[#0f1b35] border border-white/10 rounded-3xl shadow-2xl w-full max-w-md p-8 relative">
        <button id="modal-close" type="button" class="absolute top-5 right-5 text-gray-500 hover:text-white transition-colors">
          <span class="material-symbols-outlined">close</span>
        </button>

        <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
          <span class="material-symbols-outlined text-purple-400">queue_music</span>
          Create New Playlist
        </h2>

        <form id="form-create-pl" class="space-y-4" novalidate>
          <!-- Name (required) -->
          <div class="flex flex-col gap-1.5">
            <label for="pl-name" class="text-sm font-medium text-gray-300">
              Playlist Name <span class="text-red-400">*</span>
            </label>
            <input
              id="pl-name" name="name" type="text" maxlength="100"
              placeholder="My awesome playlist"
              class="w-full bg-white/5 border border-white/10 text-white rounded-xl py-2.5 px-4 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/50 transition-all placeholder-gray-600"
            />
            <p class="text-xs text-red-400 hidden" id="pl-name-err">Name is required.</p>
          </div>

          <!-- Description (optional) -->
          <div class="flex flex-col gap-1.5">
            <label for="pl-desc" class="text-sm font-medium text-gray-300">Description</label>
            <textarea
              id="pl-desc" name="description" rows="3" maxlength="300"
              placeholder="What's this playlist about?"
              class="w-full bg-white/5 border border-white/10 text-white rounded-xl py-2.5 px-4 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/50 transition-all resize-none placeholder-gray-600"
            ></textarea>
          </div>

          <!-- Visibility -->
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-medium text-gray-300">Visibility</label>
            <div class="flex gap-3">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="is_public" value="true" checked
                  class="accent-purple-500 w-4 h-4 cursor-pointer" />
                <span class="text-sm text-gray-300 flex items-center gap-1">
                  <span class="material-symbols-outlined text-[16px] text-green-400">public</span>Public
                </span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="is_public" value="false"
                  class="accent-purple-500 w-4 h-4 cursor-pointer" />
                <span class="text-sm text-gray-300 flex items-center gap-1">
                  <span class="material-symbols-outlined text-[16px] text-gray-400">lock</span>Private
                </span>
              </label>
            </div>
          </div>

          <div class="flex gap-3 pt-2">
            <button type="button" id="modal-cancel" class="flex-1 py-2.5 bg-white/5 border border-white/10 hover:bg-white/10 text-gray-300 hover:text-white rounded-xl font-semibold text-sm transition-all">
              Cancel
            </button>
            <button type="submit" id="btn-create-pl" class="flex-1 py-2.5 bg-linear-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white rounded-xl font-bold text-sm transition-all hover:scale-[1.02] shadow-lg shadow-purple-500/20">
              Create
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>

  <style>
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.3); }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
  </style>

<script>
  import { apiFetch, formatDuration, getUser } from '../lib/api.js';
  import { player } from '../lib/player.js';

  const GRADS = [
    'linear-gradient(135deg,#6366f1,#8b5cf6)',
    'linear-gradient(135deg,#f43f5e,#f97316)',
    'linear-gradient(135deg,#ec4899,#7c3aed)',
    'linear-gradient(135deg,#ef4444,#d946ef)',
    'linear-gradient(135deg,#3b82f6,#06b6d4)',
    'linear-gradient(135deg,#06b6d4,#10b981)',
    'linear-gradient(135deg,#d946ef,#7c3aed)',
    'linear-gradient(135deg,#fb923c,#fb7185)',
  ];
  const grad = (id: number) => GRADS[(id - 1) % GRADS.length];

  // ── Toast ──────────────────────────────────────────────────────────────────
  let _toastTimer: ReturnType<typeof setTimeout> | null = null;
  function showToast(msg: string, type: 'success' | 'error' | 'info' = 'info') {
    const toast  = document.getElementById('pl-toast')!;
    const msgEl  = document.getElementById('pl-toast-msg')!;
    const iconEl = document.getElementById('pl-toast-icon')!;
    msgEl.textContent  = msg;
    iconEl.textContent = type === 'success' ? 'check_circle' : type === 'error' ? 'error' : 'info';
    iconEl.className   = `material-symbols-outlined text-[18px] ${type === 'success' ? 'text-green-400' : type === 'error' ? 'text-red-400' : 'text-blue-400'}`;
    toast.classList.remove('opacity-0');
    toast.classList.add('opacity-100');
    if (_toastTimer) clearTimeout(_toastTimer);
    _toastTimer = setTimeout(() => {
      toast.classList.remove('opacity-100');
      toast.classList.add('opacity-0');
    }, 3000);
  }

  // ── Modal ──────────────────────────────────────────────────────────────────
  const modal     = document.getElementById('modal-create-pl')!;
  const openBtn   = document.getElementById('btn-open-create')!;
  const closeBtn  = document.getElementById('modal-close')!;
  const cancelBtn = document.getElementById('modal-cancel')!;

  function openModal() {
    modal.classList.remove('hidden');
    (document.getElementById('pl-name') as HTMLInputElement).focus();
  }
  function closeModal() {
    modal.classList.add('hidden');
    (document.getElementById('form-create-pl') as HTMLFormElement).reset();
    document.getElementById('pl-name-err')!.classList.add('hidden');
    (document.getElementById('pl-name') as HTMLInputElement).classList.remove('border-red-500/60');
  }

  openBtn.addEventListener('click', openModal);
  closeBtn.addEventListener('click', closeModal);
  cancelBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

  // ── Create playlist form ──────────────────────────────────────────────────
  document.getElementById('form-create-pl')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const nameInput = document.getElementById('pl-name') as HTMLInputElement;
    const descInput = document.getElementById('pl-desc') as HTMLTextAreaElement;
    const isPublic  = (document.querySelector('input[name="is_public"]:checked') as HTMLInputElement)?.value === 'true';
    const nameErr   = document.getElementById('pl-name-err')!;
    const submitBtn = document.getElementById('btn-create-pl') as HTMLButtonElement;

    const name = nameInput.value.trim();
    if (!name) {
      nameErr.classList.remove('hidden');
      nameInput.classList.add('border-red-500/60');
      nameInput.focus();
      return;
    }
    nameErr.classList.add('hidden');
    nameInput.classList.remove('border-red-500/60');

    const token = localStorage.getItem('auth_token');
    if (!token) { showToast('You must be logged in to create a playlist.', 'error'); return; }

    submitBtn.textContent = 'Creating...';
    submitBtn.disabled = true;

    try {
      const { data: pl } = await apiFetch('/playlists', {
        method: 'POST',
        body: JSON.stringify({
          name,
          description: descInput.value.trim(),
          is_public: isPublic,
        }),
      });
      closeModal();
      showToast(`Playlist "${pl.name}" created!`, 'success');
      await loadPlaylists();
    } catch (err: any) {
      showToast('Failed to create playlist: ' + (err.message || 'Unknown error'), 'error');
    } finally {
      submitBtn.textContent = 'Create';
      submitBtn.disabled = false;
    }
  });

  document.getElementById('pl-name')?.addEventListener('input', () => {
    document.getElementById('pl-name-err')!.classList.add('hidden');
    (document.getElementById('pl-name') as HTMLInputElement).classList.remove('border-red-500/60');
  });

  // ── Load playlists ────────────────────────────────────────────────────────
  async function loadPlaylists() {
    const grid  = document.getElementById('playlists-grid')!;
    const token = localStorage.getItem('auth_token');

    if (!token) {
      grid.innerHTML = `<p class="col-span-6 text-center py-10 text-gray-400">
        <a href="/login" class="text-purple-400 hover:text-purple-300 font-semibold">Log in</a> to view your playlists.
      </p>`;
      return;
    }

    try {
      const { data: playlists } = await apiFetch('/playlists');

      if (!playlists?.length) {
        grid.innerHTML = `<div class="col-span-6 flex flex-col items-center gap-4 py-16 text-center">
          <span class="material-symbols-outlined text-gray-600" style="font-size:4rem">queue_music</span>
          <p class="text-gray-400">No playlists yet.</p>
          <button id="empty-create-btn" class="px-5 py-2 bg-purple-600 hover:bg-purple-500 text-white rounded-full font-semibold text-sm transition-all">Create your first playlist</button>
        </div>`;
        document.getElementById('empty-create-btn')?.addEventListener('click', openModal);
        document.getElementById('featured-section')!.classList.add('hidden');
        return;
      }

      grid.innerHTML = playlists.map((pl: any) => `
        <div class="group cursor-pointer playlist-card" data-id="${pl.id}">
          <div class="aspect-square rounded-2xl mb-3 shadow-lg relative overflow-hidden group-hover:scale-105 transition-transform duration-300" style="background:${grad(pl.id)}">
            ${pl.cover_url ? `<img src="${pl.cover_url}" class="absolute inset-0 w-full h-full object-cover" alt=""/>` : '<div class="absolute inset-0 flex items-center justify-center"><span class="material-symbols-outlined text-white/30 text-5xl">queue_music</span></div>'}
            <div class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/30 transition-all">
              <button class="w-12 h-12 rounded-full bg-green-500 hover:bg-green-400 flex items-center justify-center shadow-xl opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0 transition-all play-pl-btn" data-id="${pl.id}">
                <span class="material-symbols-outlined text-black">play_arrow</span>
              </button>
            </div>
            ${!pl.is_public ? '<span class="absolute top-2 left-2 material-symbols-outlined text-white/60 text-[18px]">lock</span>' : ''}
          </div>
          <p class="text-white font-semibold text-sm truncate group-hover:text-purple-400 transition-colors">${pl.name}</p>
          <p class="text-gray-500 text-xs mt-0.5 truncate">${pl.description || 'Playlist'}</p>
        </div>`).join('');

      loadPlaylistDetail(playlists[0].id);

      grid.addEventListener('click', (e) => {
        const card    = (e.target as HTMLElement).closest('.playlist-card') as HTMLElement | null;
        const playBtn = (e.target as HTMLElement).closest('.play-pl-btn');
        if (card && !playBtn) loadPlaylistDetail(Number(card.dataset.id));
      });

    } catch {
      grid.innerHTML = '<p class="col-span-6 text-red-400 text-sm text-center py-10">Failed to load playlists.</p>';
    }
  }

  // ── Playlist detail ───────────────────────────────────────────────────────
  async function loadPlaylistDetail(playlistId: number) {
    const featured = document.getElementById('featured-section')!;
    const headerEl = document.getElementById('featured-header')!;
    const tbody    = document.getElementById('featured-tbody')!;
    featured.classList.remove('hidden');
    headerEl.innerHTML = '<p class="text-gray-500 text-sm py-4">Loading...</p>';
    tbody.innerHTML    = '<tr><td colspan="4" class="px-6 py-8 text-center text-gray-500">Loading...</td></tr>';

    try {
      const { data: pl } = await apiFetch(`/playlists/${playlistId}`);
      const songs    = pl?.songs || [];
      const user     = getUser();
      const totalSec = songs.reduce((s: number, t: any) => s + (parseInt(t.duration) || 0), 0);
      const durText  = totalSec > 0
        ? (totalSec >= 3600 ? `${Math.floor(totalSec / 3600)}h ${Math.floor((totalSec % 3600) / 60)}m` : `${Math.floor(totalSec / 60)} min`)
        : '—';

      headerEl.innerHTML = `
        <div class="w-48 h-48 flex-shrink-0 rounded-2xl shadow-2xl relative overflow-hidden" style="background:${grad(pl.id)}">
          ${pl.cover_url ? `<img src="${pl.cover_url}" class="absolute inset-0 w-full h-full object-cover" alt=""/>` : '<div class="absolute inset-0 flex items-center justify-center"><span class="material-symbols-outlined text-white/20 text-7xl">queue_music</span></div>'}
        </div>
        <div class="flex flex-col justify-end flex-1 min-w-0">
          <span class="text-xs font-bold text-purple-400 uppercase tracking-widest mb-2">${pl.is_public ? 'Public Playlist' : 'Private Playlist'}</span>
          <h2 class="text-4xl font-black text-white mb-2 truncate">${pl.name}</h2>
          ${pl.description ? `<p class="text-gray-400 text-sm mb-3 line-clamp-2">${pl.description}</p>` : ''}
          <div class="flex items-center gap-2 text-sm text-gray-400 flex-wrap">
            <span class="text-white font-semibold">${user?.username || '—'}</span>
            <span class="text-white/30">·</span>
            <span>${songs.length} songs</span>
            <span class="text-white/30">·</span>
            <span>${durText}</span>
          </div>
          <div class="flex items-center gap-3 mt-5">
            <button id="btn-pl-play" class="w-14 h-14 rounded-full bg-gradient-to-r from-purple-600 to-indigo-600 flex items-center justify-center hover:scale-110 transition-transform shadow-lg shadow-purple-500/30" ${!songs.length ? 'disabled' : ''}>
              <span class="material-symbols-outlined text-white text-3xl">play_arrow</span>
            </button>
            <button id="btn-pl-shuffle" class="p-3 text-gray-400 hover:text-white transition-colors" ${!songs.length ? 'disabled' : ''}>
              <span class="material-symbols-outlined text-3xl">shuffle</span>
            </button>
          </div>
        </div>`;

      const _songs = songs;
      document.getElementById('btn-pl-play')?.addEventListener('click', () => {
        if (_songs.length) player.playSong(_songs[0], _songs);
      });
      document.getElementById('btn-pl-shuffle')?.addEventListener('click', () => {
        if (!_songs.length) return;
        const shuffled = [..._songs].sort(() => Math.random() - 0.5);
        player.playSong(shuffled[0], shuffled);
      });

      if (!songs.length) {
        tbody.innerHTML = '<tr><td colspan="4" class="px-6 py-8 text-center text-gray-500">This playlist is empty.</td></tr>';
        return;
      }

      tbody.innerHTML = songs.map((s: any, i: number) => {
        const cover = s.cover_url
          ? `<img src="${s.cover_url}" class="w-10 h-10 rounded-lg flex-shrink-0 object-cover shadow-md" alt=""/>`
          : `<div class="w-10 h-10 rounded-lg flex-shrink-0 shadow-md" style="background:${grad(s.id)}"></div>`;
        return `
          <tr class="group hover:bg-white/5 transition-colors cursor-pointer song-row" data-song="${encodeURIComponent(JSON.stringify(s))}">
            <td class="px-6 py-3 text-center">
              <span class="text-gray-500 group-hover:hidden">${i + 1}</span>
              <span class="material-symbols-outlined text-purple-400 hidden group-hover:block">play_arrow</span>
            </td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-3">
                ${cover}
                <div class="min-w-0">
                  <p class="text-white font-medium text-sm group-hover:text-purple-400 transition-colors truncate">${s.title}</p>
                  <p class="text-gray-500 text-xs truncate">${s.artist_names || 'Unknown'}</p>
                </div>
              </div>
            </td>
            <td class="px-4 py-3 text-gray-500 text-sm hidden md:table-cell truncate max-w-xs">${s.album_title || '—'}</td>
            <td class="px-4 py-3 text-right">
              <span class="text-gray-500 text-sm">${formatDuration(s.duration)}</span>
            </td>
          </tr>`;
      }).join('');

      tbody.addEventListener('click', (e) => {
        const row = (e.target as HTMLElement).closest('.song-row') as HTMLElement | null;
        if (!row) return;
        try {
          const song  = JSON.parse(decodeURIComponent(row.dataset.song || ''));
          const queue = Array.from(tbody.querySelectorAll('.song-row')).map(r => {
            try { return JSON.parse(decodeURIComponent((r as HTMLElement).dataset.song || '')); } catch { return null; }
          }).filter(Boolean);
          player.playSong(song, queue);
        } catch {}
      });

    } catch {
      headerEl.innerHTML = '<p class="text-red-400 text-sm py-4">Failed to load playlist.</p>';
      tbody.innerHTML = '<tr><td colspan="4" class="px-6 py-8 text-center text-red-400">Failed to load songs.</td></tr>';
    }
  }

  loadPlaylists();
</script>

</MainLayout>
---
</MainLayout>
