---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import PlayerBar from "../components/PlayerBar.astro";
---

<MainLayout title="Playlist - Shadows of Melody">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">

    <Sidebar currentPage="playlist" />

    <!-- Main Content -->
    <main class="flex-1 flex flex-col overflow-hidden bg-gradient-to-br from-[#0c1328] via-[#060e20] to-[#040813] relative">
      <div class="absolute top-0 left-0 w-full h-80 bg-gradient-to-b from-purple-900/30 to-transparent pointer-events-none"></div>

      <!-- Header -->
      <header class="h-20 flex-shrink-0 flex items-center justify-between px-8 relative z-10">
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-bold text-white">Thư Viện Playlist</h1>
        </div>
        <button id="header-create-pl" class="flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-full transition-all hover:scale-105 shadow-lg shadow-purple-500/25">
          <span class="material-symbols-outlined">add</span>
          Tạo playlist
        </button>
      </header>

      <div class="flex-1 overflow-y-auto px-8 pb-32 relative z-10">

        <!-- Playlist Grid -->
        <section class="mb-12">
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4" id="playlists-grid">
            <p class="col-span-6 text-gray-500 text-sm text-center py-4">Loading...</p>
          </div>
        </section>

        <!-- Featured Playlist Detail -->
        <section>
          <!-- Playlist Header -->
          <div class="flex flex-col md:flex-row gap-8 mb-8 p-6 bg-white/[0.02] rounded-3xl border border-white/5">
            <div class="w-48 h-48 flex-shrink-0 rounded-2xl bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center text-7xl shadow-2xl shadow-cyan-500/20">
              🌊
            </div>
            <div class="flex flex-col justify-end">
              <span class="text-xs font-bold text-purple-400 uppercase tracking-widest mb-2">Playlist</span>
              <h2 class="text-4xl md:text-5xl font-black text-white mb-3">Chill Vibes</h2>
              <p class="text-gray-400 mb-4">Những bài hát nhẹ nhàng để thư giãn sau một ngày dài. Perfect for rainy days & late nights.</p>
              <div class="flex items-center gap-3 text-sm text-gray-400 mb-6">
                <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-purple-500 to-pink-500 flex items-center justify-center text-xs">D</div>
                <span class="text-white font-medium">Duy Ho</span>
                <span>·</span>
                <span>24 bài hát</span>
                <span>·</span>
                <span>1 giờ 32 phút</span>
              </div>
              <div class="flex items-center gap-4">
                <button class="w-14 h-14 rounded-full bg-gradient-to-r from-purple-600 to-indigo-600 flex items-center justify-center hover:scale-110 transition-transform shadow-lg shadow-purple-500/30">
                  <span class="material-symbols-outlined text-white text-3xl">play_arrow</span>
                </button>
                <button class="p-3 text-gray-400 hover:text-white transition-colors">
                  <span class="material-symbols-outlined text-3xl">shuffle</span>
                </button>
                <button class="p-3 text-gray-400 hover:text-rose-400 transition-colors">
                  <span class="material-symbols-outlined text-2xl">favorite_border</span>
                </button>
                <button class="p-3 text-gray-400 hover:text-white transition-colors">
                  <span class="material-symbols-outlined text-2xl">more_horiz</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Track List -->
          <div class="bg-white/[0.02] border border-white/5 rounded-3xl overflow-hidden">
            <table class="w-full text-left">
              <thead>
                <tr class="border-b border-white/5">
                  <th class="px-6 py-4 text-gray-500 text-sm font-medium w-12 text-center">#</th>
                  <th class="px-4 py-4 text-gray-500 text-sm font-medium">Tiêu đề</th>
                  <th class="px-4 py-4 text-gray-500 text-sm font-medium hidden md:table-cell">Album</th>
                  <th class="px-4 py-4 text-gray-500 text-sm font-medium text-right">
                    <span class="material-symbols-outlined text-base">schedule</span>
                  </th>
                </tr>
              </thead>
              <tbody id="featured-tbody">
                <tr><td colspan="4" class="px-6 py-8 text-center text-gray-500">Loading bài hát...</td></tr>
              </tbody>
            </table>
          </div>
        </section>
      </div>

      <PlayerBar />
    </main>
  </div>

<script>
  import { apiFetch, formatDuration } from '../lib/api.js';
  import { player } from '../lib/player.js';

  const GRADS = [
    'linear-gradient(135deg,#6366f1,#8b5cf6)',
    'linear-gradient(135deg,#f43f5e,#f97316)',
    'linear-gradient(135deg,#ec4899,#7c3aed)',
    'linear-gradient(135deg,#ef4444,#d946ef)',
    'linear-gradient(135deg,#3b82f6,#06b6d4)',
    'linear-gradient(135deg,#06b6d4,#10b981)',
    'linear-gradient(135deg,#d946ef,#7c3aed)',
    'linear-gradient(135deg,#fb923c,#fb7185)',
  ];
  const grad = (id: number) => GRADS[(id - 1) % GRADS.length];

  async function loadPlaylists() {
    const token = localStorage.getItem('auth_token');
    const grid = document.getElementById('playlists-grid')!;
    const sidebar = document.getElementById('sidebar-playlists')!;
    const btn = sidebar.querySelector('button');

    if (!token) {
      grid.innerHTML = `<p class="col-span-6 text-center py-8 text-gray-400">
        <a href="/login" class="text-purple-400 hover:text-purple-300 font-semibold">Đăng nhập</a> để xem playlist.
      </p>`;
      return;
    }

    try {
      const { data: playlists } = await apiFetch('/playlists');

      // Sidebar list
      const sidebarLinks = (playlists || []).map((pl: any) => `
        <a href="#playlist-${pl.id}" class="flex items-center gap-3 px-3 py-2 text-gray-500 hover:text-white hover:bg-white/5 rounded-lg transition-all text-sm cursor-pointer">
          <div class="w-8 h-8 rounded-md flex items-center justify-center flex-shrink-0 overflow-hidden" style="background:${grad(pl.id)}">
            ${pl.cover_url ? `<img src="${pl.cover_url}" class="w-full h-full object-cover" alt=""/>` : '<span class="material-symbols-outlined text-white text-sm">queue_music</span>'}
          </div>
          <span class="truncate">${pl.name}</span>
        </a>`).join('');
      sidebar.innerHTML = sidebarLinks + (btn ? btn.outerHTML : '');

      if (!playlists?.length) {
        grid.innerHTML = '<p class="col-span-6 text-gray-500 text-sm text-center py-4">Chưa có playlist nào.</p>';
        return;
      }

      grid.innerHTML = playlists.map((pl: any) => `
        <div class="group cursor-pointer" id="playlist-${pl.id}">
          <div class="aspect-square rounded-2xl mb-3 shadow-lg relative overflow-hidden group-hover:scale-105 transition-transform" style="background:${grad(pl.id)}">
            ${pl.cover_url ? `<img src="${pl.cover_url}" class="absolute inset-0 w-full h-full object-cover" alt=""/>` : '<div class="absolute inset-0 flex items-center justify-center"><span class="material-symbols-outlined text-white/30 text-5xl">queue_music</span></div>'}
            <div class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/30 transition-all">
              <button class="w-12 h-12 rounded-full bg-green-500 hover:bg-green-400 flex items-center justify-center shadow-xl opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0 transition-all">
                <span class="material-symbols-outlined text-black">play_arrow</span>
              </button>
            </div>
          </div>
          <p class="text-white font-semibold text-sm truncate group-hover:text-purple-400">${pl.name}</p>
          <p class="text-gray-500 text-xs">${pl.description || 'Playlist'}</p>
        </div>`).join('');

      // Load first playlist's songs into featured section
      if (playlists.length > 0) {
        loadPlaylistSongs(playlists[0].id);
      }
    } catch {
      grid.innerHTML = '<p class="col-span-6 text-red-400 text-sm text-center py-4">Không thể tải playlist.</p>';
    }
  }

  async function loadPlaylistSongs(playlistId: number) {
    const tbody = document.getElementById('featured-tbody')!;
    try {
      const { data: pl } = await apiFetch(`/playlists/${playlistId}`);
      const songs = pl?.songs || [];
      if (!songs.length) {
        tbody.innerHTML = '<tr><td colspan="4" class="px-6 py-8 text-center text-gray-500">Playlist trống.</td></tr>';
        return;
      }
      tbody.innerHTML = songs.map((s: any, i: number) => {
        const cover = s.cover_url
          ? `<img src="${s.cover_url}" class="w-10 h-10 rounded-lg flex-shrink-0 object-cover" alt=""/>`
          : `<div class="w-10 h-10 rounded-lg flex-shrink-0" style="background:${grad(s.id)}"></div>`;
        return `
          <tr class="group hover:bg-white/5 transition-colors cursor-pointer border-b border-white/[0.02] last:border-none song-row" data-song="${encodeURIComponent(JSON.stringify(s))}">
            <td class="px-6 py-3 text-center">
              <span class="text-gray-500 group-hover:hidden">${i + 1}</span>
              <span class="material-symbols-outlined text-purple-400 hidden group-hover:block">play_arrow</span>
            </td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-3">
                ${cover}
                <div>
                  <p class="text-white font-medium text-sm group-hover:text-purple-400">${s.title}</p>
                  <p class="text-gray-500 text-xs">${s.artist_names || 'Unknown'}</p>
                </div>
              </div>
            </td>
            <td class="px-4 py-3 text-gray-500 text-sm hidden md:table-cell">${s.album_title || '—'}</td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-3">
                <span class="material-symbols-outlined text-gray-600 hover:text-rose-400 opacity-0 group-hover:opacity-100">favorite_border</span>
                <span class="text-gray-500 text-sm">${formatDuration(s.duration)}</span>
              </div>
            </td>
          </tr>`;
      }).join('');
    } catch {}
  }

  loadPlaylists();

  // Header "Create Playlist" button wires to Sidebar modal
  document.getElementById('header-create-pl')?.addEventListener('click', () => {
    document.getElementById('modal-new-playlist')?.classList.remove('hidden');
  });

  // Song click handler
  document.getElementById('featured-tbody')?.addEventListener('click', (e) => {
    const row = (e.target as HTMLElement).closest('.song-row') as HTMLElement;
    if (!row) return;
    try {
      const song = JSON.parse(decodeURIComponent(row.dataset.song || ''));
      const allRows = Array.from(document.querySelectorAll('#featured-tbody .song-row'));
      const queue = allRows.map(r => {
        try { return JSON.parse(decodeURIComponent((r as HTMLElement).dataset.song || '')); } catch { return null; }
      }).filter((x): x is any => x !== null);
      player.playSong(song, queue);
    } catch {}
  });
</script>

</MainLayout>
