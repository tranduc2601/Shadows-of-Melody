---
import MainLayout from "../layouts/MainLayout.astro";

const playlists = [
  { id: 1, name: "Chill Vibes", tracks: 24, duration: "1h 32m", color: "from-cyan-500 to-blue-600", icon: "🌊" },
  { id: 2, name: "Late Night Drive", tracks: 18, duration: "1h 08m", color: "from-purple-500 to-indigo-700", icon: "🚗" },
  { id: 3, name: "Morning Boost", tracks: 30, duration: "1h 55m", color: "from-orange-400 to-yellow-500", icon: "☀️" },
  { id: 4, name: "Synthwave Dreams", tracks: 15, duration: "58m", color: "from-fuchsia-500 to-pink-600", icon: "🎹" },
  { id: 5, name: "Focus Mode", tracks: 22, duration: "1h 20m", color: "from-emerald-500 to-teal-600", icon: "🎯" },
  { id: 6, name: "Party Hits", tracks: 40, duration: "2h 30m", color: "from-red-500 to-orange-500", icon: "🎉" },
];

const featuredTracks = [
  { id: 1, title: "Midnight City", artist: "M83", album: "Hurry Up", duration: "4:03", cover: "bg-gradient-to-br from-indigo-500 to-purple-500" },
  { id: 2, title: "Starboy", artist: "The Weeknd", album: "Starboy", duration: "3:50", cover: "bg-gradient-to-br from-rose-500 to-orange-500" },
  { id: 3, title: "Levitating", artist: "Dua Lipa", album: "Future Nostalgia", duration: "3:23", cover: "bg-gradient-to-br from-pink-500 to-violet-500" },
  { id: 4, title: "Blinding Lights", artist: "The Weeknd", album: "After Hours", duration: "3:20", cover: "bg-gradient-to-br from-red-500 to-fuchsia-500" },
  { id: 5, title: "Save Your Tears", artist: "The Weeknd", album: "After Hours", duration: "3:35", cover: "bg-gradient-to-br from-blue-500 to-cyan-500" },
  { id: 6, title: "Neon Blade", artist: "Synthwave Vibes", album: "Cyberpunk", duration: "4:12", cover: "bg-gradient-to-br from-cyan-500 to-emerald-500" },
  { id: 7, title: "Electric Feel", artist: "MGMT", album: "Oracular Spectacular", duration: "3:49", cover: "bg-gradient-to-br from-lime-500 to-green-600" },
  { id: 8, title: "Do I Wanna Know?", artist: "Arctic Monkeys", album: "AM", duration: "4:32", cover: "bg-gradient-to-br from-amber-500 to-red-500" },
];
---

<MainLayout title="Playlist - Shadows of Melody">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">

    <!-- Sidebar -->
    <aside class="w-64 flex-shrink-0 border-r border-white/5 bg-[#0a1229]/80 backdrop-blur-xl flex flex-col hidden md:flex z-40">
      <div class="h-20 flex items-center px-6">
        <a href="/" class="text-2xl font-black bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-purple-400 flex items-center gap-2">
          <span class="material-symbols-outlined text-purple-400 animate-pulse">music_note</span>
          Melody
        </a>
      </div>
      <div class="px-4 py-6 flex-1 overflow-y-auto">
        <p class="px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Menu</p>
        <nav class="space-y-1 mb-8">
          <a href="/" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">home</span>Home
          </a>
          <a href="/search" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">search</span>Tìm Kiếm
          </a>
          <a href="/artists" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">person</span>Nghệ Sĩ
          </a>
        </nav>
        <p class="px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Library</p>
        <nav class="space-y-1">
          <a href="#" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform text-rose-400">favorite</span>Liked Songs
          </a>
          <a href="/playlist" class="flex items-center gap-4 px-4 py-3 bg-gradient-to-r from-purple-500/20 to-transparent text-white rounded-xl font-medium transition-all shadow-[inset_2px_0_0_0_rgba(168,85,247,1)]">
            <span class="material-symbols-outlined text-purple-400">queue_music</span>Playlists
          </a>
        </nav>

        <!-- Playlist list in sidebar -->
        <div class="mt-6 space-y-1 pl-2">
          {playlists.map(pl => (
            <a href={`#playlist-${pl.id}`} class="flex items-center gap-3 px-3 py-2 text-gray-500 hover:text-white hover:bg-white/5 rounded-lg transition-all text-sm group cursor-pointer">
              <div class={`w-8 h-8 rounded-md bg-gradient-to-br ${pl.color} text-sm flex items-center justify-center flex-shrink-0`}>{pl.icon}</div>
              <span class="truncate">{pl.name}</span>
            </a>
          ))}
          <button class="flex items-center gap-3 px-3 py-2 text-gray-500 hover:text-white w-full rounded-lg hover:bg-white/5 transition-all text-sm mt-2">
            <span class="w-8 h-8 rounded-md border border-dashed border-white/20 flex items-center justify-center">
              <span class="material-symbols-outlined text-base">add</span>
            </span>
            Tạo Playlist Mới
          </button>
        </div>
      </div>
      <div class="p-4 border-t border-white/5">
        <div class="flex items-center gap-3 p-2 rounded-xl hover:bg-white/5 cursor-pointer transition-colors">
          <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-purple-500 to-pink-500 p-[2px]">
            <div class="w-full h-full rounded-full bg-[#0a1229] flex items-center justify-center">
              <span class="material-symbols-outlined text-purple-400">person</span>
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-white truncate">Duy Ho</p>
            <p class="text-xs text-purple-400 font-medium">Premium</p>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col overflow-hidden bg-gradient-to-br from-[#0c1328] via-[#060e20] to-[#040813] relative">
      <div class="absolute top-0 left-0 w-full h-80 bg-gradient-to-b from-purple-900/30 to-transparent pointer-events-none"></div>

      <!-- Header -->
      <header class="h-20 flex-shrink-0 flex items-center justify-between px-8 relative z-10">
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-bold text-white">Thư Viện Playlist</h1>
        </div>
        <button class="flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-full transition-all hover:scale-105 shadow-lg shadow-purple-500/25">
          <span class="material-symbols-outlined">add</span>
          Tạo playlist
        </button>
      </header>

      <div class="flex-1 overflow-y-auto px-8 pb-32 relative z-10">

        <!-- Playlist Grid -->
        <section class="mb-12">
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
            {playlists.map(pl => (
              <div class="group cursor-pointer" id={`playlist-${pl.id}`}>
                <div class={`aspect-square rounded-2xl bg-gradient-to-br ${pl.color} mb-3 shadow-lg relative overflow-hidden group-hover:scale-105 transition-transform`}>
                  <div class="absolute inset-0 flex items-center justify-center text-5xl">
                    {pl.icon}
                  </div>
                  <div class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/30 transition-all">
                    <button class="w-12 h-12 rounded-full bg-green-500 hover:bg-green-400 flex items-center justify-center shadow-xl opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-all">
                      <span class="material-symbols-outlined text-black">play_arrow</span>
                    </button>
                  </div>
                </div>
                <p class="text-white font-semibold text-sm truncate group-hover:text-purple-400 transition-colors">{pl.name}</p>
                <p class="text-gray-500 text-xs">{pl.tracks} bài · {pl.duration}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Featured Playlist Detail -->
        <section>
          <!-- Playlist Header -->
          <div class="flex flex-col md:flex-row gap-8 mb-8 p-6 bg-white/[0.02] rounded-3xl border border-white/5">
            <div class="w-48 h-48 flex-shrink-0 rounded-2xl bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center text-7xl shadow-2xl shadow-cyan-500/20">
              🌊
            </div>
            <div class="flex flex-col justify-end">
              <span class="text-xs font-bold text-purple-400 uppercase tracking-widest mb-2">Playlist</span>
              <h2 class="text-4xl md:text-5xl font-black text-white mb-3">Chill Vibes</h2>
              <p class="text-gray-400 mb-4">Những bài hát nhẹ nhàng để thư giãn sau một ngày dài. Perfect for rainy days & late nights.</p>
              <div class="flex items-center gap-3 text-sm text-gray-400 mb-6">
                <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-purple-500 to-pink-500 flex items-center justify-center text-xs">D</div>
                <span class="text-white font-medium">Duy Ho</span>
                <span>·</span>
                <span>24 bài hát</span>
                <span>·</span>
                <span>1 giờ 32 phút</span>
              </div>
              <div class="flex items-center gap-4">
                <button class="w-14 h-14 rounded-full bg-gradient-to-r from-purple-600 to-indigo-600 flex items-center justify-center hover:scale-110 transition-transform shadow-lg shadow-purple-500/30">
                  <span class="material-symbols-outlined text-white text-3xl">play_arrow</span>
                </button>
                <button class="p-3 text-gray-400 hover:text-white transition-colors">
                  <span class="material-symbols-outlined text-3xl">shuffle</span>
                </button>
                <button class="p-3 text-gray-400 hover:text-rose-400 transition-colors">
                  <span class="material-symbols-outlined text-2xl">favorite_border</span>
                </button>
                <button class="p-3 text-gray-400 hover:text-white transition-colors">
                  <span class="material-symbols-outlined text-2xl">more_horiz</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Track List -->
          <div class="bg-white/[0.02] border border-white/5 rounded-3xl overflow-hidden">
            <table class="w-full text-left">
              <thead>
                <tr class="border-b border-white/5">
                  <th class="px-6 py-4 text-gray-500 text-sm font-medium w-12 text-center">#</th>
                  <th class="px-4 py-4 text-gray-500 text-sm font-medium">Tiêu đề</th>
                  <th class="px-4 py-4 text-gray-500 text-sm font-medium hidden md:table-cell">Album</th>
                  <th class="px-4 py-4 text-gray-500 text-sm font-medium text-right">
                    <span class="material-symbols-outlined text-base">schedule</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {featuredTracks.map((track, i) => (
                  <tr class="group hover:bg-white/5 transition-colors cursor-pointer border-b border-white/[0.02] last:border-none">
                    <td class="px-6 py-3 text-center">
                      <span class="text-gray-500 group-hover:hidden">{i + 1}</span>
                      <span class="material-symbols-outlined text-purple-400 hidden group-hover:block">play_arrow</span>
                    </td>
                    <td class="px-4 py-3">
                      <div class="flex items-center gap-3">
                        <div class={`w-10 h-10 rounded-lg ${track.cover} flex-shrink-0`}></div>
                        <div>
                          <p class="text-white font-medium text-sm group-hover:text-purple-400 transition-colors">{track.title}</p>
                          <p class="text-gray-500 text-xs">{track.artist}</p>
                        </div>
                      </div>
                    </td>
                    <td class="px-4 py-3 text-gray-500 text-sm hidden md:table-cell">{track.album}</td>
                    <td class="px-4 py-3 text-right">
                      <div class="flex items-center justify-end gap-3">
                        <span class="material-symbols-outlined text-gray-600 hover:text-rose-400 transition-colors opacity-0 group-hover:opacity-100">favorite_border</span>
                        <span class="text-gray-500 text-sm">{track.duration}</span>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </div>

      <!-- Player Bar -->
      <div class="h-24 flex-shrink-0 border-t border-white/5 bg-[#0a1229]/90 backdrop-blur-xl px-6 flex items-center gap-4 relative z-20">
        <div class="flex items-center gap-3 w-64">
          <div class="w-14 h-14 rounded-lg bg-gradient-to-br from-cyan-500 to-blue-600 flex-shrink-0 shadow-md text-2xl flex items-center justify-center">🌊</div>
          <div class="min-w-0">
            <p class="text-white text-sm font-semibold truncate">Chill Vibes</p>
            <p class="text-gray-400 text-xs truncate">Playlist · 24 bài</p>
          </div>
          <button class="ml-2"><span class="material-symbols-outlined text-gray-400 hover:text-rose-400 transition-colors">favorite_border</span></button>
        </div>
        <div class="flex-1 flex flex-col items-center gap-2">
          <div class="flex items-center gap-6">
            <button><span class="material-symbols-outlined text-gray-400 hover:text-white transition-colors">shuffle</span></button>
            <button><span class="material-symbols-outlined text-gray-400 hover:text-white transition-colors text-3xl">skip_previous</span></button>
            <button class="w-10 h-10 rounded-full bg-gradient-to-r from-purple-600 to-indigo-600 flex items-center justify-center hover:scale-110 transition-transform shadow-lg">
              <span class="material-symbols-outlined text-white">play_arrow</span>
            </button>
            <button><span class="material-symbols-outlined text-gray-400 hover:text-white transition-colors text-3xl">skip_next</span></button>
            <button><span class="material-symbols-outlined text-gray-400 hover:text-white transition-colors">repeat</span></button>
          </div>
          <div class="flex items-center gap-3 w-full max-w-md">
            <span class="text-xs text-gray-500">1:24</span>
            <div class="flex-1 h-1 bg-white/10 rounded-full"><div class="w-1/3 h-full bg-purple-500 rounded-full"></div></div>
            <span class="text-xs text-gray-500">4:03</span>
          </div>
        </div>
        <div class="flex items-center gap-2 w-40 justify-end">
          <span class="material-symbols-outlined text-gray-400">volume_up</span>
          <div class="flex-1 h-1 bg-white/10 rounded-full"><div class="w-3/4 h-full bg-white/60 rounded-full"></div></div>
        </div>
      </div>
    </main>
  </div>
</MainLayout>
