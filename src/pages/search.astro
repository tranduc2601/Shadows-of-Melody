---
import MainLayout from "../layouts/MainLayout.astro";

const songs = [
  { id: 1, title: "Midnight City", artist: "M83", album: "Hurry Up", duration: "4:03", plays: "1.2M", cover: "bg-gradient-to-br from-indigo-500 to-purple-500" },
  { id: 2, title: "Starboy", artist: "The Weeknd", album: "Starboy", duration: "3:50", plays: "2.5M", cover: "bg-gradient-to-br from-rose-500 to-orange-500" },
  { id: 3, title: "Levitating", artist: "Dua Lipa", album: "Future Nostalgia", duration: "3:23", plays: "1.8M", cover: "bg-gradient-to-br from-pink-500 to-violet-500" },
  { id: 4, title: "Blinding Lights", artist: "The Weeknd", album: "After Hours", duration: "3:20", plays: "3.1M", cover: "bg-gradient-to-br from-red-500 to-fuchsia-500" },
  { id: 5, title: "Save Your Tears", artist: "The Weeknd", album: "After Hours", duration: "3:35", plays: "2.1M", cover: "bg-gradient-to-br from-blue-500 to-cyan-500" },
  { id: 6, title: "Neon Blade", artist: "Synthwave Vibes", album: "Cyberpunk", duration: "4:12", plays: "890K", cover: "bg-gradient-to-br from-cyan-500 to-emerald-500" },
];

const artists = [
  { id: 1, name: "The Weeknd", genre: "R&B / Pop", followers: "45.2M", image: "bg-gradient-to-br from-red-500 to-orange-500" },
  { id: 2, name: "Dua Lipa", genre: "Pop / Dance", followers: "28.1M", image: "bg-gradient-to-br from-pink-500 to-purple-500" },
  { id: 3, name: "M83", genre: "Synthwave / Indie", followers: "12.5M", image: "bg-gradient-to-br from-indigo-500 to-blue-500" },
  { id: 4, name: "Synthwave Vibes", genre: "Synthwave", followers: "8.3M", image: "bg-gradient-to-br from-cyan-500 to-blue-500" },
  { id: 5, name: "Night City", genre: "Electronic", followers: "6.7M", image: "bg-gradient-to-br from-fuchsia-500 to-purple-600" },
  { id: 6, name: "Chill Girl", genre: "Lo-fi / Chill", followers: "5.1M", image: "bg-gradient-to-br from-orange-300 to-rose-400" },
];

const albums = [
  { id: 1, title: "After Hours", artist: "The Weeknd", year: 2020, tracks: 14, cover: "bg-gradient-to-br from-red-700 to-rose-900" },
  { id: 2, title: "Future Nostalgia", artist: "Dua Lipa", year: 2020, tracks: 11, cover: "bg-gradient-to-br from-pink-500 to-blue-500" },
  { id: 3, title: "Hurry Up, We're Dreaming", artist: "M83", year: 2011, tracks: 22, cover: "bg-gradient-to-br from-purple-500 to-indigo-700" },
  { id: 4, title: "Cyberpunk 2099", artist: "Night City", year: 2024, tracks: 12, cover: "bg-gradient-to-br from-fuchsia-500 to-cyan-500" },
  { id: 5, title: "Neon Nights", artist: "Synthwave Vibes", year: 2023, tracks: 10, cover: "bg-gradient-to-br from-cyan-400 to-blue-600" },
  { id: 6, title: "Lofi Escape", artist: "Chill Girl", year: 2024, tracks: 15, cover: "bg-gradient-to-br from-amber-400 to-orange-500" },
];

const categories = [
  { label: "Pop", color: "from-pink-500 to-rose-600", icon: "star" },
  { label: "R&B", color: "from-purple-500 to-indigo-600", icon: "music_note" },
  { label: "Electronic", color: "from-cyan-500 to-blue-600", icon: "electric_bolt" },
  { label: "Lo-fi", color: "from-orange-400 to-amber-500", icon: "coffee" },
  { label: "Synthwave", color: "from-fuchsia-500 to-purple-600", icon: "graphic_eq" },
  { label: "Indie", color: "from-emerald-500 to-teal-600", icon: "eco" },
  { label: "Hip-Hop", color: "from-red-500 to-orange-600", icon: "mic" },
  { label: "Jazz", color: "from-amber-500 to-yellow-600", icon: "piano" },
];
---

<MainLayout title="Tìm Kiếm - Shadows of Melody">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">

    <!-- Sidebar -->
    <aside class="w-64 flex-shrink-0 border-r border-white/5 bg-[#0a1229]/80 backdrop-blur-xl flex flex-col hidden md:flex z-40">
      <div class="h-20 flex items-center px-6">
        <a href="/" class="text-2xl font-black bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-purple-400 flex items-center gap-2">
          <span class="material-symbols-outlined text-purple-400 animate-pulse">music_note</span>
          Melody
        </a>
      </div>
      <div class="px-4 py-6 flex-1 overflow-y-auto">
        <p class="px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Menu</p>
        <nav class="space-y-1 mb-8">
          <a href="/" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">home</span>Home
          </a>
          <a href="/search" class="flex items-center gap-4 px-4 py-3 bg-gradient-to-r from-purple-500/20 to-transparent text-white rounded-xl font-medium transition-all shadow-[inset_2px_0_0_0_rgba(168,85,247,1)]">
            <span class="material-symbols-outlined text-purple-400">search</span>Tìm Kiếm
          </a>
          <a href="/artists" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">person</span>Nghệ Sĩ
          </a>
        </nav>
        <p class="px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Library</p>
        <nav class="space-y-1">
          <a href="#" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform text-rose-400">favorite</span>Liked Songs
          </a>
          <a href="/playlist" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">queue_music</span>Playlists
          </a>
        </nav>
      </div>
      <div class="p-4 border-t border-white/5">
        <div class="flex items-center gap-3 p-2 rounded-xl hover:bg-white/5 cursor-pointer transition-colors group">
          <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-purple-500 to-pink-500 p-[2px]">
            <div class="w-full h-full rounded-full bg-[#0a1229] flex items-center justify-center">
              <span class="material-symbols-outlined text-purple-400">person</span>
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-white truncate">Duy Ho</p>
            <p class="text-xs text-purple-400 font-medium">Premium</p>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main -->
    <main class="flex-1 flex flex-col overflow-hidden bg-gradient-to-br from-[#0c1328] via-[#060e20] to-[#040813]">
      <div class="absolute top-[-10%] left-[20%] w-[50%] h-[50%] bg-purple-600/10 blur-[150px] rounded-full pointer-events-none"></div>

      <!-- Search Header -->
      <header class="h-24 flex-shrink-0 flex flex-col justify-center px-8 relative z-10 gap-4">
        <div class="relative w-full max-w-2xl group">
          <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-purple-400 transition-colors text-2xl">search</span>
          <input
            id="searchInput"
            type="text"
            placeholder="Tìm kiếm bài hát, nghệ sĩ, albums..."
            class="w-full bg-white/5 border border-white/10 text-white placeholder-gray-500 rounded-full py-3 pl-12 pr-6 focus:outline-none focus:ring-2 focus:ring-purple-500/50 focus:bg-white/10 transition-all text-lg"
          />
        </div>
      </header>

      <div class="flex-1 overflow-y-auto px-8 pb-32 relative z-10">

        <!-- Default: Browse Categories -->
        <div id="browseSection">
          <h2 class="text-xl font-bold text-white mb-6">Duyệt theo thể loại</h2>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
            {categories.map(cat => (
              <div class={`bg-gradient-to-br ${cat.color} rounded-2xl p-5 cursor-pointer hover:scale-105 transition-transform relative overflow-hidden h-28`}>
                <span class="text-white font-bold text-lg">{cat.label}</span>
                <span class="material-symbols-outlined absolute right-4 bottom-4 text-white/30 text-5xl">{cat.icon}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Search Results (hidden by default, shown on search) -->
        <div id="searchResults" class="hidden">
          <!-- Tabs -->
          <div class="flex gap-2 mb-8 border-b border-white/10 pb-0">
            {["Tất cả", "Bài Hát", "Nghệ Sĩ", "Albums"].map((tab, i) => (
              <button
                class={`search-tab px-5 py-2.5 font-semibold text-sm rounded-t-lg border-b-2 transition-all cursor-pointer ${i === 0 ? "text-white border-purple-500 bg-purple-500/10" : "text-gray-400 border-transparent hover:text-white"}`}
                data-tab={tab.toLowerCase().replace(" ", "-")}
              >
                {tab}
              </button>
            ))}
          </div>

          <!-- Songs Section -->
          <div id="tab-tat-ca" class="tab-content">
            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <span class="material-symbols-outlined text-purple-400">music_note</span>Bài Hát Nổi Bật
            </h3>
            <div class="space-y-2 mb-10">
              {songs.map((song, i) => (
                <div class="flex items-center gap-4 p-3 rounded-xl hover:bg-white/5 cursor-pointer group transition-colors">
                  <span class="w-6 text-center text-gray-500 text-sm group-hover:hidden">{i + 1}</span>
                  <span class="material-symbols-outlined text-purple-400 w-6 text-center hidden group-hover:block text-sm">play_arrow</span>
                  <div class={`w-12 h-12 rounded-lg ${song.cover} flex-shrink-0 shadow-md group-hover:scale-105 transition-transform`}></div>
                  <div class="flex-1 min-w-0">
                    <p class="text-white font-medium truncate group-hover:text-purple-300 transition-colors">{song.title}</p>
                    <p class="text-gray-400 text-sm truncate">{song.artist} · {song.album}</p>
                  </div>
                  <span class="text-gray-500 text-sm hidden sm:block">{song.plays}</span>
                  <button class="opacity-0 group-hover:opacity-100 transition-opacity">
                    <span class="material-symbols-outlined text-gray-400 hover:text-white">favorite_border</span>
                  </button>
                  <span class="text-gray-500 text-sm">{song.duration}</span>
                </div>
              ))}
            </div>

            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <span class="material-symbols-outlined text-purple-400">person</span>Nghệ Sĩ
            </h3>
            <div class="flex gap-4 overflow-x-auto pb-4 mb-10">
              {artists.slice(0, 4).map(artist => (
                <a href="/artists" class="flex-shrink-0 text-center group cursor-pointer">
                  <div class={`w-24 h-24 rounded-full ${artist.image} mx-auto mb-2 shadow-lg group-hover:scale-110 group-hover:shadow-purple-500/30 transition-all`}></div>
                  <p class="text-white text-sm font-medium group-hover:text-purple-400 transition-colors">{artist.name}</p>
                  <p class="text-gray-500 text-xs">{artist.genre}</p>
                </a>
              ))}
            </div>

            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <span class="material-symbols-outlined text-purple-400">album</span>Albums
            </h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
              {albums.slice(0, 6).map(album => (
                <div class="group cursor-pointer">
                  <div class={`aspect-square rounded-xl ${album.cover} mb-2 shadow-lg group-hover:scale-105 transition-transform relative overflow-hidden`}>
                    <div class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/30 transition-all">
                      <span class="material-symbols-outlined text-white text-4xl opacity-0 group-hover:opacity-100 transition-opacity">play_circle</span>
                    </div>
                  </div>
                  <p class="text-white text-sm font-medium truncate group-hover:text-purple-400 transition-colors">{album.title}</p>
                  <p class="text-gray-500 text-xs truncate">{album.artist} · {album.year}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Player Bar -->
      <div class="h-24 flex-shrink-0 border-t border-white/5 bg-[#0a1229]/90 backdrop-blur-xl px-6 flex items-center gap-4 relative z-20">
        <div class="flex items-center gap-3 w-64">
          <div class="w-14 h-14 rounded-lg bg-gradient-to-br from-purple-500 to-indigo-500 flex-shrink-0 shadow-md"></div>
          <div class="min-w-0">
            <p class="text-white text-sm font-semibold truncate">Midnight City</p>
            <p class="text-gray-400 text-xs truncate">M83</p>
          </div>
          <button class="ml-2"><span class="material-symbols-outlined text-gray-400 hover:text-rose-400 transition-colors">favorite_border</span></button>
        </div>
        <div class="flex-1 flex flex-col items-center gap-2">
          <div class="flex items-center gap-6">
            <button><span class="material-symbols-outlined text-gray-400 hover:text-white transition-colors">shuffle</span></button>
            <button><span class="material-symbols-outlined text-gray-400 hover:text-white transition-colors text-3xl">skip_previous</span></button>
            <button class="w-10 h-10 rounded-full bg-gradient-to-r from-purple-600 to-indigo-600 flex items-center justify-center hover:scale-110 transition-transform shadow-lg">
              <span class="material-symbols-outlined text-white">play_arrow</span>
            </button>
            <button><span class="material-symbols-outlined text-gray-400 hover:text-white transition-colors text-3xl">skip_next</span></button>
            <button><span class="material-symbols-outlined text-gray-400 hover:text-white transition-colors">repeat</span></button>
          </div>
          <div class="flex items-center gap-3 w-full max-w-md">
            <span class="text-xs text-gray-500">1:24</span>
            <div class="flex-1 h-1 bg-white/10 rounded-full"><div class="w-1/3 h-full bg-purple-500 rounded-full"></div></div>
            <span class="text-xs text-gray-500">4:03</span>
          </div>
        </div>
        <div class="flex items-center gap-2 w-40 justify-end">
          <span class="material-symbols-outlined text-gray-400">volume_up</span>
          <div class="flex-1 h-1 bg-white/10 rounded-full"><div class="w-3/4 h-full bg-white/60 rounded-full"></div></div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('searchInput') as HTMLInputElement;
    const browseSection = document.getElementById('browseSection');
    const searchResults = document.getElementById('searchResults');

    input?.addEventListener('input', () => {
      if (input.value.trim().length > 0) {
        browseSection?.classList.add('hidden');
        searchResults?.classList.remove('hidden');
      } else {
        browseSection?.classList.remove('hidden');
        searchResults?.classList.add('hidden');
      }
    });
  </script>
</MainLayout>
