---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import PlayerBar from "../components/PlayerBar.astro";
---

<MainLayout title="Tìm Kiếm - Shadows of Melody">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">

    <Sidebar currentPage="search" />

    <!-- Main -->
    <main class="flex-1 flex flex-col overflow-hidden bg-gradient-to-br from-[#0c1328] via-[#060e20] to-[#040813]">
      <div class="absolute top-[-10%] left-[20%] w-[50%] h-[50%] bg-purple-600/10 blur-[150px] rounded-full pointer-events-none"></div>

      <!-- Search Header -->
      <header class="h-24 flex-shrink-0 flex flex-col justify-center px-8 relative z-10 gap-4">
        <div class="relative w-full max-w-2xl group">
          <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-purple-400 transition-colors text-2xl">search</span>
          <input
            id="searchInput"
            type="text"
            placeholder="Search for songs, artists, and albums..."
            class="w-full bg-white/5 border border-white/10 text-white placeholder-gray-500 rounded-full py-3 pl-12 pr-6 focus:outline-none focus:ring-2 focus:ring-purple-500/50 focus:bg-white/10 transition-all text-lg"
          />
        </div>
      </header>

      <div class="flex-1 overflow-y-auto px-8 pb-32 relative z-10">

        <!-- Default: Browse Categories -->
        <div id="browseSection">
          <h2 class="text-xl font-bold text-white mb-6">Browse by category</h2>
          <div id="categoriesGrid" class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
            <!-- Populated dynamically by JS -->
          </div>
        </div>

        <!-- Search Results (hidden by default, shown on search) -->
        <div id="searchResults" class="hidden">
          <!-- Tabs -->
          <div class="flex gap-2 mb-8 border-b border-white/10 pb-0">
            {["Tất cả", "Bài Hát", "Nghệ Sĩ", "Albums"].map((tab, i) => (
              <button
                class={`search-tab px-5 py-2.5 font-semibold text-sm rounded-t-lg border-b-2 transition-all cursor-pointer ${i === 0 ? "text-white border-purple-500 bg-purple-500/10" : "text-gray-400 border-transparent hover:text-white"}`}
                data-tab={tab.toLowerCase().replace(" ", "-")}
              >
                {tab}
              </button>
            ))}
          </div>

          <!-- Songs Section -->
          <div id="tab-tat-ca" class="tab-content">
            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <span class="material-symbols-outlined text-purple-400">music_note</span>Bài Hát Nổi Bật
            </h3>
            <div class="space-y-2 mb-10" id="search-songs">
              <p class="text-gray-500 text-sm text-center py-4">Loading...</p>
            </div>

            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <span class="material-symbols-outlined text-purple-400">person</span>Nghệ Sĩ
            </h3>
            <div class="flex gap-4 overflow-x-auto pb-4 mb-10" id="search-artists">
              <p class="text-gray-500 text-sm text-center py-4">Loading...</p>
            </div>

            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <span class="material-symbols-outlined text-purple-400">album</span>Albums
            </h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4" id="search-albums">
              <p class="col-span-6 text-gray-500 text-sm text-center py-4">Loading...</p>
            </div>
          </div>
        </div>
      </div>

      <PlayerBar />
    </main>
  </div>

  <script>
    import { apiFetch, formatDuration, formatCount } from '../lib/api.js';
    import { player } from '../lib/player.js';

    const GRADS = [
      'linear-gradient(135deg,#6366f1,#8b5cf6)',
      'linear-gradient(135deg,#f43f5e,#f97316)',
      'linear-gradient(135deg,#ec4899,#7c3aed)',
      'linear-gradient(135deg,#ef4444,#d946ef)',
      'linear-gradient(135deg,#3b82f6,#06b6d4)',
      'linear-gradient(135deg,#06b6d4,#10b981)',
      'linear-gradient(135deg,#d946ef,#7c3aed)',
      'linear-gradient(135deg,#fb923c,#fb7185)',
    ];
    const grad = (id: number) => GRADS[(id - 1) % GRADS.length];

    const input = document.getElementById('searchInput') as HTMLInputElement;
    const browseSection = document.getElementById('browseSection');
    const searchResults = document.getElementById('searchResults');

    let allArtists: any[] = [];
    let allAlbums: any[] = [];

    const CAT_COLORS = [
      'linear-gradient(135deg,#ec4899,#e11d48)',
      'linear-gradient(135deg,#a855f7,#4f46e5)',
      'linear-gradient(135deg,#06b6d4,#2563eb)',
      'linear-gradient(135deg,#fb923c,#f59e0b)',
      'linear-gradient(135deg,#d946ef,#7c3aed)',
      'linear-gradient(135deg,#10b981,#0d9488)',
      'linear-gradient(135deg,#ef4444,#ea580c)',
      'linear-gradient(135deg,#f59e0b,#eab308)',
      'linear-gradient(135deg,#6366f1,#8b5cf6)',
      'linear-gradient(135deg,#3b82f6,#06b6d4)',
    ];
    const CAT_ICONS = ['star','music_note','electric_bolt','coffee','graphic_eq','eco','mic','piano','headphones','radio'];

    async function loadCategories() {
      const grid = document.getElementById('categoriesGrid');
      if (!grid) return;
      try {
        const { data: genres } = await apiFetch('/songs/genres');
        if (!genres?.length) return;
        grid.innerHTML = genres.map((g: any, i: number) => `
          <div class="rounded-2xl p-5 cursor-pointer hover:scale-105 transition-transform relative overflow-hidden h-28 genre-card"
               data-genre-id="${g.id}" data-genre-name="${g.name}"
               style="background:${CAT_COLORS[i % CAT_COLORS.length]}">
            <span class="text-white font-bold text-lg">${g.name}</span>
            <span class="material-symbols-outlined absolute right-4 bottom-4 text-white/30 text-5xl">${CAT_ICONS[i % CAT_ICONS.length]}</span>
          </div>`).join('');
      } catch {}
    }

    // Preload artists and albums
    async function preload() {
      try {
        const [ar, al] = await Promise.all([
          apiFetch('/artists?limit=100'),
          apiFetch('/albums?limit=100'),
        ]);
        allArtists = ar.data || [];
        allAlbums = al.data || [];
      } catch {}
    }

    function renderSongs(songs: any[]) {
      const el = document.getElementById('search-songs');
      if (!el) return;
      if (!songs.length) { el.innerHTML = '<p class="text-gray-500 text-sm text-center py-4">Không tìm thấy bài hát.</p>'; return; }
      el.innerHTML = songs.map((s, i) => {
        const cover = s.cover_url
          ? `<img src="${s.cover_url}" class="w-12 h-12 rounded-lg flex-shrink-0 shadow-md object-cover" alt=""/>`
          : `<div class="w-12 h-12 rounded-lg flex-shrink-0 shadow-md" style="background:${grad(s.id)}"></div>`;
        return `
          <div class="flex items-center gap-4 p-3 rounded-xl hover:bg-white/5 cursor-pointer group transition-colors song-row" data-song="${encodeURIComponent(JSON.stringify(s))}">
            <span class="w-6 text-center text-gray-500 text-sm group-hover:hidden">${i + 1}</span>
            <span class="material-symbols-outlined text-purple-400 w-6 text-center hidden group-hover:block text-sm">play_arrow</span>
            ${cover}
            <div class="flex-1 min-w-0">
              <p class="text-white font-medium truncate group-hover:text-purple-300">${s.title}</p>
              <p class="text-gray-400 text-sm truncate">${s.artist_names || 'Unknown'}${s.album_title ? ' · ' + s.album_title : ''}</p>
            </div>
            <span class="text-gray-500 text-sm hidden sm:block">${formatCount(s.plays_count)}</span>
            <span class="text-gray-500 text-sm">${formatDuration(s.duration)}</span>
          </div>`;
      }).join('');
    }

    function renderArtists(artists: any[]) {
      const el = document.getElementById('search-artists');
      if (!el) return;
      if (!artists.length) { el.innerHTML = '<p class="text-gray-500 text-sm">Không tìm thấy nghệ sĩ.</p>'; return; }
      el.innerHTML = artists.slice(0, 6).map(a => {
        const img = a.image_url
          ? `<img src="${a.image_url}" class="w-full h-full object-cover" alt=""/>`
          : '';
        return `
          <a href="/artists" class="flex-shrink-0 text-center group cursor-pointer">
            <div class="w-24 h-24 rounded-full mx-auto mb-2 shadow-lg overflow-hidden group-hover:scale-110 transition-all" style="background:${grad(a.id)}">${img}</div>
            <p class="text-white text-sm font-medium group-hover:text-purple-400">${a.name}</p>
            <p class="text-gray-500 text-xs">${formatCount(a.followers_count)} người theo dõi</p>
          </a>`;
      }).join('');
    }

    function renderAlbums(albums: any[]) {
      const el = document.getElementById('search-albums');
      if (!el) return;
      if (!albums.length) { el.innerHTML = '<p class="col-span-6 text-gray-500 text-sm text-center py-4">Không tìm thấy album.</p>'; return; }
      el.innerHTML = albums.slice(0, 6).map(al => {
        const year = al.release_date ? new Date(al.release_date).getFullYear() : '';
        const cover = al.cover_url
          ? `<img src="${al.cover_url}" class="absolute inset-0 w-full h-full object-cover" alt=""/>`
          : '';
        return `
          <div class="group cursor-pointer">
            <div class="aspect-square rounded-xl mb-2 shadow-lg relative overflow-hidden group-hover:scale-105 transition-transform" style="background:${grad(al.id)}">
              ${cover}
              <div class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/30 transition-all">
                <span class="material-symbols-outlined text-white text-4xl opacity-0 group-hover:opacity-100">play_circle</span>
              </div>
            </div>
            <p class="text-white text-sm font-medium truncate group-hover:text-purple-400">${al.title}</p>
            <p class="text-gray-500 text-xs truncate">${year}</p>
          </div>`;
      }).join('');
    }

    let searchTimer: ReturnType<typeof setTimeout>;

    input?.addEventListener('input', () => {
      const q = input.value.trim();
      if (q.length > 0) {
        browseSection?.classList.add('hidden');
        searchResults?.classList.remove('hidden');

        clearTimeout(searchTimer);
        searchTimer = setTimeout(async () => {
          // Search songs
          try {
            const { data: songs } = await apiFetch(`/songs/search?q=${encodeURIComponent(q)}`);
            renderSongs(songs || []);
          } catch {
            renderSongs([]);
          }
          // Filter artists & albums client-side
          const ql = q.toLowerCase();
          renderArtists(allArtists.filter(a => a.name.toLowerCase().includes(ql)));
          renderAlbums(allAlbums.filter(a => a.title.toLowerCase().includes(ql)));
        }, 300);
      } else {
        browseSection?.classList.remove('hidden');
        searchResults?.classList.add('hidden');
      }
    });

    preload();
    loadCategories();

    // Genre category click → filter songs by genre
    document.getElementById('categoriesGrid')?.addEventListener('click', async (e) => {
      const card = (e.target as HTMLElement).closest('.genre-card') as HTMLElement | null;
      if (!card) return;
      const genreId = card.dataset.genreId;
      const genreName = card.dataset.genreName || 'Genre';
      if (!genreId) return;

      browseSection?.classList.add('hidden');
      searchResults?.classList.remove('hidden');

      const songsEl = document.getElementById('search-songs');
      const artistsEl = document.getElementById('search-artists');
      const albumsEl = document.getElementById('search-albums');
      if (songsEl) songsEl.innerHTML = '<p class="text-gray-500 text-sm text-center py-4">Loading...</p>';

      // Update input placeholder
      if (input) input.value = '';

      try {
        const { data: songs } = await apiFetch(`/songs/by-genre/${genreId}?limit=30`);
        // Show genre header
        const header = document.querySelector('#tab-tat-ca h3') as HTMLElement;
        if (header) header.innerHTML = `<span class="material-symbols-outlined text-purple-400">music_note</span>${genreName}`;
        renderSongs(songs || []);
        if (artistsEl) artistsEl.innerHTML = '';
        if (albumsEl) albumsEl.innerHTML = '';
      } catch {
        renderSongs([]);
      }
    });

    // Song click handler (delegated)
    document.getElementById('search-songs')?.addEventListener('click', (e) => {
      const row = (e.target as HTMLElement).closest('.song-row') as HTMLElement;
      if (!row) return;
      try {
        const song = JSON.parse(decodeURIComponent(row.dataset.song || ''));
        const allRows = Array.from(document.querySelectorAll('#search-songs .song-row'));
        const queue = allRows.map(r => {
          try { return JSON.parse(decodeURIComponent((r as HTMLElement).dataset.song || '')); } catch { return null; }
        }).filter(Boolean);
        player.playSong(song, queue);
      } catch {}
    });
  </script>
</MainLayout>
