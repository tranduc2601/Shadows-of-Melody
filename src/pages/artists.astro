---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import PlayerBar from "../components/PlayerBar.astro";
---

<MainLayout title="Nghệ Sĩ - Shadows of Melody">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">

    <Sidebar currentPage="artists" />

    <!-- Main -->
    <main class="flex-1 flex flex-col overflow-hidden bg-linear-to-br from-[#0c1328] via-[#060e20] to-[#040813] relative">

      <!-- Artist Hero Banner -->
      <div class="relative shrink-0 h-72 overflow-hidden">
        <!-- Background -->
        <div id="hero-bg" class="absolute inset-0 opacity-60" style="background:linear-gradient(135deg,#f43f5e,#f97316)"></div>
        <div class="absolute inset-0 bg-linear-to-b from-transparent via-black/30 to-[#060e20]"></div>

        <!-- Nav Arrows -->
        <header class="absolute top-0 left-0 right-0 h-16 flex items-center px-8 z-10">
          <div class="flex items-center gap-2">
            <button class="w-9 h-9 rounded-full bg-black/30 backdrop-blur-md flex items-center justify-center hover:bg-black/50 transition-colors">
              <span class="material-symbols-outlined text-white text-xl">arrow_back_ios_new</span>
            </button>
            <button class="w-9 h-9 rounded-full bg-black/30 backdrop-blur-md flex items-center justify-center hover:bg-black/50 transition-colors opacity-50">
              <span class="material-symbols-outlined text-white text-xl">arrow_forward_ios</span>
            </button>
          </div>
        </header>

        <!-- Artist Info -->
        <div class="absolute bottom-0 left-0 right-0 px-8 pb-6 z-10">
          <div class="flex items-end gap-6">
            <div id="hero-avatar" class="w-28 h-28 rounded-full shrink-0 border-4 border-white/10 shadow-2xl overflow-hidden" style="background:linear-gradient(135deg,#f43f5e,#f97316)"></div>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="flex items-center gap-1 text-xs text-blue-400 font-semibold">
                  <span class="material-symbols-outlined text-sm">verified</span>Verified Artist
                </span>
              </div>
              <h1 id="hero-name" class="text-5xl font-black text-white drop-shadow-xl">—</h1>
              <p id="hero-monthly" class="text-gray-300 mt-1">— người nghe hàng tháng</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Scrollable area -->
      <div class="flex-1 overflow-y-auto px-8 pb-32 relative z-10">

        <!-- Action Buttons -->
        <div class="flex items-center gap-4 py-6">
          <button class="w-14 h-14 rounded-full bg-linear-to-r from-purple-600 to-indigo-600 flex items-center justify-center hover:scale-110 transition-transform shadow-lg shadow-purple-500/30">
            <span class="material-symbols-outlined text-white text-3xl">play_arrow</span>
          </button>
          <button class="px-6 py-2.5 border-2 border-white/30 text-white font-semibold rounded-full hover:border-white transition-colors text-sm">
           Followed
          </button>
          <button class="p-2 text-gray-400 hover:text-white transition-colors">
            <span class="material-symbols-outlined text-2xl">more_horiz</span>
          </button>
          <div class="ml-auto flex items-center gap-2 text-sm text-gray-400">
            <span class="material-symbols-outlined text-purple-400">people</span>
            <span id="hero-followers">—</span>
          </div>
        </div>

        <!-- Top Tracks -->
        <section class="mb-10">
          <h2 class="text-xl font-bold text-white mb-4">Most Popular</h2>
          <div class="space-y-1" id="top-tracks">
            <p class="text-gray-500 text-sm text-center py-4">Loading...</p>
          </div>
        </section>

        <!-- Albums -->
        <section class="mb-10">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold text-white">Albums</h2>
            <button class="text-sm font-semibold text-purple-400 hover:text-purple-300 uppercase tracking-wider">See all</button>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4" id="albums-grid">
            <p class="col-span-4 text-gray-500 text-sm text-center py-4">Loading...</p>
          </div>
        </section>

        <!-- All Artists -->
        <section>
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold text-white">All Artists</h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="artists-grid">
            <p class="col-span-4 text-gray-500 text-sm text-center py-4">Loading...</p>
          </div>
        </section>
      </div>

      <PlayerBar />
    </main>
  </div>

<script>
  import { apiFetch, formatCount, formatDuration } from '../lib/api.js';
  import { player } from '../lib/player.js';

  const GRADS = [
    'linear-gradient(135deg,#6366f1,#8b5cf6)',
    'linear-gradient(135deg,#f43f5e,#f97316)',
    'linear-gradient(135deg,#ec4899,#7c3aed)',
    'linear-gradient(135deg,#ef4444,#d946ef)',
    'linear-gradient(135deg,#3b82f6,#06b6d4)',
    'linear-gradient(135deg,#06b6d4,#10b981)',
    'linear-gradient(135deg,#d946ef,#7c3aed)',
    'linear-gradient(135deg,#fb923c,#fb7185)',
  ];
  const grad = (id: number) => GRADS[(id - 1) % GRADS.length];

  async function loadArtists() {
    const [artistsRes, songsRes, albumsRes] = await Promise.allSettled([
      apiFetch('/artists?limit=20'),
      apiFetch('/songs?limit=10'),
      apiFetch('/albums?limit=8'),
    ]);

    const artists: any[] = artistsRes.status === 'fulfilled' ? (artistsRes.value.data || []) : [];
    const songs: any[] = songsRes.status === 'fulfilled' ? (songsRes.value.data || []) : [];
    const albums: any[] = albumsRes.status === 'fulfilled' ? (albumsRes.value.data || []) : [];

    // Featured artist (first one)
    if (artists.length > 0) {
      const f = artists[0];
      const g = grad(f.id);
      (document.getElementById('hero-bg') as HTMLElement).style.background = g;
      const avatar = document.getElementById('hero-avatar') as HTMLElement;
      avatar.style.background = g;
      if (f.image_url) avatar.innerHTML = `<img src="${f.image_url}" class="w-full h-full object-cover" alt=""/>`;
      (document.getElementById('hero-name') as HTMLElement).textContent = f.name;
      (document.getElementById('hero-monthly') as HTMLElement).textContent = `${formatCount(f.followers_count)} người nghe hàng tháng`;
      (document.getElementById('hero-followers') as HTMLElement).textContent = `${formatCount(f.followers_count)} người theo dõi`;
    }

    // Top tracks (from songs)
    const tracksEl = document.getElementById('top-tracks');
    if (tracksEl) {
      if (!songs.length) {
        tracksEl.innerHTML = '<p class="text-gray-500 text-sm text-center py-4">No songs available.</p>';
      } else {
        tracksEl.innerHTML = songs.slice(0, 5).map((s, i) => {
          const cover = s.cover_url
            ? `<img src="${s.cover_url}" class="w-12 h-12 rounded-lg shrink-0 shadow-md object-cover" alt=""/>`
            : `<div class="w-12 h-12 rounded-lg shrink-0 shadow-md" style="background:${grad(s.id)}"></div>`;
          return `
            <div class="flex items-center gap-4 p-3 rounded-xl hover:bg-white/5 cursor-pointer group transition-colors song-row" data-song="${encodeURIComponent(JSON.stringify(s))}">
              <span class="w-6 text-center text-gray-500 text-sm group-hover:hidden">${i + 1}</span>
              <span class="material-symbols-outlined text-purple-400 w-6 hidden group-hover:block text-sm">play_arrow</span>
              ${cover}
              <div class="flex-1 min-w-0">
                <p class="text-white font-medium truncate group-hover:text-purple-300">${s.title}</p>
                <p class="text-gray-500 text-sm">${formatCount(s.plays_count)} listens</p>
              </div>
              <span class="material-symbols-outlined text-gray-600 hover:text-rose-400 opacity-0 group-hover:opacity-100">favorite_border</span>
              <span class="text-gray-500 text-sm">${formatDuration(s.duration)}</span>
            </div>`;
        }).join('');
      }
    }

    // Albums
    const albumsEl = document.getElementById('albums-grid');
    if (albumsEl) {
      if (!albums.length) {
        albumsEl.innerHTML = '<p class="col-span-4 text-gray-500 text-sm text-center py-4">No albums available.</p>';
      } else {
        albumsEl.innerHTML = albums.slice(0, 4).map(al => {
          const year = al.release_date ? new Date(al.release_date).getFullYear() : '';
          const cover = al.cover_url ? `<img src="${al.cover_url}" class="absolute inset-0 w-full h-full object-cover" alt=""/>` : '';
          return `
            <div class="group cursor-pointer">
              <div class="aspect-square rounded-2xl mb-3 shadow-lg relative overflow-hidden group-hover:scale-105 transition-transform" style="background:${grad(al.id)}">
                ${cover}
                <div class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/30 transition-all">
                  <span class="material-symbols-outlined text-white text-4xl opacity-0 group-hover:opacity-100">play_circle</span>
                </div>
              </div>
              <p class="text-white font-semibold text-sm truncate group-hover:text-purple-400">${al.title}</p>
              <p class="text-gray-500 text-xs">${year} · Album</p>
            </div>`;
        }).join('');
      }
    }

    // All artists grid
    const artistsEl = document.getElementById('artists-grid');
    if (artistsEl) {
      if (!artists.length) {
        artistsEl.innerHTML = '<p class="col-span-4 text-gray-500 text-sm text-center py-4">No artists available.</p>';
      } else {
        artistsEl.innerHTML = artists.map(a => {
          const img = a.image_url ? `<img src="${a.image_url}" class="w-full h-full object-cover" alt=""/>` : '';
          return `
            <div class="bg-white/3 border border-white/5 rounded-2xl p-5 hover:bg-white/6 transition-all cursor-pointer group">
              <div class="flex items-center gap-4 mb-4">
                <div class="w-16 h-16 rounded-full shrink-0 shadow-lg overflow-hidden group-hover:scale-110 transition-transform" style="background:${grad(a.id)}">${img}</div>
                <div class="min-w-0">
                  <p class="text-white font-semibold truncate group-hover:text-purple-400">${a.name}</p>
                  <p class="text-gray-500 text-xs truncate">${formatCount(a.followers_count)} người theo dõi</p>
                </div>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs text-gray-500">${formatCount(a.followers_count)} người theo dõi</span>
                <button class="px-4 py-1.5 rounded-full text-xs font-semibold border border-white/20 text-gray-300 hover:border-white hover:text-white transition-all">
                  Follow
                </button>
              </div>
            </div>`;
        }).join('');
      }
    }
  }

  loadArtists().catch(console.error);

  // Song click handler
  document.getElementById('top-tracks')?.addEventListener('click', (e) => {
    const row = (e.target as HTMLElement).closest('.song-row') as HTMLElement;
    if (!row) return;
    try {
      const song = JSON.parse(decodeURIComponent(row.dataset.song || ''));
      const allRows = Array.from(document.querySelectorAll('#top-tracks .song-row'));
      const queue = allRows.map(r => {
        try { return JSON.parse(decodeURIComponent((r as HTMLElement).dataset.song || '')); } catch { return null; }
      }).filter(Boolean);
      player.playSong(song, queue);
    } catch {}
  });
</script>

</MainLayout>
