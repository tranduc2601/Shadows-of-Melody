---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import PlayerBar from "../components/PlayerBar.astro";
---

<MainLayout title="Artists - Shadows of Melody">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">
    <Sidebar currentPage="artists" />

    <main class="flex-1 flex flex-col overflow-hidden bg-linear-to-br from-[#0c1328] via-[#060e20] to-[#040813] relative min-w-0">
      <div class="absolute top-0 left-0 w-[50%] h-[50%] bg-purple-900/10 blur-[150px] rounded-full pointer-events-none"></div>

      <div class="flex-1 overflow-y-auto px-4 sm:px-6 lg:px-8 pb-32 pt-8 custom-scrollbar">
        <div class="flex items-center justify-between gap-4 mb-6">
          <h1 class="text-3xl font-black text-white">Artists</h1>
          <p class="text-sm text-gray-500">Follow artists you like</p>
        </div>
        <div id="artists-list" class="space-y-2"></div>
      </div>

      <PlayerBar />
    </main>
  </div>

  <script>
    // @ts-nocheck
    import { apiFetch, formatCount } from '../lib/api.js';

    const GRADS = [
      'linear-gradient(135deg,#6366f1,#8b5cf6)',
      'linear-gradient(135deg,#f43f5e,#f97316)',
      'linear-gradient(135deg,#ec4899,#7c3aed)',
      'linear-gradient(135deg,#ef4444,#d946ef)',
      'linear-gradient(135deg,#3b82f6,#06b6d4)',
      'linear-gradient(135deg,#06b6d4,#10b981)',
      'linear-gradient(135deg,#d946ef,#7c3aed)',
      'linear-gradient(135deg,#fb923c,#fb7185)',
    ];

    const list = document.getElementById('artists-list');

    async function loadArtists() {
      const { data } = await apiFetch('/artists?limit=500');
      const artists = [...(data || [])];
      if (!list) return;
      list.innerHTML = artists.map((a) => `
        <div class="artist-row group flex items-center gap-4 px-4 py-4 rounded-2xl hover:bg-white/[0.05] transition-colors cursor-pointer" data-id="${a.id}">
          <div class="w-12 h-12 rounded-full overflow-hidden shrink-0" style="background:${GRADS[(a.id - 1) % GRADS.length]}">
            ${a.image_url ? `<img src="${a.image_url}" loading="lazy" decoding="async" class="w-full h-full object-cover" alt="${a.name}"/>` : ''}
          </div>
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-white group-hover:text-purple-300 truncate">${a.name}</p>
            <p class="text-xs text-gray-500">${formatCount(a.followers_count)} followers</p>
          </div>
          <button class="artist-follow-btn shrink-0 text-gray-400 hover:text-purple-400 transition-colors" data-id="${a.id}" data-following="${a.is_following ? '1' : '0'}">
            <span class="material-symbols-outlined">${a.is_following ? 'how_to_reg' : 'person_add'}</span>
          </button>
        </div>
      `).join('');
    }

    list?.addEventListener('click', async (e) => {
      const target = e.target;
      const follow = target instanceof HTMLElement ? target.closest('.artist-follow-btn') : null;
      if (follow) {
        e.stopPropagation();
        const id = follow.dataset.id;
        const following = follow.dataset.following === '1';
        try {
          const { data } = await apiFetch(`/artists/${id}/follow`, { method: following ? 'DELETE' : 'POST' });
          follow.dataset.following = data.is_following ? '1' : '0';
          follow.innerHTML = `<span class="material-symbols-outlined">${data.is_following ? 'how_to_reg' : 'person_add'}</span>`;
        } catch {}
        return;
      }

      const row = target instanceof HTMLElement ? target.closest('.artist-row') : null;
      if (row) window.location.href = `/artist?id=${row.dataset.id}`;
    });

    loadArtists();
  </script>
</MainLayout>
