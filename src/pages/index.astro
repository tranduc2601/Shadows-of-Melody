---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import PlayerBar from "../components/PlayerBar.astro";
---

<MainLayout title="Shadows of Melody - Home">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">
    
    <Sidebar currentPage="home" />

    <!-- Main Content -->
    <main class="flex-1 flex flex-col relative overflow-hidden bg-linear-to-br from-[#0c1328] via-[#060e20] to-[#040813]">
      <!-- Background Ambient Glow -->
      <div class="absolute top-[-10%] left-[-10%] w-[60%] h-[60%] bg-indigo-600/10 blur-[150px] rounded-full pointer-events-none"></div>
      <div class="absolute bottom-[20%] right-[-10%] w-[40%] h-[40%] bg-purple-600/10 blur-[120px] rounded-full pointer-events-none"></div>

      <!-- Header -->
      <header class="h-20 shrink-0 flex items-center justify-between px-6 lg:px-8 relative z-10 w-full transition-all duration-300">
        <!-- Mobile Menu Button -->
        <button class="md:hidden w-10 h-10 rounded-full bg-white/5 flex items-center justify-center mr-4 text-white">
           <span class="material-symbols-outlined">menu</span>
        </button>

        <div class="flex items-center gap-4 flex-1">
          <div class="hidden sm:flex items-center gap-2 text-gray-400">
            <button class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-white/10 hover:text-white transition-all backdrop-blur-md">
              <span class="material-symbols-outlined text-[20px]">arrow_back_ios_new</span>
            </button>
            <button class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-white/10 hover:text-white transition-all backdrop-blur-md opacity-50 cursor-not-allowed">
              <span class="material-symbols-outlined text-[20px]">arrow_forward_ios</span>
            </button>
          </div>

          <div class="relative w-full max-w-md sm:ml-4 group">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-purple-400 transition-colors">search</span>
            <input 
              type="text" 
              placeholder="Search for artists, songs, or podcasts..."
              class="w-full bg-white/5 border border-white/10 text-white placeholder-gray-500 rounded-full py-2.5 pl-12 pr-4 focus:outline-none focus:ring-2 focus:ring-purple-500/50 focus:bg-white/10 transition-all backdrop-blur-md shadow-inner"
            />
          </div>
        </div>

        <div class="flex items-center gap-4 ml-4">
          <!-- <button class="w-10 h-10 rounded-full bg-white/5 border border-white/5 flex items-center justify-center hover:bg-white/10 hover:text-white transition-all backdrop-blur-md relative group">
            <span class="material-symbols-outlined text-gray-300 group-hover:text-white transition-colors">notifications</span>
            <span class="absolute top-2.5 right-2.5 w-2 h-2 rounded-full bg-pink-500 shadow-[0_0_8px_rgba(236,72,153,0.8)]"></span>
          </button> -->
        </div>
      </header>

      <!-- Scrollable Content -->
      <div class="flex-1 overflow-y-auto px-6 lg:px-8 pb-32 pt-4 relative z-10 custom-scrollbar scroll-smooth">
        
        <!-- Hero Section -->
        <section class="mb-10 group cursor-pointer relative z-20">
          <div class="relative rounded-4xl overflow-hidden bg-linear-to-r from-indigo-900 to-purple-900 shadow-2xl shadow-purple-900/20 p-8 md:p-12 min-h-85 flex flex-col justify-end transition-all duration-500 hover:shadow-purple-900/40">
            <!-- Decorative abstract background for hero -->
            <div class="absolute inset-0 opacity-40 mix-blend-overlay pointer-events-none">
               <div class="absolute right-0 top-0 w-full h-full bg-[radial-gradient(circle_at_top_right,var(--tw-gradient-stops))] from-pink-500/60 via-transparent to-transparent"></div>
               <div class="absolute -bottom-24 -right-24 w-125 h-125 bg-indigo-500 rounded-full blur-[100px]"></div>
               <!-- Hexagon Grid Pattern Overlay (subtle) -->
               <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')]"></div>
            </div>
            
            <div class="relative z-10 max-w-2xl">
              <div class="flex items-center gap-3 mb-4">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-white/10 backdrop-blur-md rounded-full text-[11px] font-bold tracking-widest text-white border border-white/20 uppercase">
                     <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
                     New Release
                  </span>
                  <span class="text-sm font-medium text-purple-200">Featured Artist</span>
              </div>
              
              <h1 class="text-5xl md:text-7xl font-black text-white mb-4 tracking-tight drop-shadow-xl">Midnight<br/><span class="text-transparent bg-clip-text bg-linear-to-r from-purple-400 to-pink-300">Reverie</span></h1>
              <p class="text-lg md:text-xl text-indigo-100/80 mb-8 max-w-lg leading-relaxed font-light">Experience the ultimate sonic journey through neon-lit streets and synthwave dreams.</p>
              
              <div class="flex items-center gap-4">
                <button class="bg-linear-to-r from-purple-500 to-indigo-600 hover:from-purple-400 hover:to-indigo-500 text-white rounded-full py-3.5 px-8 font-bold flex items-center gap-2 transition-all shadow-[0_8px_30px_rgba(168,85,247,0.4)] hover:shadow-[0_8px_30px_rgba(168,85,247,0.6)]">
                  <span class="material-symbols-outlined fill-current text-[24px]">play_arrow</span>
                  Play Listen
                </button>
                <button class="bg-white/5 hover:bg-white/15 backdrop-blur-md border border-white/20 text-white rounded-full py-3.5 px-8 font-bold transition-all">
                  Follow
                </button>
              </div>
            </div>

            <!-- Absolute decorative visual (like a floating vinyl or element) -->
            <div class="absolute right-12 top-1/2 -translate-y-1/2 w-64 h-64 bg-linear-to-tr from-purple-500/20 to-pink-500/20 rounded-full blur-3xl pointer-events-none"></div>
          </div>
        </section>

        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
          
          <!-- Left Column (Trending) -->
          <div class="xl:col-span-2">
            <div class="flex items-end justify-between mb-6">
               <h2 class="text-2xl font-bold text-white flex items-center gap-2">
                  Trending Now
               </h2>
               <button id="trending-see-all" class="text-sm font-semibold text-purple-400 hover:text-purple-300 transition-colors uppercase tracking-wider">View All</button>
            </div>

            <div class="bg-white/2 border border-white/5 rounded-3xl p-3 backdrop-blur-sm">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="text-gray-400 border-b border-white/5">
                    <th class="font-medium text-sm px-4 py-3 w-12 text-center pb-4">#</th>
                    <th class="font-medium text-sm px-4 py-3 pb-4">Title</th>
                    <th class="font-medium text-sm px-4 py-3 hidden sm:table-cell pb-4 text-right pr-12">Plays</th>
                    <th class="font-medium text-sm px-4 py-3 w-20 text-center pb-4"><span class="material-symbols-outlined text-[18px]">schedule</span></th>
                  </tr>
                </thead>
                <tbody id="trending-tbody">
                  <tr><td colspan="4" class="px-4 py-8 text-center text-gray-500 text-sm">Loading...</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Right Column (Top Artists) -->
          <div>
            <div class="flex items-end justify-between mb-6">
               <h2 class="text-xl font-bold text-white">Top Artists</h2>
            </div>

            <div id="artists-grid" class="grid grid-cols-2 gap-4">
              <div class="col-span-2 text-gray-500 text-sm text-center py-4">Loading...</div>
            </div>
          </div>
        </div>

        <!-- New Releases Grid -->
        <div class="mt-14">
            <div class="flex items-end justify-between mb-6">
               <h2 class="text-2xl font-bold text-white">New Releases</h2>
               <div class="flex gap-2">
                  <button class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-colors">
                     <span class="material-symbols-outlined text-sm">arrow_back</span>
                  </button>
                  <button class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-colors">
                     <span class="material-symbols-outlined text-sm">arrow_forward</span>
                  </button>
               </div>
            </div>

            <div id="releases-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
              <div class="col-span-5 text-gray-500 text-sm text-center py-4">Loading...</div>
            </div>
        </div>

        <!-- Artist Members -->
        <div class="mt-14" id="artist-members-section">
          <div class="flex items-end justify-between mb-6">
            <h2 class="text-2xl font-bold text-white flex items-center gap-2">
              <span class="material-symbols-outlined text-purple-400">mic</span>
              Artist Members
            </h2>
          </div>
          <div id="artist-members-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-5">
            <div class="col-span-6 text-gray-500 text-sm text-center py-4">Loading...</div>
          </div>
        </div>

      </div>

      <!-- Album Detail Overlay -->
      <div id="album-overlay" class="hidden absolute inset-0 z-20 flex flex-col bg-[#060e20] overflow-hidden">
        <!-- Hero -->
        <div class="relative shrink-0 h-56 overflow-hidden">
          <div id="album-overlay-bg" class="absolute inset-0 opacity-60" style="background:linear-gradient(135deg,#6366f1,#8b5cf6)"></div>
          <div class="absolute inset-0 bg-gradient-to-b from-transparent via-black/30 to-[#060e20]"></div>
          <header class="absolute top-0 left-0 right-0 h-16 flex items-center px-8 z-10 gap-3">
            <button id="album-overlay-back" class="w-9 h-9 rounded-full bg-black/30 backdrop-blur-md flex items-center justify-center hover:bg-black/50 transition-colors">
              <span class="material-symbols-outlined text-white text-xl">arrow_back</span>
            </button>
          </header>
          <div class="absolute bottom-0 left-0 right-0 px-8 pb-5 z-10 flex items-end gap-5">
            <div id="album-overlay-cover" class="w-20 h-20 rounded-xl shrink-0 shadow-2xl overflow-hidden border border-white/10"></div>
            <div class="min-w-0">
              <p class="text-xs font-bold text-white/50 uppercase tracking-widest mb-1">Album</p>
              <h2 id="album-overlay-title" class="text-3xl font-black text-white truncate">—</h2>
              <p id="album-overlay-meta" class="text-gray-300 mt-1 text-sm">—</p>
            </div>
          </div>
        </div>
        <!-- Action bar -->
        <div class="flex items-center gap-4 px-8 py-5 shrink-0">
          <button id="album-overlay-play" class="flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white rounded-full font-bold text-sm transition-all hover:scale-105 shadow-lg shadow-purple-900/40">
            <span class="material-symbols-outlined text-[20px]">play_arrow</span>Play All
          </button>
          <button id="album-overlay-shuffle" class="flex items-center gap-2 px-5 py-3 bg-white/5 border border-white/10 hover:bg-white/10 text-gray-300 hover:text-white rounded-full font-semibold text-sm transition-all">
            <span class="material-symbols-outlined text-[18px]">shuffle</span>Shuffle
          </button>
          <span id="album-overlay-count" class="ml-auto text-sm text-gray-500"></span>
        </div>
        <!-- Songs -->
        <div class="flex-1 overflow-y-auto px-8 pb-32 custom-scrollbar">
          <div class="bg-white/2 border border-white/5 rounded-2xl overflow-hidden">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="text-gray-500 border-b border-white/5">
                  <th class="font-medium text-xs px-5 py-3 w-12 text-center">#</th>
                  <th class="font-medium text-xs px-4 py-3 uppercase tracking-wider">Title</th>
                  <th class="font-medium text-xs px-4 py-3 w-16 text-center"><span class="material-symbols-outlined text-[16px]">schedule</span></th>
                </tr>
              </thead>
              <tbody id="album-overlay-tbody">
                <tr><td colspan="3" class="px-4 py-10 text-center text-gray-500 text-sm">Loading...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <PlayerBar />
    </main>
  </div>

  <style>
    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.1);
      border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.3);
    }
    
    /* Smooth utilities for outlines */
    .material-symbols-outlined {
      font-variation-settings:
      'FILL' 0,
      'wght' 400,
      'GRAD' 0,
      'opsz' 24
    }
  </style>
<script>
  import { apiFetch, formatDuration, formatCount } from '../lib/api.js';
  import { player } from '../lib/player.js';

  const GRADIENTS_HEX = [
    'linear-gradient(135deg,#6366f1,#8b5cf6)',
    'linear-gradient(135deg,#f43f5e,#f97316)',
    'linear-gradient(135deg,#ec4899,#7c3aed)',
    'linear-gradient(135deg,#ef4444,#d946ef)',
    'linear-gradient(135deg,#3b82f6,#06b6d4)',
    'linear-gradient(135deg,#06b6d4,#10b981)',
    'linear-gradient(135deg,#d946ef,#7c3aed)',
    'linear-gradient(135deg,#fb923c,#fb7185)',
    'linear-gradient(135deg,#34d399,#22d3ee)',
    'linear-gradient(135deg,#f59e0b,#f97316)',
  ];

  async function loadHome() {
    // Trending songs — top 3 by plays, see all on button click
    const tbody = document.getElementById('trending-tbody');
    const seeAllBtn = document.getElementById('trending-see-all') as HTMLButtonElement;
    let _allSongs: any[] = [];
    let _showingAll = false;

    function renderTrendingRows(songs: any[]) {
      if (!tbody) return;
      tbody.innerHTML = songs.map((s: any, i: number) => {
        const grad = GRADIENTS_HEX[(s.id - 1) % GRADIENTS_HEX.length];
        const cover = s.cover_url
          ? `<img src="${s.cover_url}" class="w-12 h-12 rounded-lg shadow-lg shrink-0 object-cover transition-transform duration-300 group-hover:scale-105 group-hover:shadow-purple-500/30" alt=""/>`
          : `<div class="w-12 h-12 rounded-lg shadow-lg shrink-0 transition-transform duration-300 group-hover:scale-105 group-hover:shadow-lg group-hover:shadow-purple-500/30" style="background:${grad}"></div>`;
        return `
          <tr class="group relative hover:bg-white/[0.06] transition-all duration-200 ease-out cursor-pointer song-row translate-x-0 hover:translate-x-px" data-song="${encodeURIComponent(JSON.stringify(s))}">
            <td class="px-4 py-3 text-center rounded-l-xl relative overflow-hidden">
              <div class="absolute left-0 top-1/2 -translate-y-1/2 w-0.5 h-0 bg-purple-500 rounded-full transition-all duration-200 group-hover:h-7 opacity-0 group-hover:opacity-100"></div>
              <div class="relative w-5 h-5 mx-auto">
                <span class="absolute inset-0 flex items-center justify-center text-gray-500 font-medium transition-all duration-150 group-hover:opacity-0 group-hover:scale-75">${i + 1}</span>
                <span class="absolute inset-0 flex items-center justify-center material-symbols-outlined text-purple-400 text-[20px] opacity-0 scale-50 transition-all duration-150 group-hover:opacity-100 group-hover:scale-100">play_arrow</span>
              </div>
            </td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-4">
                ${cover}
                <div class="min-w-0">
                  <p class="font-semibold text-gray-100 transition-colors duration-200 group-hover:text-purple-300 truncate text-[15px]">${s.title}</p>
                  <p class="text-xs text-gray-400 truncate mt-0.5 transition-colors duration-200 group-hover:text-gray-300">${s.artist_names || 'Unknown'}</p>
                </div>
              </div>
            </td>
            <td class="px-4 py-3 text-sm text-gray-400 hidden sm:table-cell text-right pr-12 font-medium transition-colors duration-200 group-hover:text-gray-300">${formatCount(s.plays_count)}</td>
            <td class="px-4 py-3 text-sm text-gray-400 text-center transition-colors duration-200 group-hover:text-gray-300">${formatDuration(s.duration)}</td>
            <td class="px-4 py-3 rounded-r-xl">
              <div class="flex items-center gap-1 justify-end">
                <button class="btn-add-to-pl w-8 h-8 flex items-center justify-center text-gray-500 hover:text-purple-400 hover:scale-110 transition-all duration-200 opacity-0 group-hover:opacity-100"
                        data-song="${encodeURIComponent(JSON.stringify(s))}" title="Add to Playlist">
                  <span class="material-symbols-outlined text-[20px]">playlist_add</span>
                </button>
                <button class="btn-like-song w-8 h-8 flex items-center justify-center text-gray-500 hover:text-pink-500 hover:scale-110 transition-all duration-200 opacity-0 group-hover:opacity-100"
                        data-id="${s.id}" data-liked="false" title="Yêu thích">
                  <span class="material-symbols-outlined text-[20px]" style="font-variation-settings:'FILL' 0">favorite_border</span>
                </button>
              </div>
            </td>
          </tr>`;
      }).join('');
    }

    try {
      const { data: songs } = await apiFetch('/songs?limit=50');
      if (tbody) {
        if (!songs?.length) {
          tbody.innerHTML = '<tr><td colspan="5" class="px-4 py-8 text-center text-gray-500">Chưa có bài hát nào.</td></tr>';
        } else {
          // Sort descending by plays_count, keep top 3 initially
          _allSongs = [...songs].sort((a: any, b: any) => (b.plays_count || 0) - (a.plays_count || 0));
          renderTrendingRows(_allSongs.slice(0, 3));
          // Wire See All toggle
          if (seeAllBtn) {
            seeAllBtn.addEventListener('click', () => {
              _showingAll = !_showingAll;
              renderTrendingRows(_showingAll ? _allSongs : _allSongs.slice(0, 3));
              seeAllBtn.textContent = _showingAll ? 'Show Less' : 'View All';
              setTimeout(loadFavoriteStatuses, 100);
            });
          }
        }
      }
    } catch {
      if (tbody) tbody.innerHTML = '<tr><td colspan="5" class="px-4 py-8 text-center text-red-400 text-sm">Cannot fetch data.</td></tr>';
    }

    // Top artists
    const artistsGrid = document.getElementById('artists-grid');
    try {
      const { data: artists } = await apiFetch('/artists?limit=4');
      if (artistsGrid && artists?.length) {
        artistsGrid.innerHTML = artists.slice(0, 4).map((a: any) => {
          const grad = GRADIENTS_HEX[(a.id - 1) % GRADIENTS_HEX.length];
          const img = a.image_url
            ? `<img src="${a.image_url}" class="w-full h-full object-cover" alt=""/>`
            : '';
          return `
            <div class="bg-white/5 border border-white/5 rounded-3xl p-5 flex flex-col items-center gap-3 hover:bg-white/[0.07] hover:border-white/[0.08] transition-[background,border-color] duration-200 cursor-pointer group">
              <div class="w-24 h-24 rounded-full overflow-hidden relative shadow-lg group-hover:shadow-purple-500/20 transition-shadow duration-300" style="background:${grad}">
                ${img}
                <div class="absolute inset-0 opacity-0 group-hover:opacity-100 bg-black/30 flex items-center justify-center transition-opacity duration-200">
                  <span class="material-symbols-outlined text-white text-4xl">play_circle</span>
                </div>
              </div>
              <div class="text-center mt-2">
                <p class="font-bold text-[15px] text-gray-100 group-hover:text-purple-300 transition-colors">${a.name}</p>
                <p class="text-xs text-gray-500 mt-0.5">${formatCount(a.followers_count)} fans</p>
              </div>
            </div>`;
        }).join('');
      }
    } catch {}

    // New releases (albums)
    const releasesGrid = document.getElementById('releases-grid');    try {
      const { data: albums } = await apiFetch('/albums?limit=5');
      if (releasesGrid && albums?.length) {
        releasesGrid.innerHTML = albums.slice(0, 5).map((al: any) => {
          const grad = GRADIENTS_HEX[(al.id - 1) % GRADIENTS_HEX.length];
          const cover = al.cover_url
            ? `<img src="${al.cover_url}" class="absolute inset-0 w-full h-full object-cover" alt=""/>`
            : '';
          const year = al.release_date ? new Date(al.release_date).getFullYear() : '';
          return `
            <div class="group cursor-pointer block release-album-card" data-album-id="${al.id}">
              <div class="w-full aspect-square rounded-2xl shadow-lg mb-4 relative overflow-hidden transition-transform duration-200 group-hover:scale-105 group-hover:shadow-purple-500/20 group-hover:shadow-xl" style="background:${grad}">
                ${cover}
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/25 transition-all duration-200"></div>
                <div class="absolute top-3 left-3 bg-black/30 backdrop-blur-md px-2 py-1 rounded-md text-[10px] font-bold text-white/90 uppercase tracking-widest border border-white/10">Album</div>
                <div class="absolute bottom-4 right-4 opacity-0 group-hover:opacity-100 transition-all duration-200 translate-y-2 group-hover:translate-y-0 z-10">
                  <button class="release-play-btn w-12 h-12 rounded-full bg-purple-500 hover:bg-purple-400 hover:scale-110 text-white flex items-center justify-center shadow-lg transition-all duration-200"
                          data-album-id="${al.id}">
                    <span class="material-symbols-outlined text-[24px]">play_arrow</span>
                  </button>
                </div>
              </div>
              <h3 class="font-bold text-[15px] text-gray-100 truncate group-hover:text-purple-400 transition-colors duration-200">${al.title}</h3>
              <p class="text-[13px] text-gray-400 truncate mt-0.5">${year}</p>
            </div>`;
        }).join('');
      }
    } catch {}
  }

  loadHome();

  // ── Artist Members ────────────────────────────────────────────────────────────
  async function loadArtistMembers() {
    const grid = document.getElementById('artist-members-grid');
    const section = document.getElementById('artist-members-section');
    if (!grid) return;
    try {
      const { data: members } = await apiFetch('/artists/members?limit=12');
      if (!members?.length) {
        if (section) section.classList.add('hidden');
        return;
      }
      grid.innerHTML = members.map((m: any) => {
        const initials = (m.username || m.full_name || '?').slice(0, 2).toUpperCase();
        const grad = GRADIENTS_HEX[(m.id - 1) % GRADIENTS_HEX.length];
        return `
          <div class="flex flex-col items-center gap-3 cursor-pointer group">
            <div class="w-20 h-20 rounded-full overflow-hidden shadow-md ring-2 ring-white/5 group-hover:ring-purple-500/40 transition-all"
                 style="background:${grad}">
              ${m.avatar_url
                ? `<img src="${m.avatar_url}" class="w-full h-full object-cover" alt="" />`
                : `<div class="w-full h-full flex items-center justify-center text-white font-bold text-lg">${initials}</div>`}
            </div>
            <div class="text-center">
              <p class="text-sm font-semibold text-gray-200 group-hover:text-purple-300 transition-colors truncate max-w-[80px]">${m.full_name || m.username || '—'}</p>
              <span class="inline-flex items-center gap-1 text-[10px] font-bold text-purple-400 bg-purple-500/10 px-2 py-0.5 rounded-full mt-1">
                <span class="material-symbols-outlined text-[10px]">mic</span>Artist
              </span>
            </div>
          </div>`;
      }).join('');
    } catch {
      if (section) section.classList.add('hidden');
    }
  }

  loadArtistMembers();

  // ── New Releases: open album overlay or play ────────────────────────────────
  let _overlaySongs: any[] = [];

  function shuffleOverlay<T>(arr: T[]): T[] {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function renderOverlaySongs(songs: any[]) {
    const tbody = document.getElementById('album-overlay-tbody')!;
    const grad = (id: number) => GRADIENTS_HEX[(id - 1) % GRADIENTS_HEX.length];
    if (!songs.length) {
      tbody.innerHTML = '<tr><td colspan="3" class="px-4 py-10 text-center text-gray-500 text-sm">No songs in this album.</td></tr>';
      return;
    }
    tbody.innerHTML = songs.map((s: any, i: number) => {
      const cover = s.cover_url
        ? `<img src="${s.cover_url}" class="w-10 h-10 rounded-lg object-cover shrink-0 shadow transition-transform duration-300 group-hover:scale-105 group-hover:shadow-purple-500/30" alt=""/>`
        : `<div class="w-10 h-10 rounded-lg shrink-0 shadow transition-transform duration-300 group-hover:scale-105 group-hover:shadow-purple-500/30" style="background:${grad(s.id)}"></div>`;
      return `
        <tr class="group relative hover:bg-white/[0.06] transition-all duration-200 ease-out cursor-pointer overlay-song-row" data-idx="${i}">
          <td class="px-5 py-3 text-center relative overflow-hidden">
            <div class="absolute left-0 top-1/2 -translate-y-1/2 w-0.5 h-0 bg-purple-500 rounded-full transition-all duration-200 group-hover:h-6 opacity-0 group-hover:opacity-100"></div>
            <span class="text-gray-500 text-sm transition-all duration-150 group-hover:opacity-0 group-hover:scale-75 inline-block">${i + 1}</span>
            <span class="material-symbols-outlined text-purple-400 text-[20px] absolute inset-0 flex items-center justify-center opacity-0 scale-50 transition-all duration-150 group-hover:opacity-100 group-hover:scale-100">play_arrow</span>
          </td>
          <td class="px-4 py-3">
            <div class="flex items-center gap-3">
              ${cover}
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-gray-100 group-hover:text-purple-300 truncate transition-colors duration-200">${s.title}</p>
                <p class="text-xs text-gray-500 truncate transition-colors duration-200 group-hover:text-gray-400">${s.artist_names || '—'}</p>
              </div>
            </div>
          </td>
          <td class="px-4 py-3 text-sm text-gray-500 text-center whitespace-nowrap transition-colors duration-200 group-hover:text-gray-300">${formatDuration(s.duration)}</td>
        </tr>`;
    }).join('');
  }

  async function openAlbumOverlay(albumId: string) {
    const overlay = document.getElementById('album-overlay')!;
    overlay.classList.remove('hidden');
    overlay.classList.add('flex', 'flex-col');
    // Reset
    (document.getElementById('album-overlay-title') as HTMLElement).textContent = 'Loading...';
    (document.getElementById('album-overlay-meta') as HTMLElement).textContent = '';
    (document.getElementById('album-overlay-cover') as HTMLElement).innerHTML = '';
    (document.getElementById('album-overlay-count') as HTMLElement).textContent = '';
    (document.getElementById('album-overlay-tbody') as HTMLElement).innerHTML =
      '<tr><td colspan="3" class="px-4 py-10 text-center text-gray-500 text-sm">Loading...</td></tr>';
    try {
      const { data: album } = await apiFetch(`/albums/${albumId}`);
      const g = GRADIENTS_HEX[(album.id - 1) % GRADIENTS_HEX.length];
      (document.getElementById('album-overlay-bg') as HTMLElement).style.background = g;
      const coverEl = document.getElementById('album-overlay-cover') as HTMLElement;
      coverEl.style.background = g;
      if (album.cover_url) coverEl.innerHTML = `<img src="${album.cover_url}" class="w-full h-full object-cover" alt=""/>`;
      (document.getElementById('album-overlay-title') as HTMLElement).textContent = album.title;
      const year = album.release_date ? new Date(album.release_date).getFullYear() : '';
      _overlaySongs = album.songs || [];
      const count = _overlaySongs.length;
      (document.getElementById('album-overlay-meta') as HTMLElement).textContent =
        [album.artist?.name, year, `${count} song${count !== 1 ? 's' : ''}`].filter(Boolean).join(' · ');
      (document.getElementById('album-overlay-count') as HTMLElement).textContent =
        `${count} song${count !== 1 ? 's' : ''}`;
      renderOverlaySongs(_overlaySongs);
    } catch {
      (document.getElementById('album-overlay-title') as HTMLElement).textContent = 'Failed to load';
      (document.getElementById('album-overlay-tbody') as HTMLElement).innerHTML =
        '<tr><td colspan="3" class="px-4 py-10 text-center text-red-400 text-sm">Failed to load album.</td></tr>';
    }
  }

  function closeAlbumOverlay() {
    const overlay = document.getElementById('album-overlay')!;
    overlay.classList.add('hidden');
    overlay.classList.remove('flex', 'flex-col');
    _overlaySongs = [];
  }

  document.getElementById('album-overlay-back')?.addEventListener('click', closeAlbumOverlay);

  document.getElementById('album-overlay-play')?.addEventListener('click', () => {
    if (_overlaySongs.length) player.playSong(_overlaySongs[0], _overlaySongs);
  });
  document.getElementById('album-overlay-shuffle')?.addEventListener('click', () => {
    if (!_overlaySongs.length) return;
    const s = shuffleOverlay(_overlaySongs);
    player.playSong(s[0], s);
  });

  document.getElementById('album-overlay-tbody')?.addEventListener('click', (e) => {
    const row = (e.target as HTMLElement).closest('.overlay-song-row') as HTMLElement | null;
    if (row && _overlaySongs.length) player.playSong(_overlaySongs[Number(row.dataset.idx)], _overlaySongs);
  });

  document.getElementById('releases-grid')?.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('.release-play-btn') as HTMLElement | null;
    if (btn) {
      e.stopPropagation();
      const albumId = btn.dataset.albumId;
      if (!albumId) return;
      // If overlay already open with this album, just play
      if (_overlaySongs.length) { player.playSong(_overlaySongs[0], _overlaySongs); return; }
      try {
        const { data: album } = await apiFetch(`/albums/${albumId}`);
        const songs: any[] = album?.songs || [];
        if (songs.length) player.playSong(songs[0], songs);
      } catch {}
      return;
    }
    const card = (e.target as HTMLElement).closest('.release-album-card') as HTMLElement | null;
    if (card?.dataset.albumId) openAlbumOverlay(card.dataset.albumId);
  });

  // ── Favorites helpers ────────────────────────────────────────────────────────
  const _likingInFlight = new Set<string>();

  function setLikeState(btn: HTMLElement, liked: boolean) {
    const icon = btn.querySelector('.material-symbols-outlined') as HTMLElement;
    btn.dataset.liked = String(liked);
    if (liked) {
      if (icon) {
        icon.textContent = 'favorite';
        icon.style.fontVariationSettings = "'FILL' 1";
      }
      btn.classList.add('text-pink-500');
      btn.classList.remove('text-gray-500', 'opacity-0');
      btn.classList.add('!opacity-100');
      btn.title = 'Bỏ yêu thích';
    } else {
      if (icon) {
        icon.textContent = 'favorite_border';
        icon.style.fontVariationSettings = "'FILL' 0";
      }
      btn.classList.remove('text-pink-500', '!opacity-100');
      btn.classList.add('text-gray-500', 'opacity-0');
      btn.title = 'Yêu thích';
    }
  }

  async function toggleLike(btn: HTMLElement) {
    const token = localStorage.getItem('auth_token');
    if (!token) { window.location.href = '/login'; return; }
    const songId  = btn.dataset.id!;
    if (_likingInFlight.has(songId)) return;
    _likingInFlight.add(songId);
    const isLiked = btn.dataset.liked === 'true';
    // optimistic update
    setLikeState(btn, !isLiked);
    try {
      if (isLiked) {
        await apiFetch(`/favorites/${songId}`, { method: 'DELETE' });
      } else {
        await apiFetch('/favorites', { method: 'POST', body: JSON.stringify({ songId }) });
      }
      window.dispatchEvent(new CustomEvent('favorites:changed', {
        detail: { songId: Number(songId), isFavorite: !isLiked },
      }));
    } catch {
      // revert on error
      setLikeState(btn, isLiked);
    } finally {
      _likingInFlight.delete(songId);
    }
  }

  // Pre-load favorite status for visible songs
  async function loadFavoriteStatuses() {
    const token = localStorage.getItem('auth_token');
    if (!token) return;
    document.querySelectorAll('.btn-like-song').forEach(async (btn) => {
      const b = btn as HTMLElement;
      const songId = b.dataset.id;
      if (!songId) return;
      try {
        const res = await apiFetch(`/favorites/${songId}/is-favorite`);
        setLikeState(b, !!res.data?.isFavorite);
      } catch {}
    });
  }

  // Song click handlers (delegated)
  document.getElementById('trending-tbody')?.addEventListener('click', (e) => {
    const atpBtn  = (e.target as HTMLElement).closest('.btn-add-to-pl') as HTMLElement;
    if (atpBtn) {
      e.stopPropagation();
      try { const song = JSON.parse(decodeURIComponent(atpBtn.dataset.song || '')); (window as any).openAddToPlaylist?.(song); } catch {}
      return;
    }
    const likeBtn = (e.target as HTMLElement).closest('.btn-like-song') as HTMLElement;
    if (likeBtn) { toggleLike(likeBtn); return; }
    const row = (e.target as HTMLElement).closest('.song-row') as HTMLElement;
    if (!row) return;
    try {
      const song = JSON.parse(decodeURIComponent(row.dataset.song || ''));
      const allRows = Array.from(document.querySelectorAll('.song-row'));
      const queue = allRows.map(r => {
        try { return JSON.parse(decodeURIComponent((r as HTMLElement).dataset.song || '')); } catch { return null; }
      }).filter(Boolean);
      player.playSong(song, queue);
    } catch {}
  });

  // Sync like button when PlayerBar fires favorites:changed
  window.addEventListener('favorites:changed', (e: any) => {
    const { songId, isFavorite } = e.detail;
    document.querySelectorAll(`.btn-like-song[data-id="${songId}"]`).forEach((btn) => {
      setLikeState(btn as HTMLElement, isFavorite);
    });
  });

  // Load favorites after songs are rendered
  setTimeout(loadFavoriteStatuses, 500);
</script>

</MainLayout>