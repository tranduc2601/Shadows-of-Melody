---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
---

<MainLayout title="Shadows of Melody - Home">
  <link slot="head" rel="preload" as="image" href="/images/hero.jpg" fetchpriority="high" />
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">
    
    <Sidebar currentPage="home" />

    <main class="flex-1 flex flex-col relative overflow-hidden bg-linear-to-br from-[#0c1328] via-[#060e20] to-[#040813]">
      <div class="absolute top-[-10%] left-[-10%] w-[60%] h-[60%] bg-indigo-600/10 blur-[150px] rounded-full pointer-events-none"></div>
      <div class="absolute bottom-[20%] right-[-10%] w-[40%] h-[40%] bg-purple-600/10 blur-[120px] rounded-full pointer-events-none"></div>

      <header class="h-auto md:h-20 shrink-0 flex flex-col md:flex-row md:items-center md:justify-between gap-3 md:gap-0 px-4 sm:px-6 lg:px-8 py-4 md:py-0 relative z-20 w-full transition-all duration-300 mobile-stack">
        <div class="flex items-center justify-between w-full md:w-auto gap-3">
          <button id="mobile-menu-btn" class="md:hidden w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white hover:bg-white/10 transition-colors">
             <span class="material-symbols-outlined">menu</span>
          </button>

          <div class="hidden md:flex items-center gap-2 text-gray-400">
            <button id="nav-back-btn" class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-white/10 hover:text-white transition-all backdrop-blur-md">
              <span class="material-symbols-outlined text-[20px]">arrow_back_ios_new</span>
            </button>
            <button id="nav-forward-btn" class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-white/10 hover:text-white transition-all backdrop-blur-md opacity-50">
              <span class="material-symbols-outlined text-[20px]">arrow_forward_ios</span>
            </button>
          </div>

          <div class="relative w-full max-w-none md:max-w-md md:ml-4 group mobile-full">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-purple-400 transition-colors">search</span>
            <input
              id="header-search-input"
              type="text"
              placeholder="Search songs, artists..."
              class="w-full bg-white/5 border border-white/10 text-white placeholder-gray-500 rounded-full py-2.5 pl-12 pr-4 focus:outline-none focus:ring-2 focus:ring-purple-500/50 focus:bg-white/10 transition-all backdrop-blur-md shadow-inner"
            />
          </div>
        </div>

        <div id="header-actions" class="flex items-center justify-end gap-3 w-full md:w-auto ml-0 md:ml-4 shrink-0">
          <div id="header-user" class="hidden sm:flex items-center gap-2.5 relative z-30">
            <p id="header-greeting" class="text-sm text-gray-400 hidden md:block relative z-30"></p>
            <div id="header-avatar-wrap" class="relative z-40 w-10 aspect-square rounded-full overflow-visible ring-2 ring-white/10 hover:ring-purple-500/60 transition-all shrink-0 cursor-pointer select-none shadow-lg shadow-black/25">
              <div class="w-full h-full rounded-full overflow-hidden flex items-center justify-center bg-white/5">
                <img id="header-avatar-img" src="" alt="" class="hidden w-full h-full object-cover rounded-full" />
                <span id="header-avatar-initials" class="text-xs font-bold text-gray-300 relative z-10"></span>
              </div>
              <div id="header-avatar-dropdown" class="hidden absolute right-0 top-full mt-2 w-44 rounded-2xl border border-white/10 bg-[#0a1229]/95 backdrop-blur-xl shadow-2xl shadow-black/40 z-[150] overflow-hidden py-1">
                <a href="/profile" class="flex items-center gap-3 px-4 py-3 text-sm text-gray-200 hover:bg-white/5 transition-colors">
                  <span class="material-symbols-outlined text-[18px] text-purple-400">person</span>
                  <span>Profile</span>
                </a>
                <a href="/settings" class="flex items-center gap-3 px-4 py-3 text-sm text-gray-200 hover:bg-white/5 transition-colors">
                  <span class="material-symbols-outlined text-[18px] text-cyan-400">settings</span>
                  <span>Settings</span>
                </a>
                <button type="button" id="header-logout-btn" class="w-full flex items-center gap-3 px-4 py-3 text-left text-sm text-gray-200 hover:bg-white/5 transition-colors">
                  <span class="material-symbols-outlined text-[18px] text-rose-400">logout</span>
                  <span>Logout</span>
                </button>
              </div>
            </div>
          </div>
          <a href="/login" id="header-login-btn" class="hidden text-sm font-semibold text-purple-400 hover:text-purple-300 transition-colors px-3 py-1.5 rounded-full border border-purple-500/30 hover:border-purple-400/50">
            Login
          </a>
        </div>
      </header>

      <div class="flex-1 overflow-y-auto px-4 sm:px-6 lg:px-8 pb-32 pt-4 relative z-10 custom-scrollbar scroll-smooth">
        
        <section class="mb-10 group cursor-pointer relative z-20" id="hero-section">
          <div class="absolute -inset-3 md:-inset-4 rounded-[2rem] md:rounded-[2.25rem] bg-purple-500/10 blur-2xl opacity-70 pointer-events-none"></div>
          <div id="hero-card" class="relative rounded-3xl md:rounded-4xl overflow-hidden border border-white/12 bg-[linear-gradient(135deg,rgba(18,24,54,0.88),rgba(15,18,38,0.72))] shadow-[0_24px_90px_rgba(0,0,0,0.45)] ring-1 ring-white/6 backdrop-blur-xl p-5 sm:p-8 md:p-12 min-h-[22rem] md:min-h-85 flex flex-col justify-end transition-all duration-500 hover:shadow-[0_30px_110px_rgba(0,0,0,0.58)] hover:border-white/20"
               style="background: linear-gradient(135deg, rgba(30,27,75,0.92), rgba(49,46,129,0.72))">
            <div class="absolute inset-0 opacity-45 mix-blend-screen pointer-events-none">
               <div class="absolute right-0 top-0 w-full h-full bg-[radial-gradient(circle_at_top_right,var(--tw-gradient-stops))] from-fuchsia-500/55 via-transparent to-transparent"></div>
               <div class="absolute -bottom-24 -right-24 w-125 h-125 bg-indigo-500 rounded-full blur-[110px]"></div>
               <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-60"></div>
            </div>
            <div id="hero-cover-bg" class="absolute inset-0 opacity-18 transition-opacity duration-700 bg-cover bg-center blur-[2px] scale-105 pointer-events-none"></div>

            <div class="relative z-10 max-w-2xl">
              <div class="flex flex-wrap items-center gap-3 mb-4">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-white/10 backdrop-blur-md rounded-full text-[11px] font-bold tracking-widest text-white border border-white/20 uppercase">
                     <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
                     Trending
                  </span>
                  <span id="hero-artist-label" class="text-sm font-medium text-purple-200">Featured</span>
              </div>
              
              <h1 id="hero-title" class="text-3xl sm:text-4xl md:text-7xl font-black text-white mb-4 tracking-tight drop-shadow-xl break-words">—</h1>
              <p id="hero-desc" class="text-sm sm:text-base md:text-xl text-indigo-100/80 mb-6 md:mb-8 max-w-lg leading-relaxed font-light opacity-0 transition-opacity duration-500"></p>
              
              <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                <button id="hero-play-btn" class="w-full sm:w-auto bg-linear-to-r from-purple-500 to-indigo-600 hover:from-purple-400 hover:to-indigo-500 text-white rounded-full py-3.5 px-6 sm:px-8 font-bold flex items-center justify-center gap-2 transition-all shadow-[0_8px_30px_rgba(168,85,247,0.4)] hover:shadow-[0_8px_30px_rgba(168,85,247,0.6)]">
                  <span class="material-symbols-outlined fill-current text-[24px]">play_arrow</span>
                  Play Now
                </button>
                <a id="hero-artist-link" href="/artists" class="w-full sm:w-auto text-center bg-white/5 hover:bg-white/15 backdrop-blur-md border border-white/20 text-white rounded-full py-3.5 px-6 sm:px-8 font-bold transition-all">
                  View Artist
                </a>
              </div>
            </div>

            <div class="absolute right-12 top-1/2 -translate-y-1/2 w-72 h-72 bg-linear-to-tr from-purple-500/18 via-fuchsia-500/10 to-transparent rounded-full blur-3xl pointer-events-none"></div>
            <div id="hero-cover-art" class="absolute right-10 top-1/2 -translate-y-1/2 w-40 h-40 md:w-52 md:h-52 rounded-2xl shadow-[0_18px_50px_rgba(0,0,0,0.35)] overflow-hidden opacity-0 transition-all duration-700 hidden md:block border border-white/12 ring-1 ring-white/10"></div>
          </div>
        </section>

        <section id="recently-played-section" class="hidden mb-12">
          <div class="flex items-end justify-between mb-6">
            <h2 class="text-2xl font-bold text-white flex items-center gap-2">
              <span class="material-symbols-outlined text-purple-400">history</span>
              Recently Played
            </h2>
          </div>
          <div id="recently-played-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
            <div class="col-span-6 text-gray-500 text-sm text-center py-4">Loading...</div>
          </div>
        </section>

        <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 xl:gap-8">
          
          <div class="xl:col-span-2">
            <div class="flex items-center justify-between gap-3 mb-6">
               <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
                  Trending Now
               </h2>
               <button id="trending-see-all" class="text-xs sm:text-sm font-semibold text-purple-400 hover:text-purple-300 transition-colors uppercase tracking-wider whitespace-nowrap">View All</button>
            </div>

            <div class="bg-white/2 border border-white/5 rounded-3xl p-2 sm:p-3 backdrop-blur-sm mobile-scroll-x">
              <table class="w-full text-left border-collapse min-w-[640px]">
                <thead>
                  <tr class="text-gray-400 border-b border-white/5">
                    <th class="font-medium text-sm px-4 py-3 w-12 text-center pb-4">#</th>
                    <th class="font-medium text-sm px-4 py-3 pb-4">Title</th>
                    <th class="font-medium text-sm px-4 py-3 hidden sm:table-cell pb-4 text-right pr-12">Plays</th>
                    <th class="font-medium text-sm px-4 py-3 w-20 text-center pb-4"><span class="material-symbols-outlined text-[18px]">schedule</span></th>
                    <th class="font-medium text-sm px-4 py-3 w-20 text-center pb-4">Actions</th>
                  </tr>
                </thead>
                <tbody id="trending-tbody">
                  <tr><td colspan="5" class="px-4 py-8 text-center text-gray-500 text-sm">Loading...</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <div>
            <div class="flex items-end justify-between mb-6">
               <h2 class="text-xl font-bold text-white">Top Artists</h2>
               <a href="/artists" class="text-sm font-semibold text-purple-400 hover:text-purple-300 transition-colors uppercase tracking-wider">View All</a>
            </div>

            <div id="artists-grid" class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-2 gap-4 sm:gap-5">
              <div class="col-span-2 text-gray-500 text-sm text-center py-4">Loading...</div>
            </div>
          </div>
        </div>

        <div class="mt-14">
            <div class="flex items-end justify-between mb-6">
               <h2 class="text-2xl font-bold text-white">New Releases</h2>
               <div class="flex gap-2">
                  <button id="releases-prev" class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-colors">
                     <span class="material-symbols-outlined text-sm">arrow_back</span>
                  </button>
                  <button id="releases-next" class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-colors">
                     <span class="material-symbols-outlined text-sm">arrow_forward</span>
                  </button>
               </div>
            </div>

            <div id="releases-scroll-wrapper" class="overflow-x-auto pb-2 no-scrollbar mobile-scroll-x">
              <div id="releases-grid" class="flex gap-4 sm:gap-6 w-max">
                <div class="text-gray-500 text-sm text-center py-4 w-48">Loading...</div>
              </div>
            </div>
        </div>

        <div class="mt-14" id="artist-members-section">
          <div class="flex items-end justify-between mb-6">
            <h2 class="text-2xl font-bold text-white flex items-center gap-2">
              <span class="material-symbols-outlined text-purple-400">mic</span>
              Artist Members
            </h2>
          </div>
          <div id="artist-members-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 sm:gap-5">
            <div class="col-span-6 text-gray-500 text-sm text-center py-4">Loading...</div>
          </div>
        </div>

      </div>

      <div id="album-overlay" class="hidden absolute inset-0 z-20 flex flex-col bg-[#060e20] overflow-hidden">
        <div class="relative shrink-0 h-56 overflow-hidden">
          <div id="album-overlay-bg" class="absolute inset-0 opacity-60" style="background:linear-gradient(135deg,#6366f1,#8b5cf6)"></div>
          <div class="absolute inset-0 bg-gradient-to-b from-transparent via-black/30 to-[#060e20]"></div>
          <header class="absolute top-0 left-0 right-0 h-16 flex items-center px-8 z-10 gap-3">
            <button id="album-overlay-back" class="w-9 h-9 rounded-full bg-black/30 backdrop-blur-md flex items-center justify-center hover:bg-black/50 transition-colors">
              <span class="material-symbols-outlined text-white text-xl">arrow_back</span>
            </button>
          </header>
          <div class="absolute bottom-0 left-0 right-0 px-8 pb-5 z-10 flex items-end gap-5">
            <div id="album-overlay-cover" class="w-20 h-20 rounded-xl shrink-0 shadow-2xl overflow-hidden border border-white/10"></div>
            <div class="min-w-0">
              <p class="text-xs font-bold text-white/50 uppercase tracking-widest mb-1">Album</p>
              <h2 id="album-overlay-title" class="text-3xl font-black text-white truncate">—</h2>
              <p id="album-overlay-meta" class="text-gray-300 mt-1 text-sm">—</p>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-4 px-8 py-5 shrink-0">
          <button id="album-overlay-play" class="flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white rounded-full font-bold text-sm transition-all hover:scale-105 shadow-lg shadow-purple-900/40">
            <span class="material-symbols-outlined text-[20px]">play_arrow</span>Play All
          </button>
          <button id="album-overlay-shuffle" class="flex items-center gap-2 px-5 py-3 bg-white/5 border border-white/10 hover:bg-white/10 text-gray-300 hover:text-white rounded-full font-semibold text-sm transition-all">
            <span class="material-symbols-outlined text-[18px]">shuffle</span>Shuffle
          </button>
          <span id="album-overlay-count" class="ml-auto text-sm text-gray-500"></span>
        </div>
        <div class="flex-1 overflow-y-auto px-8 pb-32 custom-scrollbar">
          <div class="bg-white/2 border border-white/5 rounded-2xl overflow-hidden">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="text-gray-500 border-b border-white/5">
                  <th class="font-medium text-xs px-5 py-3 w-12 text-center">#</th>
                  <th class="font-medium text-xs px-4 py-3 uppercase tracking-wider">Title</th>
                  <th class="font-medium text-xs px-4 py-3 w-16 text-center"><span class="material-symbols-outlined text-[16px]">schedule</span></th>
                </tr>
              </thead>
              <tbody id="album-overlay-tbody">
                <tr><td colspan="3" class="px-4 py-10 text-center text-gray-500 text-sm">Loading...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <style>
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.3); }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
  </style>

<script>
  import { apiFetch, formatDuration, formatCount, getUser, getToken, clearAuth } from '../lib/api.js';
  import { player } from '../lib/player.js';

  const GRADIENTS_HEX = [
    'linear-gradient(135deg,#6366f1,#8b5cf6)',
    'linear-gradient(135deg,#f43f5e,#f97316)',
    'linear-gradient(135deg,#ec4899,#7c3aed)',
    'linear-gradient(135deg,#ef4444,#d946ef)',
    'linear-gradient(135deg,#3b82f6,#06b6d4)',
    'linear-gradient(135deg,#06b6d4,#10b981)',
    'linear-gradient(135deg,#d946ef,#7c3aed)',
    'linear-gradient(135deg,#fb923c,#fb7185)',
    'linear-gradient(135deg,#34d399,#22d3ee)',
    'linear-gradient(135deg,#f59e0b,#f97316)',
  ];

  let homeAbortController: AbortController | null = null;

  function initHomePage() {
    if (window.location.pathname !== '/') return;
    if ((window as any).__homePageBootedFor === window.location.pathname) return;
    (window as any).__homePageBootedFor = window.location.pathname;

    homeAbortController?.abort();
    homeAbortController = new AbortController();
    const { signal } = homeAbortController;

    document.getElementById('nav-back-btn')?.addEventListener('click', () => history.back(), { signal });
    document.getElementById('nav-forward-btn')?.addEventListener('click', () => history.forward(), { signal });

    const headerSearch = document.getElementById('header-search-input') as HTMLInputElement;
    headerSearch?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const q = headerSearch.value.trim();
        if (q) window.location.href = `/search?q=${encodeURIComponent(q)}`;
      }
    }, { signal });

    const token = getToken();
    const user = token ? getUser() : null;
    if (user) {
      const greetingEl = document.getElementById('header-greeting');
      const avatarWrap = document.getElementById('header-user');
      const avatarToggle = document.getElementById('header-avatar-wrap') as HTMLElement;
      const avatarImg = document.getElementById('header-avatar-img') as HTMLImageElement;
      const initials = document.getElementById('header-avatar-initials');
      const avatarDropdown = document.getElementById('header-avatar-dropdown') as HTMLElement;
      const logoutBtn = document.getElementById('header-logout-btn') as HTMLButtonElement;

      if (avatarWrap) avatarWrap.classList.remove('hidden');
      document.getElementById('header-login-btn')?.remove();

      const hour = new Date().getHours();
      const timeGreeting = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
      const displayName = user.full_name || user.username || '';
      if (greetingEl) greetingEl.textContent = `${timeGreeting}, ${displayName}`;

      if (user.avatar_url && avatarImg) {
        avatarImg.src = user.avatar_url;
        avatarImg.classList.remove('hidden');
        if (initials) initials.textContent = '';
      } else if (initials) {
        initials.textContent = (displayName || '?').slice(0, 2).toUpperCase();
      }

      const closeAvatarDropdown = () => avatarDropdown?.classList.add('hidden');

      avatarToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = avatarDropdown?.classList.contains('hidden');
        document.querySelectorAll('#header-avatar-dropdown').forEach((el) => {
          if (el !== avatarDropdown) el.classList.add('hidden');
        });
        if (isHidden) avatarDropdown?.classList.remove('hidden');
        else closeAvatarDropdown();
      }, { signal });
      avatarDropdown?.addEventListener('click', (e) => e.stopPropagation(), { signal });
      document.addEventListener('click', (e) => {
        if (!avatarToggle?.contains(e.target as Node) && !avatarDropdown?.contains(e.target as Node)) closeAvatarDropdown();
      }, { signal });
      logoutBtn?.addEventListener('click', () => {
        clearAuth();
        window.location.href = '/login';
      }, { signal });
    } else {
      document.getElementById('header-user')?.classList.add('hidden');
      document.getElementById('header-login-btn')?.classList.add('hidden');
      document.getElementById('header-actions')?.classList.add('justify-end');
    }

    let _heroSong: any = null;

    async function loadHero() {
      try {
        const { data: songs } = await apiFetch('/songs?limit=50');
        if (!songs?.length) return;
        const sorted = [...songs].sort((a: any, b: any) => (b.plays_count || 0) - (a.plays_count || 0));
        _heroSong = sorted[0];
        const s = _heroSong;

        const title = document.getElementById('hero-title');
        const artistLabel = document.getElementById('hero-artist-label');
        const desc = document.getElementById('hero-desc');
        const coverBg = document.getElementById('hero-cover-bg');
        const coverArt = document.getElementById('hero-cover-art');
        const heroCard = document.getElementById('hero-card');
        const heroLink = document.getElementById('hero-artist-link') as HTMLAnchorElement;

        if (title) title.textContent = s.title;
        if (artistLabel) artistLabel.textContent = s.artist_names || 'Artist';

        const plays = formatCount(s.plays_count || 0);
        const dur = formatDuration(s.duration);
        if (desc) {
          desc.textContent = `${plays} plays · ${dur}`;
          desc.classList.remove('opacity-0');
        }

        if (s.cover_url) {
          if (coverBg) {
            coverBg.style.backgroundImage = `url('${s.cover_url}')`;
            coverBg.style.opacity = '0.3';
          }
          if (coverArt) {
            coverArt.innerHTML = `<img src="${s.cover_url}" class="w-full h-full object-cover" alt="" />`;
            coverArt.classList.remove('opacity-0');
            coverArt.classList.remove('hidden');
            coverArt.style.opacity = '1';
          }
        }

        if (heroCard && s.id) {
          const grad = GRADIENTS_HEX[(s.id - 1) % GRADIENTS_HEX.length];
          heroCard.style.background = `${grad}`;
        }

        if (s.artist_id && heroLink) {
          heroLink.href = `/artist?id=${s.artist_id}`;
        }
      } catch {}
    }

    document.getElementById('hero-play-btn')?.addEventListener('click', () => {
      if (_heroSong) player.playSong(_heroSong);
    }, { signal });

    const tbody = document.getElementById('trending-tbody');
    const seeAllBtn = document.getElementById('trending-see-all') as HTMLButtonElement;
    let _allSongs: any[] = [];
    let _showingAll = false;

    function renderTrendingRows(songs: any[]) {
      if (!tbody) return;
      tbody.innerHTML = songs.map((s: any, i: number) => {
        const grad = GRADIENTS_HEX[(s.id - 1) % GRADIENTS_HEX.length];
        const cover = s.cover_url
          ? `<img src="${s.cover_url}" class="w-12 h-12 rounded-lg shadow-lg shrink-0 object-cover transition-transform duration-300 group-hover:scale-105" alt=""/>`
          : `<div class="w-12 h-12 rounded-lg shadow-lg shrink-0 transition-transform duration-300 group-hover:scale-105" style="background:${grad}"></div>`;
        return `
        <tr class="group relative hover:bg-white/[0.06] transition-all duration-200 ease-out cursor-pointer song-row" data-song="${encodeURIComponent(JSON.stringify(s))}">
          <td class="px-4 py-3 text-center rounded-l-xl relative overflow-hidden">
            <div class="absolute left-0 top-1/2 -translate-y-1/2 w-0.5 h-0 bg-purple-500 rounded-full transition-all duration-200 group-hover:h-7 opacity-0 group-hover:opacity-100"></div>
            <div class="relative w-5 h-5 mx-auto">
              <span class="absolute inset-0 flex items-center justify-center text-gray-500 font-medium transition-all duration-150 group-hover:opacity-0 group-hover:scale-75">${i + 1}</span>
              <span class="absolute inset-0 flex items-center justify-center material-symbols-outlined text-purple-400 text-[20px] opacity-0 scale-50 transition-all duration-150 group-hover:opacity-100 group-hover:scale-100">play_arrow</span>
            </div>
          </td>
          <td class="px-4 py-3">
            <div class="flex items-center gap-4">
              ${cover}
              <div class="min-w-0">
                <p class="font-semibold text-gray-100 transition-colors duration-200 group-hover:text-purple-300 truncate text-[15px]">${s.title}</p>
                <p class="text-xs text-gray-400 truncate mt-0.5 transition-colors duration-200 group-hover:text-gray-300">${s.artist_names || 'Unknown'}</p>
              </div>
            </div>
          </td>
          <td class="px-4 py-3 text-sm text-gray-400 hidden sm:table-cell text-right pr-12 font-medium transition-colors duration-200 group-hover:text-gray-300">${formatCount(s.plays_count)}</td>
          <td class="px-4 py-3 text-sm text-gray-400 text-center transition-colors duration-200 group-hover:text-gray-300">${formatDuration(s.duration)}</td>
          <td class="px-4 py-3 rounded-r-xl">
            <div class="flex items-center gap-1 justify-end">
              <button class="btn-add-to-pl w-8 h-8 flex items-center justify-center text-gray-400 hover:text-purple-400 hover:scale-110 transition-all duration-200"
                      data-song="${encodeURIComponent(JSON.stringify(s))}" title="Add to playlist">
                <span class="material-symbols-outlined text-[20px]">playlist_add</span>
              </button>
              <button class="btn-like-song w-8 h-8 flex items-center justify-center text-gray-400 hover:text-pink-500 hover:scale-110 transition-all duration-200"
                      data-id="${s.id}" data-liked="false" title="Like">
                <span class="material-symbols-outlined text-[20px]" style="font-variation-settings:'FILL' 0">favorite_border</span>
              </button>
            </div>
          </td>
        </tr>`;
      }).join('');
    }

    async function loadArtists() {
      const artistsGrid = document.getElementById('artists-grid');
      try {
        const { data: artists } = await apiFetch('/artists?limit=4');
        if (artistsGrid && artists?.length) {
          artistsGrid.innerHTML = artists.slice(0, 4).map((a: any) => {
            const grad = GRADIENTS_HEX[(a.id - 1) % GRADIENTS_HEX.length];
            const imageUrl = a.image_url;
            const avatarFallback = `<div class="absolute inset-0 flex items-center justify-center"><div class="flex h-full w-full items-center justify-center bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.18),transparent_48%)]"><div class="flex h-20 w-20 items-center justify-center rounded-full border border-white/20 bg-white/10 text-4xl font-black text-white shadow-[0_10px_30px_rgba(0,0,0,0.2)]">${(a.name || 'A').slice(0, 1).toUpperCase()}</div></div></div>`;
            return `
            <a href="/artist?id=${a.id}" class="group relative overflow-hidden rounded-[1.75rem] border border-white/10 bg-white/[0.03] p-4 transition duration-300 ease-out hover:-translate-y-1 hover:border-purple-400/20 hover:bg-white/[0.06] hover:shadow-[0_18px_60px_rgba(0,0,0,0.25)] no-underline cursor-pointer">
              <div class="absolute inset-0 bg-linear-to-br from-white/[0.06] via-transparent to-transparent opacity-0 transition duration-300 group-hover:opacity-100"></div>
              <div class="relative flex flex-col gap-4">
                <div class="relative mx-auto aspect-square w-full max-w-[13rem] overflow-hidden rounded-full border border-white/10 bg-white/[0.04] shadow-lg shadow-black/20" style="background:${grad}">
                  ${imageUrl ? `<img src="${imageUrl}" loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-105" alt="${a.name || 'Artist'}"/>` : avatarFallback}
                  <div class="absolute inset-0 bg-linear-to-t from-black/55 via-black/10 to-transparent"></div>
                  <div class="absolute inset-x-0 bottom-0 h-20 bg-linear-to-t from-black/35 to-transparent"></div>
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 transition duration-300 group-hover:opacity-100">
                    <div class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 backdrop-blur border border-white/15 text-white shadow-lg shadow-black/20">
                      <span class="material-symbols-outlined text-[24px]">play_arrow</span>
                    </div>
                  </div>
                </div>
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0 text-center mx-auto">
                    <p class="truncate text-base font-semibold text-white transition-colors duration-300 group-hover:text-purple-300">${a.name}</p>
                    <p class="mt-1 text-xs text-gray-400">${formatCount(a.followers_count)} followers</p>
                  </div>
                </div>
              </div>
            </a>`;
          }).join('');
        }
      } catch {}
    }

    async function loadReleases() {
      const releasesGrid = document.getElementById('releases-grid');
      try {
        const { data: albums } = await apiFetch('/albums?limit=12');
        if (releasesGrid && albums?.length) {
          releasesGrid.innerHTML = albums.map((al: any) => {
            const grad = GRADIENTS_HEX[(al.id - 1) % GRADIENTS_HEX.length];
            const cover = al.cover_url
              ? `<img src="${al.cover_url}" class="absolute inset-0 w-full h-full object-cover" alt=""/>`
              : '';
            const year = al.release_date ? new Date(al.release_date).getFullYear() : '';
            const artistName = al.artist_name || al.artist?.name || '';
            return `
            <div class="group cursor-pointer block release-album-card w-44 shrink-0" data-album-id="${al.id}">
              <div class="w-44 h-44 rounded-2xl shadow-lg mb-3 relative overflow-hidden transition-transform duration-200 group-hover:scale-105 group-hover:shadow-purple-500/20 group-hover:shadow-xl" style="background:${grad}">
                ${cover}
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/25 transition-all duration-200"></div>
                <div class="absolute top-2.5 left-2.5 bg-black/30 backdrop-blur-md px-2 py-0.5 rounded-md text-[10px] font-bold text-white/90 uppercase tracking-widest border border-white/10">Album</div>
                <div class="absolute bottom-3 right-3 opacity-0 group-hover:opacity-100 transition-all duration-200 translate-y-2 group-hover:translate-y-0 z-10">
                  <button class="release-play-btn w-11 h-11 rounded-full bg-purple-500 hover:bg-purple-400 hover:scale-110 text-white flex items-center justify-center shadow-lg transition-all duration-200"
                          data-album-id="${al.id}">
                    <span class="material-symbols-outlined text-[22px]">play_arrow</span>
                  </button>
                </div>
              </div>
              <h3 class="font-bold text-[14px] text-gray-100 truncate group-hover:text-purple-400 transition-colors duration-200">${al.title}</h3>
              <p class="text-[12px] text-gray-400 truncate mt-0.5">${[artistName, year].filter(Boolean).join(' · ')}</p>
            </div>`;
          }).join('');
        }
      } catch {}
    }

    const releasesWrapper = document.getElementById('releases-scroll-wrapper');
    document.getElementById('releases-prev')?.addEventListener('click', () => {
      releasesWrapper?.scrollBy({ left: -400, behavior: 'smooth' });
    }, { signal });
    document.getElementById('releases-next')?.addEventListener('click', () => {
      releasesWrapper?.scrollBy({ left: 400, behavior: 'smooth' });
    }, { signal });

    async function loadRecentlyPlayed() {
      if (!getToken()) return;
      const section = document.getElementById('recently-played-section');
      const grid = document.getElementById('recently-played-grid');
      if (!section || !grid) return;
      try {
        const { data: songs } = await apiFetch('/history/recent?limit=6');
        if (!songs?.length) return;
        section.classList.remove('hidden');
        grid.innerHTML = songs.map((s: any) => {
          const grad = GRADIENTS_HEX[(s.id - 1) % GRADIENTS_HEX.length];
          const cover = s.cover_url
            ? `<img src="${s.cover_url}" class="absolute inset-0 w-full h-full object-cover" alt=""/>`
            : '';
          return `
          <div class="group cursor-pointer recent-song-card" data-song="${encodeURIComponent(JSON.stringify(s))}">
            <div class="w-full aspect-square rounded-xl relative overflow-hidden mb-2.5 transition-transform duration-200 group-hover:scale-105" style="background:${grad}">
              ${cover}
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all duration-200 flex items-center justify-center">
                <span class="material-symbols-outlined text-white text-4xl opacity-0 group-hover:opacity-100 transition-opacity duration-200">play_circle</span>
              </div>
            </div>
            <p class="text-sm font-semibold text-gray-200 truncate group-hover:text-purple-300 transition-colors">${s.title}</p>
            <p class="text-xs text-gray-500 truncate mt-0.5">${s.artist_names || '—'}</p>
          </div>`;
        }).join('');

        grid.addEventListener('click', (e) => {
          const card = (e.target as HTMLElement).closest('.recent-song-card') as HTMLElement | null;
          if (!card) return;
          try {
            const song = JSON.parse(decodeURIComponent(card.dataset.song || ''));
            player.playSong(song);
          } catch {}
        }, { signal });
      } catch {}
    }

    async function loadArtistMembers() {
      const grid = document.getElementById('artist-members-grid');
      const section = document.getElementById('artist-members-section');
      if (!grid) return;
      try {
        const { data: members } = await apiFetch('/artists/members?limit=12');
        if (!members?.length) {
          if (section) section.classList.add('hidden');
          return;
        }
        grid.innerHTML = members.map((m: any) => {
          const displayName = m.artist_name || m.full_name || m.username || '—';
          const initials = displayName.slice(0, 2).toUpperCase();
          const grad = GRADIENTS_HEX[(m.user_id - 1) % GRADIENTS_HEX.length];
          const href = m.artist_id ? `/artist?id=${m.artist_id}` : '/artists';
          const avatarFallback = `<div class="absolute inset-0 flex items-center justify-center"><div class="flex h-full w-full items-center justify-center bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.18),transparent_48%)]"><div class="flex h-20 w-20 items-center justify-center rounded-full border border-white/20 bg-white/10 text-4xl font-black text-white shadow-[0_10px_30px_rgba(0,0,0,0.2)]">${initials.slice(0, 1)}</div></div></div>`;
          return `
          <a href="${href}" class="group relative overflow-hidden rounded-[1.75rem] border border-white/10 bg-white/[0.03] p-4 transition duration-300 ease-out hover:-translate-y-1 hover:border-purple-400/20 hover:bg-white/[0.06] hover:shadow-[0_18px_60px_rgba(0,0,0,0.25)] no-underline cursor-pointer flex flex-col gap-4 items-center">
            <div class="absolute inset-0 bg-linear-to-br from-white/[0.06] via-transparent to-transparent opacity-0 transition duration-300 group-hover:opacity-100"></div>
            <div class="relative mx-auto aspect-square w-full max-w-[13rem] overflow-hidden rounded-full border border-white/10 bg-white/[0.04] shadow-lg shadow-black/20" style="background:${grad}">
              ${m.avatar_url ? `<img src="${m.avatar_url}" loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-105" alt="${displayName}" />` : avatarFallback}
              <div class="absolute inset-0 bg-linear-to-t from-black/55 via-black/10 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 h-20 bg-linear-to-t from-black/35 to-transparent"></div>
              <div class="absolute inset-0 flex items-center justify-center opacity-0 transition duration-300 group-hover:opacity-100">
                <div class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 backdrop-blur border border-white/15 text-white shadow-lg shadow-black/20">
                  <span class="material-symbols-outlined text-[24px]">mic</span>
                </div>
              </div>
            </div>
            <div class="text-center w-full">
              <p class="text-sm font-semibold text-white group-hover:text-purple-300 transition-colors truncate">${displayName}</p>
              <span class="inline-flex items-center gap-1 text-[10px] font-bold text-purple-400 bg-purple-500/10 px-2 py-0.5 rounded-full mt-2">
                <span class="material-symbols-outlined text-[10px]">mic</span>Artist
              </span>
            </div>
          </a>`;
        }).join('');
      } catch {
        if (section) section.classList.add('hidden');
      }
    }

    async function loadTrending() {
      try {
        const { data: songs } = await apiFetch('/songs?limit=50');
        if (tbody) {
          if (!songs?.length) {
            tbody.innerHTML = '<tr><td colspan="5" class="px-4 py-8 text-center text-gray-500">No songs yet.</td></tr>';
          } else {
            _allSongs = [...songs].sort((a: any, b: any) => (b.plays_count || 0) - (a.plays_count || 0));
            renderTrendingRows(_allSongs.slice(0, 3));
            if (seeAllBtn) {
              seeAllBtn.addEventListener('click', () => {
                _showingAll = !_showingAll;
                renderTrendingRows(_showingAll ? _allSongs : _allSongs.slice(0, 3));
                seeAllBtn.textContent = _showingAll ? 'Show Less' : 'View All';
                setTimeout(loadFavoriteStatuses, 100);
              });
            }
          }
        }
      } catch {
        if (tbody) tbody.innerHTML = '<tr><td colspan="5" class="px-4 py-8 text-center text-red-400 text-sm">Failed to load data.</td></tr>';
      }
    }

    let _overlaySongs: any[] = [];

    function shuffleArr<T>(arr: T[]): T[] {
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    function renderOverlaySongs(songs: any[]) {
      const tb = document.getElementById('album-overlay-tbody')!;
      if (!songs.length) {
        tb.innerHTML = '<tr><td colspan="3" class="px-4 py-10 text-center text-gray-500 text-sm">This album has no songs yet.</td></tr>';
        return;
      }
      tb.innerHTML = songs.map((s: any, i: number) => {
        const grad = GRADIENTS_HEX[(s.id - 1) % GRADIENTS_HEX.length];
        const cover = s.cover_url
          ? `<img src="${s.cover_url}" class="w-10 h-10 rounded-lg object-cover shrink-0 shadow" alt=""/>`
          : `<div class="w-10 h-10 rounded-lg shrink-0 shadow" style="background:${grad}"></div>`;
        return `
        <tr class="group relative hover:bg-white/[0.06] transition-all duration-200 ease-out cursor-pointer overlay-song-row" data-idx="${i}">
          <td class="px-5 py-3 text-center relative overflow-hidden">
            <div class="absolute left-0 top-1/2 -translate-y-1/2 w-0.5 h-0 bg-purple-500 rounded-full transition-all duration-200 group-hover:h-6 opacity-0 group-hover:opacity-100"></div>
            <span class="text-gray-500 text-sm transition-all duration-150 group-hover:opacity-0 inline-block">${i + 1}</span>
            <span class="material-symbols-outlined text-purple-400 text-[20px] absolute inset-0 flex items-center justify-center opacity-0 scale-50 transition-all duration-150 group-hover:opacity-100 group-hover:scale-100">play_arrow</span>
          </td>
          <td class="px-4 py-3">
            <div class="flex items-center gap-3">
              ${cover}
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-gray-100 group-hover:text-purple-300 truncate">${s.title}</p>
                <p class="text-xs text-gray-500 truncate">${s.artist_names || '—'}</p>
              </div>
            </div>
          </td>
          <td class="px-4 py-3 text-sm text-gray-500 text-center whitespace-nowrap group-hover:text-gray-300">${formatDuration(s.duration)}</td>
        </tr>`;
      }).join('');
    }

    async function openAlbumOverlay(albumId: string) {
      const overlay = document.getElementById('album-overlay')!;
      overlay.classList.remove('hidden');
      overlay.classList.add('flex', 'flex-col');
      (document.getElementById('album-overlay-title') as HTMLElement).textContent = 'Loading...';
      (document.getElementById('album-overlay-meta') as HTMLElement).textContent = '';
      (document.getElementById('album-overlay-cover') as HTMLElement).innerHTML = '';
      (document.getElementById('album-overlay-count') as HTMLElement).textContent = '';
      (document.getElementById('album-overlay-tbody') as HTMLElement).innerHTML =
        '<tr><td colspan="3" class="px-4 py-10 text-center text-gray-500 text-sm">Loading...</td></tr>';
      try {
        const { data: album } = await apiFetch(`/albums/${albumId}`);
        const g = GRADIENTS_HEX[(album.id - 1) % GRADIENTS_HEX.length];
        (document.getElementById('album-overlay-bg') as HTMLElement).style.background = g;
        const coverEl = document.getElementById('album-overlay-cover') as HTMLElement;
        coverEl.style.background = g;
        if (album.cover_url) coverEl.innerHTML = `<img src="${album.cover_url}" class="w-full h-full object-cover" alt=""/>`;
        (document.getElementById('album-overlay-title') as HTMLElement).textContent = album.title;
        const year = album.release_date ? new Date(album.release_date).getFullYear() : '';
        _overlaySongs = album.songs || [];
        const count = _overlaySongs.length;
        (document.getElementById('album-overlay-meta') as HTMLElement).textContent =
          [album.artist?.name, year, `${count} songs`].filter(Boolean).join(' · ');
        (document.getElementById('album-overlay-count') as HTMLElement).textContent = `${count} songs`;
        renderOverlaySongs(_overlaySongs);
      } catch {
        (document.getElementById('album-overlay-title') as HTMLElement).textContent = 'Failed to load';
      }
    }

    function closeAlbumOverlay() {
      const overlay = document.getElementById('album-overlay')!;
      overlay.classList.add('hidden');
      overlay.classList.remove('flex', 'flex-col');
      _overlaySongs = [];
    }

    document.getElementById('album-overlay-back')?.addEventListener('click', closeAlbumOverlay, { signal });
    document.getElementById('album-overlay-play')?.addEventListener('click', () => {
      if (_overlaySongs.length) player.playSong(_overlaySongs[0], _overlaySongs);
    }, { signal });
    document.getElementById('album-overlay-shuffle')?.addEventListener('click', () => {
      if (!_overlaySongs.length) return;
      const s = shuffleArr(_overlaySongs);
      player.playSong(s[0], s);
    }, { signal });
    document.getElementById('album-overlay-tbody')?.addEventListener('click', (e) => {
      const row = (e.target as HTMLElement).closest('.overlay-song-row') as HTMLElement | null;
      if (row && _overlaySongs.length) player.playSong(_overlaySongs[Number(row.dataset.idx)], _overlaySongs);
    }, { signal });

    document.getElementById('releases-grid')?.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('.release-play-btn') as HTMLElement | null;
      if (btn) {
        e.stopPropagation();
        const albumId = btn.dataset.albumId;
        if (!albumId) return;
        try {
          const { data: album } = await apiFetch(`/albums/${albumId}`);
          const songs: any[] = album?.songs || [];
          if (songs.length) player.playSong(songs[0], songs);
        } catch {}
        return;
      }
      const card = (e.target as HTMLElement).closest('.release-album-card') as HTMLElement | null;
      if (card?.dataset.albumId) openAlbumOverlay(card.dataset.albumId);
    });

    document.getElementById('trending-tbody')?.addEventListener('click', (e) => {
      const atpBtn = (e.target as HTMLElement).closest('.btn-add-to-pl') as HTMLElement;
      if (atpBtn) {
        e.stopPropagation();
        try {
          const song = JSON.parse(decodeURIComponent(atpBtn.dataset.song || ''));
          if (typeof (window as any).openAddToPlaylist === 'function') {
            (window as any).openAddToPlaylist(song);
          } else {
            window.dispatchEvent(new CustomEvent('player:add-to-playlist', { detail: { song } }));
          }
        } catch {}
        return;
      }
      const likeBtn = (e.target as HTMLElement).closest('.btn-like-song') as HTMLElement;
      if (likeBtn) { toggleLike(likeBtn); return; }
      const row = (e.target as HTMLElement).closest('.song-row') as HTMLElement;
      if (!row) return;
      try {
        const song = JSON.parse(decodeURIComponent(row.dataset.song || ''));
        const queue = _allSongs.length ? _allSongs : Array.from(document.querySelectorAll('.song-row')).map(r => {
          try { return JSON.parse(decodeURIComponent((r as HTMLElement).dataset.song || '')); } catch { return null; }
        }).filter(Boolean);
        player.playSong(song, queue);
      } catch {}
    });

    const _likingInFlight = new Set<string>();

    function setLikeState(btn: HTMLElement, liked: boolean) {
      const icon = btn.querySelector('.material-symbols-outlined') as HTMLElement;
      btn.dataset.liked = String(liked);
      if (liked) {
        if (icon) { icon.textContent = 'favorite'; icon.style.fontVariationSettings = "'FILL' 1"; }
        btn.classList.add('text-pink-500');
        btn.classList.remove('text-gray-500', 'opacity-0');
        btn.classList.add('!opacity-100');
        btn.title = 'Unlike';
      } else {
        if (icon) { icon.textContent = 'favorite_border'; icon.style.fontVariationSettings = "'FILL' 0"; }
        btn.classList.remove('text-pink-500', '!opacity-100');
        btn.classList.add('text-gray-500', 'opacity-0');
        btn.title = 'Like';
      }
    }

    async function toggleLike(btn: HTMLElement) {
      const token = localStorage.getItem('auth_token');
      if (!token) { window.location.href = '/login'; return; }
      const songId = btn.dataset.id!;
      if (_likingInFlight.has(songId)) return;
      _likingInFlight.add(songId);
      const isLiked = btn.dataset.liked === 'true';
      setLikeState(btn, !isLiked);
      try {
        if (isLiked) {
          await apiFetch(`/favorites/${songId}`, { method: 'DELETE' });
        } else {
          await apiFetch('/favorites', { method: 'POST', body: JSON.stringify({ songId }) });
        }
        window.dispatchEvent(new CustomEvent('favorites:changed', { detail: { songId: Number(songId), isFavorite: !isLiked } }));
      } catch {
        setLikeState(btn, isLiked);
      } finally {
        _likingInFlight.delete(songId);
      }
    }

    async function loadFavoriteStatuses() {
      const token = localStorage.getItem('auth_token');
      if (!token) return;
      document.querySelectorAll('.btn-like-song').forEach(async (btn) => {
        const b = btn as HTMLElement;
        const songId = b.dataset.id;
        if (!songId) return;
        try {
          const res = await apiFetch(`/favorites/${songId}/is-favorite`);
          setLikeState(b, !!res.data?.isFavorite);
        } catch {}
      });
    }

    window.addEventListener('favorites:changed', (e: any) => {
      const { songId, isFavorite } = e.detail;
      document.querySelectorAll(`.btn-like-song[data-id="${songId}"]`).forEach((btn) => {
        setLikeState(btn as HTMLElement, isFavorite);
      });
    });

    Promise.all([
      loadHero(),
      loadTrending().then(() => setTimeout(loadFavoriteStatuses, 500)),
      loadArtists(),
      loadReleases(),
      loadRecentlyPlayed(),
      loadArtistMembers(),
    ]);
  }

  document.removeEventListener('astro:page-load', initHomePage);
  document.addEventListener('astro:page-load', initHomePage);
</script>

</MainLayout>
