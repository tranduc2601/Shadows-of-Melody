---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import PlayerBar from "../components/PlayerBar.astro";
---

<MainLayout title="Shadows of Melody - Home">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">
    
    <Sidebar currentPage="home" />

    <!-- Main Content -->
    <main class="flex-1 flex flex-col relative overflow-hidden bg-linear-to-br from-[#0c1328] via-[#060e20] to-[#040813]">
      <!-- Background Ambient Glow -->
      <div class="absolute top-[-10%] left-[-10%] w-[60%] h-[60%] bg-indigo-600/10 blur-[150px] rounded-full pointer-events-none"></div>
      <div class="absolute bottom-[20%] right-[-10%] w-[40%] h-[40%] bg-purple-600/10 blur-[120px] rounded-full pointer-events-none"></div>

      <!-- Header -->
      <header class="h-20 shrink-0 flex items-center justify-between px-6 lg:px-8 relative z-10 w-full transition-all duration-300">
        <!-- Mobile Menu Button -->
        <button class="md:hidden w-10 h-10 rounded-full bg-white/5 flex items-center justify-center mr-4 text-white">
           <span class="material-symbols-outlined">menu</span>
        </button>

        <div class="flex items-center gap-4 flex-1">
          <div class="hidden sm:flex items-center gap-2 text-gray-400">
            <button class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-white/10 hover:text-white transition-all backdrop-blur-md">
              <span class="material-symbols-outlined text-[20px]">arrow_back_ios_new</span>
            </button>
            <button class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-white/10 hover:text-white transition-all backdrop-blur-md opacity-50 cursor-not-allowed">
              <span class="material-symbols-outlined text-[20px]">arrow_forward_ios</span>
            </button>
          </div>

          <div class="relative w-full max-w-md sm:ml-4 group">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-purple-400 transition-colors">search</span>
            <input 
              type="text" 
              placeholder="Search for artists, songs, or podcasts..."
              class="w-full bg-white/5 border border-white/10 text-white placeholder-gray-500 rounded-full py-2.5 pl-12 pr-4 focus:outline-none focus:ring-2 focus:ring-purple-500/50 focus:bg-white/10 transition-all backdrop-blur-md shadow-inner"
            />
          </div>
        </div>

        <div class="flex items-center gap-4 ml-4">
          <button class="w-10 h-10 rounded-full bg-white/5 border border-white/5 flex items-center justify-center hover:bg-white/10 hover:text-white transition-all backdrop-blur-md relative group">
            <span class="material-symbols-outlined text-gray-300 group-hover:text-white transition-colors">notifications</span>
            <span class="absolute top-2.5 right-2.5 w-2 h-2 rounded-full bg-pink-500 shadow-[0_0_8px_rgba(236,72,153,0.8)]"></span>
          </button>
        </div>
      </header>

      <!-- Scrollable Content -->
      <div class="flex-1 overflow-y-auto px-6 lg:px-8 pb-32 pt-4 relative z-10 custom-scrollbar scroll-smooth">
        
        <!-- Hero Section -->
        <section class="mb-10 group cursor-pointer relative z-20">
          <div class="relative rounded-4xl overflow-hidden bg-linear-to-r from-indigo-900 to-purple-900 shadow-2xl shadow-purple-900/20 p-8 md:p-12 min-h-85 flex flex-col justify-end transition-all duration-500 hover:shadow-purple-900/40">
            <!-- Decorative abstract background for hero -->
            <div class="absolute inset-0 opacity-40 mix-blend-overlay pointer-events-none">
               <div class="absolute right-0 top-0 w-full h-full bg-[radial-gradient(circle_at_top_right,var(--tw-gradient-stops))] from-pink-500/60 via-transparent to-transparent"></div>
               <div class="absolute -bottom-24 -right-24 w-125 h-125 bg-indigo-500 rounded-full blur-[100px]"></div>
               <!-- Hexagon Grid Pattern Overlay (subtle) -->
               <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')]"></div>
            </div>
            
            <div class="relative z-10 max-w-2xl">
              <div class="flex items-center gap-3 mb-4">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-white/10 backdrop-blur-md rounded-full text-[11px] font-bold tracking-widest text-white border border-white/20 uppercase">
                     <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
                     New Release
                  </span>
                  <span class="text-sm font-medium text-purple-200">Featured Artist</span>
              </div>
              
              <h1 class="text-5xl md:text-7xl font-black text-white mb-4 tracking-tight drop-shadow-xl">Midnight<br/><span class="text-transparent bg-clip-text bg-linear-to-r from-purple-400 to-pink-300">Reverie</span></h1>
              <p class="text-lg md:text-xl text-indigo-100/80 mb-8 max-w-lg leading-relaxed font-light">Experience the ultimate sonic journey through neon-lit streets and synthwave dreams.</p>
              
              <div class="flex items-center gap-4">
                <button class="bg-linear-to-r from-purple-500 to-indigo-600 hover:from-purple-400 hover:to-indigo-500 text-white rounded-full py-3.5 px-8 font-bold flex items-center gap-2 transition-all shadow-[0_8px_30px_rgba(168,85,247,0.4)] hover:shadow-[0_8px_30px_rgba(168,85,247,0.6)]">
                  <span class="material-symbols-outlined fill-current text-[24px]">play_arrow</span>
                  Play Listen
                </button>
                <button class="bg-white/5 hover:bg-white/15 backdrop-blur-md border border-white/20 text-white rounded-full py-3.5 px-8 font-bold transition-all">
                  Follow
                </button>
              </div>
            </div>

            <!-- Absolute decorative visual (like a floating vinyl or element) -->
            <div class="absolute right-12 top-1/2 -translate-y-1/2 w-64 h-64 bg-linear-to-tr from-purple-500/20 to-pink-500/20 rounded-full blur-3xl group-hover:blur-[60px] transition-all duration-700 pointer-events-none"></div>
          </div>
        </section>

        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
          
          <!-- Left Column (Trending) -->
          <div class="xl:col-span-2">
            <div class="flex items-end justify-between mb-6">
               <h2 class="text-2xl font-bold text-white flex items-center gap-2">
                  Trending Now
               </h2>
               <button class="text-sm font-semibold text-purple-400 hover:text-purple-300 transition-colors uppercase tracking-wider">See All</button>
            </div>

            <div class="bg-white/2 border border-white/5 rounded-3xl p-3 backdrop-blur-sm">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="text-gray-400 border-b border-white/5">
                    <th class="font-medium text-sm px-4 py-3 w-12 text-center pb-4">#</th>
                    <th class="font-medium text-sm px-4 py-3 pb-4">Title</th>
                    <th class="font-medium text-sm px-4 py-3 hidden sm:table-cell pb-4 text-right pr-12">Plays</th>
                    <th class="font-medium text-sm px-4 py-3 w-20 text-center pb-4"><span class="material-symbols-outlined text-[18px]">schedule</span></th>
                  </tr>
                </thead>
                <tbody id="trending-tbody">
                  <tr><td colspan="4" class="px-4 py-8 text-center text-gray-500 text-sm">Loading...</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Right Column (Top Artists) -->
          <div>
            <div class="flex items-end justify-between mb-6">
               <h2 class="text-xl font-bold text-white">Top Artists</h2>
            </div>

            <div id="artists-grid" class="grid grid-cols-2 gap-4">
              <div class="col-span-2 text-gray-500 text-sm text-center py-4">Loading...</div>
            </div>
          </div>
        </div>

        <!-- New Releases Grid -->
        <div class="mt-14">
            <div class="flex items-end justify-between mb-6">
               <h2 class="text-2xl font-bold text-white">New Releases</h2>
               <div class="flex gap-2">
                  <button class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-colors">
                     <span class="material-symbols-outlined text-sm">arrow_back</span>
                  </button>
                  <button class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-colors">
                     <span class="material-symbols-outlined text-sm">arrow_forward</span>
                  </button>
               </div>
            </div>

            <div id="releases-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
              <div class="col-span-5 text-gray-500 text-sm text-center py-4">Loading...</div>
            </div>
        </div>

        <!-- Artist Members -->
        <div class="mt-14" id="artist-members-section">
          <div class="flex items-end justify-between mb-6">
            <h2 class="text-2xl font-bold text-white flex items-center gap-2">
              <span class="material-symbols-outlined text-purple-400">mic</span>
              Artist Members
            </h2>
          </div>
          <div id="artist-members-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-5">
            <div class="col-span-6 text-gray-500 text-sm text-center py-4">Loading...</div>
          </div>
        </div>

      </div>

      <PlayerBar />
    </main>
  </div>

  <style>
    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.1);
      border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.3);
    }
    
    /* Smooth utilities for outlines */
    .material-symbols-outlined {
      font-variation-settings:
      'FILL' 0,
      'wght' 400,
      'GRAD' 0,
      'opsz' 24
    }
  </style>
<script>
  import { apiFetch, formatDuration, formatCount } from '../lib/api.js';
  import { player } from '../lib/player.js';

  const GRADIENTS_HEX = [
    'linear-gradient(135deg,#6366f1,#8b5cf6)',
    'linear-gradient(135deg,#f43f5e,#f97316)',
    'linear-gradient(135deg,#ec4899,#7c3aed)',
    'linear-gradient(135deg,#ef4444,#d946ef)',
    'linear-gradient(135deg,#3b82f6,#06b6d4)',
    'linear-gradient(135deg,#06b6d4,#10b981)',
    'linear-gradient(135deg,#d946ef,#7c3aed)',
    'linear-gradient(135deg,#fb923c,#fb7185)',
    'linear-gradient(135deg,#34d399,#22d3ee)',
    'linear-gradient(135deg,#f59e0b,#f97316)',
  ];

  async function loadHome() {
    // Trending songs
    const tbody = document.getElementById('trending-tbody');
    try {
      const { data: songs } = await apiFetch('/songs?limit=10');
      if (tbody) {
        if (!songs?.length) {
          tbody.innerHTML = '<tr><td colspan="4" class="px-4 py-8 text-center text-gray-500">Chưa có bài hát nào.</td></tr>';
        } else {
          tbody.innerHTML = songs.map((s: any, i: number) => {
            const grad = GRADIENTS_HEX[(s.id - 1) % GRADIENTS_HEX.length];
            const cover = s.cover_url
              ? `<img src="${s.cover_url}" class="w-12 h-12 rounded-lg shadow-lg shrink-0 object-cover" alt=""/>`
              : `<div class="w-12 h-12 rounded-lg shadow-lg shrink-0" style="background:${grad}"></div>`;
            return `
              <tr class="group hover:bg-white/5 transition-colors cursor-pointer song-row" data-song="${encodeURIComponent(JSON.stringify(s))}">
                <td class="px-4 py-3 text-center rounded-l-xl">
                  <span class="text-gray-500 font-medium group-hover:hidden">${i + 1}</span>
                  <span class="material-symbols-outlined text-purple-400 hidden group-hover:block animate-pulse">play_arrow</span>
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-4">
                    ${cover}
                    <div class="min-w-0">
                      <p class="font-semibold text-gray-100 group-hover:text-purple-400 transition-colors truncate text-[15px]">${s.title}</p>
                      <p class="text-xs text-gray-400 truncate mt-0.5">${s.artist_names || 'Unknown'}</p>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3 text-sm text-gray-400 hidden sm:table-cell text-right pr-12 font-medium">${formatCount(s.plays_count)}</td>
                <td class="px-4 py-3 text-sm text-gray-400 text-center">${formatDuration(s.duration)}</td>
                <td class="px-4 py-3 rounded-r-xl">
                  <button class="btn-like-song w-8 h-8 flex items-center justify-center text-gray-500 hover:text-pink-500 transition-colors opacity-0 group-hover:opacity-100"
                          data-id="${s.id}" data-liked="false" title="Yêu thích" onclick="event.stopPropagation()">
                    <span class="material-symbols-outlined text-[20px]">favorite_border</span>
                  </button>
                </td>
              </tr>`;
          }).join('');
        }
      }
    } catch {
      if (tbody) tbody.innerHTML = '<tr><td colspan="4" class="px-4 py-8 text-center text-red-400 text-sm">Cannot fetch data.</td></tr>';
    }

    // Top artists
    const artistsGrid = document.getElementById('artists-grid');
    try {
      const { data: artists } = await apiFetch('/artists?limit=4');
      if (artistsGrid && artists?.length) {
        artistsGrid.innerHTML = artists.slice(0, 4).map((a: any) => {
          const grad = GRADIENTS_HEX[(a.id - 1) % GRADIENTS_HEX.length];
          const img = a.image_url
            ? `<img src="${a.image_url}" class="w-full h-full object-cover" alt=""/>`
            : '';
          return `
            <div class="bg-white/5 border border-white/5 rounded-3xl p-5 flex flex-col items-center gap-3 hover:bg-white/8 hover:border-white/10 transition-all cursor-pointer group">
              <div class="w-24 h-24 rounded-full overflow-hidden relative shadow-lg" style="background:${grad}">
                ${img}
                <div class="absolute inset-0 opacity-0 group-hover:opacity-100 bg-black/40 flex items-center justify-center transition-opacity">
                  <span class="material-symbols-outlined text-white text-4xl">play_circle</span>
                </div>
              </div>
              <div class="text-center mt-2">
                <p class="font-bold text-[15px] text-gray-100 group-hover:text-purple-300 transition-colors">${a.name}</p>
                <p class="text-xs text-gray-500 mt-0.5">${formatCount(a.followers_count)} fans</p>
              </div>
            </div>`;
        }).join('');
      }
    } catch {}

    // New releases (albums)
    const releasesGrid = document.getElementById('releases-grid');    try {
      const { data: albums } = await apiFetch('/albums?limit=5');
      if (releasesGrid && albums?.length) {
        releasesGrid.innerHTML = albums.slice(0, 5).map((al: any) => {
          const grad = GRADIENTS_HEX[(al.id - 1) % GRADIENTS_HEX.length];
          const cover = al.cover_url
            ? `<img src="${al.cover_url}" class="absolute inset-0 w-full h-full object-cover" alt=""/>`
            : '';
          const year = al.release_date ? new Date(al.release_date).getFullYear() : '';
          return `
            <div class="group cursor-pointer">
              <div class="w-full aspect-square rounded-2xl shadow-lg mb-4 relative overflow-hidden" style="background:${grad}">
                ${cover}
                <div class="absolute top-3 left-3 bg-black/30 backdrop-blur-md px-2 py-1 rounded-md text-[10px] font-bold text-white/90 uppercase tracking-widest border border-white/10">Album</div>
                <div class="absolute bottom-4 right-4 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-4 group-hover:translate-y-0 z-10">
                  <button class="w-12 h-12 rounded-full bg-purple-500 text-white flex items-center justify-center hover:scale-110 shadow-lg">
                    <span class="material-symbols-outlined text-[24px]">play_arrow</span>
                  </button>
                </div>
              </div>
              <h3 class="font-bold text-[15px] text-gray-100 truncate group-hover:text-purple-400 transition-colors">${al.title}</h3>
              <p class="text-[13px] text-gray-400 truncate mt-0.5">${year}</p>
            </div>`;
        }).join('');
      }
    } catch {}
  }

  loadHome();

  // ── Artist Members ────────────────────────────────────────────────────────────
  async function loadArtistMembers() {
    const grid = document.getElementById('artist-members-grid');
    const section = document.getElementById('artist-members-section');
    if (!grid) return;
    try {
      const { data: members } = await apiFetch('/artists/members?limit=12');
      if (!members?.length) {
        if (section) section.classList.add('hidden');
        return;
      }
      grid.innerHTML = members.map((m: any) => {
        const initials = (m.username || m.full_name || '?').slice(0, 2).toUpperCase();
        const grad = GRADIENTS_HEX[(m.id - 1) % GRADIENTS_HEX.length];
        return `
          <div class="flex flex-col items-center gap-3 cursor-pointer group">
            <div class="w-20 h-20 rounded-full overflow-hidden shadow-md ring-2 ring-white/5 group-hover:ring-purple-500/40 transition-all"
                 style="background:${grad}">
              ${m.avatar_url
                ? `<img src="${m.avatar_url}" class="w-full h-full object-cover" alt="" />`
                : `<div class="w-full h-full flex items-center justify-center text-white font-bold text-lg">${initials}</div>`}
            </div>
            <div class="text-center">
              <p class="text-sm font-semibold text-gray-200 group-hover:text-purple-300 transition-colors truncate max-w-[80px]">${m.full_name || m.username || '—'}</p>
              <span class="inline-flex items-center gap-1 text-[10px] font-bold text-purple-400 bg-purple-500/10 px-2 py-0.5 rounded-full mt-1">
                <span class="material-symbols-outlined text-[10px]">mic</span>Artist
              </span>
            </div>
          </div>`;
      }).join('');
    } catch {
      if (section) section.classList.add('hidden');
    }
  }

  loadArtistMembers();

  // ── Favorites helpers ────────────────────────────────────────────────────────
  async function toggleLike(btn: HTMLElement) {
    const token = localStorage.getItem('auth_token');
    if (!token) { window.location.href = '/login'; return; }
    const songId  = btn.dataset.id;
    const isLiked = btn.dataset.liked === 'true';
    const icon    = btn.querySelector('.material-symbols-outlined') as HTMLElement;
    try {
      if (isLiked) {
        await apiFetch(`/favorites/${songId}`, { method: 'DELETE' });
        btn.dataset.liked = 'false';
        if (icon) icon.textContent = 'favorite_border';
        btn.classList.remove('text-pink-500');
        btn.classList.add('text-gray-500');
      } else {
        await apiFetch('/favorites', { method: 'POST', body: JSON.stringify({ song_id: songId }) });
        btn.dataset.liked = 'true';
        if (icon) icon.textContent = 'favorite';
        btn.classList.add('text-pink-500');
        btn.classList.remove('text-gray-500');
      }
      window.dispatchEvent(new CustomEvent('favorites:changed', {
        detail: { songId: Number(songId), isFavorite: !isLiked },
      }));
    } catch {}
  }

  // Pre-load favorite status for visible songs
  async function loadFavoriteStatuses() {
    const token = localStorage.getItem('auth_token');
    if (!token) return;
    document.querySelectorAll('.btn-like-song').forEach(async (btn) => {
      const b = btn as HTMLElement;
      const songId = b.dataset.id;
      if (!songId) return;
      try {
        const res = await apiFetch(`/favorites/${songId}/is-favorite`);
        if (res.data?.isFavorite) {
          b.dataset.liked = 'true';
          const icon = b.querySelector('.material-symbols-outlined') as HTMLElement;
          if (icon) icon.textContent = 'favorite';
          b.classList.add('text-pink-500');
          b.classList.remove('text-gray-500');
        }
      } catch {}
    });
  }

  // Song click handlers (delegated)
  document.getElementById('trending-tbody')?.addEventListener('click', (e) => {
    const likeBtn = (e.target as HTMLElement).closest('.btn-like-song') as HTMLElement;
    if (likeBtn) { toggleLike(likeBtn); return; }
    const row = (e.target as HTMLElement).closest('.song-row') as HTMLElement;
    if (!row) return;
    try {
      const song = JSON.parse(decodeURIComponent(row.dataset.song || ''));
      const allRows = Array.from(document.querySelectorAll('.song-row'));
      const queue = allRows.map(r => {
        try { return JSON.parse(decodeURIComponent((r as HTMLElement).dataset.song || '')); } catch { return null; }
      }).filter(Boolean);
      player.playSong(song, queue);
    } catch {}
  });

  // Sync like button when PlayerBar fires favorites:changed
  window.addEventListener('favorites:changed', (e: any) => {
    const { songId, isFavorite } = e.detail;
    document.querySelectorAll(`.btn-like-song[data-id="${songId}"]`).forEach((btn) => {
      const b = btn as HTMLElement;
      b.dataset.liked = String(isFavorite);
      const icon = b.querySelector('.material-symbols-outlined') as HTMLElement;
      if (icon) icon.textContent = isFavorite ? 'favorite' : 'favorite_border';
      b.classList.toggle('text-pink-500', isFavorite);
      b.classList.toggle('text-gray-500', !isFavorite);
    });
  });

  // Load favorites after songs are rendered
  setTimeout(loadFavoriteStatuses, 500);
</script>

</MainLayout>