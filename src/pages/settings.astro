---
import MainLayout from "../layouts/MainLayout.astro";

const categories = [
  { id: "account",       label: "Tài khoản",  icon: "manage_accounts" },
  { id: "audio",         label: "Âm thanh",   icon: "tune"             },
  { id: "appearance",    label: "Giao diện",   icon: "palette"          },
  { id: "notifications", label: "Thông báo",   icon: "notifications"    },
  { id: "privacy",       label: "Riêng tư",    icon: "lock"             },
  { id: "storage",       label: "Lưu trữ",     icon: "storage"          },
];
---

<MainLayout title="Cài đặt - Shadows of Melody">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">

    <!-- App Sidebar -->
    <aside class="w-64 shrink-0 border-r border-white/5 bg-[#0a1229]/80 backdrop-blur-xl hidden md:flex md:flex-col z-40">
      <div class="h-20 flex items-center px-6">
        <a href="/" class="text-2xl font-black bg-clip-text text-transparent bg-linear-to-r from-indigo-400 to-purple-400 flex items-center gap-2">
          <span class="material-symbols-outlined text-purple-400 animate-pulse">music_note</span>
          Melody
        </a>
      </div>

      <div class="px-4 py-6 flex-1 overflow-y-auto">
        <p class="px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Menu</p>
        <nav class="space-y-1 mb-8">
          <a href="/" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">home</span>Home
          </a>
          <a href="/search" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">search</span>Tìm Kiếm
          </a>
          <a href="/artists" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">person</span>Nghệ Sĩ
          </a>
        </nav>

        <p class="px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Library</p>
        <nav class="space-y-1">
          <a href="/liked" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform text-rose-400">favorite</span>Liked Songs
          </a>
          <a href="/playlist" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">queue_music</span>Playlists
          </a>
        </nav>
      </div>

      <div class="p-4 border-t border-white/5">
        <div class="flex items-center gap-3 p-2 rounded-xl hover:bg-white/5 transition-colors">
          <a href="/profile" class="flex items-center gap-3 flex-1 min-w-0">
            <div class="w-10 h-10 rounded-full bg-linear-to-tr from-purple-500 to-pink-500 p-0.5 shrink-0">
              <div class="w-full h-full rounded-full bg-[#0a1229] flex items-center justify-center">
                <span class="material-symbols-outlined text-purple-400">person</span>
              </div>
            </div>
            <div class="min-w-0">
              <p id="sidebar-user-name" class="text-sm font-semibold text-white truncate">—</p>
              <p class="text-xs text-purple-400 font-medium truncate">Premium</p>
            </div>
          </a>
          <!-- Active: Settings -->
          <a href="/settings" class="shrink-0 text-purple-400 p-1 rounded-lg bg-white/5">
            <span class="material-symbols-outlined text-[20px]">settings</span>
          </a>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex overflow-hidden bg-linear-to-br from-[#0c1328] via-[#060e20] to-[#040813] relative">
      <!-- Ambient Glow -->
      <div class="absolute top-0 right-0 w-[40%] h-[40%] bg-indigo-900/10 blur-[150px] rounded-full pointer-events-none"></div>

      <!-- Settings Sidebar (categories) -->
      <div class="w-64 shrink-0 border-r border-white/5 flex flex-col py-8 px-4 overflow-y-auto custom-scrollbar">
        <h1 class="text-xl font-bold text-white px-4 mb-6">Cài đặt</h1>
        <nav class="space-y-1">
          {categories.map((cat, i) => (
            <button
              type="button"
              class={`w-full flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-sm transition-all text-left ${
                i === 0
                  ? "bg-linear-to-r from-purple-500/20 to-transparent text-white shadow-[inset_2px_0_0_0_rgba(168,85,247,1)]"
                  : "text-gray-400 hover:text-white hover:bg-white/5"
              }`}
            >
              <span class={`material-symbols-outlined text-[20px] ${i === 0 ? "text-purple-400" : ""}`}>{cat.icon}</span>
              {cat.label}
            </button>
          ))}
        </nav>

        <!-- Danger zone -->
        <div class="mt-auto pt-8">
          <div class="border-t border-white/5 pt-6">
            <button type="button" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-sm text-red-400 hover:text-red-300 hover:bg-red-500/5 transition-all text-left">
              <span class="material-symbols-outlined text-[20px]">logout</span>
              Đăng xuất
            </button>
          </div>
        </div>
      </div>

      <!-- Settings Content -->
      <div class="flex-1 overflow-y-auto py-8 px-8 custom-scrollbar relative z-10 pb-32">

        <!-- Account Settings -->
        <div class="max-w-2xl">
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-white mb-1">Tài khoản</h2>
            <p class="text-gray-500 text-sm">Quản lý thông tin cá nhân và bảo mật tài khoản của bạn.</p>
          </div>

          <!-- Avatar Section -->
          <div class="bg-white/3 border border-white/5 rounded-3xl p-6 mb-5">
            <h3 class="text-sm font-bold text-gray-300 uppercase tracking-wider mb-5">Ảnh đại diện</h3>
            <div class="flex items-center gap-6">
            <div id="avatar-display" class="w-20 h-20 rounded-full bg-linear-to-tr from-purple-500 to-pink-500 p-0.5 shrink-0 shadow-lg shadow-purple-500/20">
                <div class="w-full h-full rounded-full bg-[#0a1229] flex items-center justify-center overflow-hidden" id="avatar-inner">
                  <span class="material-symbols-outlined text-purple-300" style="font-size: 2.5rem;">person</span>
                </div>
              </div>
              <div class="flex flex-col gap-2">
                <button id="upload-avatar-btn" type="button" class="flex items-center gap-2 px-4 py-2 bg-white/5 border border-white/10 hover:bg-white/10 text-white rounded-xl text-sm font-medium transition-all">
                  <span class="material-symbols-outlined text-[16px]">upload</span>
                  Tải ảnh lên
                </button>
                <button id="delete-avatar-btn" type="button" class="flex items-center gap-2 px-4 py-2 text-red-400 hover:text-red-300 hover:bg-red-500/5 rounded-xl text-sm font-medium transition-all">
                  <span class="material-symbols-outlined text-[16px]">delete</span>
                  Xóa ảnh
                </button>
                <input id="avatar-file-input" type="file" accept="image/jpeg,image/png,image/webp" class="hidden" />
              </div>
            </div>
          </div>

          <!-- Profile Info -->
          <div class="bg-white/3 border border-white/5 rounded-3xl p-6 mb-5">
            <h3 class="text-sm font-bold text-gray-300 uppercase tracking-wider mb-5">Personal Information</h3>
            <div class="space-y-4">
              <div class="flex flex-col gap-1.5">
                <label for="username" class="text-sm font-medium text-gray-400">Username</label>
                <input
                  id="username"
                  type="text"
                  placeholder="Enter your username"
                  maxlength="32"
                  class="w-full bg-white/5 border border-white/10 text-white rounded-xl py-2.5 px-4 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/50 focus:border-purple-500/50 transition-all placeholder-gray-600"
                />
              </div>
              <div class="flex justify-end">
                <button id="save-profile-btn" type="button" class="bg-linear-to-r from-purple-500 to-indigo-600 hover:from-purple-400 hover:to-indigo-500 text-white rounded-xl py-2.5 px-6 font-semibold text-sm transition-all hover:scale-105 shadow-[0_4px_20px_rgba(168,85,247,0.3)]">
                  Save Changes
                </button>
              </div>
            </div>
          </div>

          <!-- Security -->
          <div class="bg-white/3 border border-white/5 rounded-3xl p-6 mb-5">
            <h3 class="text-sm font-bold text-gray-300 uppercase tracking-wider mb-5">Bảo mật</h3>
            <div class="space-y-4">
              <div class="flex flex-col gap-1.5">
                <label for="current-password" class="text-sm font-medium text-gray-400">Mật khẩu hiện tại</label>
                <input
                  id="current-password"
                  type="password"
                  placeholder="••••••••"
                  autocomplete="current-password"
                  class="w-full bg-white/5 border border-white/10 text-white rounded-xl py-2.5 px-4 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/50 focus:border-purple-500/50 transition-all placeholder-gray-600"
                />
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="flex flex-col gap-1.5">
                  <label for="new-password" class="text-sm font-medium text-gray-400">Mật khẩu mới</label>
                  <input
                    id="new-password"
                    type="password"
                    placeholder="••••••••"
                    autocomplete="new-password"
                    class="w-full bg-white/5 border border-white/10 text-white rounded-xl py-2.5 px-4 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/50 focus:border-purple-500/50 transition-all placeholder-gray-600"
                  />
                </div>
                <div class="flex flex-col gap-1.5">
                  <label for="confirm-password" class="text-sm font-medium text-gray-400">Xác nhận mật khẩu</label>
                  <input
                    id="confirm-password"
                    type="password"
                    placeholder="••••••••"
                    autocomplete="new-password"
                    class="w-full bg-white/5 border border-white/10 text-white rounded-xl py-2.5 px-4 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/50 focus:border-purple-500/50 transition-all placeholder-gray-600"
                  />
                </div>
              </div>
              <div class="flex justify-end">
                <button id="change-password-btn" type="button" class="flex items-center gap-2 px-6 py-2.5 bg-white/5 border border-white/10 hover:bg-white/10 text-white rounded-xl text-sm font-semibold transition-all">
                  <span class="material-symbols-outlined text-[16px]">lock_reset</span>
                  Đổi mật khẩu
                </button>
              </div>
            </div>
          </div>

          <!-- Subscription -->
          <div class="bg-white/3 border border-white/5 rounded-3xl p-6 mb-5">
            <h3 class="text-sm font-bold text-gray-300 uppercase tracking-wider mb-5">Gói dịch vụ</h3>
            <div class="flex items-center justify-between p-4 bg-linear-to-r from-purple-500/15 to-pink-500/10 border border-purple-500/20 rounded-2xl">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-linear-to-br from-purple-500 to-pink-500 flex items-center justify-center shadow-lg shadow-purple-500/30">
                  <span class="material-symbols-outlined text-white text-[22px]">workspace_premium</span>
                </div>
                <div>
                  <p class="font-bold text-white">Premium</p>
                  <p class="text-xs text-gray-400 mt-0.5">Gia hạn: 3 tháng 5, 2026</p>
                </div>
              </div>
              <button type="button" class="px-4 py-2 bg-white/10 hover:bg-white/15 border border-white/10 text-white text-sm font-medium rounded-xl transition-all">
                Quản lý
              </button>
            </div>
          </div>

          <!-- Toggle Settings (Audio / Notifications snippets) -->
          <div class="bg-white/3 border border-white/5 rounded-3xl p-6 mb-5">
            <h3 class="text-sm font-bold text-gray-300 uppercase tracking-wider mb-5">Âm thanh nhanh</h3>
            <div class="space-y-4">
              {[
                { label: "Chất lượng cao (320kbps)", desc: "Tốn nhiều dữ liệu hơn", enabled: true  },
                { label: "Tải xuống offline",          desc: "Chỉ khi kết nối Wi-Fi", enabled: true  },
                { label: "Equalizer tự động",          desc: "Tối ưu âm thanh theo thể loại", enabled: false },
                { label: "Chuẩn hóa âm lượng",         desc: "Giữ âm lượng nhất quán giữa các bài", enabled: true  },
              ].map((setting) => (
                <div class="flex items-center justify-between py-1">
                  <div>
                    <p class="text-sm font-medium text-gray-200">{setting.label}</p>
                    <p class="text-xs text-gray-500 mt-0.5">{setting.desc}</p>
                  </div>
                  <!-- Toggle switch (CSS only, decorative) -->
                  <div
                    role="switch"
                    aria-checked={setting.enabled}
                    aria-label={setting.label}
                    class={`relative w-12 h-6 rounded-full cursor-pointer transition-colors ${setting.enabled ? "bg-purple-500" : "bg-white/10"}`}
                  >
                    <div class={`absolute top-1 w-4 h-4 bg-white rounded-full shadow transition-all ${setting.enabled ? "left-7" : "left-1"}`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Notifications -->
          <div class="bg-white/3 border border-white/5 rounded-3xl p-6 mb-5">
            <h3 class="text-sm font-bold text-gray-300 uppercase tracking-wider mb-5">Thông báo</h3>
            <div class="space-y-4">
              {[
                { label: "Phát hành mới từ nghệ sĩ yêu thích", enabled: true  },
                { label: "Gợi ý playlist hàng tuần",           enabled: true  },
                { label: "Cập nhật tính năng",                 enabled: false },
                { label: "Hoạt động từ bạn bè",               enabled: true  },
              ].map((n) => (
                <div class="flex items-center justify-between py-1">
                  <p class="text-sm font-medium text-gray-200">{n.label}</p>
                  <div
                    role="switch"
                    aria-checked={n.enabled}
                    aria-label={n.label}
                    class={`relative w-12 h-6 rounded-full cursor-pointer transition-colors ${n.enabled ? "bg-purple-500" : "bg-white/10"}`}
                  >
                    <div class={`absolute top-1 w-4 h-4 bg-white rounded-full shadow transition-all ${n.enabled ? "left-7" : "left-1"}`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Artist Access Request -->
          <div id="artist-request-section" class="hidden bg-indigo-950/20 border border-indigo-500/15 rounded-3xl p-6 mb-5">
            <h3 class="text-sm font-bold text-indigo-400 uppercase tracking-wider mb-1">🎤 Trở thành Nghệ Sĩ</h3>
            <p class="text-xs text-gray-500 mb-4">Gửi yêu cầu để được phê duyệt tài khoản nghệ sĩ và tải nhạc lên nền tảng.</p>
            <div class="flex items-center justify-between gap-4 flex-wrap">
              <div id="artist-request-status" class="text-sm text-gray-400 flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px] text-indigo-400">info</span>
                Tài khoản của bạn chưa đăng ký làm nghệ sĩ.
              </div>
              <button id="settings-artist-request-btn" type="button"
                class="flex items-center gap-2 px-5 py-2.5 bg-indigo-500/15 border border-indigo-500/30 hover:bg-indigo-500/25 text-indigo-300 rounded-xl font-semibold text-sm transition-all">
                <span class="material-symbols-outlined text-[18px]">star</span>
                <span id="settings-artist-label">Gửi yêu cầu</span>
              </button>
            </div>
          </div>

          <!-- Danger Zone -->
          <div class="bg-red-950/20 border border-red-500/10 rounded-3xl p-6">
            <h3 class="text-sm font-bold text-red-400 uppercase tracking-wider mb-5">Vùng nguy hiểm</h3>
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-200">Xóa tài khoản</p>
                <p class="text-xs text-gray-500 mt-0.5">Hành động này không thể hoàn tác. Tất cả dữ liệu sẽ bị xóa vĩnh viễn.</p>
              </div>
              <button type="button" class="px-4 py-2 border border-red-500/30 text-red-400 hover:bg-red-500/10 hover:border-red-400/50 rounded-xl text-sm font-medium transition-all shrink-0 ml-4">
                Xóa tài khoản
              </button>
            </div>
          </div>

        </div>
      </div>
    </main>
  </div>

  <style>
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.3); }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
  </style>

<script>
  import { apiFetch, getUser, setAuth, getToken, clearAuth, getUserRole, getCachedMe, setCachedMe, refreshMe } from '../lib/api.js';

  // ── Toast helper ─────────────────────────────────────────────────────────────
  let _toastTimer: ReturnType<typeof setTimeout> | null = null;
  function showToast(msg: string, type: 'success' | 'error' | 'info' = 'info') {
    let toast = document.getElementById('settings-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'settings-toast';
      toast.className = 'fixed bottom-8 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 transition-opacity duration-300';
      toast.innerHTML = `<div class="flex items-center gap-3 bg-[#1e2a45] border border-white/10 text-white text-sm font-medium px-5 py-3 rounded-2xl shadow-2xl backdrop-blur-md whitespace-nowrap">
        <span id="settings-toast-icon" class="material-symbols-outlined text-[18px]">info</span>
        <span id="settings-toast-msg"></span>
      </div>`;
      document.body.appendChild(toast);
    }
    const msgEl  = document.getElementById('settings-toast-msg')!;
    const iconEl = document.getElementById('settings-toast-icon')!;
    msgEl.textContent  = msg;
    iconEl.textContent = type === 'success' ? 'check_circle' : type === 'error' ? 'error' : 'info';
    iconEl.className   = `material-symbols-outlined text-[18px] ${type === 'success' ? 'text-green-400' : type === 'error' ? 'text-red-400' : 'text-blue-400'}`;
    toast.classList.remove('opacity-0');
    toast.classList.add('opacity-100');
    if (_toastTimer) clearTimeout(_toastTimer);
    _toastTimer = setTimeout(() => {
      toast!.classList.remove('opacity-100');
      toast!.classList.add('opacity-0');
    }, 3000);
  }

  // ── Load user data ─────────────────────────────────────────────────────────
  function applySidebarCache(user: any) {
    if (!user) return;
    const sidebarName = document.getElementById('sidebar-user-name') as HTMLElement;
    if (sidebarName) sidebarName.textContent = user.full_name || user.username || '—';
  }

  async function loadUser() {
    try {
      // Paint cache first so sidebar doesn't flicker
      applySidebarCache(getCachedMe());

      const { data: user } = await apiFetch('/auth/me');
      setCachedMe(user);
      const sidebarName = document.getElementById('sidebar-user-name') as HTMLElement;
      if (sidebarName) sidebarName.textContent = user.full_name || user.username || '—';

      const usernameInput = document.getElementById('username') as HTMLInputElement;
      if (usernameInput) usernameInput.value = user.username || '';

      if (user.avatar_url) setAvatarPreview(user.avatar_url);
    } catch {}
  }

  function setAvatarPreview(url: string | null) {
    const inner = document.getElementById('avatar-inner') as HTMLElement;
    if (!inner) return;
    if (url) {
      inner.innerHTML = `<img src="${url}" class="w-full h-full object-cover rounded-full" alt="Avatar" />`;
    } else {
      inner.innerHTML = `<span class="material-symbols-outlined text-purple-300" style="font-size:2.5rem">person</span>`;
    }
  }

  // ── Avatar upload ──────────────────────────────────────────────────────────
  const uploadBtn  = document.getElementById('upload-avatar-btn') as HTMLButtonElement;
  const deleteBtn  = document.getElementById('delete-avatar-btn') as HTMLButtonElement;
  const fileInput  = document.getElementById('avatar-file-input') as HTMLInputElement;

  uploadBtn?.addEventListener('click', () => fileInput?.click());

  fileInput?.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    uploadBtn.textContent = 'Đang tải...';
    uploadBtn.disabled = true;
    try {
      const form = new FormData();
      form.append('avatar', file);
      const token = getToken();
      const res = await fetch('http://localhost:5000/api/auth/upload-avatar', {
        method: 'POST',
        headers: token ? { Authorization: `Bearer ${token}` } : {},
        body: form,
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.message);
      setAvatarPreview(json.data.url);
      // Persist avatar_url immediately
      await apiFetch('/auth/profile', { method: 'PUT', body: JSON.stringify({ avatar_url: json.data.url }) });
      showToast('Avatar updated successfully.', 'success');
    } catch (err: any) {
      showToast('Failed to upload avatar: ' + err.message, 'error');
    } finally {
      uploadBtn.innerHTML = '<span class="material-symbols-outlined text-[16px]">upload</span> Tải ảnh lên';
      uploadBtn.disabled = false;
      fileInput.value = '';
    }
  });

  deleteBtn?.addEventListener('click', async () => {
    setAvatarPreview(null);
    try {
      await apiFetch('/auth/profile', { method: 'PUT', body: JSON.stringify({ avatar_url: null }) });
    } catch {}
  });

  // ── Save profile ───────────────────────────────────────────────────────────
  document.getElementById('save-profile-btn')?.addEventListener('click', async () => {
    const btn      = document.getElementById('save-profile-btn') as HTMLButtonElement;
    const username = (document.getElementById('username') as HTMLInputElement)?.value.trim();
    if (!username) { showToast('Username cannot be empty.', 'error'); return; }
    if (username.length < 3) { showToast('Username must be at least 3 characters.', 'error'); return; }
    if (username.length > 32) { showToast('Username must be at most 32 characters.', 'error'); return; }
    if (!/^[a-zA-Z0-9_]+$/.test(username)) { showToast('Username can only contain letters, numbers, and underscores.', 'error'); return; }
    btn.textContent = 'Saving...';
    btn.disabled = true;
    try {
      const { data: user } = await apiFetch('/auth/profile', {
        method: 'PUT',
        body: JSON.stringify({ username }),
      });
      const sidebarName = document.getElementById('sidebar-user-name') as HTMLElement;
      if (sidebarName) sidebarName.textContent = user.username;
      showToast('Profile updated successfully.', 'success');
      btn.textContent = 'Save Changes';
      btn.disabled = false;
    } catch (err: any) {
      showToast('Failed to save profile: ' + err.message, 'error');
      btn.textContent = 'Save Changes';
      btn.disabled = false;
    }
  });

  // ── Change password ────────────────────────────────────────────────────────
  document.getElementById('change-password-btn')?.addEventListener('click', async () => {
    const current = (document.getElementById('current-password') as HTMLInputElement)?.value;
    const newPwd   = (document.getElementById('new-password') as HTMLInputElement)?.value;
    const confirm  = (document.getElementById('confirm-password') as HTMLInputElement)?.value;
    if (!current || !newPwd) { showToast('Please fill in all password fields.', 'error'); return; }
    if (newPwd.length < 8)   { showToast('New password must be at least 8 characters.', 'error'); return; }
    if (newPwd !== confirm)  { showToast('New passwords do not match.', 'error'); return; }
    const btn = document.getElementById('change-password-btn') as HTMLButtonElement;
    btn.textContent = 'Changing...';
    btn.disabled = true;
    try {
      await apiFetch('/auth/profile', {
        method: 'PUT',
        body: JSON.stringify({ current_password: current, new_password: newPwd }),
      });
      showToast('Password changed successfully.', 'success');
      (document.getElementById('current-password') as HTMLInputElement).value = '';
      (document.getElementById('new-password') as HTMLInputElement).value = '';
      (document.getElementById('confirm-password') as HTMLInputElement).value = '';
    } catch (err: any) {
      showToast('Failed to change password: ' + err.message, 'error');
    } finally {
      btn.innerHTML = '<span class="material-symbols-outlined text-[16px]">lock_reset</span> Change Password';
      btn.disabled = false;
    }
  });

  loadUser();

  // ── Artist request (Account tab) ──────────────────────────────────────────
  (async () => {
    const role = getUserRole();
    if (role !== 'user') return;

    const section = document.getElementById('artist-request-section') as HTMLElement;
    const btn     = document.getElementById('settings-artist-request-btn') as HTMLButtonElement;
    const label   = document.getElementById('settings-artist-label') as HTMLElement;
    const status  = document.getElementById('artist-request-status') as HTMLElement;
    if (!section || !btn) return;

    try {
      const { data: req } = await apiFetch('/roles/my-request');
      if (req?.status === 'approved') return; // already artist — skip
      if (req?.status === 'pending') {
        label.textContent = 'Đang chờ duyệt\u2026';
        if (status) status.textContent = '\u23F3 Yêu cầu của bạn đang được xem xét.';
        btn.disabled = true;
        btn.classList.add('opacity-60', 'cursor-not-allowed');
      } else if (req?.status === 'rejected') {
        if (status) status.textContent = '\u274C Yêu cầu trước bị từ chối. Bạn có thể gửi lại.';
      }
    } catch {}

    section.classList.remove('hidden');

    btn.addEventListener('click', async () => {
      if (btn.disabled) return;
      btn.disabled = true;
      label.textContent = 'Đang gửi\u2026';
      try {
        await apiFetch('/roles/request-artist', { method: 'POST' });
        label.textContent = 'Đang chờ duyệt\u2026';
        if (status) status.textContent = '\u23F3 Yêu cầu của bạn đang được xem xét.';
        btn.classList.add('opacity-60', 'cursor-not-allowed');
      } catch (err: any) {
        label.textContent = 'Gửi yêu cầu';
        btn.disabled = false;
        if (status) status.textContent = '\u26A0\uFE0F ' + (err.message || 'Không thể gửi yêu cầu.');
      }
    });
  })();
</script>
</MainLayout>
