---
import MainLayout from "../layouts/MainLayout.astro";
---d 

<MainLayout title="404 - Trang không tìm thấy | Shadows of Melody">
  <div class="min-h-screen bg-[#060e20] text-gray-200 antialiased flex flex-col items-center justify-center relative overflow-hidden px-6">

    <div class="absolute top-0 left-[20%] w-[50%] h-[50%] bg-purple-600/10 blur-[180px] rounded-full pointer-events-none"></div>
    <div class="absolute bottom-0 right-[10%] w-[40%] h-[40%] bg-indigo-600/10 blur-[150px] rounded-full pointer-events-none"></div>
    <div class="absolute top-[30%] left-[-10%] w-[30%] h-[30%] bg-pink-600/8 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="absolute top-[15%] left-[10%] text-white/5 select-none pointer-events-none" style="font-size: 8rem;">♪</div>
    <div class="absolute top-[25%] right-[8%] text-white/4 select-none pointer-events-none" style="font-size: 6rem;">♫</div>
    <div class="absolute bottom-[20%] left-[15%] text-white/3 select-none pointer-events-none" style="font-size: 10rem;">♩</div>
    <div class="absolute bottom-[30%] right-[18%] text-white/5 select-none pointer-events-none" style="font-size: 5rem;">♬</div>

    <div class="relative z-10 flex flex-col items-center text-center max-w-lg">

      <div class="relative mb-8 w-36 h-36">
        <div class="absolute inset-0 bg-linear-to-br from-purple-500 to-pink-500 rounded-full blur-2xl opacity-30 animate-pulse"></div>
        <div class="relative w-36 h-36 rounded-full bg-linear-to-br from-purple-500/20 to-pink-500/20 border border-white/10 flex items-center justify-center backdrop-blur-sm">
          <span class="material-symbols-outlined text-purple-300" style="font-size: 4.5rem;">music_off</span>
        </div>
      </div>

      <p class="text-[9rem] font-black leading-none bg-clip-text text-transparent bg-linear-to-r from-indigo-400 via-purple-400 to-pink-400 mb-2 select-none" aria-hidden="true">
        404
      </p>

      <h1 class="text-2xl sm:text-3xl font-bold text-white mb-3">
        Trang Không Tìm Thấy
      </h1>
      <p class="text-gray-400 text-base mb-10 leading-relaxed max-w-sm">
        Có vẻ như bản nhạc bạn đang tìm không tồn tại. Hãy quay lại và khám phá thêm âm nhạc khác.
      </p>

      <div class="flex flex-col sm:flex-row items-center gap-4">
        <a
          href="/"
          class="flex items-center gap-2 bg-linear-to-r from-purple-500 to-indigo-600 hover:from-purple-400 hover:to-indigo-500 text-white rounded-full py-3.5 px-8 font-bold transition-all hover:scale-105 shadow-[0_8px_30px_rgba(168,85,247,0.4)]"
        >
          <span class="material-symbols-outlined text-[20px]">home</span>
          Về trang chủ
        </a>
        <a
          href="javascript:history.back()"
          class="flex items-center gap-2 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-gray-300 hover:text-white rounded-full py-3.5 px-8 font-bold transition-all"
        >
          <span class="material-symbols-outlined text-[20px]">arrow_back_ios_new</span>
          Quay lại
        </a>
      </div>

      <div class="mt-14 flex flex-col items-center gap-4">
        <p class="text-xs text-gray-600 uppercase tracking-widest font-semibold">Có thể bạn muốn:</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/search"   class="flex items-center gap-2 px-4 py-2 bg-white/3 border border-white/8 hover:bg-white/8 hover:border-white/15 text-gray-400 hover:text-white rounded-full text-sm transition-all">
            <span class="material-symbols-outlined text-[16px]">search</span>Tìm kiếm nhạc
          </a>
          <a href="/artists"  class="flex items-center gap-2 px-4 py-2 bg-white/3 border border-white/8 hover:bg-white/8 hover:border-white/15 text-gray-400 hover:text-white rounded-full text-sm transition-all">
            <span class="material-symbols-outlined text-[16px]">person</span>Khám phá nghệ sĩ
          </a>
          <a href="/playlist" class="flex items-center gap-2 px-4 py-2 bg-white/3 border border-white/8 hover:bg-white/8 hover:border-white/15 text-gray-400 hover:text-white rounded-full text-sm transition-all">
            <span class="material-symbols-outlined text-[16px]">queue_music</span>Playlists
          </a>
          <a href="/liked"    class="flex items-center gap-2 px-4 py-2 bg-white/3 border border-white/8 hover:bg-white/8 hover:border-white/15 text-gray-400 hover:text-white rounded-full text-sm transition-all">
            <span class="material-symbols-outlined text-[16px]">favorite</span>Liked Songs
          </a>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 flex items-center gap-2 opacity-30">
      <span class="material-symbols-outlined text-purple-400 text-[20px]">music_note</span>
      <span class="text-sm font-bold text-gray-400">Shadow of Melody</span>
    </div>
  </div>

  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
  </style>
</MainLayout>
