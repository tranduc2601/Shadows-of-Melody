---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Đăng Nhập - Shadows of Melody">
  <div class="min-h-screen bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30 flex items-center justify-center p-4">
    <div class="w-full max-w-md">
      <!-- Logo -->
      <div class="text-center mb-8">
        <h1 class="text-3xl font-black bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-purple-400 flex items-center justify-center gap-2 mb-2">
          <span class="material-symbols-outlined text-purple-400">music_note</span>
          Shadows of Melody
        </h1>
        <p class="text-gray-400 text-sm">Discover amazing music</p>
      </div>

      <!-- Login Form -->
      <div class="bg-[#0a1229]/80 backdrop-blur-xl border border-white/10 rounded-2xl p-8 shadow-2xl">
        <h2 class="text-2xl font-bold mb-6 text-center text-white">Login</h2>

        <form id="loginForm" class="space-y-5">
          <!-- Email Input -->
          <div>
            <label for="email" class="block text-sm font-medium text-gray-300 mb-2">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 bg-[#1a2847] border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all duration-200"
              placeholder="your@email.com"
            />
          </div>

          <!-- Password Input -->
          <div>
            <label for="password" class="block text-sm font-medium text-gray-300 mb-2">
              Password
            </label>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                class="w-full px-4 py-3 pr-12 bg-[#1a2847] border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all duration-200"
                placeholder="••••••••"
              />
              <button
                type="button"
                id="toggle-password"
                aria-label="Toggle password visibility"
                class="absolute inset-y-0 right-0 flex items-center px-3 text-gray-500 hover:text-gray-300 transition-colors"
              >
                <span class="material-symbols-outlined text-[20px]" id="toggle-password-icon">visibility</span>
              </button>
            </div>
          </div>

          <!-- Remember Me & Forgot Password -->
          <div class="flex items-center justify-between text-sm">
            <label class="flex items-center gap-2 cursor-pointer">
              <input
                type="checkbox"
                name="remember"
                class="w-4 h-4 bg-[#1a2847] border border-white/10 rounded cursor-pointer accent-purple-500"
              />
              <span class="text-gray-400">Remember me</span>
            </label>
            <a href="#" class="text-purple-400 hover:text-purple-300 transition-colors">
              Forgot password?
            </a>
          </div>

          <!-- Error message -->
          <div id="loginError" class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm rounded-lg px-4 py-3"></div>
          <!-- Session banner (shown when redirected from expired session) -->
          <div id="sessionBanner" class="hidden bg-amber-500/10 border border-amber-500/30 text-amber-300 text-sm rounded-lg px-4 py-3 flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">timer_off</span>
            Your session has expired. Please log in again.
          </div>

          <!-- Login Button -->
          <button
            type="submit"
            id="loginBtn"
            class="w-full py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-lg transition-all duration-200 transform hover:scale-[1.02] active:scale-95 shadow-lg shadow-purple-500/25"
          >
            Login
          </button>
        </form>

        <!-- Divider -->
        <div class="my-6 flex items-center">
          <div class="flex-1 h-px bg-white/10"></div>
          <span class="px-4 text-gray-500 text-sm">OR</span>
          <div class="flex-1 h-px bg-white/10"></div>
        </div>

        <!-- Google Login -->
        <button
          class="w-full py-3 bg-[#1a2847] border border-white/10 text-gray-300 font-medium rounded-lg hover:bg-[#233d5d] transition-all duration-200 flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <text x="0" y="20" font-size="20" fill="currentColor">G</text>
          </svg>
          Login with Google
        </button>

        <!-- Sign Up Link -->
        <p class="text-center text-gray-400 text-sm mt-6">
          Don't have an account?
          <a href="/signup" class="text-purple-400 hover:text-purple-300 font-semibold transition-colors">
            Sign Up
          </a>
        </p>
      </div>

      <!-- Footer -->
      <p class="text-center text-gray-500 text-xs mt-6">
        By logging in, you agree to the 
        <a href="#" class="text-purple-400 hover:text-purple-300 transition-colors">Terms of Service</a>
        and
        <a href="#" class="text-purple-400 hover:text-purple-300 transition-colors">Privacy Policy</a>
      </p>
    </div>
  </div>


<script>
  function showToast(msg: string, type: 'success' | 'error' | 'info' = 'info') {
    let container = document.getElementById('toast-container');
    if (!container) {
      container = document.createElement('div');
      container.id = 'toast-container';
      container.className = 'fixed bottom-6 right-6 z-[999] flex flex-col gap-2 pointer-events-none';
      document.body.appendChild(container);
    }
    const colors = { success: 'bg-green-500/20 border-green-500/40 text-green-300', error: 'bg-red-500/20 border-red-500/40 text-red-300', info: 'bg-indigo-500/20 border-indigo-500/40 text-indigo-300' };
    const icons  = { success: 'check_circle', error: 'error', info: 'info' };
    const toast = document.createElement('div');
    toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl border backdrop-blur-xl shadow-2xl text-sm font-medium transition-all duration-300 translate-y-2 opacity-0 ${colors[type]}`;
    toast.innerHTML = `<span class="material-symbols-outlined text-[18px] shrink-0">${icons[type]}</span><span>${msg}</span>`;
    container.appendChild(toast);
    requestAnimationFrame(() => toast.classList.remove('translate-y-2', 'opacity-0'));
    setTimeout(() => { toast.classList.add('translate-y-2', 'opacity-0'); setTimeout(() => toast.remove(), 300); }, 3500);
  }

  const form    = document.getElementById('loginForm') as HTMLFormElement;
  const errDiv  = document.getElementById('loginError') as HTMLElement;
  const banner  = document.getElementById('sessionBanner') as HTMLElement;
  const btn     = document.getElementById('loginBtn') as HTMLButtonElement;

  // Show session-expired banner if redirected with ?reason=session_expired
  const reason = new URLSearchParams(window.location.search).get('reason');
  if (reason === 'session_expired' && banner) banner.classList.remove('hidden');

  // Password show/hide toggle
  const togglePwdBtn  = document.getElementById('toggle-password') as HTMLButtonElement;
  const togglePwdIcon = document.getElementById('toggle-password-icon') as HTMLElement;
  const pwdInput      = document.getElementById('password') as HTMLInputElement;
  togglePwdBtn?.addEventListener('click', () => {
    const hidden = pwdInput.type === 'password';
    pwdInput.type = hidden ? 'text' : 'password';
    togglePwdIcon.textContent = hidden ? 'visibility_off' : 'visibility';
  });

  // If already logged in with a valid token, skip the login page
  const existingToken = localStorage.getItem('auth_token');
  if (existingToken && reason !== 'session_expired') {
    window.location.href = '/';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value;

    errDiv.classList.add('hidden');
    btn.disabled = true;
    btn.textContent = 'Logging in...';

    try {
      const res = await fetch('http://localhost:5000/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });
      const json = await res.json();
      if (!res.ok) {
        const msg = json.message || 'Login failed, try again!';
        if (json.code === 'ACCOUNT_LOCKED') {
          errDiv.textContent = msg;
          errDiv.classList.remove('hidden');
          showToast(msg, 'error');
          btn.disabled = false;
          btn.textContent = 'Login';
          return;
        }
        throw new Error(msg);
      }

      localStorage.setItem('auth_token', json.data.token);
      localStorage.setItem('auth_user', JSON.stringify(json.data));
      localStorage.setItem('me_cache', JSON.stringify(json.data));
      showToast('Login successful! Redirecting...', 'success');
      setTimeout(() => { window.location.href = '/'; }, 800);
    } catch (err: any) {
      errDiv.textContent = err.message;
      errDiv.classList.remove('hidden');
      showToast(err.message, 'error');
      btn.disabled = false;
      btn.textContent = 'Login';
    }
  });
</script>

</MainLayout>
