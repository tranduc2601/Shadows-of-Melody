---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Login - Shadows of Melody">
  <div class="min-h-screen bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30 flex items-center justify-center p-4 mobile-page-shell">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-black bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-purple-400 flex items-center justify-center gap-2 mb-2">
          <span class="material-symbols-outlined text-purple-400">music_note</span>
          Shadows of Melody
        </h1>
        <p class="text-gray-400 text-sm">Discover amazing music</p>
      </div>

      <div class="bg-[#0a1229]/80 backdrop-blur-xl border border-white/10 rounded-2xl p-8 shadow-2xl">
        <h2 class="text-2xl font-bold mb-6 text-center text-white">Login</h2>

        <form id="loginForm" class="space-y-5">
          <div>
            <label for="email" class="block text-sm font-medium text-gray-300 mb-2">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 bg-[#1a2847] border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all duration-200"
              placeholder="your@email.com"
            />
          </div>

          <div>
            <label for="password" class="block text-sm font-medium text-gray-300 mb-2">
              Password
            </label>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                class="w-full px-4 py-3 pr-12 bg-[#1a2847] border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all duration-200"
                placeholder="••••••••"
              />
              <button
                type="button"
                id="toggle-password"
                aria-label="Toggle password visibility"
                class="absolute inset-y-0 right-0 flex items-center px-3 text-gray-500 hover:text-gray-300 transition-colors"
              >
                <span class="material-symbols-outlined text-[20px]" id="toggle-password-icon">visibility</span>
              </button>
            </div>
          </div>

          <div class="flex items-center justify-between text-sm">
            <label class="flex items-center gap-2 cursor-pointer">
              <input
                type="checkbox"
                name="remember"
                class="w-4 h-4 bg-[#1a2847] border border-white/10 rounded cursor-pointer accent-purple-500"
              />
              <span class="text-gray-400">Remember me</span>
            </label>
            <a href="/forgot-password" class="text-purple-400 hover:text-purple-300 transition-colors">
              Forgot password?
            </a>
          </div>

          <div id="loginError" class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm rounded-lg px-4 py-3"></div>
          <div id="sessionBanner" class="hidden bg-amber-500/10 border border-amber-500/30 text-amber-300 text-sm rounded-lg px-4 py-3 flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">timer_off</span>
            Your session has expired. Please log in again.
          </div>

          <button
            type="submit"
            id="loginBtn"
            class="w-full py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-lg transition-all duration-200 transform hover:scale-[1.02] active:scale-95 shadow-lg shadow-purple-500/25"
          >
            Login
          </button>
        </form>

        <div class="my-6 flex items-center">
          <div class="flex-1 h-px bg-white/10"></div>
          <span class="px-4 text-gray-500 text-sm">OR</span>
          <div class="flex-1 h-px bg-white/10"></div>
        </div>

        <button
          type="button"
          id="googleLoginBtn"
          class="w-full py-3 bg-[#1a2847] border border-white/10 text-gray-300 font-medium rounded-lg hover:bg-[#233d5d] transition-all duration-200 flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <text x="0" y="20" font-size="20" fill="currentColor">G</text>
          </svg>
          Login with Google
        </button>

        <p class="text-center text-gray-400 text-sm mt-6">
          Don't have an account?
          <a href="/signup" class="text-purple-400 hover:text-purple-300 font-semibold transition-colors">
            Sign Up
          </a>
        </p>
      </div>

      <p class="text-center text-gray-500 text-xs mt-6">
        By continuing, you agree to our
        <a href="/terms" class="text-purple-400 hover:text-purple-300 transition-colors">Terms of Service</a>
        and
        <a href="/privacy" class="text-purple-400 hover:text-purple-300 transition-colors">Privacy Policy</a>
      </p>
    </div>
  </div>

<script>
  import { API_BASE, setAuth } from '../lib/api.js';

  function showToast(msg: string, type: 'success' | 'error' | 'info' = 'info') {
    let container = document.getElementById('toast-container');
    if (!container) {
      container = document.createElement('div');
      container.id = 'toast-container';
      container.className = 'fixed bottom-6 right-6 z-[999] flex flex-col gap-2 pointer-events-none';
      document.body.appendChild(container);
    }
    const colors = { success: 'bg-green-500/20 border-green-500/40 text-green-300', error: 'bg-red-500/20 border-red-500/40 text-red-300', info: 'bg-indigo-500/20 border-indigo-500/40 text-indigo-300' };
    const icons  = { success: 'check_circle', error: 'error', info: 'info' };
    const toast = document.createElement('div');
    toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl border backdrop-blur-xl shadow-2xl text-sm font-medium transition-all duration-300 translate-y-2 opacity-0 ${colors[type]}`;
    toast.innerHTML = `<span class="material-symbols-outlined text-[18px] shrink-0">${icons[type]}</span><span>${msg}</span>`;
    container.appendChild(toast);
    requestAnimationFrame(() => toast.classList.remove('translate-y-2', 'opacity-0'));
    setTimeout(() => { toast.classList.add('translate-y-2', 'opacity-0'); setTimeout(() => toast.remove(), 300); }, 3500);
  }

  const form    = document.getElementById('loginForm') as HTMLFormElement;
  const errDiv  = document.getElementById('loginError') as HTMLElement;
  const banner  = document.getElementById('sessionBanner') as HTMLElement;
  const btn     = document.getElementById('loginBtn') as HTMLButtonElement;
  const googleBtn = document.getElementById('googleLoginBtn') as HTMLButtonElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;

  const reason = new URLSearchParams(window.location.search).get('reason');
  if (reason === 'session_expired' && banner) banner.classList.remove('hidden');
  if (reason === 'password_reset_success') showToast('Password updated successfully. Please log in.', 'success');

  const togglePwdBtn  = document.getElementById('toggle-password') as HTMLButtonElement;
  const togglePwdIcon = document.getElementById('toggle-password-icon') as HTMLElement;
  const pwdInput      = document.getElementById('password') as HTMLInputElement;
  togglePwdBtn?.addEventListener('click', () => {
    const hidden = pwdInput.type === 'password';
    pwdInput.type = hidden ? 'text' : 'password';
    togglePwdIcon.textContent = hidden ? 'visibility_off' : 'visibility';
  });

  const existingToken = localStorage.getItem('auth_token');
  if (existingToken && reason !== 'session_expired') {
    window.location.href = '/';
  }

  function completeAuth(data: any, successMsg: string) {
    setAuth(data.token, data);
    localStorage.setItem('me_cache', JSON.stringify(data));
    showToast(successMsg, 'success');
    setTimeout(() => { window.location.href = '/'; }, 800);
  }

  function loadGoogleScript() {
    return new Promise<void>((resolve, reject) => {
      if ((window as any).google?.accounts?.id) return resolve();
      const existing = document.querySelector('script[data-google-gis="true"]');
      if (existing) {
        existing.addEventListener('load', () => resolve(), { once: true });
        existing.addEventListener('error', () => reject(new Error('Failed to load Google script')), { once: true });
        return;
      }
      const script = document.createElement('script');
      script.src = 'https://accounts.google.com/gsi/client';
      script.async = true;
      script.defer = true;
      script.dataset.googleGis = 'true';
      script.onload = () => resolve();
      script.onerror = () => reject(new Error('Failed to load Google script'));
      document.head.appendChild(script);
    });
  }

  async function ensureGoogleInitialized() {
    const clientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;
    if (!clientId) throw new Error('Google login is not configured.');
    await loadGoogleScript();
    const google = (window as any).google;
    if (!google?.accounts?.id) throw new Error('Google Identity Services did not load.');

    if (!(window as any).__googleLoginInitialized) {
      google.accounts.id.initialize({
        client_id: clientId,
        callback: (response: any) => {
          if (response?.credential) loginWithGoogle(response.credential);
        },
      });
      (window as any).__googleLoginInitialized = true;
    }
  }

  async function startGoogleLogin() {
    await ensureGoogleInitialized();
    (window as any).google.accounts.id.prompt();
  }

  async function loginWithGoogle(credential: string) {
    googleBtn.disabled = true;
    googleBtn.textContent = 'Signing in with Google...';
    errDiv.classList.add('hidden');
    try {
      const res = await fetch(`${API_BASE}/auth/google`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ credential }),
      });
      const json = await res.json();
      if (!res.ok) {
        const msg = json.message || 'Google login failed';
        if (json.code === 'ACCOUNT_LOCKED') {
          errDiv.textContent = msg;
          errDiv.classList.remove('hidden');
          showToast(msg, 'error');
          return;
        }
        throw new Error(msg);
      }
      completeAuth(json.data, 'Google login successful! Redirecting...');
    } catch (err: any) {
      errDiv.textContent = err.message;
      errDiv.classList.remove('hidden');
      showToast(err.message, 'error');
    } finally {
      googleBtn.disabled = false;
      googleBtn.textContent = 'Login with Google';
    }
  }

  function validateLoginField(field: 'email' | 'password') {
    const value = field === 'email' ? emailInput.value.trim() : passwordInput.value;
    const message = field === 'email' ? 'Email is required.' : 'Password is required.';
    if (!value) {
      errDiv.textContent = message;
      errDiv.classList.remove('hidden');
      return false;
    }
    if (field === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
      errDiv.textContent = 'Please enter a valid email address.';
      errDiv.classList.remove('hidden');
      return false;
    }
    if (errDiv.textContent === message || errDiv.textContent === 'Please enter a valid email address.') {
      errDiv.classList.add('hidden');
      errDiv.textContent = '';
    }
    return true;
  }

  emailInput?.addEventListener('blur', () => validateLoginField('email'));
  passwordInput?.addEventListener('blur', () => validateLoginField('password'));

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailInput.value.trim();
    const password = passwordInput.value;

    if (!validateLoginField('email') || !validateLoginField('password')) return;
    errDiv.classList.add('hidden');
    btn.disabled = true;
    btn.textContent = 'Logging in...';

    try {
      const res = await fetch(`${API_BASE}/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });
      const json = await res.json();
      if (!res.ok) {
        const msg = json.message || 'Login failed, try again!';
        if (json.code === 'ACCOUNT_LOCKED') {
          errDiv.textContent = msg;
          errDiv.classList.remove('hidden');
          showToast(msg, 'error');
          btn.disabled = false;
          btn.textContent = 'Login';
          return;
        }
        throw new Error(msg);
      }

      completeAuth(json.data, 'Login successful! Redirecting...');
    } catch (err: any) {
      errDiv.textContent = err.message;
      errDiv.classList.remove('hidden');
      showToast(err.message, 'error');
      btn.disabled = false;
      btn.textContent = 'Login';
    }
  });

  googleBtn?.addEventListener('click', async () => {
    errDiv.classList.add('hidden');
    googleBtn.disabled = true;
    googleBtn.textContent = 'Preparing Google...';
    try {
      await startGoogleLogin();
    } catch (error: any) {
      const msg = error?.message || 'Google login failed';
      errDiv.textContent = msg;
      errDiv.classList.remove('hidden');
      showToast(msg, 'error');
    } finally {
      googleBtn.disabled = false;
      googleBtn.textContent = 'Login with Google';
    }
  });
</script>

</MainLayout>
