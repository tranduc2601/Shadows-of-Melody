---
import MainLayout from "../layouts/MainLayout.astro";

const album = {
  title: "After Hours",
  artist: "The Weeknd",
  year: 2020,
  type: "Album",
  trackCount: 14,
  duration: "56 phút",
  label: "XO / Republic Records",
};

const tracks = [
  { id: 1,  title: "Alone Again",                 duration: "4:10", plays: "234M", cover: "bg-gradient-to-br from-red-700 to-rose-900",    liked: false },
  { id: 2,  title: "Too Late",                     duration: "3:58", plays: "341M", cover: "bg-gradient-to-br from-red-600 to-orange-800",   liked: true  },
  { id: 3,  title: "Hardest to Love",              duration: "3:31", plays: "289M", cover: "bg-gradient-to-br from-rose-600 to-red-900",     liked: false },
  { id: 4,  title: "Scared to Live",               duration: "3:11", plays: "198M", cover: "bg-gradient-to-br from-red-500 to-fuchsia-700",  liked: false },
  { id: 5,  title: "Snowchild",                    duration: "4:07", plays: "256M", cover: "bg-gradient-to-br from-indigo-600 to-red-800",   liked: true  },
  { id: 6,  title: "Escape from LA",               duration: "5:54", plays: "312M", cover: "bg-gradient-to-br from-orange-600 to-red-800",   liked: false },
  { id: 7,  title: "Until I Bleed Out",            duration: "3:36", plays: "178M", cover: "bg-gradient-to-br from-red-800 to-gray-900",     liked: false },
  { id: 8,  title: "Heartless",                    duration: "2:53", plays: "512M", cover: "bg-gradient-to-br from-rose-700 to-red-900",     liked: true  },
  { id: 9,  title: "Faith",                        duration: "5:14", plays: "287M", cover: "bg-gradient-to-br from-purple-700 to-red-900",   liked: false },
  { id: 10, title: "Blinding Lights",              duration: "3:20", plays: "3.1B", cover: "bg-gradient-to-br from-red-500 to-fuchsia-500",  liked: true  },
  { id: 11, title: "In Your Eyes",                 duration: "3:57", plays: "445M", cover: "bg-gradient-to-br from-rose-500 to-orange-600",  liked: false },
  { id: 12, title: "Save Your Tears",              duration: "3:35", plays: "789M", cover: "bg-gradient-to-br from-blue-500 to-cyan-500",    liked: true  },
  { id: 13, title: "Repeat After Me (Interlude)",  duration: "3:38", plays: "156M", cover: "bg-gradient-to-br from-red-600 to-rose-900",     liked: false },
  { id: 14, title: "After Hours",                  duration: "6:01", plays: "198M", cover: "bg-gradient-to-br from-red-900 to-gray-900",     liked: false },
];

const relatedAlbums = [
  { title: "Starboy",                      year: 2016, color: "from-rose-500 to-orange-600"  },
  { title: "Beauty Behind the Madness",    year: 2015, color: "from-orange-400 to-red-500"   },
  { title: "Dawn FM",                      year: 2022, color: "from-purple-500 to-indigo-600" },
  { title: "Trilogy",                      year: 2013, color: "from-gray-600 to-gray-900"    },
];
---

<MainLayout title="After Hours - Shadows of Melody">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">

    <!-- Sidebar -->
    <aside class="w-64 shrink-0 border-r border-white/5 bg-[#0a1229]/80 backdrop-blur-xl hidden md:flex md:flex-col z-40">
      <div class="h-20 flex items-center px-6">
        <a href="/" class="text-2xl font-black bg-clip-text text-transparent bg-linear-to-r from-indigo-400 to-purple-400 flex items-center gap-2">
          <span class="material-symbols-outlined text-purple-400 animate-pulse">music_note</span>
          Melody
        </a>
      </div>

      <div class="px-4 py-6 flex-1 overflow-y-auto">
        <p class="px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Menu</p>
        <nav class="space-y-1 mb-8">
          <a href="/" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">home</span>Home
          </a>
          <a href="/search" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">search</span>Tìm Kiếm
          </a>
          <a href="/artists" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">person</span>Nghệ Sĩ
          </a>
        </nav>

        <p class="px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Library</p>
        <nav class="space-y-1">
          <a href="/liked" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform text-rose-400">favorite</span>Liked Songs
          </a>
          <a href="/playlist" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">queue_music</span>Playlists
          </a>
        </nav>
      </div>

      <div class="p-4 border-t border-white/5">
        <div class="flex items-center gap-3 p-2 rounded-xl hover:bg-white/5 transition-colors">
          <a href="/profile" class="flex items-center gap-3 flex-1 min-w-0">
            <div class="w-10 h-10 rounded-full bg-linear-to-tr from-purple-500 to-pink-500 p-0.5 shrink-0">
              <div class="w-full h-full rounded-full bg-[#0a1229] flex items-center justify-center">
                <span class="material-symbols-outlined text-purple-400">person</span>
              </div>
            </div>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-white truncate">Duy Ho</p>
              <p class="text-xs text-purple-400 font-medium truncate">Premium</p>
            </div>
          </a>
          <a href="/settings" class="shrink-0 text-gray-500 hover:text-white transition-colors p-1 rounded-lg hover:bg-white/5">
            <span class="material-symbols-outlined text-[20px]">settings</span>
          </a>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col relative overflow-hidden bg-linear-to-br from-[#0c1328] via-[#060e20] to-[#040813]">
      <!-- Ambient Glow -->
      <div class="absolute top-0 left-0 w-[55%] h-[55%] bg-red-900/15 blur-[160px] rounded-full pointer-events-none"></div>
      <div class="absolute bottom-[20%] right-0 w-[35%] h-[40%] bg-purple-900/10 blur-[130px] rounded-full pointer-events-none"></div>

      <!-- Header -->
      <header class="h-16 shrink-0 flex items-center px-6 gap-4 relative z-10">
        <a href="javascript:history.back()" class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-white/10 transition-all text-gray-400 hover:text-white" aria-label="Quay lại">
          <span class="material-symbols-outlined text-[20px]">arrow_back_ios_new</span>
        </a>
        <nav aria-label="Breadcrumb" class="text-sm text-gray-500 flex items-center gap-2">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span aria-hidden="true">›</span>
          <a href="/artists" class="hover:text-white transition-colors">The Weeknd</a>
          <span aria-hidden="true">›</span>
          <span class="text-gray-200">After Hours</span>
        </nav>
      </header>

      <!-- Scrollable Content -->
      <div class="flex-1 overflow-y-auto pb-32 relative z-10 custom-scrollbar scroll-smooth">

        <!-- Album Hero -->
        <section class="relative overflow-hidden">
          <div class="absolute inset-0 bg-linear-to-b from-red-900/60 via-red-950/40 to-transparent pointer-events-none"></div>
          <div class="relative z-10 flex flex-col sm:flex-row items-end gap-8 px-8 pt-10 pb-12">
            <!-- Album Art -->
            <div class="w-52 h-52 rounded-2xl shrink-0 bg-linear-to-br from-red-700 via-rose-800 to-gray-900 shadow-2xl shadow-red-900/50 flex items-center justify-center relative overflow-hidden group cursor-pointer">
              <span class="material-symbols-outlined text-white/10 select-none" style="font-size: 8rem;">album</span>
              <div class="absolute inset-0 bg-linear-to-br from-red-400/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <span class="material-symbols-outlined text-white text-6xl drop-shadow-lg">play_circle</span>
              </div>
            </div>

            <!-- Album Info -->
            <div class="flex flex-col gap-2 min-w-0">
              <span class="text-xs font-bold uppercase tracking-widest text-white/50">{album.type}</span>
              <h1 class="text-4xl sm:text-6xl font-black text-white drop-shadow-xl leading-tight">{album.title}</h1>
              <div class="flex items-center gap-2 text-sm text-gray-300 flex-wrap mt-1">
                <a href="/artists" class="font-bold text-white hover:underline">{album.artist}</a>
                <span class="text-white/30" aria-hidden="true">·</span>
                <span>{album.year}</span>
                <span class="text-white/30" aria-hidden="true">·</span>
                <span>{album.trackCount} bài hát</span>
                <span class="text-white/30" aria-hidden="true">·</span>
                <span class="text-white/50">{album.duration}</span>
              </div>
              <div class="flex items-center gap-3 mt-4 flex-wrap">
                <button type="button" class="bg-linear-to-r from-purple-500 to-indigo-600 hover:from-purple-400 hover:to-indigo-500 text-white rounded-full py-3 px-8 font-bold flex items-center gap-2 transition-all hover:scale-105 shadow-[0_8px_30px_rgba(168,85,247,0.4)]">
                  <span class="material-symbols-outlined text-[22px]">play_arrow</span>
                  Phát
                </button>
                <button type="button" aria-label="Thêm vào yêu thích" class="w-11 h-11 rounded-full border border-white/20 flex items-center justify-center text-gray-300 hover:text-rose-400 hover:border-rose-400 transition-all">
                  <span class="material-symbols-outlined text-[22px]">favorite_border</span>
                </button>
                <button type="button" aria-label="Thêm tùy chọn" class="w-11 h-11 rounded-full border border-white/10 flex items-center justify-center text-gray-400 hover:text-white hover:border-white/30 transition-all">
                  <span class="material-symbols-outlined text-[22px]">more_horiz</span>
                </button>
              </div>
            </div>
          </div>
          <!-- Bottom fade -->
          <div class="absolute bottom-0 left-0 right-0 h-20 bg-linear-to-t from-[#060e20] to-transparent pointer-events-none"></div>
        </section>

        <!-- Track List -->
        <div class="px-6 lg:px-8 mt-2">
          <div class="bg-white/2 border border-white/5 rounded-3xl p-3 backdrop-blur-sm">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="text-gray-500 border-b border-white/5">
                  <th scope="col" class="font-medium text-xs px-4 py-3 w-12 text-center pb-4">#</th>
                  <th scope="col" class="font-medium text-xs px-4 py-3 pb-4 uppercase tracking-wider">Tên bài</th>
                  <th scope="col" class="font-medium text-xs px-4 py-3 pb-4 hidden sm:table-cell uppercase tracking-wider text-right pr-12">Lượt nghe</th>
                  <th scope="col" class="font-medium text-xs px-4 py-3 pb-4 w-16 text-center">
                    <span class="material-symbols-outlined text-[18px]">schedule</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {tracks.map((track, i) => (
                  <tr class="group hover:bg-white/5 transition-colors cursor-pointer">
                    <td class="px-4 py-3 text-center rounded-l-xl">
                      <span class="text-gray-500 font-medium group-hover:hidden">{i + 1}</span>
                      <span class="material-symbols-outlined text-purple-400 hidden group-hover:block text-[20px]">play_arrow</span>
                    </td>
                    <td class="px-4 py-3">
                      <div class="flex items-center gap-4">
                        <div class={`w-10 h-10 rounded-lg shrink-0 ${track.cover} relative overflow-hidden group-hover:scale-105 transition-transform shadow-md`}>
                          <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors"></div>
                        </div>
                        <p class="font-semibold text-gray-100 group-hover:text-purple-400 transition-colors truncate text-sm">{track.title}</p>
                      </div>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 hidden sm:table-cell text-right pr-12 font-medium">{track.plays}</td>
                    <td class="px-4 py-3 text-sm text-gray-500 text-center rounded-r-xl">{track.duration}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-xs text-gray-600 mt-4 px-2">{album.year} · {album.label}</p>
        </div>

        <!-- More from Artist -->
        <div class="px-6 lg:px-8 mt-12 mb-6">
          <h2 class="text-xl font-bold text-white mb-6">Thêm từ {album.artist}</h2>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-5">
            {relatedAlbums.map((rel) => (
              <a href="/album" class="group flex flex-col gap-3 cursor-pointer">
                <div class={`aspect-square rounded-xl bg-linear-to-br ${rel.color} shadow-lg group-hover:shadow-2xl group-hover:shadow-purple-500/10 group-hover:scale-[1.03] transition-all duration-300 relative overflow-hidden flex items-center justify-center`}>
                  <span class="material-symbols-outlined text-white/10 select-none" style="font-size: 5rem;">album</span>
                </div>
                <div>
                  <p class="font-semibold text-gray-200 group-hover:text-white transition-colors text-sm truncate">{rel.title}</p>
                  <p class="text-xs text-gray-500 mt-0.5">{rel.year} · Album</p>
                </div>
              </a>
            ))}
          </div>
        </div>

      </div>

      <!-- Now Playing Bar -->
      <div class="absolute bottom-0 left-0 w-full h-24 bg-[#0a1229]/80 backdrop-blur-2xl border-t border-white/5 z-50 flex items-center justify-between px-6 shadow-[0_-10px_40px_rgba(0,0,0,0.5)]">
        <div class="flex items-center gap-4 w-1/4 min-w-50">
          <div class="w-14 h-14 rounded-xl bg-linear-to-br from-indigo-500 to-purple-500 shadow-lg shadow-purple-500/20 relative group cursor-pointer overflow-hidden shrink-0">
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity">
              <span class="material-symbols-outlined text-white text-xl">keyboard_arrow_up</span>
            </div>
          </div>
          <div class="flex flex-col justify-center min-w-0">
            <span class="font-bold text-white text-[15px] truncate">Midnight City</span>
            <span class="text-xs text-gray-400 truncate mt-0.5">M83</span>
          </div>
          <button type="button" aria-label="Yêu thích" class="ml-2 text-gray-400 hover:text-pink-500 transition-colors shrink-0">
            <span class="material-symbols-outlined">favorite</span>
          </button>
        </div>

        <div class="flex-1 flex flex-col items-center max-w-2xl px-8">
          <div class="flex items-center gap-6 mb-1.5">
            <button type="button" aria-label="Shuffle" class="text-gray-500 hover:text-white transition-colors"><span class="material-symbols-outlined text-xl">shuffle</span></button>
            <button type="button" aria-label="Trước" class="text-gray-400 hover:text-white transition-colors"><span class="material-symbols-outlined text-2xl">skip_previous</span></button>
            <button type="button" aria-label="Phát / Dừng" class="w-10 h-10 rounded-full bg-white text-black flex items-center justify-center hover:scale-110 transition-transform shadow-[0_0_20px_rgba(255,255,255,0.3)]">
              <span class="material-symbols-outlined">play_arrow</span>
            </button>
            <button type="button" aria-label="Tiếp theo" class="text-gray-400 hover:text-white transition-colors"><span class="material-symbols-outlined text-2xl">skip_next</span></button>
            <button type="button" aria-label="Lặp lại" class="text-green-400 hover:text-green-300 transition-colors relative">
              <span class="material-symbols-outlined text-xl">repeat</span>
              <span class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-green-400"></span>
            </button>
          </div>
          <div class="w-full flex items-center gap-3">
            <span class="text-[11px] font-medium text-gray-400 w-10 text-right">0:45</span>
            <div class="flex-1 h-1 bg-white/10 rounded-full overflow-hidden group hover:h-1.5 transition-all cursor-pointer relative">
              <div class="absolute top-0 left-0 h-full bg-linear-to-r from-purple-500 to-pink-500 w-1/3">
                <div class="absolute right-0 top-1/2 -translate-y-1/2 w-2.5 h-2.5 bg-white rounded-full opacity-0 group-hover:opacity-100 shadow-md transition-opacity"></div>
              </div>
            </div>
            <span class="text-[11px] font-medium text-gray-400 w-10">4:03</span>
          </div>
        </div>

        <div class="w-1/4 min-w-50 hidden md:flex items-center justify-end gap-4">
          <button type="button" aria-label="Lyrics" class="text-gray-400 hover:text-white transition-colors"><span class="material-symbols-outlined text-xl">mic</span></button>
          <button type="button" aria-label="Hàng chờ" class="text-gray-400 hover:text-white transition-colors"><span class="material-symbols-outlined text-xl">queue_music</span></button>
          <button type="button" aria-label="Thiết bị" class="text-gray-400 hover:text-white transition-colors"><span class="material-symbols-outlined text-xl">devices</span></button>
          <div class="flex items-center gap-2 w-24 group cursor-pointer">
            <span class="material-symbols-outlined text-gray-400 text-xl group-hover:text-white transition-colors">volume_up</span>
            <div class="flex-1 h-1 bg-white/10 rounded-full overflow-hidden hover:h-1.5 transition-all">
              <div class="h-full bg-white group-hover:bg-purple-400 transition-colors w-2/3"></div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <style>
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.3); }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
  </style>
</MainLayout>
