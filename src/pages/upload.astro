---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
---

<MainLayout title="Upload Song - Shadows of Melody">
  <div class="flex min-h-[100dvh] overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30 mobile-page-shell">
    <Sidebar currentPage="upload" />

    <main class="flex-1 flex flex-col overflow-hidden">
      <div class="flex-1 overflow-y-auto pb-32 p-4 sm:p-6 lg:p-8 custom-scrollbar">
        <div class="mx-auto max-w-6xl space-y-6 lg:space-y-8">
          <section class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-[linear-gradient(180deg,rgba(12,20,40,0.96)_0%,rgba(8,14,28,0.96)_100%)] shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(168,85,247,0.16),transparent_36%),radial-gradient(circle_at_bottom_left,rgba(59,130,246,0.12),transparent_32%)]"></div>
            <div class="relative grid gap-6 p-6 sm:p-8 lg:grid-cols-[1.2fr_0.8fr] lg:p-10">
              <div class="space-y-5">
                <div class="inline-flex items-center gap-2 rounded-full border border-purple-400/20 bg-purple-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-purple-200">
                  <span class="material-symbols-outlined text-[16px]">upload</span>
                  Artist workspace
                </div>
                <div class="space-y-3">
                  <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight flex items-center gap-3">
                    <span class="grid h-12 w-12 place-items-center rounded-2xl border border-white/10 bg-white/5 text-purple-300 shadow-lg shadow-purple-500/10">
                      <span class="material-symbols-outlined text-[24px]">upload_file</span>
                    </span>
                    Upload Song
                  </h1>
                  <p class="max-w-2xl text-sm sm:text-base leading-7 text-slate-300">
                    Keep the interface clean, polished, and aligned with the current dark style of Shadows of Melody.
                    Fill in the details, choose your files, and publish a song in just a few steps.
                  </p>
                </div>

                <div class="grid gap-3 sm:grid-cols-3">
                  <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 backdrop-blur-sm">
                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Step 1</p>
                    <p class="mt-1 text-sm font-semibold text-slate-100">Song details</p>
                  </div>
                  <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 backdrop-blur-sm">
                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Step 2</p>
                    <p class="mt-1 text-sm font-semibold text-slate-100">Audio & cover</p>
                  </div>
                  <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 backdrop-blur-sm">
                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Step 3</p>
                    <p class="mt-1 text-sm font-semibold text-slate-100">Publish</p>
                  </div>
                </div>
              </div>

              <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
                  <div class="flex items-center gap-3">
                    <div class="grid h-11 w-11 place-items-center rounded-xl bg-purple-500/10 text-purple-300">
                      <span class="material-symbols-outlined">music_note</span>
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-white">Audio ready</p>
                      <p class="text-xs text-slate-400">MP3, WAV, FLAC</p>
                    </div>
                  </div>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
                  <div class="flex items-center gap-3">
                    <div class="grid h-11 w-11 place-items-center rounded-xl bg-cyan-500/10 text-cyan-300">
                      <span class="material-symbols-outlined">image</span>
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-white">Artwork optional</p>
                      <p class="text-xs text-slate-400">JPG, PNG, WEBP</p>
                    </div>
                  </div>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm sm:col-span-2 lg:col-span-1 xl:col-span-2">
                  <div class="flex items-center gap-3">
                    <div class="grid h-11 w-11 place-items-center rounded-xl bg-emerald-500/10 text-emerald-300">
                      <span class="material-symbols-outlined">shield</span>
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-white">Fast publish flow</p>
                      <p class="text-xs text-slate-400">Optimized for fast publishing with fewer steps and clear status feedback.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="grid gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(280px,0.8fr)]">
            <div class="rounded-[2rem] border border-white/10 bg-[#0a1229]/85 backdrop-blur-xl shadow-2xl shadow-black/20">
              <div class="border-b border-white/10 px-5 py-5 sm:px-7">
                <div class="flex items-center gap-3">
                  <div class="grid h-10 w-10 place-items-center rounded-xl bg-purple-500/10 text-purple-300">
                    <span class="material-symbols-outlined">playlist_add</span>
                  </div>
                  <div>
                    <h2 class="text-lg font-bold text-white">Song information</h2>
                    <p class="text-sm text-slate-400">Main details and upload files</p>
                  </div>
                </div>
              </div>

              <div class="p-5 sm:p-7">
                <form id="uploadForm" class="space-y-6" enctype="multipart/form-data">
                  <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-300">Song title <span class="text-rose-400">*</span></label>
                    <input id="title" type="text" required placeholder="Song title"
                      class="w-full rounded-2xl border border-white/10 bg-[#141f3d] px-4 py-3.5 text-white placeholder:text-slate-500 outline-none transition focus:border-purple-500/70 focus:ring-2 focus:ring-purple-500/20" />
                  </div>

                  <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-300">Audio file <span class="text-rose-400">*</span></label>
                    <label class="group flex cursor-pointer items-center gap-4 rounded-2xl border border-dashed border-white/15 bg-[#141f3d] px-4 py-4 transition hover:border-purple-400/60 hover:bg-[#182543]">
                      <span class="grid h-12 w-12 place-items-center rounded-xl bg-purple-500/10 text-purple-300 transition group-hover:scale-105">
                        <span class="material-symbols-outlined">audio_file</span>
                      </span>
                      <div class="min-w-0 flex-1">
                        <p id="audio-label" class="truncate text-sm font-medium text-slate-200">Click to choose an audio file</p>
                        <p class="text-xs text-slate-500">MP3, WAV, FLAC</p>
                      </div>
                      <span class="material-symbols-outlined text-slate-500 transition group-hover:text-purple-300">upload</span>
                      <input id="audioFile" type="file" accept="audio/*" required class="hidden" />
                    </label>
                  </div>

                  <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-300">Cover Image</label>
                    <label class="group flex cursor-pointer items-center gap-4 rounded-2xl border border-dashed border-white/15 bg-[#141f3d] px-4 py-4 transition hover:border-purple-400/60 hover:bg-[#182543]">
                      <span class="grid h-12 w-12 place-items-center rounded-xl bg-cyan-500/10 text-cyan-300 transition group-hover:scale-105">
                        <span class="material-symbols-outlined">image</span>
                      </span>
                      <div class="min-w-0 flex-1">
                        <p id="cover-label" class="truncate text-sm font-medium text-slate-200">Add a cover image if you want</p>
                        <p class="text-xs text-slate-500">JPG, PNG, WEBP</p>
                      </div>
                      <span class="material-symbols-outlined text-slate-500 transition group-hover:text-cyan-300">photo_library</span>
                      <input id="coverFile" type="file" accept="image/*" class="hidden" />
                    </label>
                  </div>

                  <div id="upload-error" class="hidden rounded-2xl border border-red-500/25 bg-red-500/10 px-4 py-3 text-sm text-red-300"></div>
                  <div id="upload-success" class="hidden rounded-2xl border border-emerald-500/25 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-300"></div>

                  <div class="rounded-2xl border border-white/10 bg-white/5 p-4 sm:p-5">
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                      <div class="space-y-1">
                        <p class="text-sm font-semibold text-white">Ready to publish</p>
                        <p class="text-xs text-slate-400">The upload button becomes active once title and audio are filled in.</p>
                      </div>
                      <button type="submit" id="uploadBtn" disabled
                        class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 px-5 py-3 font-semibold text-white shadow-lg shadow-purple-500/25 transition hover:from-purple-500 hover:to-indigo-500 enabled:cursor-pointer enabled:hover:-translate-y-0.5 enabled:shadow-purple-500/35 disabled:cursor-not-allowed disabled:from-slate-700 disabled:to-slate-700 disabled:opacity-50 sm:w-auto sm:min-w-[180px]">
                        <span class="material-symbols-outlined text-base">upload</span>
                        Upload Song
                      </button>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          </section>
        </div>
      </div>
    </main>
  </div>
</MainLayout>

<script>
  import { requireAuthClient, API_BASE } from '../lib/api.js';

  if (!requireAuthClient('artist')) throw new Error('redirecting');

  const titleInput = document.getElementById('title') as HTMLInputElement | null;
  const audioInput = document.getElementById('audioFile') as HTMLInputElement | null;
  const coverInput = document.getElementById('coverFile') as HTMLInputElement | null;
  const audioLabel = document.getElementById('audio-label') as HTMLElement | null;
  const coverLabel = document.getElementById('cover-label') as HTMLElement | null;
  const form = document.getElementById('uploadForm') as HTMLFormElement | null;
  const errDiv = document.getElementById('upload-error') as HTMLElement | null;
  const okDiv = document.getElementById('upload-success') as HTMLElement | null;
  const btn = document.getElementById('uploadBtn') as HTMLButtonElement | null;
  const uploadButtonContent = btn?.innerHTML ?? '';

  const updateUploadState = () => {
    const hasTitle = !!titleInput?.value.trim();
    const hasAudio = !!audioInput?.files?.[0];
    if (btn) {
      btn.disabled = !(hasTitle && hasAudio);
      btn.innerHTML = uploadButtonContent;
    }
  };

  titleInput?.addEventListener('input', updateUploadState);

  audioInput?.addEventListener('change', (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (f && audioLabel) audioLabel.textContent = f.name;
    updateUploadState();
  });

  coverInput?.addEventListener('change', (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (f && coverLabel) coverLabel.textContent = f.name;
  });

  updateUploadState();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errDiv?.classList.add('hidden');
    okDiv?.classList.add('hidden');

    const title = (document.getElementById('title') as HTMLInputElement | null)?.value.trim() || '';
    const audioFile = audioInput?.files?.[0];

    if (!title || !audioFile) {
      if (errDiv) {
        errDiv.textContent = 'Title and audio file are required.';
        errDiv.classList.remove('hidden');
      }
      return;
    }

    const fd = new FormData();
    fd.append('title', title);
    fd.append('audio', audioFile);
    const coverFile = coverInput?.files?.[0];
    if (coverFile) fd.append('cover', coverFile);

    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="material-symbols-outlined text-base animate-spin">sync</span> Uploading…';
    }

    try {
      const token = localStorage.getItem('auth_token');
      const res = await fetch(`${API_BASE}/songs/upload`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
        body: fd,
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.message || 'Upload failed');

      if (okDiv) {
        okDiv.textContent = `"${title}" uploaded successfully!`;
        okDiv.classList.remove('hidden');
      }
      form.reset();
      if (audioLabel) audioLabel.textContent = 'Click to choose an audio file';
      if (coverLabel) coverLabel.textContent = 'Add a cover image if you want';
      updateUploadState();
    } catch (err: any) {
      if (errDiv) {
        errDiv.textContent = err.message;
        errDiv.classList.remove('hidden');
      }
    } finally {
      updateUploadState();
    }
  });
</script>
