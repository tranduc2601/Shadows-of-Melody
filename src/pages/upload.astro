---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
---

<MainLayout title="Upload Song - Shadows of Melody">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">
    <Sidebar currentPage="upload" />

    <main class="flex-1 flex flex-col overflow-hidden">
      <div class="flex-1 overflow-y-auto pb-32 p-8 custom-scrollbar">
        <!-- Header -->
        <div class="mb-8">
          <h1 class="text-3xl font-black text-white mb-1 flex items-center gap-3">
            <span class="material-symbols-outlined text-purple-400">upload_file</span>
            Upload Song
          </h1>
          <p class="text-gray-400">Share your music with the world</p>
        </div>

        <!-- Form card -->
        <div class="max-w-2xl bg-[#0a1229]/80 backdrop-blur-xl border border-white/10 rounded-2xl p-8 shadow-2xl">
          <form id="uploadForm" class="space-y-6" enctype="multipart/form-data">

            <!-- Title -->
            <div>
              <label class="block text-sm font-medium text-gray-300 mb-2">Title <span class="text-rose-400">*</span></label>
              <input id="title" type="text" required placeholder="Song title"
                class="w-full px-4 py-3 bg-[#1a2847] border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all" />
            </div>

            <!-- Audio file -->
            <div>
              <label class="block text-sm font-medium text-gray-300 mb-2">Audio File <span class="text-rose-400">*</span></label>
              <label class="flex items-center gap-4 px-4 py-4 bg-[#1a2847] border border-dashed border-white/20 hover:border-purple-500/60 rounded-lg cursor-pointer transition-all group">
                <span class="material-symbols-outlined text-purple-400 group-hover:scale-110 transition-transform">audio_file</span>
                <span id="audio-label" class="text-gray-400 text-sm">Click to choose an audio file (MP3, WAV, FLAC)</span>
                <input id="audioFile" type="file" accept="audio/*" required class="hidden" />
              </label>
            </div>

            <!-- Cover image -->
            <div>
              <label class="block text-sm font-medium text-gray-300 mb-2">Cover Image</label>
              <label class="flex items-center gap-4 px-4 py-4 bg-[#1a2847] border border-dashed border-white/20 hover:border-purple-500/60 rounded-lg cursor-pointer transition-all group">
                <span class="material-symbols-outlined text-purple-400 group-hover:scale-110 transition-transform">image</span>
                <span id="cover-label" class="text-gray-400 text-sm">Click to choose a cover image (JPG, PNG, WEBP)</span>
                <input id="coverFile" type="file" accept="image/*" class="hidden" />
              </label>
            </div>

            <!-- Error / success messages -->
            <div id="upload-error"   class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm rounded-lg px-4 py-3"></div>
            <div id="upload-success" class="hidden bg-green-500/10 border border-green-500/30 text-green-400 text-sm rounded-lg px-4 py-3"></div>

            <!-- Submit -->
            <button type="submit" id="uploadBtn"
              class="w-full py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-xl transition-all shadow-lg shadow-purple-500/25 flex items-center justify-center gap-2">
              <span class="material-symbols-outlined text-base">upload</span>
              Upload Song
            </button>
          </form>
        </div>
      </div>
    </main>
  </div>
</MainLayout>

<script>
  import { requireAuthClient, apiFetch, getToken } from '../lib/api.js';

  // Route guard: artist or admin only
  if (!requireAuthClient('artist')) throw new Error('redirecting');

  // File label updates
  document.getElementById('audioFile')?.addEventListener('change', (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (f) (document.getElementById('audio-label') as HTMLElement).textContent = f.name;
  });
  document.getElementById('coverFile')?.addEventListener('change', (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (f) (document.getElementById('cover-label') as HTMLElement).textContent = f.name;
  });

  const form    = document.getElementById('uploadForm') as HTMLFormElement;
  const errDiv  = document.getElementById('upload-error') as HTMLElement;
  const okDiv   = document.getElementById('upload-success') as HTMLElement;
  const btn     = document.getElementById('uploadBtn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errDiv.classList.add('hidden');
    okDiv.classList.add('hidden');

    const title     = (document.getElementById('title') as HTMLInputElement).value.trim();
    const audioFile = (document.getElementById('audioFile') as HTMLInputElement).files?.[0];

    if (!title || !audioFile) {
      errDiv.textContent = 'Title and audio file are required.';
      errDiv.classList.remove('hidden');
      return;
    }

    const fd = new FormData();
    fd.append('title', title);
    fd.append('audio', audioFile);
    const coverFile = (document.getElementById('coverFile') as HTMLInputElement).files?.[0];
    if (coverFile) fd.append('cover', coverFile);

    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-outlined text-base animate-spin">sync</span> Uploading…';

    try {
      const token = getToken();
      const res = await fetch('http://localhost:5000/api/songs/upload', {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
        body: fd,
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.message || 'Upload failed');

      okDiv.textContent = `"${title}" uploaded successfully!`;
      okDiv.classList.remove('hidden');
      form.reset();
      (document.getElementById('audio-label') as HTMLElement).textContent = 'Click to choose an audio file (MP3, WAV, FLAC)';
      (document.getElementById('cover-label') as HTMLElement).textContent = 'Click to choose a cover image (JPG, PNG, WEBP)';
    } catch (err: any) {
      errDiv.textContent = err.message;
      errDiv.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<span class="material-symbols-outlined text-base">upload</span> Upload Song';
    }
  });
</script>
