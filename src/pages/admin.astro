  async function openEditAlbumModal(albumId: string, albumJson: string) {
    _editAlbumId = albumId;
    let al: any = {};
    try { al = JSON.parse(decodeURIComponent(albumJson)); } catch { try { al = JSON.parse(albumJson); } catch {} }

    (document.getElementById('edit-album-title') as HTMLInputElement).value = al.title || '';
    (document.getElementById('edit-album-release-date') as HTMLInputElement).value =
      al.release_date ? al.release_date.split('T')[0] : '';
    (document.getElementById('edit-album-description') as HTMLTextAreaElement).value = al.description || '';
    editAlbumCoverUrl.value = al.cover_url || '';
    if (al.cover_url) {
      editAlbumCoverPreview.innerHTML = `<img src="${al.cover_url}" class="w-full h-full object-cover" alt="" />`;
    } else {
      editAlbumCoverPreview.innerHTML = '<span class="material-symbols-outlined text-gray-500 text-base">image</span>';
    }
    editAlbumErrDiv?.classList.add('hidden');

    const artistSel = document.getElementById('edit-album-artist') as HTMLSelectElement;
    try {
      const { data: artists } = await apiFetch('/artists?limit=100');
      artistSel.innerHTML = '<option value="">— No artists —</option>' +
        (artists || []).map((a: any) =>
          `<option value="${a.id}"${a.id == al.artist_id ? ' selected' : ''}>${a.name}</option>`
        ).join('');
    } catch { artistSel.innerHTML = '<option value="">— No artists —</option>'; }

    openAdminModal(editAlbumModal as HTMLElement);
