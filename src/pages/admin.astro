  async function loadTasks() {
    const tbody = document.getElementById('admin-tasks-tbody');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500 text-sm">Loading...</td></tr>';
    try {
      const { data: tasks } = await apiFetch('/admin/tasks');
      if (!tasks?.length) {
        tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">No tasks assigned yet.</td></tr>';
        return;
      }
      const sStyles: Record<string,string> = {
        pending:     'bg-amber-500/15 text-amber-300',
        in_progress: 'bg-blue-500/15 text-blue-300',
        completed:   'bg-green-500/15 text-green-300',
      };
      const sLabels: Record<string,string> = { pending: 'Pending', in_progress: 'In Progress', completed: 'Completed' };
      tbody.innerHTML = tasks.map((t: any) => `
        <tr class="hover:bg-white/3 transition-colors group" data-task-id="${t.id}">
          <td class="px-6 py-4">
            <p class="text-sm font-semibold text-gray-100">${t.title}</p>
            ${t.description ? `<p class="text-xs text-gray-500 truncate mt-0.5 max-w-xs">${t.description}</p>` : ''}
          </td>
          <td class="px-6 py-4 hidden sm:table-cell text-sm text-gray-300">${t.assigned_to_name || '—'}</td>
          <td class="px-6 py-4 hidden md:table-cell">
            <span class="task-status-badge inline-flex items-center text-xs font-semibold px-2.5 py-1 rounded-full ${sStyles[t.status] ?? 'bg-white/5 text-gray-400'}">
              ${sLabels[t.status] ?? t.status}
            </span>
          </td>
          <td class="px-6 py-4 hidden lg:table-cell text-xs text-gray-400">${fmtDate(t.created_at)}</td>
          <td class="px-6 py-4">
            <div class="flex items-center justify-end min-w-max">
              <select class="select-task-status text-xs bg-[#1a2847] border border-white/10 text-gray-200 rounded-lg px-2 py-1 focus:outline-none focus:border-indigo-500 cursor-pointer transition-all"
                      data-id="${t.id}" data-current="${t.status}">
                <option value="pending"     ${t.status === 'pending'     ? 'selected' : ''}>Pending</option>
                <option value="in_progress" ${t.status === 'in_progress' ? 'selected' : ''}>In Progress</option>
                <option value="completed"   ${t.status === 'completed'   ? 'selected' : ''}>Completed</option>
              </select>
            </div>
          </td>
        </tr>`).join('');
    } catch (err: any) {
      tbody.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-red-400 text-sm">Failed: ${err.message}</td></tr>`;
    }
  }

  async function loadPlaylists(page = 1) {
    _playlistPage = page;
    const tbody = document.getElementById('admin-playlists-tbody');
    const info  = document.getElementById('playlists-pagination-info');
    const btns  = document.getElementById('playlists-pagination-btns');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500 text-sm">Loading...</td></tr>';
    try {
      const params = new URLSearchParams({ page: String(page), limit: '20' });
      if (_playlistKeyword)    params.set('keyword',    _playlistKeyword);
      if (_playlistVisibility) params.set('visibility', _playlistVisibility);
      if (_playlistSort)       params.set('sort',       _playlistSort);
      const { data: playlists, meta } = await apiFetch(`/admin/playlists?${params}`);
      if (!playlists?.length) {
        tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">No playlists found.</td></tr>';
        if (info) info.textContent = '0 playlists';
        if (btns) btns.innerHTML = '';
        return;
      }
      tbody.innerHTML = playlists.map((p: any) => `
        <tr class="hover:bg-white/3 transition-colors group" data-playlist-id="${p.id}">
          <td class="px-6 py-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg shrink-0 overflow-hidden flex items-center justify-center" style="background:${grad(p.id)}">
                ${p.cover_url
                  ? `<img src="${p.cover_url}" class="w-full h-full object-cover" alt=""/>`
                  : '<span class="material-symbols-outlined text-white/50 text-[18px]">queue_music</span>'}
              </div>
              <div class="min-w-0">
                <p class="text-sm font-semibold text-gray-100 truncate">${p.name || '—'}</p>
                <p class="text-xs text-gray-500 truncate">${p.description || '—'}</p>
              </div>
            </div>
          </td>
          <td class="px-6 py-4 hidden sm:table-cell">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded-full shrink-0 overflow-hidden flex items-center justify-center text-white text-[10px] font-bold"
                   style="background:${colorFor(p.user_id || 0)}">
                ${p.owner_avatar
                  ? `<img src="${p.owner_avatar}" class="w-full h-full object-cover" alt="" />`
                  : (p.owner_name || '?').charAt(0).toUpperCase()}
              </div>
              <span class="text-sm text-gray-400 truncate">${p.owner_name || '—'}</span>
            </div>
          </td>
          <td class="px-6 py-4 hidden md:table-cell text-sm text-gray-400 text-center font-medium">${p.songs_count ?? 0}</td>
          <td class="px-6 py-4">
            <span class="playlist-visibility-badge text-xs font-semibold px-2 py-1 rounded-full ${p.is_public ? 'bg-green-500/15 text-green-400' : 'bg-amber-500/15 text-amber-400'}">
              ${p.is_public ? 'Public' : 'Private'}
            </span>
          </td>
          <td class="px-6 py-4">
            <div class="flex items-center justify-end gap-1 min-w-max">
              <button class="btn-view-playlist-songs flex items-center gap-1 px-2.5 py-1.5 text-xs font-semibold rounded-lg bg-purple-500/10 hover:bg-purple-500/20 text-purple-300 hover:text-purple-200 border border-purple-500/15 transition-all"
                      data-id="${p.id}" data-name="${encodeURIComponent(p.name || '')}" data-cover="${encodeURIComponent(p.cover_url || '')}" data-owner="${encodeURIComponent(p.owner_name || '')}" data-count="${p.songs_count ?? 0}" title="View songs">
                <span class="material-symbols-outlined text-[15px]">queue_music</span>Songs
              </button>
              <button class="btn-edit-playlist w-8 h-8 rounded-lg bg-blue-500/10 hover:bg-blue-500/20 text-blue-300 hover:text-blue-200 border border-blue-500/15 flex items-center justify-center transition-all"
                      data-id="${p.id}" data-name="${encodeURIComponent(p.name || '')}" data-description="${encodeURIComponent(p.description || '')}" data-public="${p.is_public}" title="Edit">
                <span class="material-symbols-outlined text-[17px]">edit</span>
              </button>
              <button class="btn-delete-playlist w-8 h-8 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 hover:text-rose-200 border border-rose-500/15 flex items-center justify-center transition-all"
                      data-id="${p.id}" data-name="${encodeURIComponent(p.name || '')}" title="Delete">
                <span class="material-symbols-outlined text-[17px]">delete</span>
              </button>
            </div>
          </td>
        </tr>`).join('');

      _updatePlaylistChips();
      if (info) info.innerHTML = `<span class="text-white font-semibold">${meta?.totalItems ?? playlists.length}</span> playlists`;
      if (btns) {
        const totalPages = meta?.totalPages || 1;
        btns.innerHTML = buildPaginationBtns(page, totalPages, loadPlaylists);
        btns.querySelectorAll<HTMLElement>('[data-pg]').forEach(btn => {
          btn.addEventListener('click', () => {
            const p = parseInt(btn.dataset.pg||'1');
            if (p > 0 && !(btn as HTMLButtonElement).disabled) loadPlaylists(p);
          });
        });
      }
    } catch {
      tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-8 text-center text-red-400 text-sm">Failed to load playlists.</td></tr>';
    }
  }

