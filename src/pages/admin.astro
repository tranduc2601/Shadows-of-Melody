        const ctx = (document.getElementById('chart-user-growth') as HTMLCanvasElement)?.getContext('2d');
        const emptyEl = document.getElementById('chart-user-growth-empty');
        if (ctx) {
          if (values.every((v) => v === 0)) {
            emptyEl?.classList.remove('hidden');
            (document.getElementById('chart-user-growth') as HTMLElement).style.opacity = '0';
          } else {
            emptyEl?.classList.add('hidden');
            (document.getElementById('chart-user-growth') as HTMLElement).style.opacity = '1';
          }
          const grad = ctx.createLinearGradient(0, 0, 0, 220);
          grad.addColorStop(0, 'rgba(139,92,246,0.4)');
          grad.addColorStop(1, 'rgba(139,92,246,0.02)');
          _analyticsCharts.push(new Chart(ctx, {
            type: 'line',
            data: {
              labels,
              datasets: [{
                label: 'New Users',
                data: values,
                borderColor: 'rgba(139,92,246,1)',
                backgroundColor: grad,
                borderWidth: 2,
                pointRadius: 2,
                tension: 0.4,
                fill: true,
              }],
            },
            options: baseLineOpts,
          }));
        }
      }

      {
        const { labels, values } = fillDateSeries(listening_activity, 30, 'plays');
        const ctx = (document.getElementById('chart-listening-activity') as HTMLCanvasElement)?.getContext('2d');
        const emptyEl = document.getElementById('chart-listening-activity-empty');
        if (ctx) {
          if (values.every((v) => v === 0)) {
            emptyEl?.classList.remove('hidden');
            (document.getElementById('chart-listening-activity') as HTMLElement).style.opacity = '0';
          } else {
            emptyEl?.classList.add('hidden');
            (document.getElementById('chart-listening-activity') as HTMLElement).style.opacity = '1';
          }
          const grad = ctx.createLinearGradient(0, 0, 0, 220);
          grad.addColorStop(0, 'rgba(59,130,246,0.4)');
          grad.addColorStop(1, 'rgba(59,130,246,0.02)');
          _analyticsCharts.push(new Chart(ctx, {
            type: 'line',
            data: {
              labels,
              datasets: [{
                label: 'Plays',
                data: values,
                borderColor: 'rgba(59,130,246,1)',
                backgroundColor: grad,
                borderWidth: 2,
                pointRadius: 2,
                tension: 0.4,
                fill: true,
              }],
            },
            options: baseLineOpts,
          }));
        }
      }

      const baseBarOpts = {
        indexAxis: 'y' as const,
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { mode: 'index' as const, intersect: false },
        },
        scales: {
          x: { grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { precision: 0 } },
          y: { grid: { display: false }, ticks: { font: { size: 11 } } },
        },
      };

      {
        const labels  = (top_songs as any[]).map((s: any) => s.title.length > 22 ? s.title.slice(0, 22) + '…' : s.title);
        const values  = (top_songs as any[]).map((s: any) => s.plays_count ?? 0);
        const colors  = CHART_COLORS.slice(0, labels.length);
        const ctx = (document.getElementById('chart-top-songs') as HTMLCanvasElement)?.getContext('2d');
        if (ctx) {
          _analyticsCharts.push(new Chart(ctx, {
            type: 'bar',
            data: {
              labels,
              datasets: [{
                label: 'Plays',
                data: values,
                backgroundColor: CHART_COLORS_ALPHA.slice(0, labels.length),
                borderColor: colors,
                borderWidth: 1.5,
                borderRadius: 4,
              }],
            },
            options: baseBarOpts,
          }));
        }
      }

      {
        const labels  = (top_artists as any[]).map((a: any) => a.name.length > 22 ? a.name.slice(0, 22) + '…' : a.name);
        const values  = (top_artists as any[]).map((a: any) => a.total_plays ?? 0);
        const colors  = CHART_COLORS.slice(0, labels.length).map((c) => c.replace(',1)', ',0.85)'));
        const ctx = (document.getElementById('chart-top-artists') as HTMLCanvasElement)?.getContext('2d');
        if (ctx) {
          _analyticsCharts.push(new Chart(ctx, {
            type: 'bar',
            data: {
              labels,
              datasets: [{
                label: 'Total Plays',
                data: values,
                backgroundColor: CHART_COLORS_ALPHA.slice(0, labels.length),
                borderColor: colors,
                borderWidth: 1.5,
                borderRadius: 4,
              }],
            },
            options: baseBarOpts,
          }));
        }
      }

      {
        const gLabels  = (genre_distribution as any[]).map((g: any) => g.name);
        const gValues  = (genre_distribution as any[]).map((g: any) => g.count ?? 0);
        const gColors  = CHART_COLORS.slice(0, gLabels.length);
        const total    = gValues.reduce((a: number, b: number) => a + b, 0);
        const ctx = (document.getElementById('chart-genre-dist') as HTMLCanvasElement)?.getContext('2d');
        if (ctx) {
          _analyticsCharts.push(new Chart(ctx, {
            type: 'doughnut',
            data: {
              labels: gLabels,
              datasets: [{
                data: gValues,
                backgroundColor: gColors.map((c) => c.replace(',1)', ',0.8)')),
                borderColor: 'rgba(255,255,255,0.06)',
                borderWidth: 1,
              }],
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              cutout: '65%',
              plugins: { legend: { display: false }, tooltip: { callbacks: {
                label: (ctx: any) => ` ${ctx.label}: ${ctx.parsed} songs (${total ? ((ctx.parsed / total) * 100).toFixed(1) : 0}%)`,
              }}},
            },
          }));
        }
        const legendEl = document.getElementById('genre-dist-legend');
        if (legendEl) {
          legendEl.innerHTML = gLabels.map((label: string, i: number) => `
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background:${gColors[i] ?? '#666'}"></span>
              <span class="text-gray-300 truncate flex-1">${label}</span>
              <span class="text-gray-500 shrink-0">${gValues[i]}</span>
            </div>`).join('');
        }
      }

      {
        const rLabels  = (revenue_trends as any[]).map((r: any) => r.month);
        const rValues  = (revenue_trends as any[]).map((r: any) => parseFloat(r.total) ?? 0);
        const emptyEl  = document.getElementById('chart-revenue-empty');
        const ctx = (document.getElementById('chart-revenue') as HTMLCanvasElement)?.getContext('2d');
        if (ctx) {
          if (rLabels.length === 0) {
            emptyEl?.classList.remove('hidden');
            (document.getElementById('chart-revenue') as HTMLElement).style.opacity = '0';
          } else {
            emptyEl?.classList.add('hidden');
            (document.getElementById('chart-revenue') as HTMLElement).style.opacity = '1';
            const grad = ctx.createLinearGradient(0, 0, 0, 220);
            grad.addColorStop(0, 'rgba(16,185,129,0.4)');
            grad.addColorStop(1, 'rgba(16,185,129,0.02)');
            _analyticsCharts.push(new Chart(ctx, {
              type: 'bar',
              data: {
                labels: rLabels,
                datasets: [{
                  label: 'Revenue ($)',
                  data: rValues,
                  backgroundColor: grad,
                  borderColor: 'rgba(16,185,129,0.9)',
                  borderWidth: 1.5,
                  borderRadius: 4,
                }],
              },
              options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { callbacks: {
                  label: (ctx: any) => ` $${ctx.parsed.y.toFixed(2)}`,
                }}},
                scales: {
                  x: { grid: { color: 'rgba(255,255,255,0.04)' } },
                  y: { grid: { color: 'rgba(255,255,255,0.04)' }, beginAtZero: true, ticks: {
                    callback: (v: any) => `$${v}`,
                  }},
                },
              },
            }));
          }
        }
      }

      {
        const PLAN_LABELS: Record<string, string> = { free: 'Free', premium: 'Premium', vip: 'VIP' };
        const PLAN_COLORS: Record<string, string> = {
          free: 'rgba(107,114,128,0.8)', premium: 'rgba(59,130,246,0.8)', vip: 'rgba(168,85,247,0.8)',
        };
        const sLabels  = (subscription_stats as any[]).map((s: any) => PLAN_LABELS[s.subscription_type] ?? s.subscription_type);
        const sValues  = (subscription_stats as any[]).map((s: any) => s.count ?? 0);
        const sBg      = (subscription_stats as any[]).map((s: any) => PLAN_COLORS[s.subscription_type] ?? 'rgba(156,163,175,0.7)');
        const sTotal   = sValues.reduce((a: number, b: number) => a + b, 0);
        const ctx = (document.getElementById('chart-subscriptions') as HTMLCanvasElement)?.getContext('2d');
        if (ctx) {
          _analyticsCharts.push(new Chart(ctx, {
            type: 'doughnut',
            data: {
              labels: sLabels,
              datasets: [{
                data: sValues,
                backgroundColor: sBg,
                borderColor: 'rgba(255,255,255,0.06)',
                borderWidth: 1,
              }],
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              cutout: '65%',
              plugins: { legend: { display: false }, tooltip: { callbacks: {
                label: (ctx: any) => ` ${ctx.label}: ${ctx.parsed} (${sTotal ? ((ctx.parsed / sTotal) * 100).toFixed(1) : 0}%)`,
              }}},
            },
          }));
        }
        const legendEl = document.getElementById('subscription-legend');
        if (legendEl) {
          legendEl.innerHTML = (subscription_stats as any[]).map((s: any) => `
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full shrink-0" style="background:${PLAN_COLORS[s.subscription_type] ?? '#666'}"></span>
                <span class="text-gray-300 text-sm">${PLAN_LABELS[s.subscription_type] ?? s.subscription_type}</span>
              </div>
              <div class="text-right">
                <span class="text-white font-bold text-sm">${(s.count ?? 0).toLocaleString()}</span>
                <span class="text-gray-500 text-xs ml-1">(${sTotal ? ((s.count / sTotal) * 100).toFixed(0) : 0}%)</span>
              </div>
            </div>`).join('') || '<p class="text-gray-500 text-sm">No subscription data.</p>';
        }
      }

      {
        const listEl = document.getElementById('top-songs-list');
        if (listEl) {
          listEl.innerHTML = (top_songs as any[]).length
            ? (top_songs as any[]).map((s: any, i: number) => `
                <div class="flex items-center gap-3 px-2 py-2 rounded-lg hover:bg-white/5 transition-colors">
                  <span class="text-xs font-bold w-5 text-center ${i < 3 ? ['text-amber-400','text-gray-400','text-orange-600'][i] : 'text-gray-600'}">${i + 1}</span>
                  <div class="w-8 h-8 rounded shrink-0 overflow-hidden bg-white/10 flex items-center justify-center">
                    ${s.cover_url
                      ? `<img src="${s.cover_url}" class="w-full h-full object-cover" alt="" />`
                      : `<span class="material-symbols-outlined text-gray-600 text-[14px]">music_note</span>`}
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-xs font-semibold text-gray-200 truncate">${s.title}</p>
                    <p class="text-[11px] text-gray-500 truncate">${s.artist_names || '—'}</p>
                  </div>
                  <span class="text-xs text-gray-400 shrink-0 font-medium">${(s.plays_count ?? 0).toLocaleString()}</span>
                </div>`).join('')
            : '<p class="text-gray-500 text-xs text-center py-4">No songs found.</p>';
        }
      }

    } catch (err: any) {
      console.error('loadAnalytics error:', err.message);
    }
  }

  document.getElementById('btn-refresh-analytics')?.addEventListener('click', () => {
    _loadedSections.delete('analytics');
    destroyAnalyticsCharts();
    loadAnalytics();
  });

  let _userPage    = 1;
  let _userKeyword = '';
  let _userRole    = '';
  let _userLocked  = '';


  async function loadSubscriptionAdmin(page = 1) {
    _subPage = page;
    const tbody = document.getElementById('admin-subscriptions-tbody');
    const info = document.getElementById('sub-pagination-info');
    const btns = document.getElementById('sub-pagination-btns');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500 text-sm">Loading...</td></tr>';
    try {
      const params = new URLSearchParams({ page: String(page), limit: '10' });
      if (_subKeyword) params.set('keyword', _subKeyword);
      if (_subPlan) params.set('plan', _subPlan);
      if (_subStatus) params.set('status', _subStatus);
      if (_subRole) params.set('role', _subRole);
      const { data } = await apiFetch(`/admin/subscriptions?${params}`);
      const rows = data?.rows || [];
      const stats = data?.stats || {};
      const meta = data?.meta || { totalItems: rows.length, totalPages: 1, currentPage: page };
      const total = meta.totalItems || rows.length;
      const filtered = rows.length;

      const set = (id: string, value: string) => { const el = document.getElementById(id); if (el) el.textContent = value; };
      set('sub-total-users', String(stats.total_users ?? total));
      set('sub-active-count', String(stats.active_count ?? 0));
      set('sub-revenue', `${Number(stats.revenue ?? 0).toLocaleString('vi-VN')}đ`);
      set('sub-payments-count', String(stats.payments_count ?? 0));

      _updateSubscriptionChips(total, filtered);

      if (!rows.length) {
        tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500">No subscription records found.</td></tr>';
        if (info) info.textContent = 'No records';
        if (btns) btns.innerHTML = '';
        return;
      }

      tbody.innerHTML = rows.map((u: any) => {
        const plan = (u.subscription_type || 'free').toLowerCase();
        const active = u.subscription_active || u.is_active;
        const end = u.subscription_end_date || u.end_date || null;
        const status = active ? 'Active' : (u.payment_status === 'pending' ? 'Pending' : 'Expired');
        const planClass = plan === 'vip' ? 'bg-fuchsia-500/20 text-fuchsia-300' : plan === 'premium' ? 'bg-blue-500/20 text-blue-300' : 'bg-white/5 text-gray-400';
        const statusClass = status === 'Active' ? 'bg-green-500/15 text-green-300' : status === 'Pending' ? 'bg-amber-500/15 text-amber-300' : 'bg-red-500/15 text-red-300';
        return `<tr class="hover:bg-white/3 transition-colors group" data-sub-id="${u.id}">
          <td class="px-6 py-4">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full shrink-0 overflow-hidden flex items-center justify-center text-white text-sm font-bold" style="background:${colorFor(u.id)}">${u.avatar_url ? `<img src="${u.avatar_url}" class="w-full h-full object-cover" alt="" />` : (u.username || u.email || '?').charAt(0).toUpperCase()}</div>
              <div class="min-w-0">
                <p class="text-sm font-semibold text-gray-100 truncate">${u.username || '—'}</p>
                <p class="text-xs text-gray-500 truncate">${u.email || '—'}</p>
              </div>
            </div>
          </td>
          <td class="px-6 py-4 hidden sm:table-cell"><span class="text-xs font-semibold px-2 py-1 rounded-full ${planClass}">${plan.charAt(0).toUpperCase() + plan.slice(1)}</span></td>
          <td class="px-6 py-4 hidden md:table-cell"><span class="text-xs font-semibold px-2 py-1 rounded-full ${statusClass}">${status}</span></td>
          <td class="px-6 py-4 hidden lg:table-cell text-xs text-gray-400">${end ? fmtDate(end) : '—'}</td>
          <td class="px-6 py-4 hidden xl:table-cell text-xs text-gray-400">${u.payment_method || 'MoMo'}${u.transaction_id ? ` · ${u.transaction_id}` : ''}</td>
          <td class="px-6 py-4">
            <div class="flex items-center justify-end gap-2 min-w-max">
              <button class="btn-sub-approve px-3 py-1.5 rounded-lg text-xs font-semibold bg-green-500/15 text-green-300 border border-green-500/20 hover:bg-green-500/25" data-id="${u.id}">Approve</button>
              <button class="btn-sub-renew px-3 py-1.5 rounded-lg text-xs font-semibold bg-blue-500/15 text-blue-300 border border-blue-500/20 hover:bg-blue-500/25" data-id="${u.id}">Renew</button>
              <button class="btn-sub-cancel px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-500/15 text-rose-300 border border-rose-500/20 hover:bg-rose-500/25" data-id="${u.id}">Cancel</button>
            </div>
          </td>
        </tr>`;
      }).join('');

      if (info) info.innerHTML = `<span class="text-white font-semibold">${total}</span> subscriptions`;
      if (btns) {
        const totalPages = meta.totalPages || 1;
        btns.innerHTML = buildPaginationBtns(page, totalPages, loadSubscriptionAdmin);
        btns.querySelectorAll<HTMLElement>('[data-pg]').forEach(btn => {
          btn.addEventListener('click', () => { const p = parseInt(btn.dataset.pg || '1'); if (p > 0 && !(btn as HTMLButtonElement).disabled) loadSubscriptionAdmin(p); });
        });
      }

      tbody.querySelectorAll('.btn-sub-approve').forEach((btn) => btn.addEventListener('click', async () => {
        const id = (btn as HTMLButtonElement).dataset.id;
        if (!id) return;
        await apiFetch(`/admin/subscriptions/${id}/activate`, { method: 'PATCH' });
        loadSubscriptionAdmin(page);
      }));
      tbody.querySelectorAll('.btn-sub-renew').forEach((btn) => btn.addEventListener('click', async () => {
        const id = (btn as HTMLButtonElement).dataset.id;
        if (!id) return;
        await apiFetch(`/admin/subscriptions/${id}/renew`, { method: 'PATCH' });
        loadSubscriptionAdmin(page);
      }));
      tbody.querySelectorAll('.btn-sub-cancel').forEach((btn) => btn.addEventListener('click', async () => {
        const id = (btn as HTMLButtonElement).dataset.id;
        if (!id) return;
        await apiFetch(`/admin/subscriptions/${id}/cancel`, { method: 'PATCH' });
        loadSubscriptionAdmin(page);
      }));
    } catch (err: any) {
      if (tbody) tbody.innerHTML = `<tr><td colspan="6" class="px-6 py-8 text-center text-red-400 text-sm">${err.message || 'Failed to load subscription data.'}</td></tr>`;
    }
  }

  async function loadUsers(page = 1) {
    _userPage = page;
    const tbody = document.getElementById('admin-users-tbody');
    const info  = document.getElementById('users-pagination-info');
    const btns  = document.getElementById('users-pagination-btns');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500 text-sm">Loading...</td></tr>';
    try {
      const params = new URLSearchParams({ page: String(page), limit: '10' });
      if (_userKeyword) params.set('keyword', _userKeyword);
      if (_userRole)    params.set('role', _userRole);
      if (_userLocked)  params.set('is_locked', _userLocked);
      if (_userPlan)    params.set('plan', _userPlan);
      if (_userSort)    params.set('sort', _userSort);
      const { data: users, meta } = await apiFetch(`/admin/users?${params}`);
      const _currentRole = getUser()?.role;
      const _isAdmin = _currentRole === 'admin';
      const filteredUsers = (users || []).filter((u: any) => {
        const r = u.role || (u.is_admin ? 'admin' : 'user');
        if (r === 'admin') return false;
        if (r === 'manager' && !_isAdmin) return false;
        return true;
      });
      const _adminBadge = document.getElementById('users-admin-badge');
      if (_adminBadge && _isAdmin) _adminBadge.classList.replace('hidden', 'inline-flex');

      if (!filteredUsers.length) {
        tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500">No users found.</td></tr>';
        return;
      }
      tbody.innerHTML = filteredUsers.map((u: any) => `
        <tr class="hover:bg-white/3 transition-colors group" data-user-id="${u.id}">
          <td class="px-6 py-4">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full shrink-0 overflow-hidden flex items-center justify-center text-white text-sm font-bold"
                   style="background:${colorFor(u.id)}">
                ${u.avatar_url
                  ? `<img src="${u.avatar_url}" class="w-full h-full object-cover" alt="" />`
                  : (u.username || u.email || '?').charAt(0).toUpperCase()}
              </div>
              <div class="min-w-0">
                <p class="text-sm font-semibold text-gray-100 truncate">${u.username || '—'}</p>
                <p class="text-xs text-gray-500 truncate">${u.email}</p>
              </div>
            </div>
          </td>
          <td class="px-6 py-4 hidden sm:table-cell">
            ${(() => {
              const r = u.role || (u.is_admin ? 'admin' : 'user');
              const styles: Record<string,string> = {
                admin:   'bg-purple-500/20 text-purple-300',
                manager: 'bg-yellow-500/20 text-yellow-300',
                artist:  'bg-green-500/20  text-green-300',
                user:    'bg-white/5       text-gray-400',
              };
              return `<span class="role-badge text-xs font-semibold px-2 py-1 rounded-full ${styles[r] ?? styles.user}">${r.charAt(0).toUpperCase() + r.slice(1)}</span>`;
            })()}
          </td>
          <td class="px-6 py-4 hidden md:table-cell">
            <span class="text-xs font-semibold px-2 py-1 rounded-full bg-white/5 text-gray-400">Free</span>
          </td>
          <td class="px-6 py-4 hidden lg:table-cell text-xs text-gray-400">${fmtDate(u.created_at)}</td>
          <td class="px-6 py-4">
            <span class="user-status-badge inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full ${u.is_locked ? 'bg-red-500/15 text-red-400' : 'bg-green-500/15 text-green-400'}">
              <span class="w-1.5 h-1.5 rounded-full ${u.is_locked ? 'bg-red-400' : 'bg-green-400'}"></span>${u.is_locked ? 'Locked' : 'Active'}
            </span>
          </td>
          <td class="px-6 py-4">
            <div class="flex items-center justify-end gap-2 min-w-max">
              <select class="select-role bg-[#1a2847] border border-white/10 text-xs text-gray-300 rounded-lg px-2 py-1 focus:outline-none focus:border-purple-500 transition-all cursor-pointer"
                      data-id="${u.id}" data-current="${u.role || (u.is_admin ? 'admin' : 'user')}">
                <option value="user"    ${(!u.role || u.role === 'user')    ? 'selected' : ''}>User</option>
                <option value="artist"  ${u.role === 'artist'   ? 'selected' : ''}>Artist</option>
                <option value="manager" ${u.role === 'manager'  ? 'selected' : ''}>Manager</option>
                <option value="admin"   ${(u.role === 'admin' || (!u.role && u.is_admin)) ? 'selected' : ''}>Admin</option>
              </select>
              <button class="btn-lock-user w-8 h-8 rounded-lg transition-all flex items-center justify-center ${u.is_locked ? 'hover:bg-green-500/20 hover:text-green-400 text-amber-400' : 'hover:bg-amber-500/20 hover:text-amber-400 text-gray-500'}"
                      data-id="${u.id}" data-locked="${u.is_locked ? '1' : '0'}" data-name="${encodeURIComponent(u.username || u.email || `#${u.id}`)}" title="${u.is_locked ? 'Unlock account' : 'Lock account'}">
                <span class="material-symbols-outlined text-[17px]">${u.is_locked ? 'lock_open' : 'lock'}</span>
              </button>
              <button class="btn-delete-user w-8 h-8 rounded-lg hover:bg-rose-500/20 hover:text-rose-400 text-gray-500 flex items-center justify-center transition-all"
                      data-id="${u.id}" data-name="${encodeURIComponent(u.username || u.email || `#${u.id}`)}" title="Delete user">
                <span class="material-symbols-outlined text-[17px]">delete</span>
              </button>
            </div>
          </td>
        </tr>`).join('');

      _updateUserChips();
      if (info) info.innerHTML = `<span class="text-white font-semibold">${meta?.totalItems ?? filteredUsers.length}</span> users`;
      if (btns) {
        const totalPages = meta?.totalPages || 1;
        btns.innerHTML = buildPaginationBtns(page, totalPages, loadUsers);
        btns.querySelectorAll<HTMLElement>('[data-pg]').forEach(btn => {
          btn.addEventListener('click', () => {
            const p = parseInt(btn.dataset.pg||'1');
            if (p > 0 && !(btn as HTMLButtonElement).disabled) loadUsers(p);
          });
        });
      }

      const _lockingUsers = new Set<string>();
      tbody.addEventListener('click', async (e: Event) => {
        const target = e.target as HTMLElement;
        const lockBtn = target.closest('.btn-lock-user') as HTMLButtonElement | null;
        const delBtn  = target.closest('.btn-delete-user') as HTMLElement | null;

        if (lockBtn) {
          const id = lockBtn.dataset.id!;
          if (_lockingUsers.has(id)) return;
          const isLocked = lockBtn.dataset.locked === '1';
          const name = decodeURIComponent(lockBtn.dataset.name || `#${id}`);
          const confirmed = await showConfirm(
            isLocked
              ? { title: 'Unlock Account', body: `Unlock "${name}"? They will regain full access to their account.`, confirmLabel: 'Unlock', confirmClass: 'bg-green-600 hover:bg-green-500', icon: 'lock_open', iconClass: 'text-green-400', iconWrapClass: 'bg-green-500/15' }
              : { title: 'Lock Account', body: `Lock "${name}"? They will be unable to log in until unlocked.`, confirmLabel: 'Lock', confirmClass: 'bg-amber-600 hover:bg-amber-500', icon: 'lock', iconClass: 'text-amber-400', iconWrapClass: 'bg-amber-500/15' }
          );
          if (!confirmed) return;
          _lockingUsers.add(id);
          const origHTML = lockBtn.innerHTML;
          lockBtn.innerHTML = '<span class="material-symbols-outlined text-[17px] animate-spin">refresh</span>';
          lockBtn.disabled = true;
          try {
            const { data, message } = await apiFetch(`/admin/users/${id}/lock`, { method: 'PATCH' });
            const nowLocked = data.is_locked;
            lockBtn.dataset.locked = nowLocked ? '1' : '0';
            lockBtn.title = nowLocked ? 'Unlock account' : 'Lock account';
            lockBtn.className = `btn-lock-user w-8 h-8 rounded-lg transition-all flex items-center justify-center ${nowLocked ? 'hover:bg-green-500/20 hover:text-green-400 text-amber-400' : 'hover:bg-amber-500/20 hover:text-amber-400 text-gray-500'}`;
            lockBtn.innerHTML = `<span class="material-symbols-outlined text-[17px]">${nowLocked ? 'lock_open' : 'lock'}</span>`;
            const row = lockBtn.closest('tr');
            const statusBadge = row?.querySelector('.user-status-badge') as HTMLElement | null;
            if (statusBadge) {
              statusBadge.className = `user-status-badge inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full ${nowLocked ? 'bg-red-500/15 text-red-400' : 'bg-green-500/15 text-green-400'}`;
              statusBadge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full ${nowLocked ? 'bg-red-400' : 'bg-green-400'}"></span>${nowLocked ? 'Locked' : 'Active'}`;
            }
            showToast(message || (nowLocked ? `Account "${name}" has been locked.` : `Account "${name}" has been unlocked.`), nowLocked ? 'info' : 'success');
          } catch (err: any) {
            lockBtn.innerHTML = origHTML;
            showToast(err.message || 'Action failed. Please try again.', 'error');
          } finally {
            lockBtn.disabled = false;
            _lockingUsers.delete(id);
          }
          return;
        }

        if (delBtn) {
          const id = delBtn.dataset.id;
          const name = decodeURIComponent((delBtn as HTMLElement).dataset.name || `#${id}`);
          if (!id) return;
          const confirmed = await showConfirm({
            title: 'Delete User',
            body: `Permanently delete "${name}"? This action cannot be undone.`,
            confirmLabel: 'Delete',
            confirmClass: 'bg-rose-600 hover:bg-rose-500',
            icon: 'delete_forever',
            iconClass: 'text-rose-400',
            iconWrapClass: 'bg-rose-500/15',
          });
          if (!confirmed) return;
          try {
            await apiFetch(`/admin/users/${id}`, { method: 'DELETE' });
            delBtn.closest('tr')?.remove();
            showToast(`User "${name}" has been deleted.`, 'success');
          } catch (err: any) {
            showToast(err.message || 'Failed to delete user.', 'error');
          }
        }
      });

      tbody.addEventListener('change', async (e: Event) => {
        const select = (e.target as HTMLElement).closest('.select-role') as HTMLSelectElement | null;
        if (!select) return;
        const id      = select.dataset.id;
        const newRole = select.value;
        const prev    = select.dataset.current!;
        if (!id || newRole === prev) return;
        const userName = select.closest('tr')?.querySelector('td .text-sm.font-semibold')?.textContent?.trim() || `#${id}`;
        const confirmed = await showConfirm({
          title: 'Change User Role',
          body: `Change role for "${userName}" from "${prev}" to "${newRole}"?`,
          confirmLabel: 'Change Role',
          confirmClass: 'bg-indigo-600 hover:bg-indigo-500',
          icon: 'manage_accounts',
          iconClass: 'text-indigo-300',
          iconWrapClass: 'bg-indigo-500/15',
        });
        if (!confirmed) {
          select.value = prev;
          return;
        }
        try {
          await apiFetch(`/admin/users/${id}/role`, {
            method: 'PATCH',
            body: JSON.stringify({ role: newRole }),
          });
          select.dataset.current = newRole;
          const row = select.closest('tr');
          const badge = row?.querySelector('.role-badge') as HTMLElement | null;
          if (badge) {
            const styles: Record<string,string> = {
              admin:   'bg-purple-500/20 text-purple-300',
              manager: 'bg-yellow-500/20 text-yellow-300',
              artist:  'bg-green-500/20  text-green-300',
              user:    'bg-white/5       text-gray-400',
            };
            badge.className = `role-badge text-xs font-semibold px-2 py-1 rounded-full ${styles[newRole] ?? styles.user}`;
            badge.textContent = newRole.charAt(0).toUpperCase() + newRole.slice(1);
          }
          showToast(`Role updated to "${newRole}".`, 'success');
        } catch (err: any) {
          showToast(err.message || 'Failed to update role.', 'error');
          select.value = prev;
        }
      });
      btns?.addEventListener('click', (e: Event) => {
        const btn = (e.target as HTMLElement).closest('[data-page]') as HTMLElement | null;
        if (!btn || (btn as HTMLButtonElement).disabled) return;
        const p = parseInt(btn.dataset.page || '1');
        if (p > 0) loadUsers(p);
      });
    } catch {
      tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-red-400 text-sm">Failed to load users.</td></tr>';
    }
  }

  let _artistPage    = 1;
  let _artistKeyword = '';


  async function loadArtists(page = 1) {
    _artistPage = page;
    const tbody = document.getElementById('admin-artists-tbody');
    const info  = document.getElementById('artists-pagination-info');
    const btns  = document.getElementById('artists-pagination-btns');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="4" class="px-6 py-8 text-center text-gray-500 text-sm">Loading...</td></tr>';
    try {
      const params = new URLSearchParams({ page: String(page), limit: '20' });
      if (_artistKeyword)   params.set('keyword',    _artistKeyword);
      if (_artistHasAvatar) params.set('has_avatar', _artistHasAvatar);
      if (_artistSort)      params.set('sort',       _artistSort);
      const { data: artists, meta } = await apiFetch(`/admin/artists?${params}`);
      if (!artists?.length) {
        tbody.innerHTML = '<tr><td colspan="4" class="px-6 py-8 text-center text-gray-500">No artists found.</td></tr>';
        if (info) info.textContent = '0 artists';
        if (btns) btns.innerHTML = '';
        return;
      }
      if (page === 1 && !_artistKeyword) {
        const statEl = document.getElementById('stat-artists');
        if (statEl && meta?.totalItems) statEl.textContent = meta.totalItems.toLocaleString();
      }

      tbody.innerHTML = artists.map((a: any) => `
        <tr class="hover:bg-white/3 transition-colors group" data-artist-id="${a.id}">
          <td class="px-6 py-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full shrink-0 overflow-hidden flex items-center justify-center text-white text-sm font-bold"
                   style="background:${colorFor(a.id)}">
                ${a.image_url ? `<img src="${a.image_url}" class="w-full h-full object-cover" alt=""/>` : a.name.charAt(0)}
              </div>
              <div class="min-w-0">
                <p class="text-sm font-semibold text-gray-100 truncate">${a.name}</p>
                ${a.linked_username
                  ? `<p class="text-xs text-indigo-400 truncate">@${a.linked_username}</p>`
                  : (a.bio ? `<p class="text-xs text-gray-500 truncate">${a.bio}</p>` : '')}
              </div>
            </div>
          </td>
          <td class="px-6 py-4 hidden md:table-cell text-sm text-gray-400 text-center">${a.songs_count || 0}</td>
          <td class="px-6 py-4 hidden lg:table-cell text-sm text-gray-400 text-right font-medium">${(a.followers_count || 0).toLocaleString()}</td>
          <td class="px-6 py-4">
            <div class="flex items-center justify-end gap-1 min-w-max">
              ${a.user_id && a.linked_user_role === 'artist' ? `
              <button class="btn-revoke-artist flex items-center gap-1 px-2.5 py-1.5 text-xs font-semibold rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 hover:text-amber-200 border border-amber-500/15 transition-all"
                      data-id="${a.id}" data-name="${a.name}" title="Revoke artist role">
                <span class="material-symbols-outlined text-[15px]">person_remove</span>Revoke
              </button>` : ''}
              <button class="btn-edit-artist w-8 h-8 rounded-lg bg-blue-500/10 hover:bg-blue-500/20 text-blue-300 hover:text-blue-200 border border-blue-500/15 flex items-center justify-center transition-all"
                      data-id="${a.id}" data-name="${encodeURIComponent(a.name || '')}" data-bio="${encodeURIComponent(a.bio || '')}" data-image="${encodeURIComponent(a.image_url || '')}" title="Edit">
                <span class="material-symbols-outlined text-[17px]">edit</span>
              </button>
              <button class="btn-delete-artist w-8 h-8 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 hover:text-rose-200 border border-rose-500/15 flex items-center justify-center transition-all"
                      data-id="${a.id}" data-name="${encodeURIComponent(a.name || '')}" title="Delete">
                <span class="material-symbols-outlined text-[17px]">delete</span>
              </button>
            </div>
          </td>
        </tr>`).join('');

      tbody.addEventListener('click', async (e: Event) => {
        const revokeBtn = (e.target as HTMLElement).closest('.btn-revoke-artist') as HTMLElement | null;
        const editBtn   = (e.target as HTMLElement).closest('.btn-edit-artist') as HTMLElement | null;
        const delBtn    = (e.target as HTMLElement).closest('.btn-delete-artist') as HTMLElement | null;

        if (!revokeBtn && !editBtn && !delBtn && !(e.target as HTMLElement).closest('button')) {
          const row = (e.target as HTMLElement).closest('tr[data-artist-id]') as HTMLElement | null;
          if (row?.dataset.artistId) openArtistDetail(row.dataset.artistId);
          return;
        }

        if (editBtn) {
          openEditArtistModal(
            editBtn.dataset.id!,
            decodeURIComponent(editBtn.dataset.name || ''),
            decodeURIComponent(editBtn.dataset.bio || ''),
            decodeURIComponent(editBtn.dataset.image || '')
          );
          return;
        }

        if (revokeBtn) {
          const id   = revokeBtn.dataset.id;
          const name = revokeBtn.dataset.name || `#${id}`;
          if (!id) return;
          const confirmed = await showConfirm({
            title: 'Revoke Artist Role',
            body: `Revoke artist role for "${name}"? The user will be downgraded to a regular user.`,
            confirmLabel: 'Revoke',
            confirmClass: 'bg-amber-600 hover:bg-amber-500',
            icon: 'person_remove',
            iconClass: 'text-amber-400',
            iconWrapClass: 'bg-amber-500/15',
          });
          if (!confirmed) return;
          revokeBtn.setAttribute('disabled', 'true');
          try {
            await apiFetch(`/admin/artists/${id}/revoke-role`, { method: 'PATCH' });
            revokeBtn.remove();
            showToast(`Artist role revoked for "${name}".`, 'success');
            loadStats();
          } catch (err: any) {
            showToast(err.message || 'Failed to revoke artist role.', 'error');
            revokeBtn.removeAttribute('disabled');
          }
          return;
        }

        if (delBtn) {
          const id   = delBtn.dataset.id;
          const name = decodeURIComponent(delBtn.dataset.name || `#${id}`);
          if (!id) return;
          const confirmed = await showConfirm({
            title: 'Delete Artist',
            body: `Delete artist "${name}"? This will remove all related songs and cannot be undone.`,
            confirmLabel: 'Delete',
            confirmClass: 'bg-rose-600 hover:bg-rose-500',
            icon: 'delete_forever',
            iconClass: 'text-rose-400',
            iconWrapClass: 'bg-rose-500/15',
          });
          if (!confirmed) return;
          try {
            await apiFetch(`/admin/artists/${id}`, { method: 'DELETE' });
            delBtn.closest('tr')?.remove();
            showToast(`Artist "${name}" deleted successfully.`, 'success');
            const statEl = document.getElementById('stat-artists');
            if (statEl) statEl.textContent = String(Math.max(0, parseInt(statEl.textContent || '0') - 1));
          } catch (err: any) {
            showToast(err.message || 'Failed to delete artist.', 'error');
          }
        }
      });

      _updateArtistChips();
      if (info) info.innerHTML = `<span class="text-white font-semibold">${meta?.totalItems ?? artists.length}</span> artists`;
      if (btns) {
        const totalPages = meta?.totalPages || 1;
        btns.innerHTML = buildPaginationBtns(page, totalPages, loadArtists);
        btns.querySelectorAll<HTMLElement>('[data-pg]').forEach(btn => {
          btn.addEventListener('click', () => {
            const p = parseInt(btn.dataset.pg||'1');
            if (p > 0 && !(btn as HTMLButtonElement).disabled) loadArtists(p);
          });
        });
      }
    } catch {
      tbody.innerHTML = '<tr><td colspan="4" class="px-6 py-8 text-center text-red-400 text-sm">Failed to load data.</td></tr>';
    }
  }

  let _songPage    = 1;
  let _songKeyword = '';
  let _songStatus  = '';


  async function loadSongs(page = 1) {
    _songPage = page;
    const tbody = document.getElementById('admin-songs-tbody');
    const info  = document.getElementById('songs-pagination-info');
    const btns  = document.getElementById('songs-pagination-btns');
    if (!tbody) return;
    try {
      const params = new URLSearchParams({ page: String(page), limit: '20' });
      if (_songKeyword) params.set('keyword', _songKeyword);
      if (_songStatus)  params.set('status',  _songStatus);
      if (_songGenre)   params.set('genre_id', _songGenre);
      if (_songSort)    params.set('sort',     _songSort);
      const { data: songs, meta } = await apiFetch(`/admin/songs?${params}`);
      if (!songs?.length) {
        tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500">No songs found.</td></tr>';
        if (info) info.textContent = '0 songs';
        if (btns) btns.innerHTML = '';
        return;
      }
      tbody.innerHTML = songs.map((s: any) => `
        <tr class="hover:bg-white/3 transition-colors group" data-song-id="${s.id}">
          <td class="px-6 py-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg shrink-0 overflow-hidden" style="background:${grad(s.id)}">
                ${s.cover_url ? `<img src="${s.cover_url}" class="w-full h-full object-cover" alt=""/>` : ''}
              </div>
              <div class="min-w-0">
                <p class="text-sm font-semibold text-gray-100 truncate">${s.title}</p>
                <p class="text-xs text-gray-500 truncate">${s.artist_names || '—'}</p>
              </div>
            </div>
          </td>
          <td class="px-6 py-4 hidden md:table-cell text-sm text-gray-400">${s.album_title || '—'}</td>
          <td class="px-6 py-4 hidden sm:table-cell text-sm text-gray-400 text-right font-medium">${s.plays_count?.toLocaleString() || 0}</td>
          <td class="px-6 py-4 hidden lg:table-cell text-sm text-gray-400 text-center">${fmt(s.duration)}</td>
          <td class="px-6 py-4">
            <div class="flex flex-col items-start gap-2">
              <button class="btn-toggle-status flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full transition-all cursor-pointer
                ${(s.status || 'published') === 'suppressed'
                  ? 'bg-amber-500/15 text-amber-400 hover:bg-amber-500/25'
                  : 'bg-green-500/15 text-green-400 hover:bg-green-500/25'}"
                data-id="${s.id}" data-status="${s.status || 'published'}" data-title="${encodeURIComponent(s.title)}" title="Click to toggle status">
                <span class="material-symbols-outlined text-[13px]">${(s.status || 'published') === 'suppressed' ? 'visibility_off' : 'visibility'}</span>
                ${(s.status || 'published') === 'suppressed' ? 'Suppressed' : 'Published'}
              </button>
              <button class="btn-toggle-featured flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full transition-all cursor-pointer
                ${s.is_featured ? 'bg-pink-500/15 text-pink-300 hover:bg-pink-500/25' : 'bg-white/5 text-gray-400 hover:bg-white/10 hover:text-white'}"
                data-id="${s.id}" data-featured="${s.is_featured ? '1' : '0'}" data-title="${encodeURIComponent(s.title)}" title="Click to toggle featured">
                <span class="material-symbols-outlined text-[13px]">${s.is_featured ? 'star' : 'star_outline'}</span>
                ${s.is_featured ? 'Featured' : 'Mark featured'}
              </button>
            </div>
          </td>
          <td class="px-6 py-4">
            <div class="flex items-center justify-end gap-1 min-w-max">
              <button class="btn-edit-song w-8 h-8 rounded-lg bg-blue-500/10 hover:bg-blue-500/20 text-blue-300 hover:text-blue-200 border border-blue-500/15 flex items-center justify-center transition-all"
                      data-id="${s.id}" data-song="${encodeURIComponent(JSON.stringify(s))}" title="Edit">
                <span class="material-symbols-outlined text-[17px]">edit</span>
              </button>
              <button class="btn-delete-song w-8 h-8 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 hover:text-rose-200 border border-rose-500/15 flex items-center justify-center transition-all" data-id="${s.id}" title="Delete">
                <span class="material-symbols-outlined text-[17px]">delete</span>
              </button>
            </div>
          </td>
        </tr>`).join('');

      const _toggleStatusInFlight = new Set<string>();
      tbody.addEventListener('click', async (e) => {
        const editBtn   = (e.target as HTMLElement).closest('.btn-edit-song') as HTMLElement;
        const delBtn    = (e.target as HTMLElement).closest('.btn-delete-song') as HTMLElement;
        const statusBtn = (e.target as HTMLElement).closest('.btn-toggle-status') as HTMLElement;
        const featuredBtn = (e.target as HTMLElement).closest('.btn-toggle-featured') as HTMLElement;

        if (editBtn) {
          openEditSongModal(editBtn.dataset.id!, editBtn.dataset.song!);
        }

        if (featuredBtn) {
          const id = featuredBtn.dataset.id!;
          const songLabel = decodeURIComponent(featuredBtn.dataset.title ?? `Song #${id}`);
          const isFeatured = featuredBtn.dataset.featured === '1';
          const confirmed = await showConfirm({
            title: isFeatured ? 'Unfeature Song' : 'Feature Song',
            body: isFeatured
              ? `Remove "${songLabel}" from featured songs?`
              : `Mark "${songLabel}" as featured?`,
            confirmLabel: isFeatured ? 'Unfeature' : 'Feature',
            confirmClass: isFeatured ? 'bg-white/10 hover:bg-white/15' : 'bg-pink-600 hover:bg-pink-500',
            icon: isFeatured ? 'star_outline' : 'star',
            iconClass: isFeatured ? 'text-gray-300' : 'text-pink-300',
            iconWrapClass: isFeatured ? 'bg-white/5 border-white/10' : 'bg-pink-500/15 border-pink-500/20',
          });
          if (!confirmed) return;
          const origHTML = featuredBtn.innerHTML;
          featuredBtn.disabled = true;
          featuredBtn.innerHTML = '<span class="material-symbols-outlined text-[13px] animate-spin">refresh</span> Saving...';
          try {
            const { data } = await apiFetch(`/admin/songs/${id}/featured`, { method: 'PATCH' });
            featuredBtn.dataset.featured = data.is_featured ? '1' : '0';
            featuredBtn.className = `btn-toggle-featured flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full transition-all cursor-pointer ${data.is_featured ? 'bg-pink-500/15 text-pink-300 hover:bg-pink-500/25' : 'bg-white/5 text-gray-400 hover:bg-white/10 hover:text-white'}`;
            featuredBtn.innerHTML = `<span class="material-symbols-outlined text-[13px]">${data.is_featured ? 'star' : 'star_outline'}</span>${data.is_featured ? 'Featured' : 'Mark featured'}`;
            showToast(data.is_featured ? `"${songLabel}" is now featured.` : `"${songLabel}" was removed from featured.`, 'success');
          } catch (err: any) {
            featuredBtn.innerHTML = origHTML;
            showToast(err.message || 'Failed to update featured state.', 'error');
          } finally {
            featuredBtn.disabled = false;
          }
          return;
        }

        if (statusBtn) {
          const id = statusBtn.dataset.id!;
          if (_toggleStatusInFlight.has(id)) return;
          const current = statusBtn.dataset.status!;
          const next = current === 'suppressed' ? 'published' : 'suppressed';
          const title = decodeURIComponent(statusBtn.dataset.title ?? '');
          const songLabel = title || `Song #${id}`;
          const confirmed = await showConfirm(
            next === 'suppressed'
              ? { title: 'Suppress Song', body: `Suppress "${songLabel}"? It will be hidden from all users.`, confirmLabel: 'Suppress', confirmClass: 'bg-amber-600 hover:bg-amber-500', icon: 'visibility_off', iconClass: 'text-amber-400', iconWrapClass: 'bg-amber-500/15' }
              : { title: 'Publish Song', body: `Publish "${songLabel}"? It will become visible to all users.`, confirmLabel: 'Publish', confirmClass: 'bg-green-600 hover:bg-green-500', icon: 'visibility', iconClass: 'text-green-400', iconWrapClass: 'bg-green-500/15' }
          );
          if (!confirmed) return;
          _toggleStatusInFlight.add(id);
          statusBtn.setAttribute('disabled', 'true');
          const origHTML = statusBtn.innerHTML;
          statusBtn.innerHTML = '<span class="material-symbols-outlined text-[13px] animate-spin">refresh</span>';
          try {
            await apiFetch(`/admin/songs/${id}/status`, {
              method: 'PATCH',
              body: JSON.stringify({ status: next }),
            });
            statusBtn.dataset.status = next;
            if (next === 'suppressed') {
              statusBtn.className = 'btn-toggle-status flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full transition-all cursor-pointer bg-amber-500/15 text-amber-400 hover:bg-amber-500/25';
              statusBtn.innerHTML = '<span class="material-symbols-outlined text-[13px]">visibility_off</span>Suppressed';
            } else {
              statusBtn.className = 'btn-toggle-status flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full transition-all cursor-pointer bg-green-500/15 text-green-400 hover:bg-green-500/25';
              statusBtn.innerHTML = '<span class="material-symbols-outlined text-[13px]">visibility</span>Published';
            }
            showToast(`Song ${next === 'suppressed' ? 'suppressed' : 'published'} successfully.`, 'success');
          } catch (err: any) {
            statusBtn.innerHTML = origHTML;
            showToast(err.message || 'Failed to update status.', 'error');
          } finally {
            statusBtn.removeAttribute('disabled');
            _toggleStatusInFlight.delete(id);
          }
        }

        if (delBtn) {
          const id = delBtn.dataset.id;
          if (!id) return;
          const songTitle = delBtn.closest('tr')?.querySelector('td .text-sm.font-semibold')?.textContent?.trim() || `#${id}`;
          const confirmed = await showConfirm({
            title: 'Delete Song',
            body: `Delete "${songTitle}"? This action cannot be undone.`,
            confirmLabel: 'Delete',
            confirmClass: 'bg-rose-600 hover:bg-rose-500',
            icon: 'delete_forever',
            iconClass: 'text-rose-400',
            iconWrapClass: 'bg-rose-500/15',
          });
          if (!confirmed) return;
          try {
            await apiFetch(`/songs/${id}`, { method: 'DELETE' });
            delBtn.closest('tr')?.remove();
            showToast('Song deleted successfully.', 'success');
          } catch (err: any) {
            showToast(err.message || 'Failed to delete song.', 'error');
          }
        }
      }, { once: false });

      _updateSongChips();
      if (info) info.innerHTML = `<span class="text-white font-semibold">${meta?.totalItems ?? songs.length}</span> songs`;
      if (btns) {
        const totalPages = meta?.totalPages || 1;
        btns.innerHTML = buildPaginationBtns(page, totalPages, loadSongs);
        btns.querySelectorAll<HTMLElement>('[data-pg]').forEach(btn => {
          btn.addEventListener('click', () => {
            const p = parseInt(btn.dataset.pg||'1');
            if (p > 0 && !(btn as HTMLButtonElement).disabled) loadSongs(p);
          });
        });
      }
    } catch {
      tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-red-400 text-sm">Failed to load data.</td></tr>';
    }
  }

  const editModal      = document.getElementById('modal-edit-song') as HTMLElement;
  const editModalBg    = document.getElementById('modal-edit-song-bg') as HTMLElement;
  const editModalClose = document.getElementById('modal-edit-song-close') as HTMLElement;
  const editForm       = document.getElementById('form-edit-song') as HTMLFormElement;
  const editErrDiv     = document.getElementById('edit-song-error') as HTMLElement;
  const editCoverFile  = document.getElementById('edit-cover-file') as HTMLInputElement;
  const editCoverDropzone = document.getElementById('edit-cover-dropzone') as HTMLElement;
  const editCoverPreview  = document.getElementById('edit-cover-preview') as HTMLElement;
  const editCoverFilename = document.getElementById('edit-cover-filename') as HTMLElement;
  const editCoverStatus   = document.getElementById('edit-cover-status') as HTMLElement;
  const editCoverUrl      = document.getElementById('edit-cover-url') as HTMLInputElement;
  const editSubmitBtn     = document.getElementById('btn-edit-song-submit') as HTMLButtonElement;

  let _editSongId: string | null = null;
  let _editSongCoverPending = false;
  let _editSongSubmitPending = false;

  function updateEditSongSubmitState() {
    if (!editSubmitBtn) return;
    editSubmitBtn.disabled = _editSongCoverPending || _editSongSubmitPending;
  }

  async function openEditSongModal(songId: string, songJson: string) {
    _editSongId = songId;
    let song: any = {};
    try { song = JSON.parse(decodeURIComponent(songJson)); } catch { try { song = JSON.parse(songJson); } catch {} }

    (document.getElementById('edit-title') as HTMLInputElement).value = song.title || '';
    editCoverUrl.value = song.cover_url || '';
    if (song.cover_url) {
      editCoverPreview.innerHTML = `<img src="${song.cover_url}" class="w-full h-full object-cover" alt="" />`;
    } else {
      editCoverPreview.innerHTML = '<span class="material-symbols-outlined text-gray-500 text-2xl">image</span>';
    }
    editCoverFilename.classList.add('hidden');
    editCoverStatus.classList.add('hidden');
    editErrDiv?.classList.add('hidden');
    _editSongCoverPending = false;
    _editSongSubmitPending = false;
    updateEditSongSubmitState();

    const albumSel = document.getElementById('edit-album') as HTMLSelectElement;
    try {
      const { data: albums } = await apiFetch('/admin/albums');
      albumSel.innerHTML = '<option value="">— No album —</option>' +
        (albums || []).map((al: any) => `<option value="${al.id}" ${al.id == song.album_id ? 'selected' : ''}>${al.title}${al.artist_name ? ' — ' + al.artist_name : ''}</option>`).join('');
    } catch { albumSel.innerHTML = '<option value="">— No album —</option>'; }

    const editArtistsSel = document.getElementById('edit-artists-select') as HTMLSelectElement;
    const currentArtistIds = (song.artist_ids || '').split(',').map((x: string) => x.trim()).filter(Boolean);
    try {
      const { data: artists } = await apiFetch('/artists?limit=100');
      const selectedArtistId = currentArtistIds[0] ?? '';
      editArtistsSel.innerHTML = '<option value="">— No artist —</option>' +
        (artists as any[]).map((a: any) =>
          `<option value="${a.id}"${String(a.id) === selectedArtistId ? ' selected' : ''}>${a.name}</option>`
        ).join('');
    } catch { editArtistsSel.innerHTML = '<option value="" disabled selected>Cannot load artists</option>'; }

    const editGenresBox = document.getElementById('edit-genres-checkboxes') as HTMLElement;
    const currentGenreIds = (song.genre_ids || '').split(',').map((x: string) => x.trim()).filter(Boolean);
    try {
      const { data: genres } = await apiFetch('/admin/genres');
      editGenresBox.innerHTML = (genres || []).map((g: any) => `
        <label class="flex items-center gap-2 cursor-pointer hover:bg-white/5 rounded px-2 py-1">
          <input type="checkbox" value="${g.id}" class="accent-indigo-500 w-3.5 h-3.5" name="edit_genre_ids"${currentGenreIds.includes(String(g.id)) ? ' checked' : ''} />
          <span class="text-xs text-gray-300 truncate">${g.name}</span>
        </label>`).join('');
    } catch { editGenresBox.innerHTML = '<p class="text-gray-500 text-xs">Cannot load genres.</p>'; }

    openAdminModal(editModal as HTMLElement);
  }

  editModalBg?.addEventListener('click',    () => closeAdminModal(editModal as HTMLElement));
  editModalClose?.addEventListener('click', () => closeAdminModal(editModal as HTMLElement));

  editCoverDropzone?.addEventListener('click', () => editCoverFile?.click());
  editCoverFile?.addEventListener('change', async () => {
    const file = editCoverFile.files?.[0];
    if (!file) return;
    const allowed = ['image/jpeg', 'image/png', 'image/webp'];
    if (!allowed.includes(file.type) || file.size > 5 * 1024 * 1024) {
      editErrDiv.textContent = 'Image must be JPG/PNG/WebP, max 5MB.';
      editErrDiv.classList.remove('hidden');
      editCoverFile.value = '';
      _editSongCoverPending = false;
      updateEditSongSubmitState();
      return;
    }
    _editSongCoverPending = true;
    updateEditSongSubmitState();
    editCoverFilename.textContent = file.name;
    editCoverFilename.classList.remove('hidden');
    editCoverStatus.textContent = 'Uploading...';
    editCoverStatus.classList.remove('hidden');
    const objUrl = URL.createObjectURL(file);
    editCoverPreview.innerHTML = `<img src="${objUrl}" class="w-full h-full object-cover" alt="" />`;
    try {
      const fd = new FormData();
      fd.append('cover', file);
      const token = getToken();
      const res = await fetch(`${API_BASE}/admin/upload/cover`, {
        method: 'POST',
        headers: token ? { Authorization: `Bearer ${token}` } : {},
        body: fd,
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.message || 'Upload failed');
      editCoverUrl.value = json.data.url;
      editCoverStatus.textContent = '✓ Uploaded successfully';
    } catch (err: any) {
      editCoverStatus.textContent = `Error: ${err.message}`;
      editCoverPreview.innerHTML = '<span class="material-symbols-outlined text-gray-500 text-2xl">image</span>';
      editCoverUrl.value = '';
    } finally {
      _editSongCoverPending = false;
      updateEditSongSubmitState();
      URL.revokeObjectURL(objUrl);
    }
  });

  editForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!_editSongId || _editSongCoverPending || _editSongSubmitPending) return;
    editErrDiv?.classList.add('hidden');

    const title    = (document.getElementById('edit-title') as HTMLInputElement).value.trim();
    const albumId  = (document.getElementById('edit-album') as HTMLSelectElement).value;
    const coverUrl = editCoverUrl.value;
    const editArtistSelVal = (document.getElementById('edit-artists-select') as HTMLSelectElement)?.value;
    const artistIds = editArtistSelVal ? [editArtistSelVal] : [];
    const genreIds  = Array.from(editForm.querySelectorAll('input[name="edit_genre_ids"]:checked')).map((cb: any) => cb.value);

    if (!title) { editErrDiv.textContent = 'Please enter the song title.'; editErrDiv.classList.remove('hidden'); return; }

    const confirmed = await showConfirm({
      title: 'Save Song Changes',
      body: `Apply updates to "${title}"?`,
      confirmLabel: 'Save Changes',
      confirmClass: 'bg-indigo-600 hover:bg-indigo-500',
      icon: 'save',
      iconClass: 'text-indigo-300',
      iconWrapClass: 'bg-indigo-500/15',
    });
    if (!confirmed) return;

    if (_editSongCoverPending || _editSongSubmitPending) return;
    _editSongSubmitPending = true;
    updateEditSongSubmitState();
    const origText = editSubmitBtn?.innerHTML ?? '';
    if (editSubmitBtn) editSubmitBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span> Saving...';

    try {
      await apiFetch(`/admin/songs/${_editSongId}`, {
        method: 'PATCH',
        body: JSON.stringify({
          title,
          cover_url: coverUrl || undefined,
          album_id:  albumId  || undefined,
          artist_ids: artistIds,
          genre_ids:  genreIds,
        }),
      });
      showToast('Song updated successfully.', 'success');
      closeAdminModal(editModal as HTMLElement);
      loadSongs();
    } catch (err: any) {
      editErrDiv.textContent = err.message || 'Failed to save changes.';
      editErrDiv.classList.remove('hidden');
    } finally {
      _editSongSubmitPending = false;
      updateEditSongSubmitState();
      if (editSubmitBtn) editSubmitBtn.innerHTML = origText;
    }
  });

  const modal       = document.getElementById('modal-upload') as HTMLElement;
  const modalBg     = document.getElementById('modal-upload-bg') as HTMLElement;
  const modalClose  = document.getElementById('modal-upload-close') as HTMLElement;
  const form        = document.getElementById('form-upload') as HTMLFormElement;
  const audioFile   = document.getElementById('audio-file') as HTMLInputElement;
  const dropzone    = document.getElementById('audio-dropzone') as HTMLElement;
  const audioName   = document.getElementById('audio-filename') as HTMLElement;
  const upTitle     = document.getElementById('up-title') as HTMLInputElement;
  const upDuration  = document.getElementById('up-duration') as HTMLInputElement;
  const upAlbum     = document.getElementById('up-album') as HTMLSelectElement;
  const upCoverUrl     = document.getElementById('up-cover-url') as HTMLInputElement;
  const coverFile       = document.getElementById('cover-file') as HTMLInputElement;
  const coverDropzone   = document.getElementById('cover-dropzone') as HTMLElement;
  const coverPreview    = document.getElementById('cover-preview') as HTMLElement;
  const coverFilename   = document.getElementById('cover-filename') as HTMLElement;
  const coverUploadStatus = document.getElementById('cover-upload-status') as HTMLElement;
  const genresBox   = document.getElementById('genres-checkboxes') as HTMLElement;
  const errDiv      = document.getElementById('upload-error') as HTMLElement;
  const progressEl  = document.getElementById('upload-progress') as HTMLElement;
  const uploadBar   = document.getElementById('upload-bar') as HTMLElement;
  const uploadStatus = document.getElementById('upload-status') as HTMLElement;
  const submitBtn   = document.getElementById('btn-upload-submit') as HTMLButtonElement;
  const artistsBox  = document.getElementById('artists-checkboxes') as HTMLElement;

  function openModal() {
    openAdminModal(modal as HTMLElement);
    loadFormDropdowns();
  }
  function closeModal() {
    closeAdminModal(modal as HTMLElement);
    form?.reset();
    errDiv?.classList.add('hidden');
    progressEl?.classList.add('hidden');
    if (audioName) { audioName.textContent = ''; audioName.classList.add('hidden'); }
    if (coverPreview) coverPreview.innerHTML = '<span class="material-symbols-outlined text-gray-500 text-2xl">image</span>';
    if (coverFilename) coverFilename.classList.add('hidden');
    if (coverUploadStatus) coverUploadStatus.classList.add('hidden');
    if (upCoverUrl) upCoverUrl.value = '';
  }

  document.getElementById('btn-open-upload')?.addEventListener('click', openModal);
  document.getElementById('qa-upload')?.addEventListener('click', openModal);
  modalBg?.addEventListener('click', closeModal);
  modalClose?.addEventListener('click', closeModal);

  dropzone?.addEventListener('click', () => audioFile?.click());
  audioFile?.addEventListener('change', () => {
    const file = audioFile.files?.[0];
    if (!file) return;
    if (audioName) {
      audioName.textContent = `✓ ${file.name} (${(file.size / 1024 / 1024).toFixed(1)} MB)`;
      audioName.classList.remove('hidden');
    }
    const url = URL.createObjectURL(file);
    const tmpAudio = new Audio(url);
    tmpAudio.addEventListener('loadedmetadata', () => {
      if (upDuration && tmpAudio.duration && isFinite(tmpAudio.duration)) {
        upDuration.value = String(Math.round(tmpAudio.duration));
      }
      URL.revokeObjectURL(url);
    });
  });

  coverDropzone?.addEventListener('click', () => coverFile?.click());
  coverFile?.addEventListener('change', async () => {
    const file = coverFile.files?.[0];
    if (!file) return;
    const allowed = ['image/jpeg', 'image/png', 'image/webp'];
    if (!allowed.includes(file.type)) {
      showErr('Cover image must be JPG, PNG, or WebP format.');
      coverFile.value = '';
      return;
    }
    if (file.size > 5 * 1024 * 1024) {
      showErr('Cover image must not exceed 5MB.');
      coverFile.value = '';
      return;
    }
    if (coverFilename) { coverFilename.textContent = file.name; coverFilename.classList.remove('hidden'); }
    if (coverUploadStatus) { coverUploadStatus.textContent = 'Uploading...'; coverUploadStatus.classList.remove('hidden'); }
    if (upCoverUrl) upCoverUrl.value = '';
    const objUrl = URL.createObjectURL(file);
    if (coverPreview) coverPreview.innerHTML = `<img src="${objUrl}" class="w-full h-full object-cover" alt="" />`;
    try {
      const imgFd = new FormData();
      imgFd.append('cover', file);
      const token = getToken();
      const res = await fetch(`${API_BASE}/admin/upload/cover`, {
        method: 'POST',
        headers: token ? { Authorization: `Bearer ${token}` } : {},
        body: imgFd,
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.message || 'Image upload failed');
      if (upCoverUrl) upCoverUrl.value = json.data.url;
      if (coverUploadStatus) coverUploadStatus.textContent = '✓ Uploaded successfully';
      URL.revokeObjectURL(objUrl);
    } catch (err: any) {
      if (coverUploadStatus) coverUploadStatus.textContent = `Error: ${err.message}`;
      if (coverPreview) coverPreview.innerHTML = '<span class="material-symbols-outlined text-gray-500 text-2xl">image</span>';
      if (upCoverUrl) upCoverUrl.value = '';
      URL.revokeObjectURL(objUrl);
    }
  });

  async function loadFormDropdowns() {
    const artistsSel = artistsBox as unknown as HTMLSelectElement;
    if (artistsSel) {
      try {
        const { data: artists } = await apiFetch('/artists?limit=100');
        artistsSel.innerHTML = '<option value="">— No artist —</option>' +
          (artists?.length
            ? artists.map((a: any) => `<option value="${a.id}">${a.name}</option>`).join('')
            : '');
      } catch { artistsSel.innerHTML = '<option value="">— No artist —</option>'; }
    }

    await reloadGenresBox();

    try {
      const { data: albums } = await apiFetch('/admin/albums');
      if (upAlbum && albums?.length) {
        upAlbum.innerHTML = '<option value="">— No album —</option>' +
          albums.map((al: any) => `<option value="${al.id}">${al.title}${al.artist_name ? ' — ' + al.artist_name : ''}</option>`).join('');
      }
    } catch {}
  }

  async function reloadGenresBox(autoCheckId?: number) {
    const genresSel = genresBox as unknown as HTMLSelectElement;
    if (!genresSel) return;
    try {
      const { data: genres } = await apiFetch('/admin/genres');
      if (!genres?.length) { genresSel.innerHTML = '<option disabled value="">No genres available.</option>'; return; }
      genresSel.innerHTML = genres.map((g: any) =>
        `<option value="${g.id}">${g.name}</option>`).join('');
      if (autoCheckId != null) {
        const opt = genresSel.querySelector(`option[value="${autoCheckId}"]`) as HTMLOptionElement | null;
        if (opt) opt.selected = true;
      }
    } catch { genresSel.innerHTML = '<option disabled value="">Cannot load genres.</option>'; }
  }

  const toggleNewGenreBtn  = document.getElementById('btn-toggle-new-genre') as HTMLButtonElement;
  const newGenreForm       = document.getElementById('new-genre-form') as HTMLElement;
  const newGenreNameInput  = document.getElementById('new-genre-name') as HTMLInputElement;
  const createGenreBtn     = document.getElementById('btn-create-genre') as HTMLButtonElement;
  const cancelNewGenreBtn  = document.getElementById('btn-cancel-new-genre') as HTMLButtonElement;
  const newGenreError      = document.getElementById('new-genre-error') as HTMLElement;

  toggleNewGenreBtn?.addEventListener('click', () => {
    newGenreForm.classList.toggle('hidden');
    if (!newGenreForm.classList.contains('hidden')) newGenreNameInput?.focus();
  });

  cancelNewGenreBtn?.addEventListener('click', () => {
    newGenreForm.classList.add('hidden');
    newGenreNameInput.value = '';
    newGenreError.classList.add('hidden');
  });

  createGenreBtn?.addEventListener('click', async () => {
    const name = newGenreNameInput.value.trim();
    newGenreError.classList.add('hidden');
    if (!name) { newGenreError.textContent = 'Please enter a genre name.'; newGenreError.classList.remove('hidden'); return; }

    const confirmed = await showConfirm({
      title: 'Create Genre',
      body: `Create new genre "${name}"?`,
      confirmLabel: 'Create',
      confirmClass: 'bg-green-600 hover:bg-green-500',
      icon: 'add_circle',
      iconClass: 'text-green-300',
      iconWrapClass: 'bg-green-500/15',
    });
    if (!confirmed) return;

    createGenreBtn.disabled = true;
    const origHTML = createGenreBtn.innerHTML;
    createGenreBtn.innerHTML = '<span class="material-symbols-outlined text-[13px] animate-spin">refresh</span>';

    try {
      const json = await apiFetch('/admin/genres', {
        method: 'POST',
        body: JSON.stringify({ name }),
      });
      const newId: number = json.data.id;
      newGenreNameInput.value = '';
      newGenreForm.classList.add('hidden');
      showToast('Genre created successfully.', 'success');
      await reloadGenresBox(newId);
    } catch (err: any) {
      newGenreError.textContent = err.message || 'Failed to create genre.';
      newGenreError.classList.remove('hidden');
    } finally {
      createGenreBtn.disabled = false;
      createGenreBtn.innerHTML = origHTML;
    }
  });

  newGenreNameInput?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter') { e.preventDefault(); createGenreBtn?.click(); }
  });

  const toggleNewAlbumBtn  = document.getElementById('btn-toggle-new-album') as HTMLButtonElement;
  const newAlbumForm       = document.getElementById('new-album-form') as HTMLElement;
  const newAlbumTitleInput = document.getElementById('new-album-title') as HTMLInputElement;
  const createAlbumBtn     = document.getElementById('btn-create-album') as HTMLButtonElement;
  const cancelNewAlbumBtn  = document.getElementById('btn-cancel-new-album') as HTMLButtonElement;
  const newAlbumError      = document.getElementById('new-album-error') as HTMLElement;

  toggleNewAlbumBtn?.addEventListener('click', () => {
    newAlbumForm.classList.toggle('hidden');
    if (!newAlbumForm.classList.contains('hidden')) newAlbumTitleInput?.focus();
  });

  cancelNewAlbumBtn?.addEventListener('click', () => {
    newAlbumForm.classList.add('hidden');
    newAlbumTitleInput.value = '';
    newAlbumError.classList.add('hidden');
  });

  createAlbumBtn?.addEventListener('click', async () => {
    const title = newAlbumTitleInput.value.trim();
    newAlbumError.classList.add('hidden');
    if (!title) {
      newAlbumError.textContent = 'Album title is required.';
      newAlbumError.classList.remove('hidden');
      return;
    }

    const confirmed = await showConfirm({
      title: 'Create Album',
      body: `Create new album "${title}"?`,
      confirmLabel: 'Create',
      confirmClass: 'bg-green-600 hover:bg-green-500',
      icon: 'add_circle',
      iconClass: 'text-green-300',
      iconWrapClass: 'bg-green-500/15',
    });
    if (!confirmed) return;

    createAlbumBtn.disabled = true;
    const origHTML = createAlbumBtn.innerHTML;
    createAlbumBtn.innerHTML = '<span class="material-symbols-outlined text-[13px] animate-spin">refresh</span>';
    try {
      const { data: album } = await apiFetch('/admin/albums', {
        method: 'POST',
        body: JSON.stringify({ title }),
      });
      const opt = document.createElement('option');
      opt.value = String(album.id);
      opt.textContent = album.title;
      opt.selected = true;
      upAlbum.appendChild(opt);
      newAlbumForm.classList.add('hidden');
      newAlbumTitleInput.value = '';
      showToast(`Album "${title}" created successfully.`, 'success');
    } catch (err: any) {
      newAlbumError.textContent = err.message || 'Failed to create album.';
      newAlbumError.classList.remove('hidden');
    } finally {
      createAlbumBtn.disabled = false;
      createAlbumBtn.innerHTML = origHTML;
    }
  });

  newAlbumTitleInput?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter') { e.preventDefault(); createAlbumBtn?.click(); }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errDiv?.classList.add('hidden');

    const file = audioFile?.files?.[0];
    if (!file) { showErr('Please select an audio file.'); return; }
    if (!upTitle.value.trim()) { showErr('Please enter a title.'); return; }
    if (!upDuration.value || parseInt(upDuration.value) <= 0) { showErr('Please enter a valid duration.'); return; }

    const artistsSel = document.getElementById('artists-checkboxes') as HTMLSelectElement;
    const genresSel  = document.getElementById('genres-checkboxes') as HTMLSelectElement;
    const checkedArtists = artistsSel?.value ? [artistsSel.value] : [];
    const checkedGenres  = genresSel  ? Array.from(genresSel.selectedOptions).map((o: any) => o.value)  : [];

    const fd = new FormData();
    fd.append('audio', file);
    fd.append('title', upTitle.value.trim());
    fd.append('duration', upDuration.value);
    if (upAlbum.value) fd.append('album_id', upAlbum.value);
    const hasCoverFile = (coverFile?.files?.length ?? 0) > 0;
    if (hasCoverFile && !upCoverUrl.value) { showErr('Cover image is uploading or has an error. Please reselect the cover image.'); return; }
    if (upCoverUrl.value) fd.append('cover_url', upCoverUrl.value);
    fd.append('artist_ids', JSON.stringify(checkedArtists));
    fd.append('genre_ids',  JSON.stringify(checkedGenres));

    const confirmed = await showConfirm({
      title: 'Upload Song',
      body: `Upload song "${upTitle.value.trim()}"?`,
      confirmLabel: 'Upload',
      confirmClass: 'bg-indigo-600 hover:bg-indigo-500',
      icon: 'upload',
      iconClass: 'text-indigo-300',
      iconWrapClass: 'bg-indigo-500/15',
    });
    if (!confirmed) return;

    submitBtn.disabled = true;
    progressEl?.classList.remove('hidden');
    if (uploadBar) uploadBar.style.width = '10%';

    try {
      const token = getToken();
      const res = await fetch(`${API_BASE}/admin/songs/upload`, {
        method: 'POST',
        headers: token ? { Authorization: `Bearer ${token}` } : {},
        body: fd,
      });
      if (uploadBar) uploadBar.style.width = '90%';
      const json = await res.json();
      if (!res.ok) throw new Error(json.message || 'Upload failed');
      if (uploadBar) uploadBar.style.width = '100%';
      if (uploadStatus) uploadStatus.textContent = 'Upload successful!';
      showToast('Song uploaded successfully.', 'success');
      setTimeout(() => { closeModal(); loadSongs(); }, 1200);
    } catch (err: any) {
      showErr(err.message || 'Upload failed.');
      progressEl?.classList.add('hidden');
    } finally {
      submitBtn.disabled = false;
    }
  });

  function showErr(msg: string) {
    if (errDiv) { errDiv.textContent = msg; errDiv.classList.remove('hidden'); }
  }

  async function loadArtistRequests() {
    const container = document.getElementById('artist-requests-list');
    const badge = document.getElementById('requests-count-badge') as HTMLElement | null;
    if (!container) return;
    container.innerHTML = '<p class="px-6 py-6 text-sm text-gray-500 text-center">Loading...</p>';
    try {
      const { data: requests } = await apiFetch('/roles/requests?status=pending');
      if (!requests?.length) {
        container.innerHTML = '<p class="px-6 py-6 text-sm text-gray-500 text-center">No pending artist requests.</p>';
        if (badge) badge.classList.add('hidden');
        return;
      }
      if (badge) { badge.textContent = String(requests.length); badge.classList.remove('hidden'); }
      container.innerHTML = requests.map((r: any) => `
        <div class="flex items-center gap-4 px-6 py-4 hover:bg-white/3 transition-colors" data-req-id="${r.id}">
          <div class="w-9 h-9 rounded-full shrink-0 flex items-center justify-center text-white text-sm font-bold"
               style="background:${colorFor(r.user_id)}">
            ${(r.username || r.email || '?').charAt(0).toUpperCase()}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-gray-100">${r.username || '—'}</p>
            <p class="text-xs text-gray-500 truncate">${r.email} · ${fmtDate(r.created_at)}</p>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <button class="btn-approve-req flex items-center gap-1 px-3 py-1.5 text-xs font-semibold bg-green-500/15 hover:bg-green-500/25 text-green-400 rounded-lg transition-all"
                    data-id="${r.id}">
              <span class="material-symbols-outlined text-[14px]">check_circle</span>Approve
            </button>
            <button class="btn-reject-req flex items-center gap-1 px-3 py-1.5 text-xs font-semibold bg-red-500/15 hover:bg-red-500/25 text-red-400 rounded-lg transition-all"
                    data-id="${r.id}">
              <span class="material-symbols-outlined text-[14px]">cancel</span>Reject
            </button>
          </div>
        </div>`).join('');
    } catch (err: any) {
      container.innerHTML = `<p class="px-6 py-6 text-sm text-red-400 text-center">Failed to load: ${err.message}</p>`;
    }
  }

  document.getElementById('artist-requests-list')?.addEventListener('click', async (e: Event) => {
    const approveBtn = (e.target as HTMLElement).closest('.btn-approve-req') as HTMLButtonElement | null;
    const rejectBtn  = (e.target as HTMLElement).closest('.btn-reject-req')  as HTMLButtonElement | null;
    const btn = approveBtn || rejectBtn;
    if (!btn || btn.disabled) return;
    const id     = btn.dataset.id;
    const action = approveBtn ? 'approve' : 'reject';
    const reqRow = btn.closest('[data-req-id]');
    const reqName = reqRow?.querySelector('.text-sm.font-semibold')?.textContent?.trim() || `#${id}`;
    const confirmed = await showConfirm(
      approveBtn
        ? {
            title: 'Approve Artist Request',
            body: `Approve artist request from "${reqName}"?`,
            confirmLabel: 'Approve',
            confirmClass: 'bg-green-600 hover:bg-green-500',
            icon: 'check_circle',
            iconClass: 'text-green-400',
            iconWrapClass: 'bg-green-500/15',
          }
        : {
            title: 'Reject Artist Request',
            body: `Reject artist request from "${reqName}"?`,
            confirmLabel: 'Reject',
            confirmClass: 'bg-rose-600 hover:bg-rose-500',
            icon: 'cancel',
            iconClass: 'text-rose-400',
            iconWrapClass: 'bg-rose-500/15',
          }
    );
    if (!confirmed) return;
    const container = document.getElementById('artist-requests-list')!;
    const badge = document.getElementById('requests-count-badge') as HTMLElement | null;
    (btn as HTMLButtonElement).disabled = true;
    const origHTML = btn.innerHTML;
    btn.innerHTML = '<span class="material-symbols-outlined text-[14px] animate-spin">refresh</span>';
    try {
      await apiFetch(`/roles/requests/${id}`, { method: 'PATCH', body: JSON.stringify({ action }) });
      container.querySelector(`[data-req-id="${id}"]`)?.remove();
      const remaining = container.querySelectorAll('[data-req-id]').length;
      if (!remaining) {
        container.innerHTML = '<p class="px-6 py-6 text-sm text-gray-500 text-center">No pending artist requests.</p>';
        if (badge) badge.classList.add('hidden');
      } else if (badge) { badge.textContent = String(remaining); }
      showToast(approveBtn ? 'Artist request approved.' : 'Artist request rejected.', 'success');
      if (approveBtn) loadUsers(_userPage);
    } catch (err: any) {
      showToast(err.message || 'Action failed.', 'error');
      (btn as HTMLButtonElement).disabled = false;
      btn.innerHTML = origHTML;
    }
  });

