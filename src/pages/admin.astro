      showToast('Album created successfully.', 'success');
      _loadedSections.delete('albums');
      loadAlbums();
    } catch (err: any) {
      addAlbumErrDiv.textContent = err.message || 'Failed to create album.';
      addAlbumErrDiv.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = origText;
    }
  });

