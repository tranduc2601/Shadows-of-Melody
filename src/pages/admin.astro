---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Admin Panel - Shadows of Melody">
  <div class="flex min-h-[100dvh] overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30 mobile-page-shell">

    <script is:inline>
      (function () {
        if (localStorage.getItem('sidebar_collapsed') === 'true') {
          var el = document.getElementById('admin-sidebar');
          if (el) {
            el.classList.add('admin-sidebar-collapsed', 'no-sidebar-transition');
            requestAnimationFrame(function () {
              requestAnimationFrame(function () {
                el.classList.remove('no-sidebar-transition');
              });
            });
          }
        }
      })();
    </script>

    <aside id="admin-sidebar"
      class="admin-sidebar-root w-64 shrink-0 border-r border-white/5 bg-[#070d1f] hidden md:flex md:flex-col z-40
             transition-[width] duration-300 ease-in-out overflow-hidden">
      <div class="h-20 flex items-center justify-between px-4 border-b border-white/5 shrink-0">
        <a href="/" class="flex items-center gap-2 min-w-0 overflow-hidden">
          <span class="material-symbols-outlined text-purple-400 animate-pulse shrink-0">music_note</span>
          <span class="admin-sidebar-label text-2xl font-black bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-purple-400
                       transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Melody</span>
        </a>
        <button id="admin-sidebar-toggle"
          title="Toggle sidebar"
          class="shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-400
                 hover:text-white hover:bg-white/10 transition-all duration-200">
          <span id="admin-sidebar-toggle-icon" class="material-symbols-outlined text-[20px] transition-transform duration-300">chevron_left</span>
        </button>
      </div>

      <div class="mx-3 mt-4 px-3 py-2 rounded-xl bg-linear-to-r from-purple-500/20 to-indigo-500/10 border border-purple-500/20 flex items-center gap-2 overflow-hidden shrink-0">
        <span class="material-symbols-outlined text-purple-400 text-[18px] shrink-0">admin_panel_settings</span>
        <span class="admin-sidebar-label text-xs font-bold text-purple-300 uppercase tracking-widest
                     transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Admin Panel</span>
      </div>

      <div class="px-3 py-4 flex-1 overflow-y-auto overflow-x-hidden">
        <p class="admin-sidebar-label px-3 text-xs font-bold text-gray-500 uppercase tracking-wider mb-3
                  transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Overview</p>
        <nav class="space-y-1 mb-6">
          <button data-section="dashboard" title="Dashboard"
            class="nav-btn admin-nav-item nav-active w-full flex items-center gap-4 px-3 py-3 bg-linear-to-r from-purple-500/20 to-transparent text-white rounded-xl font-medium transition-all duration-200 shadow-[inset_2px_0_0_0_rgba(168,85,247,1)]">
            <span class="nav-icon material-symbols-outlined text-purple-400 shrink-0 transition-all duration-200">dashboard</span>
            <span class="admin-sidebar-label transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Dashboard</span>
          </button>
        </nav>

        <p class="admin-sidebar-label px-3 text-xs font-bold text-gray-500 uppercase tracking-wider mb-3
                  transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Manage</p>
        <nav class="space-y-1 mb-6">
          <button data-section="users" title="Users"
            class="nav-btn admin-nav-item w-full flex items-center gap-4 px-3 py-3 text-slate-100 hover:text-white hover:bg-white/10 rounded-xl font-medium transition-all duration-200 group border border-transparent hover:border-white/10">
            <span class="nav-icon material-symbols-outlined shrink-0 text-slate-200 transition-all duration-200 group-hover:scale-110">group</span>
            <span class="admin-sidebar-label transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Users</span>
          </button>
          <button data-section="songs" title="Songs"
            class="nav-btn admin-nav-item w-full flex items-center gap-4 px-3 py-3 text-slate-100 hover:text-white hover:bg-white/10 rounded-xl font-medium transition-all duration-200 group border border-transparent hover:border-white/10">
            <span class="nav-icon material-symbols-outlined shrink-0 text-slate-200 transition-all duration-200 group-hover:scale-110">music_note</span>
            <span class="admin-sidebar-label transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Songs</span>
          </button>
          <button data-section="artists" title="Artists"
            class="nav-btn admin-nav-item w-full flex items-center gap-4 px-3 py-3 text-slate-100 hover:text-white hover:bg-white/10 rounded-xl font-medium transition-all duration-200 group border border-transparent hover:border-white/10">
            <span class="nav-icon material-symbols-outlined shrink-0 text-slate-200 transition-all duration-200 group-hover:scale-110">mic</span>
            <span class="admin-sidebar-label transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Artists</span>
          </button>
          <button data-section="playlists" title="Playlists"
            class="nav-btn admin-nav-item w-full flex items-center gap-4 px-3 py-3 text-slate-100 hover:text-white hover:bg-white/10 rounded-xl font-medium transition-all duration-200 group border border-transparent hover:border-white/10">
            <span class="nav-icon material-symbols-outlined shrink-0 text-slate-200 transition-all duration-200 group-hover:scale-110">queue_music</span>
            <span class="admin-sidebar-label transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Playlists</span>
          </button>
          <button data-section="albums" title="Albums"
            class="nav-btn admin-nav-item w-full flex items-center gap-4 px-3 py-3 text-slate-100 hover:text-white hover:bg-white/10 rounded-xl font-medium transition-all duration-200 group border border-transparent hover:border-white/10">
            <span class="nav-icon material-symbols-outlined shrink-0 text-slate-200 transition-all duration-200 group-hover:scale-110">album</span>
            <span class="admin-sidebar-label transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Albums</span>
          </button>
          <button data-section="genres" title="Genres"
            class="nav-btn admin-nav-item w-full flex items-center gap-4 px-3 py-3 text-slate-100 hover:text-white hover:bg-white/10 rounded-xl font-medium transition-all duration-200 group border border-transparent hover:border-white/10">
            <span class="nav-icon material-symbols-outlined shrink-0 text-slate-200 transition-all duration-200 group-hover:scale-110">label</span>
            <span class="admin-sidebar-label transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Genres</span>
          </button>
        </nav>

        <p class="admin-sidebar-label px-3 text-xs font-bold text-gray-500 uppercase tracking-wider mb-3
                  transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Reports</p>
        <nav class="space-y-1 mb-6">
          <button data-section="analytics" title="Analytics"
            class="nav-btn admin-nav-item w-full flex items-center gap-4 px-3 py-3 text-slate-100 hover:text-white hover:bg-white/10 rounded-xl font-medium transition-all duration-200 group border border-transparent hover:border-white/10">
            <span class="nav-icon material-symbols-outlined shrink-0 text-slate-200 transition-all duration-200 group-hover:scale-110">bar_chart_4_bars</span>
            <span class="admin-sidebar-label transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Analytics</span>
          </button>
        </nav>

        <p class="admin-sidebar-label px-3 text-xs font-bold text-gray-500 uppercase tracking-wider mb-3
                  transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">System</p>
        <nav class="space-y-1">
          <a href="/" title="Go Back"
            class="admin-nav-item flex items-center gap-4 px-3 py-3 text-slate-100 hover:text-white hover:bg-white/10 rounded-xl font-medium transition-all duration-200 group border border-transparent hover:border-white/10">
            <span class="nav-icon material-symbols-outlined shrink-0 text-slate-200 transition-all duration-200 group-hover:scale-110">arrow_back</span>
            <span class="admin-sidebar-label transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">Go Back</span>
          </a>
        </nav>
      </div>

      <div class="p-3 border-t border-white/5 shrink-0">
        <div class="admin-nav-item flex items-center gap-3 p-2 rounded-xl bg-white/5 cursor-pointer transition-all duration-200 overflow-hidden border border-white/5">
          <div class="w-10 h-10 rounded-full bg-linear-to-tr from-indigo-500 to-purple-500 p-0.5 shrink-0">
            <div id="sidebar-admin-avatar" class="w-full h-full rounded-full bg-[#0a1229] flex items-center justify-center overflow-hidden">
              <span class="material-symbols-outlined text-purple-400">shield_person</span>
            </div>
          </div>
          <div class="admin-sidebar-label flex-1 min-w-0 transition-all duration-300 ease-in-out overflow-hidden whitespace-nowrap">
            <p id="sidebar-admin-name" class="text-sm font-semibold text-white truncate">Admin</p>
            <p id="sidebar-admin-role" class="text-xs text-indigo-400 font-medium">Super Admin</p>
          </div>
          <button id="admin-logout-btn" title="Sign Out"
            class="admin-sidebar-label shrink-0 text-gray-500 hover:text-red-400 transition-all duration-200 p-1 rounded-lg hover:bg-red-500/10
                   overflow-hidden whitespace-nowrap">
            <span class="material-symbols-outlined text-[18px]">logout</span>
          </button>
        </div>
      </div>
    </aside>

    <main class="flex-1 flex flex-col relative overflow-hidden bg-linear-to-br from-[#0c1328] via-[#060e20] to-[#040813]">
      <div class="absolute top-[-10%] left-[-10%] w-[28%] h-[28%] bg-indigo-600/6 rounded-full opacity-60 pointer-events-none"></div>
      <div class="absolute bottom-[10%] right-[-5%] w-[20%] h-[20%] bg-purple-600/6 rounded-full opacity-50 pointer-events-none"></div>

      <header class="h-20 shrink-0 flex items-center justify-between px-6 lg:px-8 border-b border-white/5 relative z-10">
        <div class="flex items-center gap-4">
          <button class="md:hidden w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white">
            <span class="material-symbols-outlined">menu</span>
          </button>
          <div>
            <h1 id="page-title" class="text-xl font-bold text-white">Dashboard</h1>
            <p class="text-xs text-gray-500">Welcome back, <span id="header-admin-name">Admin</span></p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="relative hidden sm:flex items-center group">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-[19px] group-focus-within:text-purple-400 transition-colors pointer-events-none">search</span>
            <input
              type="text"
              placeholder="Search anything..."
              class="w-64 h-10 bg-white/6 border border-white/10 text-gray-100 placeholder-gray-500 rounded-xl py-0 pl-11 pr-10 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/40 focus:border-purple-500/40 focus:bg-white/10 transition-all duration-200 "
            />
            <kbd class="absolute right-3 top-1/2 -translate-y-1/2 hidden lg:inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] font-semibold text-gray-600 bg-white/5 border border-white/10 rounded-md pointer-events-none select-none">/</kbd>
          </div>

        </div>
      </header>

      <div class="flex-1 overflow-y-auto px-6 lg:px-8 py-8 relative z-10 custom-scrollbar">

        <div id="section-dashboard" class="space-y-5">

          <div class="grid grid-cols-2 xl:grid-cols-4 gap-4">
            <div class="bg-white/3 border border-white/5 rounded-2xl p-5  hover:bg-white/5 transition-all group">
              <div class="flex items-start justify-between mb-3">
                <div class="w-11 h-11 rounded-xl bg-linear-to-br from-violet-500 to-purple-600 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-white text-[20px]">group</span>
                </div>
                <span id="dash-users-trend" class="hidden text-xs font-semibold px-2 py-1 rounded-full bg-green-500/15 text-green-400 flex items-center gap-0.5"></span>
              </div>
              <p id="stat-users" class="text-2xl font-black text-white mb-0.5">—</p>
              <p class="text-xs text-gray-400 font-medium">Total Users</p>
              <p id="dash-users-new" class="text-[11px] text-violet-400 mt-1 hidden"></p>
            </div>
            <div class="bg-white/3 border border-white/5 rounded-2xl p-5 backdrop-blur-sm hover:bg-white/5 transition-all group">
              <div class="flex items-start justify-between mb-3">
                <div class="w-11 h-11 rounded-xl bg-linear-to-br from-blue-500 to-indigo-600 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-white text-[20px]">music_note</span>
                </div>
              </div>
              <p id="stat-songs" class="text-2xl font-black text-white mb-0.5">—</p>
              <p class="text-xs text-gray-400 font-medium">Total Songs</p>
            </div>
            <div class="bg-white/3 border border-white/5 rounded-2xl p-5 backdrop-blur-sm hover:bg-white/5 transition-all group">
              <div class="flex items-start justify-between mb-3">
                <div class="w-11 h-11 rounded-xl bg-linear-to-br from-pink-500 to-rose-600 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-white text-[20px]">mic</span>
                </div>
              </div>
              <p id="stat-artists" class="text-2xl font-black text-white mb-0.5">—</p>
              <p class="text-xs text-gray-400 font-medium">Total Artists</p>
            </div>
            <div class="bg-white/3 border border-white/5 rounded-2xl p-5 backdrop-blur-sm hover:bg-white/5 transition-all group">
              <div class="flex items-start justify-between mb-3">
                <div class="w-11 h-11 rounded-xl bg-linear-to-br from-amber-500 to-orange-600 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-white text-[20px]">queue_music</span>
                </div>
              </div>
              <p id="stat-playlists" class="text-2xl font-black text-white mb-0.5">—</p>
              <p class="text-xs text-gray-400 font-medium">Total Playlists</p>
            </div>
          </div>

          <div class="grid grid-cols-2 xl:grid-cols-4 gap-4">
            <div class="bg-white/3 border border-white/5 rounded-2xl p-5 backdrop-blur-sm hover:bg-white/5 transition-all group">
              <div class="flex items-start justify-between mb-3">
                <div class="w-11 h-11 rounded-xl bg-linear-to-br from-emerald-500 to-teal-600 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-white text-[20px]">play_circle</span>
                </div>
              </div>
              <p id="dash-total-plays" class="text-2xl font-black text-white mb-0.5">—</p>
              <p class="text-xs text-gray-400 font-medium">Total Plays</p>
            </div>
            <div class="bg-white/3 border border-white/5 rounded-2xl p-5 backdrop-blur-sm hover:bg-white/5 transition-all group">
              <div class="flex items-start justify-between mb-3">
                <div class="w-11 h-11 rounded-xl bg-linear-to-br from-sky-500 to-blue-600 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-white text-[20px]">headphones</span>
                </div>
              </div>
              <p id="dash-active-listeners" class="text-2xl font-black text-white mb-0.5">—</p>
              <p class="text-xs text-gray-400 font-medium">Active Listeners</p>
              <p class="text-[11px] text-sky-400 mt-1">Last 30 days</p>
            </div>
            <div class="bg-white/3 border border-white/5 rounded-2xl p-5 backdrop-blur-sm hover:bg-white/5 transition-all group">
              <div class="flex items-start justify-between mb-3">
                <div class="w-11 h-11 rounded-xl bg-linear-to-br from-indigo-500 to-violet-600 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-white text-[20px]">schedule</span>
                </div>
              </div>
              <p id="dash-listening-time" class="text-2xl font-black text-white mb-0.5">—</p>
              <p class="text-xs text-gray-400 font-medium">Listening Time</p>
            </div>
            <div class="bg-white/3 border border-white/5 rounded-2xl p-5 backdrop-blur-sm hover:bg-white/5 transition-all group">
              <div class="flex items-start justify-between mb-3">
                <div class="w-11 h-11 rounded-xl bg-linear-to-br from-rose-500 to-pink-600 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-white text-[20px]">payments</span>
                </div>
              </div>
              <p id="dash-revenue-month" class="text-2xl font-black text-white mb-0.5">—</p>
              <p class="text-xs text-gray-400 font-medium">Revenue This Month</p>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
            <div class="bg-white/3 border border-white/5 rounded-2xl p-5 backdrop-blur-sm">
              <div class="flex items-center gap-2 mb-1">
                <span class="material-symbols-outlined text-violet-400 text-[18px]">group_add</span>
                <h3 class="text-sm font-bold text-white">User Growth</h3>
                <span class="ml-auto text-[11px] text-gray-500 bg-white/5 px-2 py-0.5 rounded-full">Last 30 days</span>
              </div>
              <p id="dash-user-growth-sub" class="text-xs text-gray-500 mb-3"></p>
              <div class="relative h-[180px]">
                <canvas id="dash-chart-user-growth"></canvas>
              </div>
            </div>
            <div class="bg-white/3 border border-white/5 rounded-2xl p-5 backdrop-blur-sm">
              <div class="flex items-center gap-2 mb-1">
                <span class="material-symbols-outlined text-blue-400 text-[18px]">multiline_chart</span>
                <h3 class="text-sm font-bold text-white">Listening Activity</h3>
                <span class="ml-auto text-[11px] text-gray-500 bg-white/5 px-2 py-0.5 rounded-full">Last 30 days</span>
              </div>
              <p id="dash-listening-sub" class="text-xs text-gray-500 mb-3"></p>
              <div class="relative h-[180px]">
                <canvas id="dash-chart-listening"></canvas>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
            <div class="bg-white/3 border border-white/5 rounded-2xl p-5 backdrop-blur-sm lg:col-span-1">
              <div class="flex items-center gap-2 mb-4">
                <span class="material-symbols-outlined text-pink-400 text-[18px]">leaderboard</span>
                <h3 class="text-sm font-bold text-white">Top Songs</h3>
                <button data-section="analytics"
                  class="nav-btn ml-auto text-[11px] text-purple-400 hover:text-purple-300 flex items-center gap-0.5 transition-colors">
                  View all <span class="material-symbols-outlined text-[13px]">chevron_right</span>
                </button>
              </div>
              <div id="dash-top-songs" class="space-y-2">
                <p class="text-gray-500 text-xs text-center py-4">Loading...</p>
              </div>
            </div>

            <div class="bg-white/3 border border-white/5 rounded-2xl p-5 backdrop-blur-sm lg:col-span-1">
              <div class="flex items-center gap-2 mb-4">
                <span class="material-symbols-outlined text-emerald-400 text-[18px]">donut_large</span>
                <h3 class="text-sm font-bold text-white">Genres</h3>
              </div>
              <div class="flex flex-col items-center gap-3">
                <div class="relative w-[130px] h-[130px]">
                  <canvas id="dash-chart-genres"></canvas>
                  <div id="dash-genres-empty" class="hidden absolute inset-0 flex items-center justify-center">
                    <p class="text-gray-500 text-xs text-center">No data</p>
                  </div>
                </div>
                <div id="dash-genre-legend" class="w-full space-y-1.5 text-xs"></div>
              </div>
            </div>

            <div class="bg-white/3 border border-white/5 rounded-2xl p-5 backdrop-blur-sm lg:col-span-1">
              <div class="flex items-center gap-2 mb-4">
                <span class="material-symbols-outlined text-amber-400 text-[18px]">person_add</span>
                <h3 class="text-sm font-bold text-white">New Users</h3>
                <button data-section="users"
                  class="nav-btn ml-auto text-[11px] text-purple-400 hover:text-purple-300 flex items-center gap-0.5 transition-colors">
                  View all <span class="material-symbols-outlined text-[13px]">chevron_right</span>
                </button>
              </div>
              <div id="admin-recent-users" class="space-y-3">
                <p class="text-xs text-gray-500 text-center py-4">Loading...</p>
              </div>
            </div>
          </div>

          <div class="bg-white/3 border border-white/5 rounded-2xl p-5 backdrop-blur-sm">
            <div class="flex items-center gap-2 mb-4">
              <span class="material-symbols-outlined text-indigo-400 text-[18px]">bolt</span>
              <h3 class="text-sm font-bold text-white">Quick Actions</h3>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <button data-section="songs" class="nav-btn flex flex-col items-center gap-2 p-4 bg-white/3 hover:bg-white/8 border border-white/5 hover:border-blue-500/30 rounded-xl transition-all group">
                <div class="w-10 h-10 rounded-xl bg-blue-500/15 group-hover:bg-blue-500/25 flex items-center justify-center transition-all">
                  <span class="material-symbols-outlined text-blue-400 text-[20px]">upload_file</span>
                </div>
                <span class="text-xs font-medium text-gray-300 group-hover:text-white">Upload Song</span>
              </button>
              <button data-section="artists" class="nav-btn flex flex-col items-center gap-2 p-4 bg-white/3 hover:bg-white/8 border border-white/5 hover:border-pink-500/30 rounded-xl transition-all group">
                <div class="w-10 h-10 rounded-xl bg-pink-500/15 group-hover:bg-pink-500/25 flex items-center justify-center transition-all">
                  <span class="material-symbols-outlined text-pink-400 text-[20px]">mic</span>
                </div>
                <span class="text-xs font-medium text-gray-300 group-hover:text-white">Manage Artists</span>
              </button>
              <button data-section="users" class="nav-btn flex flex-col items-center gap-2 p-4 bg-white/3 hover:bg-white/8 border border-white/5 hover:border-violet-500/30 rounded-xl transition-all group">
                <div class="w-10 h-10 rounded-xl bg-violet-500/15 group-hover:bg-violet-500/25 flex items-center justify-center transition-all">
                  <span class="material-symbols-outlined text-violet-400 text-[20px]">manage_accounts</span>
                </div>
                <span class="text-xs font-medium text-gray-300 group-hover:text-white">Manage Users</span>
              </button>
              <button data-section="subscriptions" class="nav-btn flex flex-col items-center gap-2 p-4 bg-white/3 hover:bg-white/8 border border-white/5 hover:border-amber-500/30 rounded-xl transition-all group">
                <div class="w-10 h-10 rounded-xl bg-amber-500/15 group-hover:bg-amber-500/25 flex items-center justify-center transition-all">
                  <span class="material-symbols-outlined text-amber-400 text-[20px]">workspace_premium</span>
                </div>
                <span class="text-xs font-medium text-gray-300 group-hover:text-white">Subscriptions</span>
              </button>
              <button data-section="analytics" class="nav-btn flex flex-col items-center gap-2 p-4 bg-white/3 hover:bg-white/8 border border-white/5 hover:border-emerald-500/30 rounded-xl transition-all group">
