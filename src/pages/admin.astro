  document.getElementById('admin-genres-tbody')?.addEventListener('click', async (e: Event) => {
    const editBtn = (e.target as HTMLElement).closest('.btn-edit-genre') as HTMLElement | null;
    const delBtn  = (e.target as HTMLElement).closest('.btn-delete-genre') as HTMLElement | null;
    if (editBtn) {
      openGenreModal(editBtn.dataset.id!, decodeURIComponent(editBtn.dataset.name!), decodeURIComponent(editBtn.dataset.description ?? ''));
    } else if (delBtn) {
      const id   = delBtn.dataset.id!;
      const name = delBtn.dataset.name!;
      if (!confirm(`Delete genre "${name}"? Songs using this genre will lose it.`)) return;
      try {
        await apiFetch(`/admin/genres/${id}`, { method: 'DELETE' });
        loadGenres();
        showToast('Genre deleted.', 'success');
      } catch (err: any) {
        showToast(err.message || 'Failed to delete genre.', 'error');
      }
