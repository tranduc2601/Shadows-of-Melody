  async function loadStats() {
    try {
      const [statsRes, analyticsRes] = await Promise.allSettled([
        apiFetch('/admin/stats'),
        apiFetch('/admin/analytics'),
      ]);

      const set = (id: string, v: any) => { const el = document.getElementById(id); if (el) el.textContent = String(v); };

      if (statsRes.status === 'fulfilled') {
        const data = statsRes.value.data;
        set('stat-users',     data.users_count?.toLocaleString()    ?? '0');
        set('stat-songs',     data.songs_count?.toLocaleString()    ?? '0');
        set('stat-artists',   data.artists_count?.toLocaleString()  ?? '0');
        set('stat-playlists', data.playlists_count?.toLocaleString() ?? '—');

        const recentEl = document.getElementById('admin-recent-users');
        if (recentEl && data.recent_users?.length) {
          recentEl.innerHTML = data.recent_users.map((u: any) => `
            <div class="flex items-center gap-3 group">
              <div class="w-8 h-8 rounded-full flex items-center justify-center shrink-0 text-white text-xs font-bold"
                   style="background:${colorFor(u.id)}">
                ${(u.username || u.email || '?').charAt(0).toUpperCase()}
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-xs font-semibold text-gray-200 truncate">${u.username || u.email}</p>
                <p class="text-[11px] text-gray-500 truncate">${u.email}</p>
              </div>
              <span class="text-[11px] text-gray-600 shrink-0">${fmtDate(u.created_at)}</span>
            </div>`).join('');
        } else if (recentEl) {
          recentEl.innerHTML = '<p class="text-xs text-gray-500 text-center py-4">No recent users.</p>';
        }

        const newUsersEl = document.getElementById('dash-users-new');
        if (newUsersEl && data.recent_users?.length) {
          const week = new Date(); week.setDate(week.getDate() - 7);
          const newCount = data.recent_users.filter((u: any) => new Date(u.created_at) > week).length;
          if (newCount > 0) {
            newUsersEl.textContent = `+${newCount} this week`;
            newUsersEl.classList.remove('hidden');
          }
        }
      }

      if (analyticsRes.status === 'fulfilled') {
        const { summary, user_growth, listening_activity, top_songs, genre_distribution } = analyticsRes.value.data;

        set('dash-total-plays',      (summary.total_plays ?? 0).toLocaleString());
        set('dash-active-listeners', (summary.active_listeners ?? 0).toLocaleString());
        set('dash-listening-time',   fmtSeconds(summary.total_listening_seconds ?? 0));
        set('dash-revenue-month',    `$${(summary.revenue_this_month ?? 0).toFixed(2)}`);

        const ugTotal = (user_growth as any[]).reduce((s: number, r: any) => s + (r.count ?? 0), 0);
        const laTotal = (listening_activity as any[]).reduce((s: number, r: any) => s + (r.plays ?? 0), 0);
        const ugSubEl = document.getElementById('dash-user-growth-sub');
        const laSubEl = document.getElementById('dash-listening-sub');
        if (ugSubEl) ugSubEl.textContent = `${ugTotal} new registrations in the last 30 days`;
        if (laSubEl) laSubEl.textContent = `${laTotal.toLocaleString()} plays recorded in the last 30 days`;

        await ensureChartJs();
        const Chart = (window as any).Chart;
        chartDefaults(Chart);
        destroyDashCharts();

        const baseLineOpts = {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: { mode: 'index' as const, intersect: false },
          },
          scales: {
            x: { grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { maxTicksLimit: 6, font: { size: 10 } } },
            y: { grid: { color: 'rgba(255,255,255,0.04)' }, beginAtZero: true, ticks: { precision: 0, font: { size: 10 } } },
          },
        };

        {
          const { labels, values } = fillDateSeries(user_growth, 30, 'count');
          const ctx = (document.getElementById('dash-chart-user-growth') as HTMLCanvasElement)?.getContext('2d');
          if (ctx) {
            const grad = ctx.createLinearGradient(0, 0, 0, 180);
            grad.addColorStop(0, 'rgba(139,92,246,0.35)');
            grad.addColorStop(1, 'rgba(139,92,246,0.02)');
            _dashCharts.push(new Chart(ctx, {
              type: 'line',
              data: {
                labels,
                datasets: [{
                  label: 'New Users',
                  data: values,
                  borderColor: 'rgba(139,92,246,1)',
                  backgroundColor: grad,
                  borderWidth: 2,
                  pointRadius: 2,
                  pointHoverRadius: 4,
                  tension: 0.4,
                  fill: true,
                }],
              },
              options: baseLineOpts,
            }));
          }
        }

        {
          const { labels, values } = fillDateSeries(listening_activity, 30, 'plays');
          const ctx = (document.getElementById('dash-chart-listening') as HTMLCanvasElement)?.getContext('2d');
          if (ctx) {
            const grad = ctx.createLinearGradient(0, 0, 0, 180);
            grad.addColorStop(0, 'rgba(59,130,246,0.35)');
            grad.addColorStop(1, 'rgba(59,130,246,0.02)');
            _dashCharts.push(new Chart(ctx, {
              type: 'line',
              data: {
                labels,
                datasets: [{
                  label: 'Plays',
                  data: values,
                  borderColor: 'rgba(59,130,246,1)',
                  backgroundColor: grad,
                  borderWidth: 2,
                  pointRadius: 2,
                  pointHoverRadius: 4,
                  tension: 0.4,
                  fill: true,
                }],
              },
              options: baseLineOpts,
            }));
          }
        }

        {
          const gLabels = (genre_distribution as any[]).slice(0, 7).map((g: any) => g.name);
          const gValues = (genre_distribution as any[]).slice(0, 7).map((g: any) => g.count ?? 0);
          const gColors = CHART_COLORS.slice(0, gLabels.length);
          const total   = gValues.reduce((a: number, b: number) => a + b, 0);
          const emptyEl = document.getElementById('dash-genres-empty');
          const ctx = (document.getElementById('dash-chart-genres') as HTMLCanvasElement)?.getContext('2d');
          if (ctx) {
            if (total === 0) {
              emptyEl?.classList.remove('hidden');
            } else {
              emptyEl?.classList.add('hidden');
              _dashCharts.push(new Chart(ctx, {
                type: 'doughnut',
                data: {
                  labels: gLabels,
                  datasets: [{
                    data: gValues,
                    backgroundColor: gColors.map((c) => c.replace(',1)', ',0.8)')),
                    borderColor: 'rgba(255,255,255,0.04)',
                    borderWidth: 1,
                  }],
                },
                options: {
                  responsive: true,
                  maintainAspectRatio: false,
                  cutout: '68%',
                  plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: {
                      label: (ctx: any) => ` ${ctx.label}: ${ctx.parsed} (${total ? ((ctx.parsed / total) * 100).toFixed(1) : 0}%)`,
                    }},
                  },
                },
              }));
            }
          }
          const legendEl = document.getElementById('dash-genre-legend');
          if (legendEl) {
            legendEl.innerHTML = gLabels.map((label: string, i: number) => `
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full shrink-0" style="background:${gColors[i] ?? '#666'}"></span>
                <span class="text-gray-400 truncate flex-1 text-[11px]">${label}</span>
                <span class="text-gray-500 text-[11px] shrink-0">${gValues[i]}</span>
              </div>`).join('') || '<p class="text-gray-600 text-[11px] text-center">No genres</p>';
          }
        }

        {
          const listEl = document.getElementById('dash-top-songs');
          if (listEl) {
            const songs5 = (top_songs as any[]).slice(0, 5);
            listEl.innerHTML = songs5.length
              ? songs5.map((s: any, i: number) => `
                  <div class="flex items-center gap-2.5">
                    <span class="text-xs font-black w-4 text-center ${i === 0 ? 'text-amber-400' : i === 1 ? 'text-gray-400' : i === 2 ? 'text-orange-600' : 'text-gray-600'}">${i + 1}</span>
                    <div class="w-7 h-7 rounded shrink-0 overflow-hidden bg-white/10 flex items-center justify-center">
                      ${s.cover_url
                        ? `<img src="${s.cover_url}" class="w-full h-full object-cover" alt="" />`
                        : `<span class="material-symbols-outlined text-gray-600 text-[13px]">music_note</span>`}
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-xs font-semibold text-gray-200 truncate">${s.title}</p>
                      <p class="text-[11px] text-gray-500 truncate">${s.artist_names || '—'}</p>
                    </div>
                    <span class="text-[11px] text-gray-400 shrink-0">${(s.plays_count ?? 0).toLocaleString()}</span>
                  </div>`).join('')
              : '<p class="text-gray-500 text-xs text-center py-4">No songs yet.</p>';
          }
        }
      }
    } catch (err: any) {
      console.error('loadStats error:', err.message);
    }
  }

