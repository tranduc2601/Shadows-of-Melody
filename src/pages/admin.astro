  loadGenres = async function () {
    const tbody = document.getElementById('admin-genres-tbody') as HTMLElement;
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="3" class="px-6 py-8 text-center text-gray-500 text-sm">Loading...</td></tr>';
    try {
      const { data: genres } = await apiFetch('/admin/genres');
      _allGenres = genres || [];

      const songGenreSel = document.getElementById('songs-filter-genre') as HTMLSelectElement;
      if (songGenreSel && _allGenres.length) {
        const curVal = songGenreSel.value;
        songGenreSel.innerHTML = '<option value="">All Genres</option>' +
          _allGenres.map((g:any) => `<option value="${g.id}"${String(g.id)===curVal?' selected':''}>${g.name}</option>`).join('');
      }

      if (!(_genreSearchEl as any)._genreWired) {
        (_genreSearchEl as any)._genreWired = true;
        let _genreTimer: ReturnType<typeof setTimeout>|null = null;
        _genreSearchEl?.addEventListener('input', () => {
          if (_genreTimer) clearTimeout(_genreTimer);
          _genreTimer = setTimeout(() => { _genreKeyword = _genreSearchEl.value.trim(); _renderGenres(); }, 250);
        });
        _genreSortSel?.addEventListener('change', () => { _genreSort = _genreSortSel.value; _renderGenres(); });
        document.getElementById('btn-genres-clear-filters')?.addEventListener('click', () => {
          _genreKeyword=''; _genreSort=''; _genreSearchEl.value=''; _genreSortSel.value=''; _renderGenres();
        });
      }

      _renderGenres();
    } catch {
      tbody.innerHTML = '<tr><td colspan="3" class="px-6 py-8 text-center text-red-400 text-sm">Failed to load genres.</td></tr>';
    }
  }

