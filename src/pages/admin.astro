    const viewBtn = (e.target as HTMLElement).closest('.btn-view-playlist-songs') as HTMLElement | null;
    const editBtn = (e.target as HTMLElement).closest('.btn-edit-playlist') as HTMLElement | null;
    const delBtn  = (e.target as HTMLElement).closest('.btn-delete-playlist') as HTMLElement | null;

    if (viewBtn) {
      openPlaylistSongsModal(
        viewBtn.dataset.id!,
        decodeURIComponent(viewBtn.dataset.name || ''),
        decodeURIComponent(viewBtn.dataset.cover || ''),
        decodeURIComponent(viewBtn.dataset.owner || ''),
        parseInt(viewBtn.dataset.count || '0')
      );
      return;
    }

    if (editBtn) {
      openEditPlaylistModal(
        editBtn.dataset.id!,
        decodeURIComponent(editBtn.dataset.name || ''),
        decodeURIComponent(editBtn.dataset.description || ''),
        editBtn.dataset.public === 'true'
      );
      return;
    }

    if (delBtn) {
      const id   = delBtn.dataset.id;
      const name = decodeURIComponent(delBtn.dataset.name || `#${id}`);
      if (!id) return;
      const confirmed = await showConfirm({
        title: 'Delete Playlist',
        body: `Delete playlist "${name}"? This action cannot be undone.`,
        confirmLabel: 'Delete',
        confirmClass: 'bg-rose-600 hover:bg-rose-500',
        icon: 'delete_forever',
        iconClass: 'text-rose-400',
        iconWrapClass: 'bg-rose-500/15',
      });
      if (!confirmed) return;
      try {
        await apiFetch(`/admin/playlists/${id}`, { method: 'DELETE' });
        delBtn.closest('tr')?.remove();
        showToast('Playlist deleted successfully.', 'success');
        const statEl = document.getElementById('stat-playlists');
        if (statEl) statEl.textContent = String(Math.max(0, parseInt(statEl.textContent || '0') - 1));
      } catch (err: any) {
        showToast(err.message || 'Failed to delete playlist.', 'error');
      }
    }
  });

  const editPlaylistModal      = document.getElementById('modal-edit-playlist') as HTMLElement;
  const editPlaylistModalBg    = document.getElementById('modal-edit-playlist-bg') as HTMLElement;
  const editPlaylistModalClose = document.getElementById('modal-edit-playlist-close') as HTMLElement;
  const editPlaylistForm       = document.getElementById('form-edit-playlist') as HTMLFormElement;
  const editPlaylistErrDiv     = document.getElementById('edit-playlist-error') as HTMLElement;

  function openEditPlaylistModal(id: string, name: string, description: string, isPublic: boolean) {
    (document.getElementById('edit-playlist-id') as HTMLInputElement).value = id;
    (document.getElementById('edit-playlist-name') as HTMLInputElement).value = name;
    (document.getElementById('edit-playlist-description') as HTMLTextAreaElement).value = description;
    (document.getElementById('edit-playlist-public') as HTMLInputElement).checked = isPublic;
    editPlaylistErrDiv?.classList.add('hidden');
    openAdminModal(editPlaylistModal as HTMLElement);
  }

  editPlaylistModalBg?.addEventListener('click',    () => closeAdminModal(editPlaylistModal as HTMLElement));
  editPlaylistModalClose?.addEventListener('click', () => closeAdminModal(editPlaylistModal as HTMLElement));

  editPlaylistForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    editPlaylistErrDiv?.classList.add('hidden');

    const id          = (document.getElementById('edit-playlist-id') as HTMLInputElement).value;
    const name        = (document.getElementById('edit-playlist-name') as HTMLInputElement).value.trim();
    const description = (document.getElementById('edit-playlist-description') as HTMLTextAreaElement).value.trim();
    const isPublic    = (document.getElementById('edit-playlist-public') as HTMLInputElement).checked;

    if (!name) {
      editPlaylistErrDiv.textContent = 'Playlist name is required.';
      editPlaylistErrDiv.classList.remove('hidden');
      return;
    }

    const confirmed = await showConfirm({
      title: 'Save Playlist Changes',
      body: `Apply updates to playlist "${name}"?`,
      confirmLabel: 'Save Changes',
      confirmClass: 'bg-indigo-600 hover:bg-indigo-500',
      icon: 'save',
      iconClass: 'text-indigo-300',
      iconWrapClass: 'bg-indigo-500/15',
    });
    if (!confirmed) return;

    const submitBtn = document.getElementById('btn-edit-playlist-submit') as HTMLButtonElement;
    submitBtn.disabled = true;
    const origText = submitBtn.innerHTML;
    submitBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span> Saving...';

    try {
      await apiFetch(`/admin/playlists/${id}`, {
        method: 'PATCH',
        body: JSON.stringify({ name, description: description || null, is_public: isPublic }),
      });
      closeAdminModal(editPlaylistModal as HTMLElement);
      showToast('Playlist updated successfully.', 'success');
      loadPlaylists(_playlistPage);
    } catch (err: any) {
      editPlaylistErrDiv.textContent = err.message || 'Failed to save changes.';
      editPlaylistErrDiv.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = origText;
    }
  });

  const playlistSongsModal      = document.getElementById('modal-playlist-songs') as HTMLElement;
  const playlistSongsModalBg    = document.getElementById('modal-playlist-songs-bg') as HTMLElement;
  const playlistSongsModalClose = document.getElementById('modal-playlist-songs-close') as HTMLElement;
  const playlistSongsContent    = document.getElementById('playlist-songs-content') as HTMLElement;

  let _currentPlaylistId: string = '';

  playlistSongsModalBg?.addEventListener('click',    () => closeAdminModal(playlistSongsModal as HTMLElement));
  playlistSongsModalClose?.addEventListener('click', () => closeAdminModal(playlistSongsModal as HTMLElement));

  async function openPlaylistSongsModal(id: string, name: string, coverUrl: string, ownerName: string, songsCount: number) {
    _currentPlaylistId = id;
    const nameEl  = document.getElementById('playlist-songs-name') as HTMLElement;
    const metaEl  = document.getElementById('playlist-songs-meta') as HTMLElement;
    const coverEl = document.getElementById('playlist-songs-cover') as HTMLElement;

    if (nameEl)  nameEl.textContent = name || 'Playlist';
    if (metaEl)  metaEl.textContent = `${songsCount} songs · by ${ownerName || 'Unknown'}`;
    if (coverEl) {
      coverEl.style.background = grad(parseInt(id) || 1);
      coverEl.innerHTML = coverUrl
        ? `<img src="${coverUrl}" class="w-full h-full object-cover" alt="" />`
        : '<span class="material-symbols-outlined text-white/70 text-xl">queue_music</span>';
    }

    playlistSongsContent.innerHTML = '<p class="text-gray-500 text-sm text-center py-8">Loading...</p>';
    openAdminModal(playlistSongsModal as HTMLElement);

    try {
      const { data } = await apiFetch(`/admin/playlists/${id}/songs`);
      const songs = data.songs || [];

      if (!songs.length) {
        playlistSongsContent.innerHTML = '<p class="text-gray-500 text-sm text-center py-8">This playlist has no songs.</p>';
        return;
      }

      playlistSongsContent.innerHTML = `
        <div class="divide-y divide-white/5">
          ${songs.map((s: any, i: number) => `
            <div class="flex items-center gap-3 px-5 py-3 hover:bg-white/3 transition-colors group">
              <span class="text-xs text-gray-600 w-6 text-right shrink-0">${i + 1}</span>
              <div class="w-10 h-10 rounded-lg shrink-0 overflow-hidden flex items-center justify-center" style="background:${grad(s.id)}">
                ${s.cover_url
                  ? `<img src="${s.cover_url}" class="w-full h-full object-cover" alt="" />`
                  : '<span class="material-symbols-outlined text-white/50 text-[16px]">music_note</span>'}
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-gray-100 truncate">${s.title}</p>
                <p class="text-xs text-gray-500 truncate">${s.artist_names || '—'}</p>
              </div>
              <span class="text-xs text-gray-500 shrink-0 hidden sm:block">${fmt(s.duration)}</span>
              <span class="text-xs text-gray-600 shrink-0 hidden md:block">${(s.plays_count || 0).toLocaleString()} plays</span>
              <button class="btn-remove-playlist-song shrink-0 w-7 h-7 rounded-lg opacity-0 group-hover:opacity-100 hover:bg-rose-500/20 hover:text-rose-400 text-gray-500 flex items-center justify-center transition-all"
                      data-song-id="${s.id}" data-song-title="${encodeURIComponent(s.title)}" title="Remove from playlist">
                <span class="material-symbols-outlined text-[16px]">remove_circle</span>
              </button>
            </div>
          `).join('')}
        </div>`;
    } catch (err: any) {
      playlistSongsContent.innerHTML = `<p class="text-red-400 text-sm text-center py-8">${err.message || 'Failed to load songs'}</p>`;
    }
  }

  playlistSongsContent?.addEventListener('click', async (e: Event) => {
    const btn = (e.target as HTMLElement).closest('.btn-remove-playlist-song') as HTMLButtonElement | null;
    if (!btn || btn.disabled) return;

    const songId    = btn.dataset.songId!;
    const songTitle = decodeURIComponent(btn.dataset.songTitle || `#${songId}`);

    const confirmed = await showConfirm({
      title: 'Remove Song From Playlist',
      body: `Remove "${songTitle}" from this playlist?`,
      confirmLabel: 'Remove',
      confirmClass: 'bg-amber-600 hover:bg-amber-500',
      icon: 'remove_circle',
      iconClass: 'text-amber-400',
      iconWrapClass: 'bg-amber-500/15',
    });
    if (!confirmed) return;

    btn.disabled = true;
    const origHTML = btn.innerHTML;
    btn.innerHTML = '<span class="material-symbols-outlined text-[16px] animate-spin">refresh</span>';

    try {
      await apiFetch(`/admin/playlists/${_currentPlaylistId}/songs/${songId}`, { method: 'DELETE' });
      btn.closest('.flex.items-center.gap-3')?.remove();
      showToast(`Removed "${songTitle}" from playlist.`, 'success');
      const metaEl = document.getElementById('playlist-songs-meta') as HTMLElement;
      if (metaEl) {
        const match = metaEl.textContent?.match(/(\d+) songs/);
        if (match) {
          const newCount = Math.max(0, parseInt(match[1]) - 1);
          metaEl.textContent = metaEl.textContent!.replace(/\d+ songs/, `${newCount} songs`);
        }
      }
      _loadedSections.delete('playlists');
    } catch (err: any) {
      showToast(err.message || 'Failed to remove song.', 'error');
      btn.disabled = false;
      btn.innerHTML = origHTML;
    }
  })

  let _allAlbums: any[]  = [];
  let _albumPage         = 1;
  let _albumKeyword      = '';
  let _albumArtistFilter = '';
  let _albumYearFilter   = '';
  let _albumSort         = '';
  const ALBUM_PAGE_SIZE  = 20;

  const _albumSearchSel     = document.getElementById('albums-search')         as HTMLInputElement;
  const _albumArtistSelEl   = document.getElementById('albums-filter-artist')  as HTMLSelectElement;
  const _albumYearSelEl     = document.getElementById('albums-filter-year')    as HTMLSelectElement;
  const _albumSortSel       = document.getElementById('albums-sort')           as HTMLSelectElement;

  function _renderAlbums(page = 1) {
    _albumPage = page;
    const tbody   = document.getElementById('admin-albums-tbody');
    const info    = document.getElementById('albums-pagination-info');
    const btnsEl  = document.getElementById('albums-pagination-btns');
    if (!tbody) return;

    let filtered = _allAlbums.filter(al => {
      if (_albumKeyword) {
        const kw = _albumKeyword.toLowerCase();
        if (!al.title.toLowerCase().includes(kw) && !(al.artist_name || '').toLowerCase().includes(kw)) return false;
      }
      if (_albumArtistFilter && String(al.artist_id) !== _albumArtistFilter) return false;
      if (_albumYearFilter) {
        const yr = al.release_date ? new Date(al.release_date).getFullYear().toString() : '';
        if (yr !== _albumYearFilter) return false;
      }
      return true;
    });

    if (_albumSort === 'title_asc')   filtered.sort((a,b) => a.title.localeCompare(b.title));
    else if (_albumSort === 'title_desc') filtered.sort((a,b) => b.title.localeCompare(a.title));
    else if (_albumSort === 'songs_desc') filtered.sort((a,b) => (b.songs_count||0) - (a.songs_count||0));
    else if (_albumSort === 'oldest') filtered.sort((a,b) => (a.release_date||'').localeCompare(b.release_date||''));
    else filtered.sort((a,b) => (b.release_date||'').localeCompare(a.release_date||''));

    const totalPages = Math.max(1, Math.ceil(filtered.length / ALBUM_PAGE_SIZE));
    const pg = Math.min(page, totalPages);
    const pageData = filtered.slice((pg-1)*ALBUM_PAGE_SIZE, pg*ALBUM_PAGE_SIZE);

    const albumChipFilters: Array<{label:string;value:string;clearFn:()=>void}> = [];
    if (_albumKeyword)      albumChipFilters.push({ label:'Search', value: _albumKeyword, clearFn: () => { _albumKeyword=''; _albumSearchSel.value=''; _renderAlbums(1); } });
    if (_albumArtistFilter) albumChipFilters.push({ label:'Artist', value: _albumArtistSelEl?.options[_albumArtistSelEl.selectedIndex]?.text||'', clearFn: () => { _albumArtistFilter=''; _albumArtistSelEl.value=''; syncFilterSelectStyle(_albumArtistSelEl); _renderAlbums(1); } });
    if (_albumYearFilter)   albumChipFilters.push({ label:'Year',   value: _albumYearFilter, clearFn: () => { _albumYearFilter=''; _albumYearSelEl.value=''; syncFilterSelectStyle(_albumYearSelEl); _renderAlbums(1); } });
    if (_albumSort)         albumChipFilters.push({ label:'Sort',   value: _albumSort.replace(/_/g,' '), clearFn: () => { _albumSort=''; _albumSortSel.value=''; _renderAlbums(1); } });
    renderFilterChips('albums-filter-chips','btn-albums-clear-filters','albums-results-count', _allAlbums.length, filtered.length, albumChipFilters, () => {
      _albumKeyword=''; _albumArtistFilter=''; _albumYearFilter=''; _albumSort='';
      [_albumSearchSel,_albumArtistSelEl,_albumYearSelEl,_albumSortSel].forEach(s=>{if(s&&'value' in s)s.value=''; syncFilterSelectStyle(s as HTMLSelectElement);});
      _renderAlbums(1);
    });
    [_albumArtistSelEl, _albumYearSelEl].forEach(syncFilterSelectStyle);

    if (!pageData.length) {
      tbody.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">${_allAlbums.length ? 'No albums match the current filters.' : 'No albums found.'}</td></tr>`;
      if (info) info.textContent = '';
      if (btnsEl) btnsEl.innerHTML = '';
      return;
    }

    tbody.innerHTML = pageData.map((al: any) => `
      <tr class="hover:bg-white/3 transition-colors group" data-album-id="${al.id}">
        <td class="px-6 py-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg shrink-0 overflow-hidden flex items-center justify-center" style="background:${grad(al.id)}">
              ${al.cover_url ? `<img src="${al.cover_url}" class="w-full h-full object-cover" alt=""/>` : '<span class="material-symbols-outlined text-white/50 text-[18px]">album</span>'}
            </div>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-gray-100 truncate">${al.title}</p>
              ${al.release_date ? `<p class="text-xs text-gray-600">${new Date(al.release_date).getFullYear()}</p>` : ''}
            </div>
          </div>
        </td>
        <td class="px-6 py-4 hidden sm:table-cell text-sm text-gray-400">${al.artist_name || '—'}</td>
        <td class="px-6 py-4 hidden md:table-cell text-sm text-gray-400 text-center">${al.songs_count ?? 0}</td>
        <td class="px-6 py-4 hidden lg:table-cell text-xs text-gray-400">${al.release_date ? fmtDate(al.release_date) : '—'}</td>
        <td class="px-6 py-4">
          <div class="flex items-center justify-end gap-1 min-w-max">
            <button class="btn-manage-album-songs flex items-center gap-1 px-2.5 py-1.5 text-xs font-semibold rounded-lg bg-purple-500/10 hover:bg-purple-500/20 text-purple-300 hover:text-purple-200 border border-purple-500/15 transition-all"
                    data-id="${al.id}" data-title="${al.title}">
              <span class="material-symbols-outlined text-[15px]">library_music</span>Songs
            </button>
            <button class="btn-edit-album w-8 h-8 rounded-lg bg-blue-500/10 hover:bg-blue-500/20 text-blue-300 hover:text-blue-200 border border-blue-500/15 flex items-center justify-center transition-all"
                    data-id="${al.id}" data-album="${encodeURIComponent(JSON.stringify(al))}">
              <span class="material-symbols-outlined text-[17px]">edit</span>
            </button>
            <button class="btn-delete-album w-8 h-8 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 hover:text-rose-200 border border-rose-500/15 flex items-center justify-center transition-all"
                    data-id="${al.id}" data-title="${al.title}">
              <span class="material-symbols-outlined text-[17px]">delete</span>
            </button>
          </div>
        </td>
      </tr>`).join('');

    if (info) info.innerHTML = `<span class="text-white font-semibold">${filtered.length}</span> albums${filtered.length < _allAlbums.length ? ` <span class="text-gray-600">(filtered from ${_allAlbums.length})</span>` : ''}`;
    if (btnsEl) {
      btnsEl.innerHTML = buildPaginationBtns(pg, totalPages, _renderAlbums);
      btnsEl.querySelectorAll<HTMLElement>('[data-pg]').forEach(btn => {
        btn.addEventListener('click', () => {
          const p = parseInt(btn.dataset.pg||'1');
          if (p > 0 && p <= totalPages && !(btn as HTMLButtonElement).disabled) _renderAlbums(p);
        });
      });
    }
  }

  async function loadAlbums() {
    const tbody = document.getElementById('admin-albums-tbody');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500 text-sm">Loading...</td></tr>';
    try {
      const { data: albums } = await apiFetch('/admin/albums?limit=200');
      _allAlbums = albums || [];

      const artistIds = new Set<string>();
      const artistNames: Record<string,string> = {};
      _allAlbums.forEach((al:any) => { if (al.artist_id) { artistIds.add(String(al.artist_id)); artistNames[al.artist_id] = al.artist_name; } });
      if (_albumArtistSelEl) {
        _albumArtistSelEl.innerHTML = '<option value="">All Artists</option>' +
          Array.from(artistIds).sort((a,b) => (artistNames[a]||'').localeCompare(artistNames[b]||''))
            .map(id => `<option value="${id}">${artistNames[id]||'Unknown'}</option>`).join('');
      }

      const years = new Set<string>();
      _allAlbums.forEach((al:any) => { if (al.release_date) years.add(new Date(al.release_date).getFullYear().toString()); });
      if (_albumYearSelEl) {
        _albumYearSelEl.innerHTML = '<option value="">All Years</option>' +
          Array.from(years).sort((a,b) => b.localeCompare(a))
            .map(y => `<option value="${y}">${y}</option>`).join('');
      }

      if (!(_albumSearchSel as any)._albumWired) {
        (_albumSearchSel as any)._albumWired = true;
        let _albumTimer: ReturnType<typeof setTimeout>|null = null;
        _albumSearchSel?.addEventListener('input', () => {
          if (_albumTimer) clearTimeout(_albumTimer);
          _albumTimer = setTimeout(() => { _albumKeyword = _albumSearchSel.value.trim(); _renderAlbums(1); }, 280);
        });
        _albumArtistSelEl?.addEventListener('change', () => { _albumArtistFilter = _albumArtistSelEl.value; _renderAlbums(1); });
        _albumYearSelEl?.addEventListener('change', () => { _albumYearFilter = _albumYearSelEl.value; _renderAlbums(1); });
        _albumSortSel?.addEventListener('change', () => { _albumSort = _albumSortSel.value; _renderAlbums(1); });
        document.getElementById('btn-albums-clear-filters')?.addEventListener('click', () => {
          _albumKeyword=''; _albumArtistFilter=''; _albumYearFilter=''; _albumSort='';
          [_albumSearchSel,_albumArtistSelEl,_albumYearSelEl,_albumSortSel].forEach(s=>{ if(s&&'value' in s)s.value=''; syncFilterSelectStyle(s as HTMLSelectElement); });
          _renderAlbums(1);
        });

        document.getElementById('admin-albums-tbody')?.addEventListener('click', async (e: Event) => {
          const editBtn   = (e.target as HTMLElement).closest('.btn-edit-album')         as HTMLElement | null;
          const delBtn    = (e.target as HTMLElement).closest('.btn-delete-album')       as HTMLElement | null;
          const manageBtn = (e.target as HTMLElement).closest('.btn-manage-album-songs') as HTMLElement | null;
          if (manageBtn) { openAlbumSongsModal(manageBtn.dataset.id!, manageBtn.dataset.title!); return; }
          if (editBtn)   { openEditAlbumModal(editBtn.dataset.id!, editBtn.dataset.album!); return; }
          if (!delBtn) return;
          const id    = delBtn.dataset.id;
          const title = delBtn.dataset.title || `#${id}`;
          if (!id) return;
          const confirmed = await showConfirm({ title:'Delete Album', body:`Delete album "${title}"?`, confirmLabel:'Delete', confirmClass:'bg-rose-600 hover:bg-rose-500', icon:'delete_forever', iconClass:'text-rose-400', iconWrapClass:'bg-rose-500/15' });
          if (!confirmed) return;
          try {
            await apiFetch(`/admin/albums/${id}`, { method: 'DELETE' });
            _allAlbums = _allAlbums.filter((a:any) => String(a.id) !== id);
            _renderAlbums(_albumPage);
            showToast('Album deleted successfully.', 'success');
          } catch (err: any) { showToast(err.message || 'Failed to delete album.', 'error'); }
        });
      }
      _renderAlbums(1);
    } catch {
      tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-8 text-center text-red-400 text-sm">Failed to load albums.</td></tr>';
    }
  }

  let _allGenres: any[] = [];
  let _genreKeyword = '';
  let _genreSort    = '';

  const _genreSearchEl = document.getElementById('genres-search')  as HTMLInputElement;
  const _genreSortSel  = document.getElementById('genres-sort')    as HTMLSelectElement;

  function _renderGenres() {
    const tbody = document.getElementById('admin-genres-tbody') as HTMLElement;
    if (!tbody) return;
    let filtered = _allGenres.filter(g =>
      !_genreKeyword || g.name.toLowerCase().includes(_genreKeyword.toLowerCase()) ||
      (g.description||'').toLowerCase().includes(_genreKeyword.toLowerCase())
    );
    if (_genreSort === 'name_asc')  filtered.sort((a,b) => a.name.localeCompare(b.name));
    else if (_genreSort === 'name_desc') filtered.sort((a,b) => b.name.localeCompare(a.name));

    const genreChipFilters: Array<{label:string;value:string;clearFn:()=>void}> = [];
    if (_genreKeyword) genreChipFilters.push({ label:'Search', value:_genreKeyword, clearFn:()=>{ _genreKeyword=''; _genreSearchEl.value=''; _renderGenres(); } });
    if (_genreSort)    genreChipFilters.push({ label:'Sort', value:_genreSort.replace(/_/g,' '), clearFn:()=>{ _genreSort=''; _genreSortSel.value=''; _renderGenres(); } });
    renderFilterChips('genres-filter-chips','btn-genres-clear-filters','genres-results-count', _allGenres.length, filtered.length, genreChipFilters, ()=>{ _genreKeyword=''; _genreSort=''; _genreSearchEl.value=''; _genreSortSel.value=''; _renderGenres(); });

    if (!filtered.length) {
      tbody.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500 text-sm">${_allGenres.length ? 'No genres match.' : 'No genres found.'}</td></tr>`;
      return;
    }
    tbody.innerHTML = filtered.map((g: any) => `
      <tr class="group hover:bg-white/3 transition-colors">
        <td class="px-6 py-4">
          <div class="w-10 h-10 rounded-lg bg-indigo-500/20 flex items-center justify-center shrink-0 overflow-hidden border border-white/8">
            ${g.image_url
              ? `<img src="${g.image_url}" class="w-full h-full object-cover" alt="" />`
              : `<span class="material-symbols-outlined text-indigo-400 text-[16px]">label</span>`}
          </div>
        </td>
        <td class="px-6 py-4">
          <span class="text-sm font-semibold text-gray-100">${g.name}</span>
        </td>
        <td class="px-6 py-4 hidden sm:table-cell text-sm text-gray-400">${g.description || '—'}</td>
        <td class="px-6 py-4 hidden md:table-cell text-sm text-gray-400">${fmtDate(g.created_at)}</td>
        <td class="px-6 py-4">
          <div class="flex items-center justify-end gap-1 min-w-max">
            <button class="btn-edit-genre w-8 h-8 rounded-lg bg-blue-500/10 hover:bg-blue-500/20 text-blue-300 hover:text-blue-200 border border-blue-500/15 flex items-center justify-center transition-all"
