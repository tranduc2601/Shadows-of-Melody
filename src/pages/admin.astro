---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Admin Panel - Shadows of Melody">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">

    <!-- Admin Sidebar -->
    <aside class="w-64 shrink-0 border-r border-white/5 bg-[#070d1f]/90 backdrop-blur-xl hidden md:flex md:flex-col z-40">
      <!-- Logo -->
      <div class="h-20 flex items-center px-6 border-b border-white/5">
        <a href="/" class="flex items-center gap-2">
          <span class="material-symbols-outlined text-purple-400 animate-pulse">music_note</span>
          <span class="text-2xl font-black bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-purple-400">Melody</span>
        </a>
      </div>

      <!-- Admin Badge -->
      <div class="mx-4 mt-4 px-3 py-2 rounded-xl bg-linear-to-r from-purple-500/20 to-indigo-500/10 border border-purple-500/20 flex items-center gap-2">
        <span class="material-symbols-outlined text-purple-400 text-[18px]">admin_panel_settings</span>
        <span class="text-xs font-bold text-purple-300 uppercase tracking-widest">Admin Panel</span>
      </div>

      <!-- Nav -->
      <div class="px-4 py-6 flex-1 overflow-y-auto">
        <p class="px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Overview</p>
        <nav class="space-y-1 mb-8">
          <button data-section="dashboard" class="nav-btn w-full flex items-center gap-4 px-4 py-3 bg-linear-to-r from-purple-500/20 to-transparent text-white rounded-xl font-medium transition-all shadow-[inset_2px_0_0_0_rgba(168,85,247,1)]">
            <span class="material-symbols-outlined text-purple-400">dashboard</span>Dashboard
          </button>
          <!-- <button data-section="analytics" class="nav-btn w-full flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">bar_chart</span>Analytics
          </button>
          <button data-section="reports" class="nav-btn w-full flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">receipt_long</span>Reports
          </button> -->
        </nav>

        <p class="px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Manage</p>
        <nav class="space-y-1 mb-8">
          <button data-section="users" class="nav-btn w-full flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">group</span>Users
          </button>
          <button data-section="songs" class="nav-btn w-full flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">music_note</span>Songs
          </button>
          <button data-section="artists" class="nav-btn w-full flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">mic</span>Artists
          </button>
          <button data-section="playlists" class="nav-btn w-full flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">queue_music</span>Playlists
          </button>
          <button data-section="albums" class="nav-btn w-full flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">album</span>Albums
          </button>
          <button data-section="genres" class="nav-btn w-full flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">label</span>Genres
          </button>
        </nav>

        <p class="px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">System</p>
        <nav class="space-y-1">
          <!-- <button data-section="tasks" class="nav-btn w-full flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">assignment</span>Tasks
          </button> -->
          <a href="/" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">arrow_back</span>Go Back
          </a>
        </nav>
      </div>

      <!-- Admin Profile -->
      <div class="p-4 border-t border-white/5">
        <div class="flex items-center gap-3 p-2 rounded-xl hover:bg-white/5 cursor-pointer transition-colors">
          <div class="w-10 h-10 rounded-full bg-linear-to-tr from-indigo-500 to-purple-500 p-0.5">
            <div id="sidebar-admin-avatar" class="w-full h-full rounded-full bg-[#0a1229] flex items-center justify-center overflow-hidden">
              <span class="material-symbols-outlined text-purple-400">shield_person</span>
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <p id="sidebar-admin-name" class="text-sm font-semibold text-white truncate">Admin</p>
            <p id="sidebar-admin-role" class="text-xs text-indigo-400 font-medium">Super Admin</p>
          </div>
          <button id="admin-logout-btn" title="Đăng xuất" class="shrink-0 text-gray-500 hover:text-red-400 transition-colors p-1 rounded-lg hover:bg-red-500/10">
            <span class="material-symbols-outlined text-[18px]">logout</span>
          </button>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col relative overflow-hidden bg-linear-to-br from-[#0c1328] via-[#060e20] to-[#040813]">
      <!-- Ambient Glow -->
      <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-indigo-600/8 blur-[150px] rounded-full pointer-events-none"></div>
      <div class="absolute bottom-[10%] right-[-5%] w-[35%] h-[35%] bg-purple-600/8 blur-[120px] rounded-full pointer-events-none"></div>

      <!-- Header -->
      <header class="h-20 shrink-0 flex items-center justify-between px-6 lg:px-8 border-b border-white/5 relative z-10">
        <div class="flex items-center gap-4">
          <!-- Mobile menu -->
          <button class="md:hidden w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white">
            <span class="material-symbols-outlined">menu</span>
          </button>
          <div>
            <h1 id="page-title" class="text-xl font-bold text-white">Dashboard</h1>
            <p class="text-xs text-gray-500">Welcome back, <span id="header-admin-name">Admin</span></p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <!-- Search -->
          <div class="relative hidden sm:flex items-center group">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-[19px] group-focus-within:text-purple-400 transition-colors pointer-events-none">search</span>
            <input
              type="text"
              placeholder="Search anything..."
              class="w-64 h-10 bg-white/6 border border-white/10 text-gray-100 placeholder-gray-500 rounded-xl py-0 pl-11 pr-10 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/40 focus:border-purple-500/40 focus:bg-white/10 transition-all duration-200 backdrop-blur-sm"
            />
            <kbd class="absolute right-3 top-1/2 -translate-y-1/2 hidden lg:inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] font-semibold text-gray-600 bg-white/5 border border-white/10 rounded-md pointer-events-none select-none">/</kbd>
          </div>

          <!-- Notifications -->
          <!-- <button class="w-10 h-10 rounded-full bg-white/5 border border-white/5 flex items-center justify-center hover:bg-white/10 transition-all relative">
            <span class="material-symbols-outlined text-gray-300 text-[20px]">notifications</span>
            <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-rose-500 shadow-[0_0_8px_rgba(244,63,94,0.8)]"></span>
          </button> -->

          <!-- Quick Add -->
          <!-- <button id="btn-add-new-header" class="flex items-center gap-2 px-4 py-2 bg-linear-to-r from-purple-500 to-indigo-600 hover:from-purple-400 hover:to-indigo-500 text-white rounded-full text-sm font-semibold transition-all hover:scale-105 shadow-[0_4px_20px_rgba(168,85,247,0.3)]">
            <span class="material-symbols-outlined text-[18px]">add</span>
            <span class="hidden sm:inline">Add New</span>
          </button> -->
        </div>
      </header>

      <!-- Scrollable Content -->
      <div class="flex-1 overflow-y-auto px-6 lg:px-8 py-8 relative z-10 custom-scrollbar">

        <!-- ── Dashboard Section ─────────────────────────────────────────── -->
        <div id="section-dashboard">
          <!-- Stats Cards -->
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-8">
            <!-- Users -->
            <div class="bg-white/3 border border-white/5 rounded-2xl p-5 backdrop-blur-sm hover:bg-white/5 transition-all group">
              <div class="flex items-start justify-between mb-4">
                <div class="w-11 h-11 rounded-xl bg-linear-to-br from-violet-500 to-purple-600 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-white text-[20px]">group</span>
                </div>
                <!-- <span class="text-xs font-semibold px-2 py-1 rounded-full bg-green-500/15 text-green-400 flex items-center gap-0.5">
                  <span class="material-symbols-outlined text-[14px]">trending_up</span>
                  <span id="stat-users-change">—</span>
                </span> -->
              </div>
              <p id="stat-users" class="text-2xl font-black text-white mb-1">—</p>
              <p class="text-xs text-gray-400 font-medium">Total Users</p>
            </div>
            <!-- Songs -->
            <div class="bg-white/3 border border-white/5 rounded-2xl p-5 backdrop-blur-sm hover:bg-white/5 transition-all group">
              <div class="flex items-start justify-between mb-4">
                <div class="w-11 h-11 rounded-xl bg-linear-to-br from-blue-500 to-indigo-600 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-white text-[20px]">music_note</span>
                </div>
                <!-- <span class="text-xs font-semibold px-2 py-1 rounded-full bg-green-500/15 text-green-400 flex items-center gap-0.5">
                  <span class="material-symbols-outlined text-[14px]">library_music</span>
                  Live
                </span> -->
              </div>
              <p id="stat-songs" class="text-2xl font-black text-white mb-1">—</p>
              <p class="text-xs text-gray-400 font-medium">Total Songs</p>
            </div>
            <!-- Artists -->
            <div class="bg-white/3 border border-white/5 rounded-2xl p-5 backdrop-blur-sm hover:bg-white/5 transition-all group">
              <div class="flex items-start justify-between mb-4">
                <div class="w-11 h-11 rounded-xl bg-linear-to-br from-pink-500 to-rose-600 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-white text-[20px]">mic</span>
                </div>
                <!-- <span class="text-xs font-semibold px-2 py-1 rounded-full bg-green-500/15 text-green-400 flex items-center gap-0.5">
                  <span class="material-symbols-outlined text-[14px]">trending_up</span>
                  Live
                </span> -->
              </div>
              <p id="stat-artists" class="text-2xl font-black text-white mb-1">—</p>
              <p class="text-xs text-gray-400 font-medium">Total Artists</p>
            </div>
            <!-- Playlists -->
            <div class="bg-white/3 border border-white/5 rounded-2xl p-5 backdrop-blur-sm hover:bg-white/5 transition-all group">
              <div class="flex items-start justify-between mb-4">
                <div class="w-11 h-11 rounded-xl bg-linear-to-br from-amber-500 to-orange-600 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-white text-[20px]">queue_music</span>
                </div>
                <!-- <span class="text-xs font-semibold px-2 py-1 rounded-full bg-green-500/15 text-green-400 flex items-center gap-0.5">
                  <span class="material-symbols-outlined text-[14px]">trending_up</span>
                  Live
                </span> -->
              </div>
              <p id="stat-playlists" class="text-2xl font-black text-white mb-1">—</p>
              <p class="text-xs text-gray-400 font-medium">Total Playlists</p>
            </div>
          </div>
        </div>

        <!-- ── Users Section ─────────────────────────────────────────────── -->
        <div id="section-users" class="hidden space-y-6">
          <!-- Users Table -->
          <div class="bg-white/3 border border-white/5 rounded-2xl backdrop-blur-sm overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-white/5">
              <div class="flex items-center gap-3">
                <h2 class="text-base font-bold text-white">User Management</h2>
                <span id="users-admin-badge" class="hidden items-center gap-1 text-xs font-semibold px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/20">
                  <span class="material-symbols-outlined text-[12px]">admin_panel_settings</span>Includes Managers
                </span>
              </div>
              <div class="flex items-center gap-2">
                <button class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 rounded-lg transition-all">
                  <span class="material-symbols-outlined text-[16px]">filter_list</span>Filter
                </button>
                <button class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 rounded-lg transition-all">
                  <span class="material-symbols-outlined text-[16px]">file_download</span>Export
                </button>
              </div>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead>
                  <tr class="border-b border-white/5 text-gray-500 text-xs font-bold uppercase tracking-wider">
                    <th class="px-6 py-3">User</th>
                    <th class="px-6 py-3 hidden sm:table-cell">Role</th>
                    <th class="px-6 py-3 hidden md:table-cell">Plan</th>
                    <th class="px-6 py-3 hidden lg:table-cell">Joined</th>
                    <th class="px-6 py-3">Status</th>
                    <th class="px-6 py-3 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody id="admin-users-tbody" class="divide-y divide-white/3">
                  <tr><td colspan="6" class="px-6 py-8 text-center text-gray-500 text-sm">Loading...</td></tr>
                </tbody>
              </table>
            </div>
            <!-- Pagination -->
            <div class="flex items-center justify-between px-6 py-4 border-t border-white/5">
              <p id="users-pagination-info" class="text-xs text-gray-500">Loading...</p>
              <div class="flex items-center gap-1" id="users-pagination-btns"></div>
            </div>
          </div>

          <!-- Pending Artist Requests -->
          <div class="bg-white/3 border border-amber-500/10 rounded-2xl backdrop-blur-sm overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-white/5">
              <h2 class="text-base font-bold text-white flex items-center gap-2">
                <span class="material-symbols-outlined text-amber-400 text-[18px]">star_rate</span>
                Pending Artist Requests
                <span id="requests-count-badge" class="hidden text-xs bg-amber-500/20 text-amber-300 px-2 py-0.5 rounded-full font-semibold">0</span>
              </h2>
              <button id="btn-refresh-requests" class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 rounded-lg transition-all">
                <span class="material-symbols-outlined text-[16px]">refresh</span>Refresh
              </button>
            </div>
            <div id="artist-requests-list" class="divide-y divide-white/5">
              <p class="px-6 py-6 text-sm text-gray-500 text-center">Loading...</p>
            </div>
          </div>
        </div>

        <!-- ── Songs Section ─────────────────────────────────────────────── -->
        <div id="section-songs" class="hidden space-y-6">
          <div class="bg-white/3 border border-white/5 rounded-2xl backdrop-blur-sm overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-white/5">
              <h2 class="text-base font-bold text-white">Song Management</h2>
              <button id="btn-open-upload" class="flex items-center gap-2 px-4 py-2 bg-linear-to-r from-purple-500/20 to-indigo-500/10 hover:from-purple-500/30 border border-purple-500/20 text-purple-300 rounded-xl text-xs font-semibold transition-all">
                <span class="material-symbols-outlined text-[16px]">upload</span>Upload Song
              </button>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead>
                  <tr class="border-b border-white/5 text-gray-500 text-xs font-bold uppercase tracking-wider">
                    <th class="px-6 py-3">Song</th>
                    <th class="px-6 py-3 hidden md:table-cell">Album</th>
                    <th class="px-6 py-3 hidden sm:table-cell text-right">Plays</th>
                    <th class="px-6 py-3 hidden lg:table-cell text-center">Duration</th>
                    <th class="px-6 py-3">Status</th>
                    <th class="px-6 py-3 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody id="admin-songs-tbody" class="divide-y divide-white/3">
                  <tr><td colspan="6" class="px-6 py-8 text-center text-gray-500 text-sm">Loading...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ── Artists Section ───────────────────────────────────────────── -->
        <div id="section-artists" class="hidden space-y-6">
          <div class="bg-white/3 border border-white/5 rounded-2xl backdrop-blur-sm overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-white/5">
              <h2 class="text-base font-bold text-white">Artist Management</h2>
              <button id="btn-add-artist" class="flex items-center gap-2 px-4 py-2 bg-linear-to-r from-purple-500/20 to-indigo-500/10 hover:from-purple-500/30 border border-purple-500/20 text-purple-300 rounded-xl text-xs font-semibold transition-all">
                <span class="material-symbols-outlined text-[16px]">add</span>Add Artist
              </button>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead>
                  <tr class="border-b border-white/5 text-gray-500 text-xs font-bold uppercase tracking-wider">
                    <th class="px-6 py-3">Artist</th>
                    <th class="px-6 py-3 hidden md:table-cell text-center">Songs</th>
                    <th class="px-6 py-3 hidden lg:table-cell text-right">Followers</th>
                    <th class="px-6 py-3 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody id="admin-artists-tbody" class="divide-y divide-white/3">
                  <tr><td colspan="4" class="px-6 py-8 text-center text-gray-500 text-sm">Loading...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ── Playlists Section ─────────────────────────────────────────── -->
        <div id="section-playlists" class="hidden space-y-6">
          <div class="bg-white/3 border border-white/5 rounded-2xl backdrop-blur-sm overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-white/5">
              <h2 class="text-base font-bold text-white">Playlist Management</h2>
              <button id="btn-refresh-playlists" class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 rounded-lg transition-all">
                <span class="material-symbols-outlined text-[16px]">refresh</span>Refresh
              </button>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead>
                  <tr class="border-b border-white/5 text-gray-500 text-xs font-bold uppercase tracking-wider">
                    <th class="px-6 py-3">Playlist</th>
                    <th class="px-6 py-3 hidden sm:table-cell">Owner</th>
                    <th class="px-6 py-3 hidden md:table-cell text-center">Songs</th>
                    <th class="px-6 py-3">Visibility</th>
                    <th class="px-6 py-3 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody id="admin-playlists-tbody" class="divide-y divide-white/3">
                  <tr><td colspan="5" class="px-6 py-8 text-center text-gray-500 text-sm">Loading...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ── Albums Section ───────────────────────────────────────────── -->
        <div id="section-albums" class="hidden space-y-6">
          <div class="bg-white/3 border border-white/5 rounded-2xl backdrop-blur-sm overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-white/5">
              <h2 class="text-base font-bold text-white">Album Management</h2>
              <button id="btn-add-album" class="flex items-center gap-2 px-4 py-2 bg-linear-to-r from-purple-500/20 to-indigo-500/10 hover:from-purple-500/30 border border-purple-500/20 text-purple-300 rounded-xl text-xs font-semibold transition-all">
                <span class="material-symbols-outlined text-[16px]">add</span>Add Album
              </button>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead>
                  <tr class="border-b border-white/5 text-gray-500 text-xs font-bold uppercase tracking-wider">
                    <th class="px-6 py-3">Album</th>
                    <th class="px-6 py-3 hidden sm:table-cell">Artist</th>
                    <th class="px-6 py-3 hidden md:table-cell text-center">Songs</th>
                    <th class="px-6 py-3 hidden lg:table-cell">Release</th>
                    <th class="px-6 py-3 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody id="admin-albums-tbody" class="divide-y divide-white/3">
                  <tr><td colspan="4" class="px-6 py-8 text-center text-gray-500 text-sm">Loading...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ── Genres Section ───────────────────────────────────────────── -->
        <div id="section-genres" class="hidden space-y-6">
          <div class="bg-white/3 border border-white/5 rounded-2xl backdrop-blur-sm overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-white/5">
              <h2 class="text-base font-bold text-white">Genre Management</h2>
              <button id="btn-add-genre" class="flex items-center gap-2 px-4 py-2 bg-linear-to-r from-purple-500/20 to-indigo-500/10 hover:from-purple-500/30 border border-purple-500/20 text-purple-300 rounded-xl text-xs font-semibold transition-all">
                <span class="material-symbols-outlined text-[16px]">add</span>Add Genre
              </button>
            </div>
