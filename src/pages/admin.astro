<script>
  // @ts-nocheck
  import { apiFetch, getToken, getUser, colorFor, requireAuthClient, hasMinRole, API_BASE } from '../lib/api.js';

  if (!requireAuthClient('manager')) {

    throw new Error('redirecting');
  }

  let _adminModalOpenCount = 0;
  let _adminScrollY = 0;

  function lockAdminPageScroll() {
    if (_adminModalOpenCount === 0) {
      _adminScrollY = window.scrollY || window.pageYOffset || 0;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${_adminScrollY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';
    }
    _adminModalOpenCount += 1;
  }

  function unlockAdminPageScroll() {
    _adminModalOpenCount = Math.max(0, _adminModalOpenCount - 1);
    if (_adminModalOpenCount !== 0) return;
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.left = '';
    document.body.style.right = '';
    document.body.style.width = '';
    document.body.style.overflow = '';
    window.scrollTo(0, _adminScrollY);
  }

  function openAdminModal(el: HTMLElement) {
    el.classList.remove('hidden', 'modal-closing');
    lockAdminPageScroll();

    void el.offsetWidth;
  }

  function closeAdminModal(el: HTMLElement) {
    if (el.classList.contains('hidden')) return;
    el.classList.add('modal-closing');
    setTimeout(() => {
      el.classList.add('hidden');
      el.classList.remove('modal-closing');
      unlockAdminPageScroll();
    }, 180);
  }

  function showToast(message: string, type: 'success' | 'error' | 'info' = 'info') {
    let container = document.getElementById('toast-container');
    if (!container) {
      container = document.createElement('div');
      container.id = 'toast-container';
      container.className = 'fixed bottom-6 right-6 z-[999] flex flex-col gap-2 pointer-events-none';
      document.body.appendChild(container);
    }
    const colors = {
      success: 'bg-green-500/20 border-green-500/40 text-green-300',
      error:   'bg-red-500/20 border-red-500/40 text-red-300',
      info:    'bg-indigo-500/20 border-indigo-500/40 text-indigo-300',
    };
    const icons = { success: 'check_circle', error: 'error', info: 'info' };
    const toast = document.createElement('div');
    toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl border backdrop-blur-xl shadow-2xl text-sm font-medium transition-all duration-300 translate-y-2 opacity-0 ${colors[type]}`;
    toast.innerHTML = `<span class="material-symbols-outlined text-[18px] shrink-0">${icons[type]}</span><span>${message}</span>`;
    container.appendChild(toast);
    requestAnimationFrame(() => {
      toast.classList.remove('translate-y-2', 'opacity-0');
    });
    setTimeout(() => {
      toast.classList.add('translate-y-2', 'opacity-0');
      setTimeout(() => toast.remove(), 300);
    }, 3500);
  }

  type ConfirmOptions = {
    title?: string;
    body: string;
    confirmLabel?: string;
    confirmClass?: string;
    icon?: string;
    iconClass?: string;
    iconWrapClass?: string;
  };

  function showConfirm(opts: ConfirmOptions): Promise<boolean> {
    return new Promise((resolve) => {
      const modal      = document.getElementById('modal-confirm')!;
      const titleEl    = document.getElementById('modal-confirm-title')!;
      const bodyEl     = document.getElementById('modal-confirm-body')!;
      const okBtn      = document.getElementById('modal-confirm-ok') as HTMLButtonElement;
      const cancelBtn  = document.getElementById('modal-confirm-cancel') as HTMLButtonElement;
      const iconEl     = document.getElementById('modal-confirm-icon')!;
      const iconWrap   = document.getElementById('modal-confirm-icon-wrap')!;

      titleEl.textContent  = opts.title ?? 'Confirm Action';
      bodyEl.textContent   = opts.body;
      okBtn.textContent    = opts.confirmLabel ?? 'Confirm';
      okBtn.className      = `px-5 py-2 text-sm font-semibold text-white rounded-xl transition-all duration-150 shadow-[0_4px_12px_rgba(225,29,72,0.3)] ${opts.confirmClass ?? 'bg-rose-600 hover:bg-rose-500'}`;
      iconEl.textContent   = opts.icon ?? 'warning';
      iconEl.className     = `material-symbols-outlined text-[24px] ${opts.iconClass ?? 'text-rose-400'}`;
      iconWrap.className   = `w-12 h-12 rounded-xl flex items-center justify-center shrink-0 border ${opts.iconWrapClass ?? 'bg-rose-500/15 border-rose-500/20'}`;

      openAdminModal(modal as HTMLElement);

      const cleanup = (result: boolean) => {
        closeAdminModal(modal as HTMLElement);
        okBtn.removeEventListener('click', onOk);
        cancelBtn.removeEventListener('click', onCancel);
        document.getElementById('modal-confirm-bg')!.removeEventListener('click', onCancel);
        resolve(result);
      };
      const onOk     = () => cleanup(true);
      const onCancel = () => cleanup(false);

      okBtn.addEventListener('click', onOk);
      cancelBtn.addEventListener('click', onCancel);
      document.getElementById('modal-confirm-bg')!.addEventListener('click', onCancel);
    });
  }

  const GRADS = [
    'linear-gradient(135deg,#6366f1,#8b5cf6)',
    'linear-gradient(135deg,#f43f5e,#f97316)',
    'linear-gradient(135deg,#ec4899,#7c3aed)',
    'linear-gradient(135deg,#ef4444,#d946ef)',
    'linear-gradient(135deg,#3b82f6,#06b6d4)',
    'linear-gradient(135deg,#06b6d4,#10b981)',
    'linear-gradient(135deg,#d946ef,#7c3aed)',
    'linear-gradient(135deg,#fb923c,#fb7185)',
  ];
  const grad = (id: number) => GRADS[(Number(id) - 1) % GRADS.length];

  function fmt(sec: number) {
    const s = Math.floor(sec) || 0;
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  }









  function renderFilterChips(
    chipsId: string,
    clearBtnId: string,
    countId: string | null,
    total: number,
    filtered: number,
    filters: Array<{ label: string; value: string; clearFn: () => void }>,
    clearAllFn: () => void,
  ) {
    const container = document.getElementById(chipsId);
    const clearBtn  = document.getElementById(clearBtnId);
    const countEl   = countId ? document.getElementById(countId) : null;

    const hasFilters = filters.length > 0;

    if (clearBtn) clearBtn.classList.toggle('hidden', !hasFilters);

    if (countEl) {
      if (hasFilters && filtered < total) {
        countEl.textContent = `${filtered} / ${total}`;
        countEl.classList.remove('hidden');
      } else if (total > 0) {
        countEl.textContent = `${total}`;
        countEl.classList.remove('hidden');
      } else {
        countEl.classList.add('hidden');
      }
    }

    if (!container) return;
    if (!hasFilters) { container.classList.add('hidden'); container.innerHTML = ''; return; }

    container.classList.remove('hidden');
    container.innerHTML = `
      <span class="text-[11px] text-gray-500 font-medium mr-0.5">Filters:</span>
      ${filters.map(f => `
        <button class="filter-chip" data-chip>
          <span class="text-gray-400 font-normal">${f.label}:</span>&nbsp;${f.value}
          <span class="material-symbols-outlined text-[11px] opacity-70">close</span>
        </button>
      `).join('')}
      <button class="filter-chip-clear-all">Clear all</button>
    `;

    const chips = container.querySelectorAll<HTMLElement>('[data-chip]');
    chips.forEach((chip, i) => chip.addEventListener('click', () => { filters[i].clearFn(); }));
    container.querySelector('.filter-chip-clear-all')?.addEventListener('click', clearAllFn);
  }


  function syncFilterSelectStyle(sel: HTMLSelectElement | null) {
    if (!sel) return;
    sel.classList.toggle('adm-filter-active', sel.value !== '');
  }


  function buildPaginationBtns(
    current: number, total: number, gotoFn: (p: number) => void,
  ): string {
    if (total <= 1) return '';
    const btnCls = (p: number) =>
      p === current
        ? 'px-3 py-1 text-xs font-bold rounded-lg bg-purple-600 text-white'
        : 'px-3 py-1 text-xs rounded-lg bg-white/5 text-gray-400 hover:bg-white/10 hover:text-white transition-all';
    const pages: string[] = [];
    for (let p = 1; p <= total; p++) {
      if (p === 1 || p === total || Math.abs(p - current) <= 2)
        pages.push(`<button class="${btnCls(p)}" data-pg="${p}">${p}</button>`);
      else if (pages[pages.length - 1] !== '…')
        pages.push('…');
    }
    const prevDis = current === 1;
    const nextDis = current === total;
    return `
      <button data-pg="${current - 1}" ${prevDis ? 'disabled' : ''}
        class="px-2 py-1 text-xs rounded-lg ${prevDis ? 'text-gray-600 cursor-default' : 'bg-white/5 text-gray-400 hover:bg-white/10 hover:text-white transition-all'}">
        <span class="material-symbols-outlined text-[16px]">chevron_left</span>
      </button>
      ${pages.join('')}
      <button data-pg="${current + 1}" ${nextDis ? 'disabled' : ''}
        class="px-2 py-1 text-xs rounded-lg ${nextDis ? 'text-gray-600 cursor-default' : 'bg-white/5 text-gray-400 hover:bg-white/10 hover:text-white transition-all'}">
        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
      </button>
    `;
  }

  function fmtDate(iso: string) {
    if (!iso) return '—';
    return new Date(iso).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
  }

  let loadGenres: () => Promise<void>;

  const ALL_SECTIONS = ['dashboard', 'users', 'subscriptions', 'songs', 'artists', 'playlists', 'albums', 'tasks', 'genres', 'analytics'] as const;
  type Section = typeof ALL_SECTIONS[number];

  const SECTION_TITLES: Record<string, string> = {
    dashboard: 'Dashboard',
    users:     'User Management',
    subscriptions: 'Subscription Management',
    songs:     'Song Management',
    artists:   'Artist Management',
    playlists: 'Playlist Management',
    albums:    'Album Management',
    tasks:     'Manager Tasks',
    genres:    'Genre Management',
    analytics: 'Analytics & Reports',
  };

  let _activeSection: string = 'dashboard';
  const _loadedSections = new Set<string>(['dashboard']);
  const _prunedSections = new Set<string>();

  function pruneSectionDom(section: string) {
    if (section === 'users') {
      ['admin-users-tbody', 'users-pagination-btns', 'users-results-count', 'users-filter-chips', 'artist-requests-list'].forEach((id) => {
        const el = document.getElementById(id);
        if (el) el.innerHTML = '';
      });
      _loadedSections.delete('users');
      _prunedSections.add('users');
      return;
    }
    if (section === 'songs') {
      ['admin-songs-tbody', 'songs-pagination-btns', 'songs-results-count', 'songs-filter-chips'].forEach((id) => {
        const el = document.getElementById(id);
        if (el) el.innerHTML = '';
      });
      _loadedSections.delete('songs');
      _prunedSections.add('songs');
      return;
    }
    if (section === 'analytics') {
      destroyDashCharts();
      destroyAnalyticsCharts();
      ['dash-top-songs', 'dash-genre-legend', 'admin-recent-users', 'top-songs-list', 'genre-dist-legend', 'subscription-legend'].forEach((id) => {
        const el = document.getElementById(id);
        if (el) el.innerHTML = '';
      });
      ['dash-chart-user-growth', 'dash-chart-listening', 'dash-chart-genres', 'chart-user-growth', 'chart-listening-activity', 'chart-top-songs', 'chart-top-artists', 'chart-genre-dist', 'chart-revenue', 'chart-subscriptions'].forEach((id) => {
        const el = document.getElementById(id) as HTMLCanvasElement | null;
        if (el) {
          const ctx = el.getContext('2d');
          ctx?.clearRect(0, 0, el.width, el.height);
        }
      });
      ['chart-user-growth-empty', 'chart-listening-activity-empty', 'chart-revenue-empty', 'dash-genres-empty'].forEach((id) => {
        const el = document.getElementById(id);
        if (el) el.classList.add('hidden');
      });
      _loadedSections.delete('analytics');
      _prunedSections.add('analytics');
      return;
    }
  }

  function switchSection(section: string) {
    if (_activeSection === section) return;
    const prevSection = _activeSection;
    _activeSection = section;

    ALL_SECTIONS.forEach((s) => {
      const el = document.getElementById(`section-${s}`);
      if (el) el.classList.toggle('hidden', s !== section);
    });

    document.querySelectorAll<HTMLElement>('.nav-btn[data-section]').forEach((btn) => {
      const isActive = btn.dataset.section === section;
      btn.classList.toggle('nav-active', isActive);
      btn.classList.toggle('bg-linear-to-r', isActive);
      btn.classList.toggle('from-purple-500/20', isActive);
      btn.classList.toggle('to-transparent', isActive);
      btn.classList.toggle('text-white', isActive);
      btn.classList.toggle('shadow-[inset_2px_0_0_0_rgba(168,85,247,1)]', isActive);
      btn.classList.toggle('text-gray-400', !isActive);
      btn.classList.toggle('hover:text-white', !isActive);
      btn.classList.toggle('hover:bg-white/5', !isActive);
      btn.classList.toggle('group', !isActive);
      const icon = btn.querySelector<HTMLElement>('.nav-icon');
      if (icon) {
        icon.classList.toggle('text-purple-400', isActive);
        icon.classList.toggle('group-hover:scale-110', !isActive);
      }
    });

    if (prevSection === 'users' || prevSection === 'songs' || prevSection === 'analytics') pruneSectionDom(prevSection);

    const titleEl = document.getElementById('page-title');
    if (titleEl) titleEl.textContent = SECTION_TITLES[section] ?? 'Dashboard';

    if (!_loadedSections.has(section)) {
      _loadedSections.add(section);
      switch (section) {
        case 'users':     loadUsers(); loadArtistRequests(); break;
        case 'subscriptions': loadSubscriptionAdmin(); break;
        case 'songs':     loadSongs(); break;
        case 'artists':   loadArtists(); break;
        case 'playlists': loadPlaylists(); break;
        case 'albums':    loadAlbums(); break;
        case 'tasks':     loadTasks(); break;
        case 'genres':    break;
        case 'analytics': loadAnalytics(); break;
      }
    }
    if (section === 'genres') loadGenres();
  }

  document.querySelectorAll<HTMLElement>('.nav-btn[data-section]').forEach((btn) => {
    btn.addEventListener('click', () => switchSection(btn.dataset.section!));
  });

  document.getElementById('btn-add-new-header')?.addEventListener('click', () => {
    if (_activeSection === 'songs')   { document.getElementById('btn-open-upload')?.click(); return; }
    if (_activeSection === 'artists') { document.getElementById('btn-add-artist')?.click(); return; }
    if (_activeSection === 'tasks')   { document.getElementById('btn-assign-task')?.click(); return; }
    if (_activeSection === 'genres')  { document.getElementById('btn-add-genre')?.click(); return; }
  });

  let _usersSearchTimer: ReturnType<typeof setTimeout> | null = null;
  document.getElementById('users-search')?.addEventListener('input', (e) => {
    if (_usersSearchTimer) clearTimeout(_usersSearchTimer);
    _usersSearchTimer = setTimeout(() => {
      _userKeyword = (e.target as HTMLInputElement).value.trim();
      _userPage    = 1;
      loadUsers(1);
    }, 350);
  });
  let _userPlan    = '';
  let _userSort    = '';
  const _userRoleSel    = document.getElementById('users-filter-role')    as HTMLSelectElement;
  const _userLockedSel  = document.getElementById('users-filter-locked')  as HTMLSelectElement;
  const _userPlanSel    = document.getElementById('users-filter-plan')    as HTMLSelectElement;
  const _userSortSel    = document.getElementById('users-sort')           as HTMLSelectElement;

  let _subPage = 1;
  let _subKeyword = '';
  let _subPlan = '';
  let _subStatus = '';
  let _subRole = '';
  const _subSearchEl = document.getElementById('sub-search') as HTMLInputElement;
  const _subPlanSel = document.getElementById('sub-filter-plan') as HTMLSelectElement;
  const _subStatusSel = document.getElementById('sub-filter-status') as HTMLSelectElement;
  const _subRoleSel = document.getElementById('sub-filter-role') as HTMLSelectElement;

  function _updateUserChips() {
    const active: Array<{label:string; value:string; clearFn:()=>void}> = [];
    if (_userKeyword)  active.push({ label: 'Search', value: _userKeyword, clearFn: () => { _userKeyword = ''; (document.getElementById('users-search') as HTMLInputElement).value = ''; syncFilterSelectStyle(_userRoleSel); loadUsers(1); } });
    if (_userRole)     active.push({ label: 'Role', value: _userRole, clearFn: () => { _userRole = ''; _userRoleSel.value = ''; syncFilterSelectStyle(_userRoleSel); loadUsers(1); } });
    if (_userLocked)   active.push({ label: 'Status', value: _userLocked === '1' ? 'Locked' : 'Active', clearFn: () => { _userLocked = ''; _userLockedSel.value = ''; syncFilterSelectStyle(_userLockedSel); loadUsers(1); } });
    if (_userPlan)     active.push({ label: 'Plan', value: _userPlan, clearFn: () => { _userPlan = ''; _userPlanSel.value = ''; syncFilterSelectStyle(_userPlanSel); loadUsers(1); } });
    if (_userSort)     active.push({ label: 'Sort', value: _userSort.replace(/_/g,' '), clearFn: () => { _userSort = ''; _userSortSel.value = ''; loadUsers(1); } });
    renderFilterChips('users-filter-chips', 'btn-users-clear-filters', 'users-results-count', 0, 0, active, () => {
      _userKeyword = ''; _userRole = ''; _userLocked = ''; _userPlan = ''; _userSort = '';
      (document.getElementById('users-search') as HTMLInputElement).value = '';
      _userRoleSel.value = ''; _userLockedSel.value = ''; _userPlanSel.value = ''; _userSortSel.value = '';
      [_userRoleSel, _userLockedSel, _userPlanSel, _userSortSel].forEach(syncFilterSelectStyle);
      loadUsers(1);
    });
    [_userRoleSel, _userLockedSel, _userPlanSel].forEach(syncFilterSelectStyle);
  }

  function _updateSubscriptionChips(total = 0, filtered = 0) {
    const active: Array<{label:string; value:string; clearFn:()=>void}> = [];
    if (_subKeyword) active.push({ label: 'Search', value: _subKeyword, clearFn: () => { _subKeyword = ''; if (_subSearchEl) _subSearchEl.value = ''; loadSubscriptionAdmin(1); } });
    if (_subPlan) active.push({ label: 'Plan', value: _subPlan.toUpperCase(), clearFn: () => { _subPlan = ''; if (_subPlanSel) _subPlanSel.value = ''; syncFilterSelectStyle(_subPlanSel); loadSubscriptionAdmin(1); } });
    if (_subStatus) active.push({ label: 'Status', value: _subStatus, clearFn: () => { _subStatus = ''; if (_subStatusSel) _subStatusSel.value = ''; syncFilterSelectStyle(_subStatusSel); loadSubscriptionAdmin(1); } });
    if (_subRole) active.push({ label: 'Role', value: _subRole, clearFn: () => { _subRole = ''; if (_subRoleSel) _subRoleSel.value = ''; syncFilterSelectStyle(_subRoleSel); loadSubscriptionAdmin(1); } });
    renderFilterChips('sub-filter-chips', 'btn-sub-clear-filters', 'sub-results-count', total, filtered, active, () => {
      _subKeyword = ''; _subPlan = ''; _subStatus = ''; _subRole = '';
