  document.getElementById('modal-edit-album-bg')?.addEventListener('click',    () => closeAdminModal(editAlbumModal as HTMLElement));
  document.getElementById('modal-edit-album-close')?.addEventListener('click', () => closeAdminModal(editAlbumModal as HTMLElement));

  editAlbumCoverDropzone?.addEventListener('click', () => editAlbumCoverFile?.click());
  editAlbumCoverFile?.addEventListener('change', async () => {
    const file = editAlbumCoverFile.files?.[0];
    if (!file) return;
    if (!['image/jpeg','image/png','image/webp'].includes(file.type) || file.size > 5*1024*1024) {
      editAlbumErrDiv.textContent = 'Image must be JPG/PNG/WebP, max 5MB.';
      editAlbumErrDiv.classList.remove('hidden');
      editAlbumCoverFile.value = '';
      return;
    }
    const objUrl = URL.createObjectURL(file);
    editAlbumCoverPreview.innerHTML = `<img src="${objUrl}" class="w-full h-full object-cover" alt="" />`;
    try {
      const fd = new FormData(); fd.append('cover', file);
      const token = getToken();
      const res = await fetch(`${API_BASE}/admin/upload/cover`, {
        method: 'POST',
        headers: token ? { Authorization: `Bearer ${token}` } : {},
        body: fd,
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.message || 'Upload failed');
      editAlbumCoverUrl.value = json.data.url;
      URL.revokeObjectURL(objUrl);
    } catch (err: any) {
      editAlbumErrDiv.textContent = `Image upload error: ${err.message}`;
      editAlbumErrDiv.classList.remove('hidden');
      editAlbumCoverPreview.innerHTML = '<span class="material-symbols-outlined text-gray-500 text-base">image</span>';
      editAlbumCoverUrl.value = '';
      URL.revokeObjectURL(objUrl);
    }
  });

