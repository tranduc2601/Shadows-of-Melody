      </button>
    </div>
    <form id="form-genre" class="space-y-4">
      <input id="genre-id" type="hidden" value="" />
      <div>
        <label class="block text-sm font-medium text-gray-300 mb-2">Genre Name <span class="text-rose-400">*</span></label>
        <input id="genre-name-input" type="text" maxlength="100" placeholder="e.g. Pop, Rock, Jazz…"
          class="w-full px-4 py-3 bg-[#1a2847] border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all" />
        <p id="genre-name-err" class="hidden mt-1 text-xs text-red-400">Genre name is required.</p>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-300 mb-2">Description <span class="text-gray-500 font-normal">(optional)</span></label>
        <textarea id="genre-desc-input" maxlength="300" rows="3" placeholder="Short description of this genre…"
          class="w-full px-4 py-3 bg-[#1a2847] border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all resize-none"></textarea>
      </div>
      <div id="genre-error" class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm rounded-lg px-4 py-3"></div>
      <button type="submit" id="btn-genre-submit"
        class="w-full py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-lg transition-all flex items-center justify-center gap-2">
        <span class="material-symbols-outlined text-[18px]">save</span>
        <span id="btn-genre-submit-label">Create Genre</span>
      </button>
    </form>
  </div>
</div>

</MainLayout>
