  });

  // ── Genre Modal ──────────────────────────────────────────────────────────────
  const genreModal      = document.getElementById('modal-genre') as HTMLElement;
  const genreModalBg    = document.getElementById('modal-genre-bg') as HTMLElement;
  const genreModalClose = document.getElementById('modal-genre-close') as HTMLElement;
  const genreForm       = document.getElementById('form-genre') as HTMLFormElement;
  const genreIdInput    = document.getElementById('genre-id') as HTMLInputElement;
  const genreNameInput  = document.getElementById('genre-name-input') as HTMLInputElement;
  const genreDescInput  = document.getElementById('genre-desc-input') as HTMLTextAreaElement;
  const genreNameErr    = document.getElementById('genre-name-err') as HTMLElement;
  const genreErrDiv     = document.getElementById('genre-error') as HTMLElement;
  const genreModalTitle = document.getElementById('modal-genre-title') as HTMLElement;
  const genreSubmitLabel = document.getElementById('btn-genre-submit-label') as HTMLElement;

  function openGenreModal(id: string | null, name = '', description = '') {
    genreIdInput.value   = id ?? '';
    genreNameInput.value = name;
    genreDescInput.value = description;
    genreNameErr.classList.add('hidden');
    genreErrDiv.classList.add('hidden');
    genreModalTitle.textContent   = id ? 'Edit Genre' : 'Add Genre';
    genreSubmitLabel.textContent  = id ? 'Save Changes' : 'Create Genre';
    genreModal.classList.remove('hidden');
    genreNameInput.focus();
  }

  document.getElementById('btn-add-genre')?.addEventListener('click', () => openGenreModal(null));
  genreModalBg?.addEventListener('click',    () => genreModal.classList.add('hidden'));
  genreModalClose?.addEventListener('click', () => genreModal.classList.add('hidden'));

  genreForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = genreNameInput.value.trim();
    genreNameErr.classList.add('hidden');
    genreErrDiv.classList.add('hidden');
    if (!name) { genreNameErr.classList.remove('hidden'); genreNameInput.focus(); return; }

    const id = genreIdInput.value;
    const btn = document.getElementById('btn-genre-submit') as HTMLButtonElement;
    const origLabel = genreSubmitLabel.textContent!;
    btn.disabled = true;
    genreSubmitLabel.textContent = 'Saving…';

    try {
      const description = genreDescInput.value.trim() || null;
      if (id) {
        await apiFetch(`/admin/genres/${id}`, { method: 'PUT', body: JSON.stringify({ name, description }) });
        showToast('Genre updated.', 'success');
      } else {
        await apiFetch('/admin/genres', { method: 'POST', body: JSON.stringify({ name, description }) });
        showToast('Genre created.', 'success');
      }
      genreModal.classList.add('hidden');
      _loadedSections.delete('genres');
      loadGenres();
    } catch (err: any) {
      genreErrDiv.textContent = err.message || 'Failed to save genre.';
      genreErrDiv.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      genreSubmitLabel.textContent = origLabel;
    }
  });

  // Task status change — delegated listener, survives innerHTML replacements
  document.getElementById('admin-tasks-tbody')?.addEventListener('change', async (e: Event) => {
    const sel = (e.target as HTMLElement).closest('.select-task-status') as HTMLSelectElement | null;
    if (!sel) return;
    const id = sel.dataset.id;
    const newStatus = sel.value;
    const prev = sel.dataset.current!;
    if (!id || newStatus === prev) return;
    try {
      await apiFetch(`/admin/tasks/${id}/status`, { method: 'PATCH', body: JSON.stringify({ status: newStatus }) });
      sel.dataset.current = newStatus;
      const row = sel.closest('tr');
      const badge = row?.querySelector('.task-status-badge') as HTMLElement | null;
      if (badge) {
        const ss: Record<string,string> = { pending: 'bg-amber-500/15 text-amber-300', in_progress: 'bg-blue-500/15 text-blue-300', completed: 'bg-green-500/15 text-green-300' };
        const sl: Record<string,string> = { pending: 'Pending', in_progress: 'In Progress', completed: 'Completed' };
        badge.className = `task-status-badge inline-flex items-center text-xs font-semibold px-2.5 py-1 rounded-full ${ss[newStatus] ?? 'bg-white/5 text-gray-400'}`;
        badge.textContent = sl[newStatus] ?? newStatus;
      }
      showToast('Task status updated.', 'success');
    } catch (err: any) { showToast(err.message || 'Failed to update task status.', 'error'); sel.value = prev; }
  });

  // Task assignment modal
  const taskModal      = document.getElementById('modal-assign-task')   as HTMLElement;
  const taskModalBg    = document.getElementById('modal-task-bg')       as HTMLElement;
  const taskModalClose = document.getElementById('modal-task-close')    as HTMLElement;
  const taskForm       = document.getElementById('form-assign-task')    as HTMLFormElement;
  const taskErrDiv     = document.getElementById('task-error')          as HTMLElement;
  const taskManagerSel = document.getElementById('task-manager-select') as HTMLSelectElement;

  document.getElementById('btn-assign-task')?.addEventListener('click', async () => {
    taskErrDiv?.classList.add('hidden');
    taskForm?.reset();
    taskManagerSel.innerHTML = '<option value="">Loading managers...</option>';
    taskModal?.classList.remove('hidden');
    try {
      const { data: managers } = await apiFetch('/admin/managers');
      taskManagerSel.innerHTML = managers?.length
        ? '<option value="">— Select a manager —</option>' + managers.map((m: any) => `<option value="${m.id}">${m.username}</option>`).join('')
        : '<option value="">— No managers available —</option>';
    } catch {
      taskManagerSel.innerHTML = '<option value="">— Failed to load —</option>';
    }
  });

  taskModalBg?.addEventListener('click',    () => { taskModal?.classList.add('hidden'); });
  taskModalClose?.addEventListener('click', () => { taskModal?.classList.add('hidden'); taskForm?.reset(); });

  taskForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    taskErrDiv?.classList.add('hidden');
    const title      = (document.getElementById('task-title')       as HTMLInputElement).value.trim();
    const desc       = (document.getElementById('task-description') as HTMLTextAreaElement).value.trim();
    const assignedTo = taskManagerSel.value;
    if (!title)      { taskErrDiv.textContent = 'Task title is required.';  taskErrDiv.classList.remove('hidden'); return; }
    if (!assignedTo) { taskErrDiv.textContent = 'Please select a manager.'; taskErrDiv.classList.remove('hidden'); return; }
    const subBtn = document.getElementById('btn-task-submit') as HTMLButtonElement;
    subBtn.disabled = true;
    const orig = subBtn.innerHTML;
    subBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span> Assigning...';
    try {
      await apiFetch('/admin/tasks', {
        method: 'POST',
        body: JSON.stringify({ title, description: desc || undefined, assigned_to: Number(assignedTo) }),
      });
      taskModal?.classList.add('hidden');
      taskForm?.reset();
      showToast('Task assigned successfully.', 'success');
      loadTasks();
    } catch (err: any) {
      taskErrDiv.textContent = err.message || 'Failed to assign task';
      taskErrDiv.classList.remove('hidden');
    } finally {
      subBtn.disabled = false;
      subBtn.innerHTML = orig;
    }
  });

  // ── Add Artist Modal ─────────────────────────────────────────────────────────
  const artistModal      = document.getElementById('modal-add-artist') as HTMLElement;
  const artistModalBg    = document.getElementById('modal-artist-bg') as HTMLElement;
  const artistModalClose = document.getElementById('modal-artist-close') as HTMLElement;
  const artistForm       = document.getElementById('form-add-artist') as HTMLFormElement;
  const artistErrDiv     = document.getElementById('artist-error') as HTMLElement;

  document.getElementById('btn-add-artist')?.addEventListener('click', () => artistModal?.classList.remove('hidden'));
  artistModalBg?.addEventListener('click',    () => { artistModal?.classList.add('hidden'); artistForm?.reset(); });
  artistModalClose?.addEventListener('click', () => { artistModal?.classList.add('hidden'); artistForm?.reset(); });

  artistForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    artistErrDiv?.classList.add('hidden');
    const name     = (document.getElementById('artist-name')     as HTMLInputElement)?.value.trim();
    const bio      = (document.getElementById('artist-bio')      as HTMLTextAreaElement)?.value.trim();
    const imageUrl = (document.getElementById('artist-image-url') as HTMLInputElement)?.value.trim();
    if (!name) { artistErrDiv.textContent = 'Vui lòng nhập tên nghệ sĩ.'; artistErrDiv.classList.remove('hidden'); return; }
    const submitArtistBtn = document.getElementById('btn-artist-submit') as HTMLButtonElement;
    submitArtistBtn.disabled = true;
    try {
      await apiFetch('/artists', { method: 'POST', body: JSON.stringify({ name, bio: bio || undefined, image_url: imageUrl || undefined }) });
      artistModal?.classList.add('hidden');
      artistForm?.reset();
      showToast('Artist added successfully.', 'success');
      loadArtists();
    } catch (err: any) {
      artistErrDiv.textContent = err.message || 'Failed to add artist.';
      artistErrDiv.classList.remove('hidden');
    } finally {
      submitArtistBtn.disabled = false;
    }
  });

  // ── Artist Detail Modal ──────────────────────────────────────────────────
  const artistDetailModal   = document.getElementById('modal-artist-detail') as HTMLElement;
  const artistDetailModalBg = document.getElementById('modal-artist-detail-bg') as HTMLElement;
  const artistDetailClose   = document.getElementById('modal-artist-detail-close') as HTMLElement;

  artistDetailModalBg?.addEventListener('click', () => artistDetailModal?.classList.add('hidden'));
  artistDetailClose?.addEventListener('click',   () => artistDetailModal?.classList.add('hidden'));

  async function openArtistDetail(artistId: string | number) {
    artistDetailModal?.classList.remove('hidden');
    const nameEl   = document.getElementById('artist-detail-name') as HTMLElement;
    const metaEl   = document.getElementById('artist-detail-meta') as HTMLElement;
    const avatarEl = document.getElementById('artist-detail-avatar') as HTMLElement;
    const albumsEl = document.getElementById('artist-detail-albums') as HTMLElement;
    const songsEl  = document.getElementById('artist-detail-songs') as HTMLElement;
    if (nameEl)   nameEl.textContent = 'Loading...';
    if (metaEl)   metaEl.textContent = '';
    if (avatarEl) avatarEl.innerHTML = '';
    if (albumsEl) albumsEl.innerHTML = '<p class="text-gray-500 text-xs col-span-full text-center py-4">Loading...</p>';
    if (songsEl)  songsEl.innerHTML  = '<p class="text-gray-500 text-xs text-center py-4">Loading...</p>';
    try {
      const { data } = await apiFetch(`/admin/artists/${artistId}/content`);
      const { artist, albums, songs, total_songs } = data;
      if (nameEl) nameEl.textContent = artist.name;
      if (metaEl) metaEl.textContent = `${total_songs} song${total_songs !== 1 ? 's' : ''} · ${(artist.followers_count || 0).toLocaleString()} followers`;
      if (avatarEl) {
        avatarEl.style.background = colorFor(artist.id);
        avatarEl.innerHTML = artist.image_url
          ? `<img src="${artist.image_url}" class="w-full h-full object-cover" alt="" />`
          : `<span>${(artist.name || '?').charAt(0).toUpperCase()}</span>`;
      }
      if (albumsEl) albumsEl.innerHTML = albums.length
        ? albums.map((al: any) => `
            <div class="bg-white/5 rounded-xl p-3 hover:bg-white/8 transition-colors">
              <div class="w-full aspect-square rounded-lg bg-white/10 overflow-hidden mb-2 flex items-center justify-center">
                ${al.cover_url
                  ? `<img src="${al.cover_url}" class="w-full h-full object-cover" alt="" />`
                  : `<span class="material-symbols-outlined text-gray-600 text-3xl">album</span>`}
              </div>
              <p class="text-xs font-semibold text-gray-200 truncate">${al.title}</p>
            </div>`).join('')
        : '<p class="text-gray-500 text-xs col-span-full text-center py-4">No albums.</p>';
      if (songsEl) songsEl.innerHTML = songs.length
        ? songs.map((s: any, i: number) => `
            <div class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-white/5 transition-colors">
              <span class="text-xs text-gray-600 w-5 text-right shrink-0">${i + 1}</span>
              <div class="w-8 h-8 rounded shrink-0 overflow-hidden bg-white/10 flex items-center justify-center">
                ${s.cover_url
                  ? `<img src="${s.cover_url}" class="w-full h-full object-cover" alt="" />`
                  : `<span class="material-symbols-outlined text-gray-600 text-[16px]">music_note</span>`}
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-gray-200 truncate">${s.title}</p>
                ${s.album_title ? `<p class="text-xs text-gray-500 truncate">${s.album_title}</p>` : ''}
              </div>
              <span class="text-xs text-gray-500 shrink-0">${fmt(s.duration)}</span>
            </div>`).join('')
        : '<p class="text-gray-500 text-xs text-center py-4">No songs.</p>';
    } catch (err: any) {
      if (albumsEl) albumsEl.innerHTML = `<p class="text-red-400 text-xs col-span-full text-center py-4">${err.message}</p>`;
      if (songsEl)  songsEl.innerHTML  = '';
    }
  }

  // ── Album Songs Modal ───────────────────────────────────────────────────────
  const albumSongsModal      = document.getElementById('modal-album-songs') as HTMLElement;
  const albumSongsModalBg    = document.getElementById('modal-album-songs-bg') as HTMLElement;
  const albumSongsModalClose = document.getElementById('modal-album-songs-close') as HTMLElement;
  const albumSongsContent    = document.getElementById('album-songs-content') as HTMLElement;
  const albumSongsSearch     = document.getElementById('album-songs-search') as HTMLInputElement;
  const albumSongsSearchWrap = document.getElementById('album-songs-search-wrap') as HTMLElement;
  const tabAlbumCurrent      = document.getElementById('tab-album-current') as HTMLButtonElement;
  const tabAlbumAdd          = document.getElementById('tab-album-add') as HTMLButtonElement;
  const albumSongsCountBadge = document.getElementById('album-songs-count-badge') as HTMLElement;

  let _albumSongsModalId: string = '';
  let _albumSongsData: { album_songs: any[]; all_songs: any[] } = { album_songs: [], all_songs: [] };
  let _albumSongsTab: 'current' | 'add' = 'current';

  albumSongsModalBg?.addEventListener('click',    () => albumSongsModal?.classList.add('hidden'));
  albumSongsModalClose?.addEventListener('click', () => albumSongsModal?.classList.add('hidden'));

  tabAlbumCurrent?.addEventListener('click', () => switchAlbumTab('current'));
  tabAlbumAdd?.addEventListener('click',     () => switchAlbumTab('add'));

  albumSongsSearch?.addEventListener('input', () => renderAlbumSongsTab());

  function switchAlbumTab(tab: 'current' | 'add') {
    _albumSongsTab = tab;
    const activeClass   = 'album-songs-tab px-4 py-2 text-sm font-semibold rounded-lg bg-purple-600 text-white transition-all';
    const inactiveClass = 'album-songs-tab px-4 py-2 text-sm font-semibold rounded-lg bg-white/5 text-gray-400 hover:bg-white/10 hover:text-white transition-all';
    tabAlbumCurrent.className = tab === 'current' ? activeClass : inactiveClass;
    tabAlbumAdd.className     = tab === 'add'     ? activeClass : inactiveClass;
    albumSongsSearchWrap?.classList.toggle('hidden', tab !== 'add');
    if (albumSongsSearch) albumSongsSearch.value = '';
    renderAlbumSongsTab();
  }

  function renderAlbumSongsTab() {
    if (_albumSongsTab === 'current') {
      const songs = _albumSongsData.album_songs;
      if (!songs.length) {
        albumSongsContent.innerHTML = '<p class="text-gray-500 text-sm text-center py-8">Album chưa có bài hát nào.</p>';
        return;
      }
      albumSongsContent.innerHTML = songs.map((s: any) => `
        <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-white/5 transition-colors group">
          <div class="w-10 h-10 rounded-lg shrink-0 overflow-hidden flex items-center justify-center" style="background:${grad(s.id)}">
            ${s.cover_url ? `<img src="${s.cover_url}" class="w-full h-full object-cover" alt="" />` : ''}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-gray-100 truncate">${s.title}</p>
            <p class="text-xs text-gray-500 truncate">${s.artist_names || '—'} · ${fmt(s.duration)}</p>
          </div>
          <button class="btn-remove-from-album shrink-0 flex items-center gap-1 px-2.5 py-1.5 text-xs font-semibold rounded-lg opacity-0 group-hover:opacity-100 hover:bg-rose-500/20 hover:text-rose-400 text-gray-500 transition-all"
                  data-song-id="${s.id}" data-song-title="${s.title}">
            <span class="material-symbols-outlined text-[14px]">remove_circle</span>Xóa khỏi album
          </button>
        </div>`).join('');
    } else {
      const query = albumSongsSearch?.value.trim().toLowerCase() || '';
      const inAlbumIds = new Set(_albumSongsData.album_songs.map((s: any) => String(s.id)));
      let songs = _albumSongsData.all_songs.filter((s: any) => !inAlbumIds.has(String(s.id)));
      if (query) songs = songs.filter((s: any) => s.title.toLowerCase().includes(query) || (s.artist_names || '').toLowerCase().includes(query));
      if (!songs.length) {
        albumSongsContent.innerHTML = '<p class="text-gray-500 text-sm text-center py-8">Không tìm thấy bài hát nào.</p>';
        return;
      }
      albumSongsContent.innerHTML = songs.map((s: any) => `
        <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-white/5 transition-colors group">
          <div class="w-10 h-10 rounded-lg shrink-0 overflow-hidden flex items-center justify-center" style="background:${grad(s.id)}">
            ${s.cover_url ? `<img src="${s.cover_url}" class="w-full h-full object-cover" alt="" />` : ''}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-gray-100 truncate">${s.title}</p>
            <p class="text-xs text-gray-500 truncate">${s.artist_names || '—'}${s.album_title ? ' · Album: ' + s.album_title : ''} · ${fmt(s.duration)}</p>
          </div>
          <button class="btn-add-to-album shrink-0 flex items-center gap-1 px-2.5 py-1.5 text-xs font-semibold rounded-lg opacity-0 group-hover:opacity-100 hover:bg-green-500/20 hover:text-green-400 text-gray-500 transition-all"
                  data-song-id="${s.id}" data-song-title="${s.title}">
            <span class="material-symbols-outlined text-[14px]">add_circle</span>Thêm vào album
          </button>
        </div>`).join('');
    }
  }

  albumSongsContent?.addEventListener('click', async (e: Event) => {
    const removeBtn = (e.target as HTMLElement).closest('.btn-remove-from-album') as HTMLButtonElement | null;
    const addBtn    = (e.target as HTMLElement).closest('.btn-add-to-album')       as HTMLButtonElement | null;
    const btn = removeBtn || addBtn;
    if (!btn || btn.disabled) return;

    const songId    = btn.dataset.songId!;
    const songTitle = btn.dataset.songTitle || `#${songId}`;
    const action    = removeBtn ? 'remove' : 'add';

    btn.disabled = true;
    const origHTML = btn.innerHTML;
    btn.innerHTML = '<span class="material-symbols-outlined text-[14px] animate-spin">refresh</span>';

    try {
      await apiFetch(`/admin/albums/${_albumSongsModalId}/songs/${songId}`, {
        method: 'PATCH',
        body: JSON.stringify({ action }),
      });

      if (action === 'remove') {
        _albumSongsData.album_songs = _albumSongsData.album_songs.filter((s: any) => String(s.id) !== songId);
      } else {
        const song = _albumSongsData.all_songs.find((s: any) => String(s.id) === songId);
        if (song) _albumSongsData.album_songs.push(song);
      }

      albumSongsCountBadge.textContent = String(_albumSongsData.album_songs.length);
      renderAlbumSongsTab();
      showToast(
        action === 'remove'
          ? `Đã xóa "${songTitle}" khỏi album.`
          : `Đã thêm "${songTitle}" vào album.`,
        'success'
      );
      // Refresh albums table song count
      _loadedSections.delete('albums');
    } catch (err: any) {
      showToast(err.message || 'Thao tác thất bại.', 'error');
      btn.disabled = false;
      btn.innerHTML = origHTML;
    }
  });

  async function openAlbumSongsModal(albumId: string, albumTitle: string) {
    _albumSongsModalId = albumId;
    _albumSongsTab = 'current';
    const titleEl = document.getElementById('album-songs-modal-title') as HTMLElement;
    if (titleEl) titleEl.textContent = albumTitle;
    albumSongsSearchWrap?.classList.add('hidden');
    if (albumSongsSearch) albumSongsSearch.value = '';
    tabAlbumCurrent.className = 'album-songs-tab px-4 py-2 text-sm font-semibold rounded-lg bg-purple-600 text-white transition-all';
    tabAlbumAdd.className     = 'album-songs-tab px-4 py-2 text-sm font-semibold rounded-lg bg-white/5 text-gray-400 hover:bg-white/10 hover:text-white transition-all';
    albumSongsContent.innerHTML = '<p class="text-gray-500 text-sm text-center py-8">Đang tải...</p>';
    albumSongsModal?.classList.remove('hidden');

    try {
      const { data } = await apiFetch(`/admin/albums/${albumId}/songs`);
      _albumSongsData = { album_songs: data.album_songs || [], all_songs: data.all_songs || [] };
      albumSongsCountBadge.textContent = String(_albumSongsData.album_songs.length);
      renderAlbumSongsTab();
    } catch (err: any) {
      albumSongsContent.innerHTML = `<p class="text-red-400 text-sm text-center py-8">${err.message}</p>`;
    }
  }

  // ── Boot ─────────────────────────────────────────────────────────────────────
  // Verify admin session before loading any data
  (async () => {
    const token = getToken();

    if (!token) {
      window.location.href = '/login?reason=not_logged_in';
      return;
    }

    // Always verify against the API — don't trust stale localStorage
    let meData: any;
    try {
      const res = await apiFetch('/auth/me');
      meData = res.data;
    } catch {
      // apiFetch already redirects on 401
      return;
    }

    if (!meData?.is_admin && !['manager', 'admin'].includes(meData?.role)) {
      window.location.href = '/?reason=forbidden';
      return;
    }

    // Refresh localStorage so subsequent checks are correct
    const storedUser = getUser();
    if (storedUser) {
      import('../lib/api.js').then(({ setAuth }) => {
        setAuth(token, { ...storedUser, ...meData });
      });
    }

    // Token is valid — load dashboard stats and show default section
    loadStats();
    _loadedSections.add('dashboard');
    // Keep dashboard visible (already shown by default in HTML)
  })();

  // ── Admin logout ─────────────────────────────────────────────────────────────
  document.getElementById('admin-logout-btn')?.addEventListener('click', async () => {
    if (!confirm('Đăng xuất khỏi Admin Panel?')) return;
    try {
      const token = getToken();
      if (token) {
        await fetch('http://localhost:5000/api/auth/logout', {
          method: 'POST', headers: { Authorization: `Bearer ${token}` },
        });
      }
    } catch {}
    import('../lib/player.js').then(({ player }) => player?.reset?.());
    import('../lib/api.js').then(({ clearAuth }) => {
      clearAuth();
      window.location.href = '/login';
    });
  });
</script>

