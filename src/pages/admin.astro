  function ensureChartJs(): Promise<void> {
    return new Promise((resolve) => {
      if ((window as any).Chart) { resolve(); return; }
      const s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js';
      s.onload = () => resolve();
      document.head.appendChild(s);
    });
  }

  const CHART_COLORS = [
    'rgba(139,92,246,1)',  'rgba(59,130,246,1)',  'rgba(16,185,129,1)',
    'rgba(245,158,11,1)',  'rgba(239,68,68,1)',   'rgba(236,72,153,1)',
    'rgba(20,184,166,1)',  'rgba(99,102,241,1)',  'rgba(249,115,22,1)',
    'rgba(168,85,247,1)',  'rgba(14,165,233,1)',  'rgba(34,197,94,1)',
    'rgba(234,179,8,1)',   'rgba(248,113,113,1)', 'rgba(167,139,250,1)',
  ];
  const CHART_COLORS_ALPHA = CHART_COLORS.map((c) => c.replace(',1)', ',0.15)'));

  function chartDefaults(Chart: any) {
    Chart.defaults.color = '#9ca3af';
    Chart.defaults.borderColor = 'rgba(255,255,255,0.06)';
    Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
  }

  function fillDateSeries(raw: {date: string; count?: number; plays?: number}[], days = 30, field = 'count') {
    const map: Record<string, number> = {};
    raw.forEach((r) => { map[r.date] = (r as any)[field] ?? 0; });
    const labels: string[] = [];
    const values: number[] = [];
    const now = new Date();
    for (let i = days - 1; i >= 0; i--) {
      const d = new Date(now);
      d.setDate(d.getDate() - i);
      const key = d.toISOString().slice(0, 10);
      labels.push(key.slice(5));
      values.push(map[key] ?? 0);
    }
    return { labels, values };
  }

  function fmtSeconds(s: number): string {
    if (s < 3600) return `${Math.round(s / 60)}m`;
    if (s < 86400) return `${(s / 3600).toFixed(1)}h`;
    return `${Math.round(s / 86400)}d`;
  }

  let _dashCharts: any[] = [];

  function destroyDashCharts() {
    _dashCharts.forEach((c) => { try { c?.destroy(); } catch {} });
    _dashCharts = [];
