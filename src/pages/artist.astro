---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import PlayerBar from "../components/PlayerBar.astro";
---

<MainLayout title="Artist - Shadows of Melody">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">
    <Sidebar currentPage="artists" />
    <main class="flex-1 flex flex-col overflow-hidden relative min-w-0 bg-linear-to-br from-[#0c1328] via-[#060e20] to-[#040813]">
      <div class="flex-1 overflow-y-auto px-4 sm:px-6 lg:px-8 pb-32 pt-8 custom-scrollbar">
        <div class="flex items-center gap-4 mb-6">
          <a href="/artists" class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors"><span class="material-symbols-outlined text-white text-xl">arrow_back_ios_new</span></a>
          <h1 id="artist-name" class="text-3xl font-black text-white">Artist</h1>
        </div>
        <section class="mb-10"><h2 class="text-xl font-bold text-white mb-4">Songs</h2><div id="artist-songs" class="space-y-2"></div></section>
        <section><h2 class="text-xl font-bold text-white mb-4">Albums</h2><div id="artist-albums" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4"></div></section>
      </div>
      <PlayerBar />
    </main>
  </div>
<script>
  // @ts-nocheck
  import { apiFetch, formatDuration } from '../lib/api.js';
  import { player } from '../lib/player.js';

  const GRADS = [
    'linear-gradient(135deg,#6366f1,#8b5cf6)',
    'linear-gradient(135deg,#f43f5e,#f97316)',
    'linear-gradient(135deg,#ec4899,#7c3aed)',
    'linear-gradient(135deg,#ef4444,#d946ef)',
    'linear-gradient(135deg,#3b82f6,#06b6d4)',
    'linear-gradient(135deg,#06b6d4,#10b981)',
    'linear-gradient(135deg,#d946ef,#7c3aed)',
    'linear-gradient(135deg,#fb923c,#fb7185)',
  ];

  const id = new URLSearchParams(location.search).get('id');
  if (!id) location.href = '/artists';

  const nameEl = document.getElementById('artist-name');
  const songsEl = document.getElementById('artist-songs');
  const albumsEl = document.getElementById('artist-albums');

  async function loadArtist() {
    const { data: a } = await apiFetch(`/artists/${id}`);
    if (!a) return;

    if (nameEl) nameEl.textContent = a.name;
    document.title = `${a.name} - Shadows of Melody`;

    if (songsEl) {
      const songs = Array.isArray(a.songs) ? a.songs : [];
      songsEl.innerHTML = songs.map((s, i) => `
        <div class="group flex items-center gap-4 px-4 py-4 rounded-2xl hover:bg-white/[0.05] transition-colors cursor-pointer song-row" data-song="${encodeURIComponent(JSON.stringify(s))}">
          <span class="w-6 text-center text-gray-500 group-hover:hidden">${i + 1}</span>
          <span class="material-symbols-outlined text-purple-400 hidden group-hover:block text-[20px]">play_arrow</span>
          <div class="w-12 h-12 rounded-lg shrink-0 overflow-hidden" style="background:${GRADS[(s.id - 1) % GRADS.length]}">
            ${s.cover_url ? `<img src="${s.cover_url}" loading="lazy" decoding="async" class="w-full h-full object-cover" alt=""/>` : ''}
          </div>
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-white group-hover:text-purple-300 truncate">${s.title}</p>
            <p class="text-xs text-gray-500">${s.artist_names || a.name}</p>
          </div>
          <span class="text-sm text-gray-500">${formatDuration(s.duration)}</span>
        </div>
      `).join('') || '<p class="text-gray-500 text-sm">No songs yet.</p>';
    }

    if (albumsEl) {
      const albums = Array.isArray(a.albums) ? a.albums : [];
      albumsEl.innerHTML = albums.map((al) => `
        <a href="/album?id=${al.id}" class="group block">
          <div class="aspect-square rounded-2xl mb-3 overflow-hidden" style="background:${GRADS[(al.id - 1) % GRADS.length]}">
            ${al.cover_url ? `<img src="${al.cover_url}" loading="lazy" decoding="async" class="w-full h-full object-cover" alt=""/>` : ''}
          </div>
          <p class="text-white font-semibold text-sm truncate group-hover:text-purple-300">${al.title}</p>
        </a>
      `).join('') || '<p class="text-gray-500 text-sm">No albums yet.</p>';
    }
  }

  songsEl?.addEventListener('click', (e) => {
    const target = e.target;
    const row = target instanceof HTMLElement ? target.closest('.song-row') : null;
    if (!row || !songsEl) return;
    const songRows = [...songsEl.querySelectorAll('.song-row')];
    const songs = songRows.map((r) => {
      try { return JSON.parse(decodeURIComponent((r as HTMLElement).dataset.song || '')); } catch { return null; }
    }).filter(Boolean);
    try {
      const song = JSON.parse(decodeURIComponent(row.dataset.song || ''));
      player.playSong(song, songs);
    } catch {}
  });

  loadArtist();
</script>
</MainLayout>
