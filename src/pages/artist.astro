---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import PlayerBar from "../components/PlayerBar.astro";
---

<MainLayout title="Artist - Shadows of Melody">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">
    <Sidebar currentPage="artists" />

    <main class="flex-1 flex flex-col overflow-hidden bg-linear-to-br from-[#0c1328] via-[#060e20] to-[#040813] relative min-w-0">
      <div class="absolute top-0 left-0 w-[50%] h-[50%] bg-purple-900/10 blur-[150px] rounded-full pointer-events-none"></div>
      <div class="absolute right-0 top-24 w-[32rem] h-[32rem] bg-cyan-500/10 blur-[160px] rounded-full pointer-events-none"></div>

      <div class="flex-1 overflow-y-auto px-4 sm:px-6 lg:px-8 pb-32 pt-8 custom-scrollbar">
        <section class="mb-8 rounded-[2rem] border border-white/10 bg-white/[0.03] backdrop-blur-xl shadow-2xl shadow-black/20 overflow-hidden">
          <div id="artist-hero" class="relative overflow-hidden border-b border-white/10 bg-linear-to-r from-purple-500/10 via-fuchsia-500/5 to-cyan-500/10">
            <div class="absolute inset-0 opacity-60" id="artist-hero-bg"></div>
            <div class="absolute inset-0 bg-linear-to-t from-[#060e20]/90 via-[#060e20]/50 to-transparent"></div>
            <div class="relative p-6 sm:p-8">
              <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
                <div class="max-w-3xl">
                  <a href="/artists" class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-white transition hover:bg-white/[0.08] hover:border-purple-400/30">
                    <span class="material-symbols-outlined text-xl">arrow_back_ios_new</span>
                  </a>
                  <p class="inline-flex items-center gap-2 rounded-full border border-purple-400/20 bg-purple-400/10 px-3 py-1 text-xs font-semibold text-purple-200 mb-4">
                    <span class="material-symbols-outlined text-sm">artist</span>
                    Artist profile
                  </p>
                  <div class="flex items-center gap-4">
                    <div class="relative h-20 w-20 sm:h-24 sm:w-24 overflow-hidden rounded-full border border-white/15 bg-white/5 ring-4 ring-white/5">
                      <img id="artist-avatar" alt="Artist avatar" class="h-full w-full object-cover hidden" />
                      <div id="artist-avatar-fallback" class="flex h-full w-full items-center justify-center text-2xl font-black text-white">A</div>
                    </div>
                    <div>
                      <h1 id="artist-name" class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight">Artist</h1>
                      <p id="artist-bio" class="mt-3 text-sm sm:text-base text-gray-300 max-w-2xl">Explore songs, albums, and quick actions in a polished profile view.</p>
                    </div>
                  </div>
                </div>

                <div class="grid grid-cols-3 gap-3 sm:gap-4 text-center min-w-[240px]">
                  <div class="rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-3">
                    <p id="stat-songs" class="text-2xl font-black text-white">0</p>
                    <p class="text-xs uppercase tracking-[0.2em] text-gray-400 mt-1">Songs</p>
                  </div>
                  <div class="rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-3">
                    <p id="stat-albums" class="text-2xl font-black text-white">0</p>
                    <p class="text-xs uppercase tracking-[0.2em] text-gray-400 mt-1">Albums</p>
                  </div>
                  <div class="rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-3">
                    <p id="stat-followers" class="text-2xl font-black text-white">0</p>
                    <p class="text-xs uppercase tracking-[0.2em] text-gray-400 mt-1">Followers</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="p-4 sm:p-6 flex flex-wrap items-center gap-3">
            <button id="artist-follow-btn" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-purple-400/20 bg-purple-400/10 px-4 py-3 text-sm font-semibold text-purple-100 transition hover:bg-purple-400/15 hover:border-purple-300/30">
              <span class="material-symbols-outlined text-[20px]" id="artist-follow-icon">person_add</span>
              <span id="artist-follow-label">Follow</span>
            </button>
            <button id="artist-refresh" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-3 text-sm font-semibold text-gray-100 transition hover:bg-white/[0.08] hover:border-white/20">
              <span class="material-symbols-outlined text-[20px]">refresh</span>
              Refresh
            </button>
            <div class="ml-auto text-sm text-gray-400" id="artist-status"></div>
          </div>
        </section>

        <section class="mb-10 rounded-[2rem] border border-white/10 bg-white/[0.03] p-4 sm:p-6">
          <div class="mb-4 flex items-center justify-between gap-4">
            <h2 class="text-xl font-bold text-white">Top songs</h2>
            <span class="text-sm text-gray-400">Tap a song to play</span>
          </div>
          <div id="artist-top-songs" class="space-y-3"></div>
        </section>

        <section class="mb-10 rounded-[2rem] border border-white/10 bg-white/[0.03] p-4 sm:p-6">
          <div class="mb-4 flex items-center justify-between gap-4">
            <h2 class="text-xl font-bold text-white">Songs</h2>
            <span class="text-sm text-gray-400">All tracks</span>
          </div>
          <div id="artist-songs" class="space-y-3"></div>
        </section>

        <section class="rounded-[2rem] border border-white/10 bg-white/[0.03] p-4 sm:p-6">
          <div class="mb-4 flex items-center justify-between gap-4">
            <h2 class="text-xl font-bold text-white">Popular albums</h2>
            <span class="text-sm text-gray-400">Browse the discography</span>
          </div>
          <div id="artist-albums" class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4"></div>
        </section>
      </div>
      <PlayerBar />
    </main>
  </div>
<script>
  // @ts-nocheck
  import { apiFetch, formatDuration, formatCount } from '../lib/api.js';
  import { player } from '../lib/player.js';
  import { getRouteParams } from '../lib/route.js';

  const GRADS = [
    'linear-gradient(135deg,#6366f1,#8b5cf6)',
    'linear-gradient(135deg,#f43f5e,#f97316)',
    'linear-gradient(135deg,#ec4899,#7c3aed)',
    'linear-gradient(135deg,#ef4444,#d946ef)',
    'linear-gradient(135deg,#3b82f6,#06b6d4)',
    'linear-gradient(135deg,#06b6d4,#10b981)',
    'linear-gradient(135deg,#d946ef,#7c3aed)',
    'linear-gradient(135deg,#fb923c,#fb7185)',
  ];

  const route = getRouteParams();
  const id = route.get('id') || route.getPathParam('id');
  if (!id) location.href = '/artists';

  const nameEl = document.getElementById('artist-name');
  const bioEl = document.getElementById('artist-bio');
  const avatarEl = document.getElementById('artist-avatar');
  const avatarFallbackEl = document.getElementById('artist-avatar-fallback');
  const heroBgEl = document.getElementById('artist-hero-bg');
  const topSongsEl = document.getElementById('artist-top-songs');
  const songsEl = document.getElementById('artist-songs');
  const albumsEl = document.getElementById('artist-albums');
  const statusEl = document.getElementById('artist-status');
  const followBtn = document.getElementById('artist-follow-btn');
  const followLabel = document.getElementById('artist-follow-label');
  const followIcon = document.getElementById('artist-follow-icon');
  const statSongs = document.getElementById('stat-songs');
  const statAlbums = document.getElementById('stat-albums');
  const statFollowers = document.getElementById('stat-followers');
  const refreshBtn = document.getElementById('artist-refresh');

  let artist = null;

  function setStatus(message) { if (statusEl) statusEl.textContent = message; }

  function skeletonBlock() {
    return `
      <div class="animate-pulse space-y-3">
        <div class="h-16 rounded-2xl bg-white/5"></div>
        <div class="h-16 rounded-2xl bg-white/5"></div>
        <div class="h-16 rounded-2xl bg-white/5"></div>
      </div>
    `;
  }

  function updateFollowUI() {
    const following = !!artist?.is_following;
    if (followLabel) followLabel.textContent = following ? 'Following' : 'Follow';
    if (followIcon) followIcon.textContent = following ? 'how_to_reg' : 'person_add';
    if (followBtn) followBtn.setAttribute('aria-pressed', following ? 'true' : 'false');
  }

  function getArtistPalette(seed) {
    return GRADS[(Number(seed) - 1) % GRADS.length] || GRADS[0];
  }

  async function loadArtist() {
    setStatus('Loading artist...');
    if (songsEl) songsEl.innerHTML = skeletonBlock();
    if (albumsEl) albumsEl.innerHTML = skeletonBlock();
    try {
      const { data: a } = await apiFetch(`/artists/${id}`);
      if (!a) return;
      artist = a;
      if (nameEl) nameEl.textContent = a.name;
      if (bioEl) bioEl.textContent = a.description || 'Explore songs, albums, and quick actions in a polished profile view.';
      document.title = `${a.name} - Shadows of Melody`;

      const songs = Array.isArray(a.songs) ? a.songs : [];
      const albums = Array.isArray(a.albums) ? a.albums : [];
      const topSongs = [...songs].sort((x, y) => Number(y.play_count || y.plays || 0) - Number(x.play_count || x.plays || 0)).slice(0, 5);

      if (avatarEl && avatarFallbackEl) {
        const avatar = a.cover_url || a.image_url || a.avatar_url || a.coverImage || '';
        if (avatar) {
          avatarEl.src = avatar;
          avatarEl.classList.remove('hidden');
          avatarFallbackEl.classList.add('hidden');
        } else {
          avatarEl.classList.add('hidden');
          avatarFallbackEl.classList.remove('hidden');
          avatarFallbackEl.textContent = (a.name || 'A').slice(0, 1).toUpperCase();
        }
      }
      if (heroBgEl) {
        const heroImage = a.cover_url || a.image_url || a.coverImage || a.avatar_url;
        heroBgEl.style.background = heroImage ? `linear-gradient(rgba(6,14,32,.35), rgba(6,14,32,.8)), url('${heroImage}') center/cover no-repeat` : getArtistPalette(a.id);
      }

      if (statSongs) statSongs.textContent = String(songs.length);
      if (statAlbums) statAlbums.textContent = String(albums.length);
      if (statFollowers) statFollowers.textContent = formatCount(a.followers_count || 0);
      updateFollowUI();

      if (topSongsEl) {
        topSongsEl.innerHTML = topSongs.map((s, i) => `
          <div class="song-row group flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-4 transition duration-300 ease-out hover:-translate-y-0.5 hover:bg-white/[0.06] hover:border-purple-400/20 hover:shadow-[0_12px_40px_rgba(0,0,0,0.22)] cursor-pointer" data-song="${encodeURIComponent(JSON.stringify(s))}">
            <span class="w-6 text-center text-gray-500 transition-transform duration-300 group-hover:hidden">${i + 1}</span>
            <span class="material-symbols-outlined hidden text-[20px] text-purple-400 group-hover:block">play_arrow</span>
            <div class="w-12 h-12 rounded-full shrink-0 overflow-hidden ring-1 ring-white/10 transition duration-300 ease-out group-hover:scale-105" style="background:${getArtistPalette(s.id)}">
              ${s.cover_url ? `<img src="${s.cover_url}" loading="lazy" decoding="async" class="w-full h-full object-cover transition duration-500 ease-out group-hover:scale-110" alt=""/>` : ''}
            </div>
            <div class="min-w-0 flex-1">
              <p class="font-semibold text-white transition-colors duration-300 group-hover:text-purple-300 truncate">${s.title}</p>
              <p class="text-xs text-gray-400 mt-1">${s.artist_names || a.name}</p>
            </div>
            <span class="text-xs rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-gray-300 transition duration-300 group-hover:border-purple-400/20 group-hover:bg-purple-400/10 group-hover:text-purple-200">Top ${i + 1}</span>
          </div>
        `).join('') || '<div class="rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-5 text-sm text-gray-400">No top songs yet.</div>';
      }

      if (songsEl) {
        songsEl.innerHTML = songs.map((s, i) => `
          <div class="song-row group flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-4 transition duration-300 ease-out hover:-translate-y-0.5 hover:bg-white/[0.06] hover:border-purple-400/20 hover:shadow-[0_12px_40px_rgba(0,0,0,0.22)] cursor-pointer" data-song="${encodeURIComponent(JSON.stringify(s))}">
            <span class="w-6 text-center text-gray-500 transition-transform duration-300 group-hover:hidden">${i + 1}</span>
            <span class="material-symbols-outlined hidden text-[20px] text-purple-400 group-hover:block">play_arrow</span>
            <div class="w-12 h-12 rounded-full shrink-0 overflow-hidden ring-1 ring-white/10 transition duration-300 ease-out group-hover:scale-105" style="background:${getArtistPalette(s.id)}">
              ${s.cover_url ? `<img src="${s.cover_url}" loading="lazy" decoding="async" class="w-full h-full object-cover transition duration-500 ease-out group-hover:scale-110" alt=""/>` : ''}
            </div>
            <div class="min-w-0 flex-1">
              <p class="font-semibold text-white transition-colors duration-300 group-hover:text-purple-300 truncate">${s.title}</p>
              <p class="text-xs text-gray-400 mt-1">${s.artist_names || a.name}</p>
            </div>
            <span class="text-sm text-gray-400 transition-colors duration-300 group-hover:text-gray-200">${formatDuration(s.duration)}</span>
          </div>
        `).join('') || '<div class="rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-5 text-sm text-gray-400">No songs yet.</div>';
      }

      if (albumsEl) {
        albumsEl.innerHTML = albums.map((al) => `
          <a href="/album?id=${al.id}" class="group block rounded-[1.5rem] border border-white/10 bg-white/[0.03] p-4 transition hover:-translate-y-1 hover:border-purple-400/20 hover:bg-white/[0.06]">
            <div class="aspect-square rounded-full mb-3 overflow-hidden relative" style="background:${getArtistPalette(al.id)}">
              ${al.cover_url ? `<img src="${al.cover_url}" loading="lazy" decoding="async" class="w-full h-full object-cover transition duration-500 group-hover:scale-105" alt=""/>` : ''}
              <div class="absolute inset-0 bg-linear-to-t from-black/50 via-transparent to-transparent"></div>
            </div>
            <p class="text-white font-semibold text-sm truncate group-hover:text-purple-300">${al.title}</p>
          </a>
        `).join('') || '<div class="rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-5 text-sm text-gray-400">No albums yet.</div>';
      }
      setStatus(`${songs.length} songs · ${albums.length} albums`);
    } catch {
      setStatus('Failed to load artist.');
    }
  }

  followBtn?.addEventListener('click', async () => {
    if (!artist) return;
    const following = !!artist.is_following;
    try {
      const { data } = await apiFetch(`/artists/${id}/follow`, { method: following ? 'DELETE' : 'POST' });
      artist.is_following = !!data.is_following;
      updateFollowUI();
      setStatus(artist.is_following ? 'Following artist' : 'Unfollowed artist');
    } catch {}
  });

  refreshBtn?.addEventListener('click', loadArtist);

  songsEl?.addEventListener('click', (e) => {
    const target = e.target;
    const row = target instanceof HTMLElement ? target.closest('.song-row') : null;
    if (!row || !songsEl || !artist) return;
    const songRows = [...songsEl.querySelectorAll('.song-row')];
    const songs = songRows.map((r) => {
      try { return JSON.parse(decodeURIComponent((r as HTMLElement).dataset.song || '')); } catch { return null; }
    }).filter(Boolean);
    try {
      const song = JSON.parse(decodeURIComponent(row.dataset.song || ''));
      player.playSong(song, songs);
    } catch {}
  });

  loadArtist();
</script>
</MainLayout>
