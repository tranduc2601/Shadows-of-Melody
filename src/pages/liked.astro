---
import MainLayout from "../layouts/MainLayout.astro";
import PlayerBar from "../components/PlayerBar.astro";
---

<MainLayout title="Liked Songs - Shadows of Melody">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">

    <!-- Sidebar -->
    <aside class="w-64 shrink-0 border-r border-white/5 bg-[#0a1229]/80 backdrop-blur-xl hidden md:flex md:flex-col z-40">
      <div class="h-20 flex items-center px-6">
        <a href="/" class="text-2xl font-black bg-clip-text text-transparent bg-linear-to-r from-indigo-400 to-purple-400 flex items-center gap-2">
          <span class="material-symbols-outlined text-purple-400 animate-pulse">music_note</span>
          Melody
        </a>
      </div>

      <div class="px-4 py-6 flex-1 overflow-y-auto">
        <p class="px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Menu</p>
        <nav class="space-y-1 mb-8">
          <a href="/" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">home</span>Home
          </a>
          <a href="/search" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">search</span>Search
          </a>
          <a href="/artists" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">person</span>Artists
          </a>
        </nav>

        <p class="px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Library</p>
        <nav class="space-y-1">
          <!-- Active: Liked Songs -->
          <a href="/liked" class="flex items-center gap-4 px-4 py-3 bg-linear-to-r from-purple-500/20 to-transparent text-white rounded-xl font-medium transition-all shadow-[inset_2px_0_0_0_rgba(168,85,247,1)]">
            <span class="material-symbols-outlined text-rose-400">favorite</span>Favorite Songs
          </a>
          <a href="/playlist" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">queue_music</span>Playlists
          </a>
        </nav>
      </div>

      <div class="p-4 border-t border-white/5">
        <div class="flex items-center gap-3 p-2 rounded-xl hover:bg-white/5 transition-colors">
          <a href="/profile" class="flex items-center gap-3 flex-1 min-w-0">
            <div id="sidebar-avatar-wrap" class="w-10 h-10 rounded-full bg-linear-to-tr from-purple-500 to-pink-500 p-0.5 shrink-0">
              <div class="w-full h-full rounded-full bg-[#0a1229] flex items-center justify-center overflow-hidden">
                <img id="sidebar-avatar-img" src="" alt="" class="w-full h-full object-cover rounded-full hidden" />
                <span id="sidebar-avatar-icon" class="material-symbols-outlined text-purple-400">person</span>
              </div>
            </div>
            <div class="min-w-0">
              <p id="sidebar-user-name" class="text-sm font-semibold text-white truncate">—</p>
              <p id="sidebar-user-plan" class="text-xs text-purple-400 font-medium truncate">—</p>
            </div>
          </a>
          <a href="/settings" class="shrink-0 text-gray-500 hover:text-white transition-colors p-1 rounded-lg hover:bg-white/5">
            <span class="material-symbols-outlined text-[20px]">settings</span>
          </a>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col relative overflow-hidden bg-linear-to-br from-[#0c1328] via-[#060e20] to-[#040813]">
      <!-- Ambient Glow -->
      <div class="absolute top-[-5%] left-[-5%] w-[50%] h-[50%] bg-rose-900/15 blur-[160px] rounded-full pointer-events-none"></div>
      <div class="absolute bottom-[20%] right-0 w-[35%] h-[40%] bg-purple-900/10 blur-[130px] rounded-full pointer-events-none"></div>

      <!-- Scrollable Content -->
      <div class="flex-1 overflow-y-auto pb-32 relative z-10 custom-scrollbar scroll-smooth">

        <!-- Hero Header -->
        <section class="relative overflow-hidden">
          <div class="absolute inset-0 bg-linear-to-b from-rose-900/40 via-purple-900/20 to-transparent pointer-events-none"></div>
          <div class="relative z-10 flex flex-col sm:flex-row items-end gap-8 px-8 pt-10 pb-12">
            <!-- Cover Art -->
            <div class="w-52 h-52 rounded-2xl shrink-0 bg-linear-to-br from-rose-500 via-pink-600 to-purple-700 shadow-2xl shadow-rose-900/50 flex items-center justify-center relative overflow-hidden">
              <!-- Decorative hearts -->
              <div class="absolute inset-0 flex items-center justify-center opacity-15">
                <span class="material-symbols-outlined text-white" style="font-size: 9rem;">favorite</span>
              </div>
              <div class="absolute top-4 left-4 w-16 h-16 rounded-xl bg-linear-to-br from-red-500 to-fuchsia-500 shadow-md"></div>
              <div class="absolute top-4 right-4 w-16 h-16 rounded-xl bg-linear-to-br from-indigo-500 to-purple-500 shadow-md"></div>
              <div class="absolute bottom-4 left-4 w-16 h-16 rounded-xl bg-linear-to-br from-pink-500 to-violet-500 shadow-md"></div>
              <div class="absolute bottom-4 right-4 w-16 h-16 rounded-xl bg-linear-to-br from-rose-500 to-orange-500 shadow-md"></div>
            </div>

            <!-- Info -->
            <div class="flex flex-col gap-2 min-w-0">
              <span class="text-xs font-bold uppercase tracking-widest text-white/50">Playlist</span>
              <h1 class="text-5xl sm:text-6xl font-black text-white drop-shadow-xl">Liked Songs</h1>
              <div class="flex items-center gap-2 text-sm text-gray-400 mt-1 flex-wrap">
                <a href="/profile" id="hero-user-name" class="font-bold text-white hover:underline">—</a>
                <span class="text-white/30" aria-hidden="true">·</span>
                <span><span id="total-tracks">0</span> songs</span>
                <span class="text-white/30" aria-hidden="true">·</span>
                <span class="text-white/50" id="total-duration">—</span>
              </div>
              <div class="flex items-center gap-3 mt-4 flex-wrap">
                <button id="btn-play-all" type="button" class="bg-linear-to-r from-rose-500 to-pink-600 hover:from-rose-400 hover:to-pink-500 text-white rounded-full py-3 px-8 font-bold flex items-center gap-2 transition-all hover:scale-105 shadow-[0_8px_30px_rgba(244,63,94,0.4)]">
                  <span class="material-symbols-outlined text-[22px]">play_arrow</span>
                  Play All
                </button>
                <button id="btn-shuffle-play" type="button" class="flex items-center gap-2 px-5 py-3 bg-white/5 border border-white/10 hover:bg-white/10 text-gray-300 hover:text-white rounded-full font-semibold text-sm transition-all">
                  <span class="material-symbols-outlined text-[18px]">shuffle</span>
                  Shuffle Play
                </button>
              </div>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 right-0 h-20 bg-linear-to-t from-[#060e20] to-transparent pointer-events-none"></div>
        </section>

        <!-- Search & Sort bar -->
        <div class="px-6 lg:px-8 mt-4 mb-4 flex items-center gap-4 flex-wrap">
          <div class="relative flex-1 max-w-xs">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-[18px]">search</span>
            <input
              id="liked-search"
              type="text"
              placeholder="Search in Liked Songs..."
              class="w-full bg-white/5 border border-white/10 text-white placeholder-gray-600 rounded-full py-2 pl-9 pr-9 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/40 focus:bg-white/10 transition-all"
            />
            <button id="liked-search-clear" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-white transition-colors">
              <span class="material-symbols-outlined text-[16px]">close</span>
            </button>
          </div>
          <div class="relative flex items-center gap-2 text-sm text-gray-500">
            <span>Sort by:</span>
            <div class="relative">
              <button id="liked-sort-btn" type="button" class="flex items-center gap-1 text-gray-300 hover:text-white transition-colors font-medium px-2 py-1 rounded-lg hover:bg-white/5">
                <span id="liked-sort-label">Date Added</span>
                <span class="material-symbols-outlined text-[16px]">arrow_drop_down</span>
              </button>
              <div id="liked-sort-menu" class="hidden absolute right-0 top-full mt-1 bg-[#0e1835] border border-white/10 rounded-xl shadow-2xl z-50 min-w-[160px] py-1 backdrop-blur-xl">
                <button class="liked-sort-option w-full text-left px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/5 transition-colors flex items-center gap-2" data-sort="date_desc">
                  <span class="material-symbols-outlined text-[15px] text-purple-400 sort-check" data-for="date_desc">check</span>Date Added ↓
                </button>
                <button class="liked-sort-option w-full text-left px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/5 transition-colors flex items-center gap-2" data-sort="date_asc">
                  <span class="material-symbols-outlined text-[15px] text-transparent sort-check" data-for="date_asc">check</span>Date Added ↑
                </button>
                <button class="liked-sort-option w-full text-left px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/5 transition-colors flex items-center gap-2" data-sort="title_asc">
                  <span class="material-symbols-outlined text-[15px] text-transparent sort-check" data-for="title_asc">check</span>Title A–Z
                </button>
                <button class="liked-sort-option w-full text-left px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/5 transition-colors flex items-center gap-2" data-sort="title_desc">
                  <span class="material-symbols-outlined text-[15px] text-transparent sort-check" data-for="title_desc">check</span>Title Z–A
                </button>
                <button class="liked-sort-option w-full text-left px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/5 transition-colors flex items-center gap-2" data-sort="artist_asc">
                  <span class="material-symbols-outlined text-[15px] text-transparent sort-check" data-for="artist_asc">check</span>Artist A–Z
                </button>
                <button class="liked-sort-option w-full text-left px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/5 transition-colors flex items-center gap-2" data-sort="duration_asc">
                  <span class="material-symbols-outlined text-[15px] text-transparent sort-check" data-for="duration_asc">check</span>Duration ↑
                </button>
                <button class="liked-sort-option w-full text-left px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/5 transition-colors flex items-center gap-2" data-sort="duration_desc">
                  <span class="material-symbols-outlined text-[15px] text-transparent sort-check" data-for="duration_desc">check</span>Duration ↓
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Track Table -->
        <div class="px-6 lg:px-8">
          <div class="bg-white/2 border border-white/5 rounded-3xl p-3 backdrop-blur-sm">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="text-gray-500 border-b border-white/5">
                  <th scope="col" class="font-medium text-xs px-4 py-3 w-12 text-center pb-4">#</th>
                  <th scope="col" class="font-medium text-xs px-4 py-3 pb-4 uppercase tracking-wider">Title</th>
                  <th scope="col" class="font-medium text-xs px-4 py-3 pb-4 hidden lg:table-cell uppercase tracking-wider">Album</th>
                  <th scope="col" class="font-medium text-xs px-4 py-3 pb-4 hidden sm:table-cell uppercase tracking-wider text-right pr-8">Date Added</th>
                  <th scope="col" class="font-medium text-xs px-4 py-3 pb-4 w-16 text-center">
                    <span class="material-symbols-outlined text-[18px]">schedule</span>
                  </th>
                </tr>
              </thead>
              <tbody id="liked-tbody">
                <tr><td colspan="5" class="px-4 py-10 text-center text-gray-500">Loading...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>

      <!-- Toast notification -->
      <div id="liked-toast" class="fixed bottom-36 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 transition-opacity duration-300">
        <div class="flex items-center gap-3 bg-[#1e2a45] border border-white/10 text-white text-sm font-medium px-5 py-3 rounded-2xl shadow-2xl backdrop-blur-md">
          <span class="material-symbols-outlined text-rose-400 text-[18px]">info</span>
          <span id="liked-toast-msg"></span>
        </div>
      </div>

      <!-- Now Playing Bar -->
      <PlayerBar />
    </main>
  </div>

  <style>
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.3); }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
  </style>

<script>
  import { apiFetch, formatDuration, getUser, getCachedMe, setCachedMe, refreshMe } from '../lib/api.js';
  import { player } from '../lib/player.js';

  // ── Populate sidebar + hero — cache first, then refresh silently ──────────
  function applySidebarUser(me: any) {
    if (!me) return;
    const sidebarName = document.getElementById('sidebar-user-name') as HTMLElement;
    const sidebarPlan = document.getElementById('sidebar-user-plan') as HTMLElement;
    const avatarIcon  = document.getElementById('sidebar-avatar-icon') as HTMLElement;
    const avatarImg   = document.getElementById('sidebar-avatar-img') as HTMLImageElement;
    const heroName    = document.getElementById('hero-user-name') as HTMLElement;

    if (sidebarName) sidebarName.textContent = me.full_name || me.username || '—';
    if (heroName)    heroName.textContent    = me.full_name || me.username || '—';

    if (sidebarPlan) {
      const plan = me.subscription?.plan;
      sidebarPlan.textContent = plan === 'premium' ? 'Premium' : plan === 'student' ? 'Student' : 'Free';
      sidebarPlan.className = `text-xs font-medium truncate ${plan && plan !== 'free' ? 'text-purple-400' : 'text-gray-500'}`;
    }

    if (me.avatar_url && avatarImg && avatarIcon) {
      avatarImg.src = me.avatar_url;
      avatarImg.classList.remove('hidden');
      avatarIcon.style.display = 'none';
    }
  }

  // 1) Paint from cache immediately (no flicker)
  const _cached = getCachedMe();
  if (_cached) applySidebarUser(_cached);

  // 2) Refresh from API in background, update cache + UI if data changed
  if (localStorage.getItem('auth_token')) {
    refreshMe().then((fresh) => {
      if (fresh) applySidebarUser(fresh);
    });
  }

  const GRADS = [
    'linear-gradient(135deg,#6366f1,#8b5cf6)',
    'linear-gradient(135deg,#f43f5e,#f97316)',
    'linear-gradient(135deg,#ec4899,#7c3aed)',
    'linear-gradient(135deg,#ef4444,#d946ef)',
    'linear-gradient(135deg,#3b82f6,#06b6d4)',
    'linear-gradient(135deg,#06b6d4,#10b981)',
    'linear-gradient(135deg,#d946ef,#7c3aed)',
    'linear-gradient(135deg,#fb923c,#fb7185)',
  ];
  const grad = (id: number) => GRADS[(id - 1) % GRADS.length];

  // ── Module-level tracks list and display state ───────────────────────────
  let _tracks: any[] = [];
  let _searchQuery: string = '';
  let _sortKey: string = 'date_desc';

  const SORT_LABELS: Record<string, string> = {
    date_desc:    'Date Added',
    date_asc:     'Date Added ↑',
    title_asc:    'Title A–Z',
    title_desc:   'Title Z–A',
    artist_asc:   'Artist A–Z',
    duration_asc: 'Duration ↑',
    duration_desc:'Duration ↓',
  };

  function getDisplayTracks(): any[] {
    let list = [..._tracks];
    // Filter
    if (_searchQuery) {
      const q = _searchQuery.toLowerCase();
      list = list.filter((t: any) =>
        t.title.toLowerCase().includes(q) ||
        (t.artist_names || '').toLowerCase().includes(q) ||
        (t.album_title  || '').toLowerCase().includes(q)
      );
    }
    // Sort
    list.sort((a: any, b: any) => {
      switch (_sortKey) {
        case 'date_desc': return new Date(b.favorited_at || b.added_at || 0).getTime() - new Date(a.favorited_at || a.added_at || 0).getTime();
        case 'date_asc':  return new Date(a.favorited_at || a.added_at || 0).getTime() - new Date(b.favorited_at || b.added_at || 0).getTime();
        case 'title_asc': return a.title.localeCompare(b.title);
        case 'title_desc':return b.title.localeCompare(a.title);
        case 'artist_asc':return (a.artist_names || '').localeCompare(b.artist_names || '');
        case 'duration_asc': return (a.duration || 0) - (b.duration || 0);
        case 'duration_desc':return (b.duration || 0) - (a.duration || 0);
        default: return 0;
      }
    });
    return list;
  }

  function updateStats() {
    (document.getElementById('total-tracks') as HTMLElement).textContent = String(_tracks.length);
    const totalSec = _tracks.reduce((s: number, t: any) => s + (parseInt(t.duration) || 0), 0);
    const h = Math.floor(totalSec / 3600);
    const m = Math.floor((totalSec % 3600) / 60);
    (document.getElementById('total-duration') as HTMLElement).textContent =
      totalSec === 0 ? '—' : h > 0 ? `${h} hr ${m} min` : `${m} min`;
  }

  function renderTracks() {
    const display = getDisplayTracks();
    const tbody = document.getElementById('liked-tbody')!;
    if (!_tracks.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="px-4 py-10 text-center text-gray-500">No liked songs.</td></tr>';
      return;
    }
    if (!display.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="px-4 py-10 text-center text-gray-500">Không tìm thấy bài hát nào.</td></tr>';
      return;
    }
    tbody.innerHTML = display.map((t: any, i: number) => {
      const cover = t.cover_url
        ? `<img src="${t.cover_url}" class="w-10 h-10 rounded-lg shrink-0 object-cover shadow-md" alt=""/>`
        : `<div class="w-10 h-10 rounded-lg shrink-0 shadow-md" style="background:${grad(t.id)}"></div>`;
      const added = (t.favorited_at || t.added_at)
        ? new Date(t.favorited_at || t.added_at).toLocaleDateString('en-US') : '—';
      return `
        <tr class="group hover:bg-white/5 transition-colors cursor-pointer song-row" data-id="${t.id}">
          <td class="px-4 py-3 text-center rounded-l-xl pointer-events-none">
            <span class="text-gray-500 font-medium group-hover:hidden">${i + 1}</span>
            <span class="material-symbols-outlined text-purple-400 hidden group-hover:block text-[20px]">play_arrow</span>
          </td>
          <td class="px-4 py-3 pointer-events-none">
            <div class="flex items-center gap-4">
              ${cover}
              <div class="min-w-0">
                <p class="font-semibold text-gray-100 group-hover:text-purple-400 transition-colors truncate text-sm">${t.title}</p>
                <p class="text-xs text-gray-500 truncate mt-0.5">${t.artist_names || 'Unknown'}</p>
              </div>
            </div>
          </td>
          <td class="px-4 py-3 text-sm text-gray-500 hidden lg:table-cell truncate max-w-40 pointer-events-none">${t.album_title || '—'}</td>
          <td class="px-4 py-3 text-sm text-gray-500 hidden sm:table-cell text-right pr-8 whitespace-nowrap pointer-events-none">${added}</td>
          <td class="px-4 py-3 rounded-r-xl">
            <div class="flex items-center justify-center gap-3">
              <button class="unlike-btn opacity-0 group-hover:opacity-100 text-rose-400 hover:text-rose-300 transition-all" data-id="${t.id}" title="Bỏ yêu thích">
                <span class="material-symbols-outlined text-[18px]" style="font-variation-settings:'FILL' 1">favorite</span>
              </button>
              <span class="text-sm text-gray-500 pointer-events-none">${formatDuration(t.duration)}</span>
            </div>
          </td>
        </tr>`;
    }).join('');
  }

  async function loadFavorites() {
    const tbody = document.getElementById('liked-tbody')!;
    const token = localStorage.getItem('auth_token');

    if (!token) {
      tbody.innerHTML = `<tr><td colspan="5" class="px-4 py-10 text-center">
        <p class="text-gray-400 mb-2">Bạn cần đăng nhập để xem bài hát yêu thích.</p>
        <a href="/login" class="text-purple-400 hover:text-purple-300 font-semibold">Đăng nhập</a>
      </td></tr>`;
      return;
    }

    try {
      const { data: tracks } = await apiFetch('/favorites');
      _tracks = tracks || [];
      updateStats();
      renderTracks();
    } catch (err) {
      tbody.innerHTML = '<tr><td colspan="5" class="px-4 py-10 text-center text-red-400">Không thể tải dữ liệu.</td></tr>';
    }
  }

  // ── Event delegation: play row click ─────────────────────────────────────
  document.getElementById('liked-tbody')!.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    // Unlike button
    const unlikeBtn = target.closest('.unlike-btn') as HTMLElement | null;
    if (unlikeBtn) {
      e.stopPropagation();
      const songId = unlikeBtn.dataset.id;
      if (!songId) return;
      unlikeBtn.style.opacity = '0.4';
      unlikeBtn.style.pointerEvents = 'none';
      try {
        await apiFetch(`/favorites/${songId}`, { method: 'DELETE' });
        _tracks = _tracks.filter((t: any) => String(t.id) !== songId);
        updateStats();
        renderTracks();
        window.dispatchEvent(new CustomEvent('favorites:changed', {
          detail: { songId: Number(songId), isFavorite: false },
        }));
      } catch {
        unlikeBtn.style.opacity = '';
        unlikeBtn.style.pointerEvents = '';
      }
      return;
    }

    // Row click → play song
    const row = target.closest('.song-row') as HTMLElement | null;
    if (row && _tracks.length) {
      const songId = Number(row.dataset.id);
      const song = _tracks.find((t: any) => t.id === songId);
      if (song) player.playSong(song, _tracks);
    }
  });

  // ── Toast helper ─────────────────────────────────────────────────────────
  let _toastTimer: ReturnType<typeof setTimeout> | null = null;
  function showToast(msg: string) {
    const toast = document.getElementById('liked-toast')!;
    const msgEl = document.getElementById('liked-toast-msg')!;
    msgEl.textContent = msg;
    toast.classList.remove('opacity-0');
    toast.classList.add('opacity-100');
    if (_toastTimer) clearTimeout(_toastTimer);
    _toastTimer = setTimeout(() => {
      toast.classList.remove('opacity-100');
      toast.classList.add('opacity-0');
    }, 3000);
  }

  // ── Fisher-Yates shuffle ──────────────────────────────────────────────────
  function shuffleArray<T>(arr: T[]): T[] {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  // ── Play All button ───────────────────────────────────────────────────────
  document.getElementById('btn-play-all')?.addEventListener('click', () => {
    if (!_tracks.length) {
      showToast('Bạn chưa có bài hát yêu thích nào để phát.');
      return;
    }
    // Play in order; disable shuffle if it was on
    if (player.shuffle) player.toggleShuffle();
    player.playSong(_tracks[0], _tracks);
  });

  // ── Shuffle Play button ───────────────────────────────────────────────────
  document.getElementById('btn-shuffle-play')?.addEventListener('click', () => {
    if (!_tracks.length) {
      showToast('Bạn chưa có bài hát yêu thích nào để phát.');
      return;
    }
    // Pre-shuffle the queue so player cycles through all songs without repeats
    const shuffled = shuffleArray(_tracks);
    player.playSong(shuffled[0], shuffled);
  });

  // ── Refresh when a favorite changes in another component ─────────────────
  window.addEventListener('favorites:changed', (e: any) => {
    const { songId, isFavorite } = e.detail;
    if (!isFavorite) {
      _tracks = _tracks.filter((t: any) => t.id !== songId);
      updateStats();
      renderTracks();
    }
  });

  loadFavorites();

  // ── Search ────────────────────────────────────────────────────────────────
  const searchInput = document.getElementById('liked-search') as HTMLInputElement;
  const searchClear = document.getElementById('liked-search-clear') as HTMLElement;

  searchInput?.addEventListener('input', () => {
    _searchQuery = searchInput.value.trim();
    searchClear?.classList.toggle('hidden', !_searchQuery);
    renderTracks();
  });

  searchClear?.addEventListener('click', () => {
    searchInput.value = '';
    _searchQuery = '';
    searchClear.classList.add('hidden');
    renderTracks();
    searchInput.focus();
  });

  // ── Sort dropdown ─────────────────────────────────────────────────────────
  const sortBtn   = document.getElementById('liked-sort-btn') as HTMLButtonElement;
  const sortMenu  = document.getElementById('liked-sort-menu') as HTMLElement;
  const sortLabel = document.getElementById('liked-sort-label') as HTMLElement;

  sortBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    sortMenu?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => sortMenu?.classList.add('hidden'));

  document.querySelectorAll<HTMLElement>('.liked-sort-option').forEach((btn) => {
    btn.addEventListener('click', () => {
      _sortKey = btn.dataset.sort!;
      if (sortLabel) sortLabel.textContent = SORT_LABELS[_sortKey] ?? _sortKey;
      // Update checkmarks
      document.querySelectorAll<HTMLElement>('.sort-check').forEach((icon) => {
        icon.style.color = icon.dataset.for === _sortKey ? 'rgb(192 132 252)' : 'transparent';
      });
      sortMenu?.classList.add('hidden');
      renderTracks();
    });
  });
</script>

</MainLayout>
