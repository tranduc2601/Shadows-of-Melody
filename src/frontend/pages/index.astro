---
import MainLayout from "../../layouts/MainLayout.astro";

const trendingTracks = [
  { id: 1, title: "Midnight City", artist: "M83", duration: "4:03", plays: "1.2M", cover: "bg-gradient-to-br from-indigo-500 to-purple-500" },
  { id: 2, title: "Starboy", artist: "The Weeknd", duration: "3:50", plays: "2.5M", cover: "bg-gradient-to-br from-rose-500 to-orange-500" },
  { id: 3, title: "Levitating", artist: "Dua Lipa", duration: "3:23", plays: "1.8M", cover: "bg-gradient-to-br from-pink-500 to-violet-500" },
  { id: 4, title: "Blinding Lights", artist: "The Weeknd", duration: "3:20", plays: "3.1M", cover: "bg-gradient-to-br from-red-500 to-fuchsia-500" },
  { id: 5, title: "Save Your Tears", artist: "The Weeknd", duration: "3:35", plays: "2.1M", cover: "bg-gradient-to-br from-blue-500 to-cyan-500" },
];

const newReleases = [
  { title: "Neon Nights", artist: "Synthwave Vibes", type: "Album", color: "from-cyan-400 to-blue-500" },
  { title: "Lofi Study", artist: "Chill Girl", type: "Playlist", color: "from-orange-300 to-rose-400" },
  { title: "Deep Focus", artist: "Brain Waves", type: "Playlist", color: "from-emerald-400 to-cyan-500" },
  { title: "Cyberpunk", artist: "Night City", type: "Album", color: "from-fuchsia-500 to-purple-600" },
  { title: "Acoustic", artist: "Raw Sounds", type: "Album", color: "from-amber-500 to-orange-600" },
];
---

<MainLayout title="Shadows of Melody - Home">
  <div class="flex h-screen overflow-hidden bg-[#060e20] text-gray-200 antialiased selection:bg-purple-500/30">
    
    <!-- Sidebar -->
    <aside class="w-64 flex-shrink-0 border-r border-white/5 bg-[#0a1229]/80 backdrop-blur-xl flex flex-col hidden md:flex z-40">
      <div class="h-20 flex items-center px-6">
        <a href="/" class="text-2xl font-black bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-purple-400 flex items-center gap-2">
          <span class="material-symbols-outlined text-purple-400 animate-pulse">music_note</span>
          Shadow of Melody
        </a>
      </div>

      <div class="px-4 py-6 flex-1 overflow-y-auto">
        <p class="px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Menu</p>
        <nav class="space-y-1 mb-8">
          <a href="/" class="flex items-center gap-4 px-4 py-3 bg-gradient-to-r from-purple-500/20 to-transparent text-white rounded-xl font-medium transition-all shadow-[inset_2px_0_0_0_rgba(168,85,247,1)]">
            <span class="material-symbols-outlined text-purple-400">home</span>Home
          </a>
          <a href="/search" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">search</span>Tìm Kiếm
          </a>
          <a href="/artists" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">person</span>Nghệ Sĩ
          </a>
        </nav>

        <p class="px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Library</p>
        <nav class="space-y-1">
          <a href="#" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform text-rose-400">favorite</span>Liked Songs
          </a>
          <a href="/playlist" class="flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">queue_music</span>Playlists
          </a>
        </nav>
      </div>

      <!-- User Profile (Bottom of Sidebar) -->
      <div class="p-4 border-t border-white/5">
        <div class="flex items-center gap-3 p-2 rounded-xl hover:bg-white/5 cursor-pointer transition-colors">
          <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-purple-500 to-pink-500 p-[2px]">
            <div class="w-full h-full rounded-full bg-[#0a1229] flex items-center justify-center">
              <span class="material-symbols-outlined text-purple-400">person</span>
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-white truncate">Duy Ho</p>
            <p class="text-xs text-purple-400 font-medium truncate">Premium</p>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col relative overflow-hidden bg-gradient-to-br from-[#0c1328] via-[#060e20] to-[#040813]">
      <!-- Background Ambient Glow -->
      <div class="absolute top-[-10%] left-[-10%] w-[60%] h-[60%] bg-indigo-600/10 blur-[150px] rounded-full pointer-events-none"></div>
      <div class="absolute bottom-[20%] right-[-10%] w-[40%] h-[40%] bg-purple-600/10 blur-[120px] rounded-full pointer-events-none"></div>

      <!-- Header -->
      <header class="h-20 flex-shrink-0 flex items-center justify-between px-6 lg:px-8 relative z-10 w-full transition-all duration-300">
        <!-- Mobile Menu Button -->
        <button class="md:hidden w-10 h-10 rounded-full bg-white/5 flex items-center justify-center mr-4 text-white">
           <span class="material-symbols-outlined">menu</span>
        </button>

        <div class="flex items-center gap-4 flex-1">
          <div class="hidden sm:flex items-center gap-2 text-gray-400">
            <button class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-white/10 hover:text-white transition-all backdrop-blur-md">
              <span class="material-symbols-outlined text-[20px]">arrow_back_ios_new</span>
            </button>
            <button class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-white/10 hover:text-white transition-all backdrop-blur-md opacity-50 cursor-not-allowed">
              <span class="material-symbols-outlined text-[20px]">arrow_forward_ios</span>
            </button>
          </div>

          <div class="relative w-full max-w-md sm:ml-4 group">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-purple-400 transition-colors">search</span>
            <input 
              type="text" 
              placeholder="Search for artists, songs, or podcasts..."
              class="w-full bg-white/5 border border-white/10 text-white placeholder-gray-500 rounded-full py-2.5 pl-12 pr-4 focus:outline-none focus:ring-2 focus:ring-purple-500/50 focus:bg-white/10 transition-all backdrop-blur-md shadow-inner"
            />
          </div>
        </div>

        <div class="flex items-center gap-4 ml-4">
          <button class="w-10 h-10 rounded-full bg-white/5 border border-white/5 flex items-center justify-center hover:bg-white/10 hover:text-white transition-all backdrop-blur-md relative group">
            <span class="material-symbols-outlined text-gray-300 group-hover:text-white transition-colors">notifications</span>
            <span class="absolute top-2.5 right-2.5 w-2 h-2 rounded-full bg-pink-500 shadow-[0_0_8px_rgba(236,72,153,0.8)]"></span>
          </button>
        </div>
      </header>

      <!-- Scrollable Content -->
      <div class="flex-1 overflow-y-auto px-6 lg:px-8 pb-32 pt-4 relative z-10 custom-scrollbar scroll-smooth">
        
        <!-- Hero Section -->
        <section class="mb-10 group cursor-pointer relative z-20">
          <div class="relative rounded-[32px] overflow-hidden bg-gradient-to-r from-indigo-900 to-purple-900 shadow-2xl shadow-purple-900/20 p-8 md:p-12 min-h-[340px] flex flex-col justify-end transition-transform duration-500 hover:scale-[1.01]">
            <!-- Decorative abstract background for hero -->
            <div class="absolute inset-0 opacity-40 mix-blend-overlay pointer-events-none">
               <div class="absolute right-0 top-0 w-full h-full bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-pink-500/60 via-transparent to-transparent"></div>
               <div class="absolute -bottom-24 -right-24 w-[500px] h-[500px] bg-indigo-500 rounded-full blur-[100px]"></div>
               <!-- Hexagon Grid Pattern Overlay (subtle) -->
               <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')]"></div>
            </div>
            
            <div class="relative z-10 max-w-2xl">
              <div class="flex items-center gap-3 mb-4">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-white/10 backdrop-blur-md rounded-full text-[11px] font-bold tracking-widest text-white border border-white/20 uppercase">
                     <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
                     New Release
                  </span>
                  <span class="text-sm font-medium text-purple-200">Featured Artist</span>
              </div>
              
              <h1 class="text-5xl md:text-7xl font-black text-white mb-4 tracking-tight drop-shadow-xl group-hover:translate-x-2 transition-transform duration-500">Midnight<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-300">Reverie</span></h1>
              <p class="text-lg md:text-xl text-indigo-100/80 mb-8 max-w-lg leading-relaxed font-light">Experience the ultimate sonic journey through neon-lit streets and synthwave dreams.</p>
              
              <div class="flex items-center gap-4">
                <button class="bg-gradient-to-r from-purple-500 to-indigo-600 hover:from-purple-400 hover:to-indigo-500 text-white rounded-full py-3.5 px-8 font-bold flex items-center gap-2 transition-all hover:scale-105 shadow-[0_8px_30px_rgba(168,85,247,0.4)]">
                  <span class="material-symbols-outlined fill-current text-[24px]">play_arrow</span>
                  Play Listen
                </button>
                <button class="bg-white/5 hover:bg-white/10 backdrop-blur-md border border-white/20 text-white rounded-full py-3.5 px-8 font-bold transition-all hover:scale-105">
                  Follow
                </button>
              </div>
            </div>

            <!-- Absolute decorative visual (like a floating vinyl or element) -->
            <div class="absolute right-12 top-1/2 -translate-y-1/2 w-64 h-64 bg-gradient-to-tr from-purple-500/20 to-pink-500/20 rounded-full blur-3xl group-hover:blur-[60px] transition-all duration-700 pointer-events-none"></div>
          </div>
        </section>

        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
          
          <!-- Left Column (Trending) -->
          <div class="xl:col-span-2">
            <div class="flex items-end justify-between mb-6">
               <h2 class="text-2xl font-bold text-white flex items-center gap-2">
                  Trending Now
               </h2>
               <button class="text-sm font-semibold text-purple-400 hover:text-purple-300 transition-colors uppercase tracking-wider">See All</button>
            </div>

            <div class="bg-white/[0.02] border border-white/5 rounded-3xl p-3 backdrop-blur-sm">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="text-gray-400 border-b border-white/5">
                    <th class="font-medium text-sm px-4 py-3 w-12 text-center pb-4">#</th>
                    <th class="font-medium text-sm px-4 py-3 pb-4">Title</th>
                    <th class="font-medium text-sm px-4 py-3 hidden sm:table-cell pb-4 text-right pr-12">Plays</th>
                    <th class="font-medium text-sm px-4 py-3 w-20 text-center pb-4"><span class="material-symbols-outlined text-[18px]">schedule</span></th>
                  </tr>
                </thead>
                <tbody>
                  {trendingTracks.map((track, index) => (
                    <tr class="group hover:bg-white/5 transition-colors rounded-xl cursor-pointer">
                      <td class="px-4 py-3 text-center rounded-l-xl">
                        <span class="text-gray-500 font-medium group-hover:hidden transition-all">{index + 1}</span>
                        <span class="material-symbols-outlined text-purple-400 hidden group-hover:block transition-all animate-pulse">play_arrow</span>
                      </td>
                      <td class="px-4 py-3">
                        <div class="flex items-center gap-4">
                          <div class={`w-12 h-12 rounded-lg shadow-lg ${track.cover} flex-shrink-0 relative overflow-hidden group-hover:scale-105 transition-transform`}>
                             <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors"></div>
                          </div>
                          <div class="min-w-0">
                            <p class="font-semibold text-gray-100 group-hover:text-purple-400 transition-colors truncate text-[15px]">{track.title}</p>
                            <p class="text-xs text-gray-400 truncate mt-0.5">{track.artist}</p>
                          </div>
                        </div>
                      </td>
                      <td class="px-4 py-3 text-sm text-gray-400 hidden sm:table-cell text-right pr-12 font-medium">{track.plays}</td>
                      <td class="px-4 py-3 text-sm text-gray-400 text-center rounded-r-xl">{track.duration}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Right Column (Top Artists) -->
          <div>
            <div class="flex items-end justify-between mb-6">
               <h2 class="text-xl font-bold text-white">Top Artists</h2>
            </div>

            <div class="grid grid-cols-2 gap-4">
              {[
                { name: "The Weeknd", followers: "34M", mix: "from-red-500 to-black" },
                { name: "Dua Lipa", followers: "28M", mix: "from-pink-500 to-rose-400" },
                { name: "Daft Punk", followers: "15M", mix: "from-yellow-400 to-orange-500" },
                { name: "M83", followers: "8M", mix: "from-blue-500 to-indigo-600" }
              ].map((artist) => (
                <div class="bg-white/5 border border-white/5 rounded-3xl p-5 flex flex-col items-center justify-center gap-3 hover:bg-white/10 transition-all cursor-pointer group hover:-translate-y-1.5 hover:shadow-xl hover:shadow-purple-500/10">
                  <div class={`w-24 h-24 rounded-full bg-gradient-to-tr ${artist.mix} overflow-hidden relative shadow-lg group-hover:shadow-2xl group-hover:shadow-purple-500/30 transition-shadow`}>
                     <div class="absolute inset-0 opacity-0 group-hover:opacity-100 bg-black/40 flex items-center justify-center transition-opacity duration-300">
                        <span class="material-symbols-outlined text-white text-4xl transform scale-50 group-hover:scale-100 transition-transform duration-300">play_circle</span>
                     </div>
                  </div>
                  <div class="text-center mt-2">
                    <p class="font-bold text-[15px] text-gray-100 group-hover:text-purple-300 transition-colors">{artist.name}</p>
                    <p class="text-xs text-gray-500 mt-0.5">{artist.followers} fans</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- New Releases Grid -->
        <div class="mt-14">
            <div class="flex items-end justify-between mb-6">
               <h2 class="text-2xl font-bold text-white">New Releases</h2>
               <div class="flex gap-2">
                  <button class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-colors">
                     <span class="material-symbols-outlined text-sm">arrow_back</span>
                  </button>
                  <button class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-colors">
                     <span class="material-symbols-outlined text-sm">arrow_forward</span>
                  </button>
               </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
               {newReleases.map((release) => (
                  <div class="group cursor-pointer">
                     <div class={`w-full aspect-square rounded-2xl bg-gradient-to-br ${release.color} shadow-lg mb-4 relative overflow-hidden transition-all duration-300`}>
                        <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors"></div>
                        
                        <!-- Type Badge -->
                        <div class="absolute top-3 left-3 bg-black/30 backdrop-blur-md px-2 py-1 rounded-md text-[10px] font-bold text-white/90 uppercase tracking-widest border border-white/10">
                           {release.type}
                        </div>

                        <!-- Hover Play Button overlay -->
                        <div class="absolute bottom-4 right-4 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-4 group-hover:translate-y-0 z-10">
                           <button class="w-12 h-12 rounded-full bg-purple-500 text-white flex items-center justify-center hover:scale-110 hover:bg-purple-400 shadow-[0_8px_20px_rgba(168,85,247,0.6)] transition-transform">
                              <span class="material-symbols-outlined text-[24px]">play_arrow</span>
                           </button>
                        </div>
                     </div>
                     <h3 class="font-bold text-[15px] text-gray-100 truncate group-hover:text-purple-400 transition-colors">{release.title}</h3>
                     <p class="text-[13px] text-gray-400 truncate mt-0.5">{release.artist}</p>
                  </div>
               ))}
            </div>
        </div>

      </div>

      <!-- Now Playing Bar (Glassmorphism) -->
      <div class="absolute bottom-0 left-0 w-full h-24 bg-[#0a1229]/80 backdrop-blur-2xl border-t border-white/5 z-50 flex items-center justify-between px-6 shadow-[0_-10px_40px_rgba(0,0,0,0.5)]">
         
         <!-- Track Info -->
         <div class="flex items-center gap-4 w-1/4 min-w-[200px]">
            <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-500 shadow-lg shadow-purple-500/20 relative group cursor-pointer overflow-hidden">
               <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity">
                  <span class="material-symbols-outlined text-white text-xl">keyboard_arrow_up</span>
               </div>
            </div>
            <div class="flex flex-col justify-center min-w-0">
               <a href="#" class="font-bold text-white text-[15px] hover:underline truncate">Midnight City</a>
               <a href="#" class="text-xs text-gray-400 hover:underline truncate mt-0.5">M83</a>
            </div>
            <button class="ml-2 text-gray-400 hover:text-pink-500 transition-colors">
               <span class="material-symbols-outlined">favorite</span>
            </button>
         </div>

         <!-- Primary Controls -->
         <div class="flex-1 flex flex-col items-center max-w-2xl px-8">
            <div class="flex items-center gap-6 mb-1.5">
               <button class="text-gray-500 hover:text-white transition-colors"><span class="material-symbols-outlined text-xl">shuffle</span></button>
               <button class="text-gray-400 hover:text-white transition-colors"><span class="material-symbols-outlined text-2xl">skip_previous</span></button>
               <button class="w-10 h-10 rounded-full bg-white text-black flex items-center justify-center hover:scale-110 transition-transform shadow-[0_0_20px_rgba(255,255,255,0.3)]">
                  <span class="material-symbols-outlined">play_arrow</span>
               </button>
               <button class="text-gray-400 hover:text-white transition-colors"><span class="material-symbols-outlined text-2xl">skip_next</span></button>
               <button class="text-green-400 hover:text-green-300 transition-colors relative">
                  <span class="material-symbols-outlined text-xl">repeat</span>
                  <span class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-green-400"></span>
               </button>
            </div>
            
            <div class="w-full flex items-center gap-3">
               <span class="text-[11px] font-medium text-gray-400 w-10 text-right">0:45</span>
               <div class="flex-1 h-1 bg-white/10 rounded-full overflow-hidden group hover:h-1.5 transition-all cursor-pointer relative">
                  <div class="absolute top-0 left-0 h-full bg-gradient-to-r from-purple-500 to-pink-500 w-1/3 relative">
                     <div class="absolute right-0 top-1/2 -translate-y-1/2 w-2.5 h-2.5 bg-white rounded-full opacity-0 group-hover:opacity-100 shadow-md transition-opacity"></div>
                  </div>
               </div>
               <span class="text-[11px] font-medium text-gray-400 w-10">4:03</span>
            </div>
         </div>

         <!-- Secondary Controls -->
         <div class="w-1/4 min-w-[200px] flex items-center justify-end gap-4 hidden md:flex">
            <button class="text-gray-400 hover:text-white transition-colors"><span class="material-symbols-outlined text-xl">mic</span></button>
            <button class="text-gray-400 hover:text-white transition-colors"><span class="material-symbols-outlined text-xl">queue_music</span></button>
            <button class="text-gray-400 hover:text-white transition-colors"><span class="material-symbols-outlined text-xl">devices</span></button>
            <div class="flex items-center gap-2 w-24 group cursor-pointer">
               <span class="material-symbols-outlined text-gray-400 text-xl group-hover:text-white transition-colors">volume_up</span>
               <div class="flex-1 h-1 bg-white/10 rounded-full overflow-hidden hover:h-1.5 transition-all">
                  <div class="h-full bg-white group-hover:bg-purple-400 transition-colors w-2/3"></div>
               </div>
            </div>
         </div>
      </div>

    </main>
  </div>

  <style>
    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.1);
      border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.3);
    }
    
    /* Smooth utilities for outlines */
    .material-symbols-outlined {
      font-variation-settings:
      'FILL' 0,
      'wght' 400,
      'GRAD' 0,
      'opsz' 24
    }
  </style>
</MainLayout>