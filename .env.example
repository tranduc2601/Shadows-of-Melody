# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/shadows_of_melody
# Set to "true" if your DB host requires SSL (e.g. Supabase, Neon, Render)
DB_SSL=false

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL of the frontend dev server (Astro defaults to port 4321)
CORS_ORIGIN=http://localhost:4321

# ── Cloudinary (audio + image storage) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Upload limits ─────────────────────────────────────────────────────────────
# Maximum upload size in bytes (default 500 MB)
MAX_FILE_SIZE=524288000

# ── Streaming ─────────────────────────────────────────────────────────────────
# Audio stream chunk size in bytes (default 64 KB)
CHUNK_SIZE=65536

# ── Frontend public variables (Astro / Vite) ──────────────────────────────────
# Must be prefixed with PUBLIC_ to be exposed to the browser
PUBLIC_API_BASE=http://localhost:5000/api
